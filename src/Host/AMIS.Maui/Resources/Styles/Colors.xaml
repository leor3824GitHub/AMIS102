<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="Danger">#E53935</Color>
    <Color x:Key="Success">#43A047</Color>
    <Color x:Key="Warning">#FB8C00</Color>

    <Color x:Key="Surface">#F5F5F7</Color>
    <Color x:Key="PrimaryLight">#EDE9FB</Color>
    <Color x:Key="DangerLight">#FFEBEE</Color>

    <!-- ── Accent palette (subtle chips / tinted icon boxes) ── -->
    <Color x:Key="Info">#1E88E5</Color>
    <Color x:Key="InfoLight">#E3F2FD</Color>
    <Color x:Key="SuccessLight">#E8F5E9</Color>
    <Color x:Key="WarningLight">#FFF3E0</Color>
    <Color x:Key="Teal">#00897B</Color>
    <Color x:Key="TealLight">#E0F2F1</Color>

    <!-- Translucent white overlay for chips/avatars sitting on a gradient -->
    <Color x:Key="OnGradientOverlay">#33FFFFFF</Color>

    <!-- Semi-transparent dark pill for controls overlaid on the camera viewfinder -->
    <Color x:Key="CameraOverlayBg">#99212121</Color>

    <!-- ── Reusable gradient brushes ── -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6A3DE8" Offset="0.0" />
        <GradientStop Color="#512BD4" Offset="0.55" />
        <GradientStop Color="#3A1C9E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C4DFF" Offset="0.0" />
        <GradientStop Color="#512BD4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26A69A" Offset="0.0" />
        <GradientStop Color="#00897B" Offset="0.55" />
        <GradientStop Color="#00695C" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
