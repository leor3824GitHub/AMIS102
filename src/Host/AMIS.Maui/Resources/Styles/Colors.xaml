<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#BCBCBC</Color>
    <Color x:Key="Gray300">#A1A1A1</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#4B5563</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="Danger">#E53935</Color>
    <Color x:Key="Success">#43A047</Color>
    <Color x:Key="Warning">#9A3412</Color>

    <!-- Slightly deeper neutral canvas for app background — cool slate so white cards + the
         gradient hero panels read as raised instead of blending into a near-white background. -->
    <Color x:Key="Surface">#E9ECF2</Color>
    <Color x:Key="PrimaryLight">#EDE9FB</Color>
    <Color x:Key="DangerLight">#FFEBEE</Color>

    <!-- ── Accent palette (subtle chips / tinted icon boxes) ── -->
    <Color x:Key="Info">#1E88E5</Color>
    <Color x:Key="InfoLight">#E3F2FD</Color>
    <Color x:Key="SuccessLight">#E8F5E9</Color>
    <Color x:Key="WarningLight">#FFEDD5</Color>

    <!-- Darker nav unselected color for better legibility -->
    <Color x:Key="NavUnselected">#595959</Color>

    <!-- Card / group border stroke to anchor white cards on a light canvas -->
    <Color x:Key="CardBorderStroke">#E5E7EB</Color>
    <Color x:Key="PrimaryText">#111827</Color>
    <Color x:Key="Teal">#00897B</Color>
    <Color x:Key="TealLight">#E0F2F1</Color>

    <!-- OPAQUE deep-indigo overlay for chips/avatars/progress-tracks sitting on the gradient.
         Must be dark AND fully opaque: on-gradient foreground text is white. A translucent overlay
         (even a dark-tinted one) composites toward white on WinUI → white-on-white, making chip
         contents and progress fills invisible (observed on the Inventory ICS/PAR count pills).
         A solid deep indigo keeps white text high-contrast on every platform; we trade the subtle
         "glass" look on Android/iOS for guaranteed legibility on Windows. -->
    <Color x:Key="OnGradientOverlay">#FF201060</Color>

    <!-- Muted (78% opacity) white for secondary text on a gradient panel -->
    <Color x:Key="OnGradientMuted">#C8FFFFFF</Color>

    <!-- Semi-transparent dark pill for controls overlaid on the camera viewfinder -->
    <Color x:Key="CameraOverlayBg">#99212121</Color>

    <!-- ── Reusable gradient brushes ── -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6A3DE8" Offset="0.0" />
        <GradientStop Color="#512BD4" Offset="0.55" />
        <GradientStop Color="#3A1C9E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C4DFF" Offset="0.0" />
        <GradientStop Color="#512BD4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26A69A" Offset="0.0" />
        <GradientStop Color="#00897B" Offset="0.55" />
        <GradientStop Color="#00695C" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
