<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <converters:IsNotNullConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="IsNotNullConverter" />
    <converters:IsNullConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="IsNullConverter" />
    <converters:IsNotZeroConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="IsNotZeroConverter" />
    <converters:InvertedBoolConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="InvertedBoolConverter" />
    <converters:KindToColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="KindToColorConverter" />
    <converters:StringEqualsConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="StringEqualsConverter" />
    <converters:SegmentColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="SegmentColorConverter" />
    <converters:BoolToColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="BoolToColorConverter" />
    <converters:ImageUrlToSourceConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="ImageUrlToSourceConverter" />
    <converters:AssetImageSourceConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="AssetImageSourceConverter" />
    <converters:NameToColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="NameToColorConverter" />
    <converters:CountStatusColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="CountStatusColorConverter" />
    <converters:EntryResultColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="EntryResultColorConverter" />
    <converters:EntryResultLabelConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="EntryResultLabelConverter" />
    <converters:InitialsConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="InitialsConverter" />
    <converters:BoolToLayoutOptionsConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="BoolToLayoutOptionsConverter" />
    <converters:ChatBubbleColorConverter xmlns:converters="clr-namespace:AMIS.Maui.Converters" x:Key="ChatBubbleColorConverter" />

    <!-- ── Design tokens ──
         Spacing doubles feed Spacing/ColumnSpacing/RowSpacing; Thickness tokens feed Padding/Margin.
         Radii live inside the named styles below so each shape is defined once. -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">20</x:Double>
    <x:Double x:Key="SpaceXXL">24</x:Double>

    <x:Double x:Key="IconSizeSmall">16</x:Double>
    <x:Double x:Key="IconSizeMedium">22</x:Double>
    <x:Double x:Key="IconSizeLarge">28</x:Double>

    <Thickness x:Key="PagePadding">16,0</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>

    <!-- Hero panel padding for pages that hide the Shell nav bar: the top inset stands in for the
         status bar / safe area, so it differs per platform. -->
    <OnPlatform x:Key="HeroPadding" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="20,59,20,28" />
        <On Platform="Android" Value="20,36,20,28" />
        <On Platform="WinUI" Value="20,24,20,28" />
    </OnPlatform>

    <!-- Hero padding for pages where the Shell nav bar stays visible (no status-bar inset needed) -->
    <Thickness x:Key="HeroPaddingUnderNavBar">20,20,20,24</Thickness>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource NavUnselected}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <!-- ── Shared named styles ── -->

    <!-- Gradient hero panel — the signature header (reference implementation: HomePage).
         Rounded bottom corners + Primary-tinted drop shadow lift it off the Surface canvas. -->
    <Style x:Key="HeroBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Background" Value="{StaticResource HeaderGradient}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="18" Opacity="0.25" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stat/count chip sitting ON a gradient panel. Background must stay the OPAQUE
         OnGradientOverlay — translucent overlays composite white-on-white on WinUI. -->
    <Style x:Key="HeroChipStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{StaticResource OnGradientOverlay}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic status pill/chip base; caller supplies BackgroundColor (converter-driven) -->
    <Style x:Key="PillBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-font glyph label (Material Symbols) -->
    <Style x:Key="IconLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <!-- Muted trailing chevron on tappable rows (replaces the old "›" text glyph) -->
    <Style x:Key="ChevronIconStyle" TargetType="Label" BasedOn="{StaticResource IconLabelStyle}">
        <Setter Property="Text" Value="&#xe5cc;" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardBorderStroke}, Dark={StaticResource Gray600}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.05" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        <Setter Property="Margin" Value="20,0,20,10" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <!-- ── Typography scale ── -->

    <Style x:Key="DisplayStyle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="TitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="CharacterSpacing" Value="0.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <!-- ── Found-at-Station capture (tablet master-detail) ── -->

    <!-- Prominent live-search box -->
    <Style x:Key="SearchEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="ReturnType" Value="Search" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>

    <!-- Tappable catalog result row — generous touch target for tablet -->
    <Style x:Key="ResultCardStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardBorderStroke}, Dark={StaticResource Gray600}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="MinimumHeightRequest" Value="64" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Code badge chip on a result row -->
    <Style x:Key="CodeBadgeStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pinned primary / secondary actions -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
    </Style>

</ResourceDictionary>
