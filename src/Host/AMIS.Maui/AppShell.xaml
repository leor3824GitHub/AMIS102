<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:home="clr-namespace:AMIS.Maui.Features.Home"
       xmlns:inventory="clr-namespace:AMIS.Maui.Features.Inventory"
       xmlns:scan="clr-namespace:AMIS.Maui.Features.Scan"
       xmlns:profile="clr-namespace:AMIS.Maui.Features.Profile"
       xmlns:count="clr-namespace:AMIS.Maui.Features.PhysicalCount"
       x:Class="AMIS.Maui.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      Icon="home.png"
                      ContentTemplate="{DataTemplate home:HomePage}"
                      Route="HomePage" />
        <ShellContent Title="My Inventory"
                      Icon="inventory.png"
                      ContentTemplate="{DataTemplate inventory:InventoryPage}"
                      Route="InventoryPage" />
        <ShellContent Title="Scan"
                      Icon="scan.png"
                      ContentTemplate="{DataTemplate scan:ScanPage}"
                      Route="ScanPage" />
        <ShellContent Title="Count"
                      Icon="scan.png"
                      ContentTemplate="{DataTemplate count:PhysicalCountSessionListPage}"
                      Route="PhysicalCountSessionListPage" />
        <ShellContent Title="Profile"
                      Icon="profile.png"
                      ContentTemplate="{DataTemplate profile:ProfilePage}"
                      Route="ProfilePage" />
    </TabBar>
</Shell>
