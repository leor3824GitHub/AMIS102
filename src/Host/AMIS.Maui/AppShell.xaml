<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:home="clr-namespace:AMIS.Maui.Features.Home"
       xmlns:scan="clr-namespace:AMIS.Maui.Features.Scan"
       xmlns:count="clr-namespace:AMIS.Maui.Features.PhysicalCount"
       xmlns:chat="clr-namespace:AMIS.Maui.Features.Chat"
       xmlns:helpers="clr-namespace:AMIS.Maui.Helpers"
       x:Class="AMIS.Maui.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate home:HomePage}"
                      Route="HomePage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="{x:Static helpers:MaterialIcons.Home}"
                                 Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Scan"
                      ContentTemplate="{DataTemplate scan:ScanPage}"
                      Route="ScanPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="{x:Static helpers:MaterialIcons.QrCodeScanner}"
                                 Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Count"
                      ContentTemplate="{DataTemplate count:PhysicalCountSessionListPage}"
                      Route="PhysicalCountSessionListPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="{x:Static helpers:MaterialIcons.Checklist}"
                                 Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <!-- Icon is swapped for the unread variant from code-behind; Shell has no badge API. -->
        <ShellContent x:Name="ChatTab"
                      Title="Chat"
                      ContentTemplate="{DataTemplate chat:ChatChannelListPage}"
                      Route="ChatChannelListPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialSymbols"
                                 Glyph="{x:Static helpers:MaterialIcons.ChatBubble}"
                                 Size="22" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
