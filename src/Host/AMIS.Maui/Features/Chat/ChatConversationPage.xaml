<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.Chat"
             x:DataType="vm:ChatConversationViewModel"
             x:Class="AMIS.Maui.Features.Chat.ChatConversationPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Error banner with a working retry (the conversation has no pull-to-refresh) -->
        <Border Grid.Row="0"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource DangerLight}"
                Padding="14,10"
                Margin="16,12,16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding ErrorMessage}" FontSize="12"
                       TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Retry" Padding="12,4" Command="{Binding LoadCommand}" />
            </Grid>
        </Border>

        <!-- Messages. KeepItemsInView anchors the visible top row so prepending older history doesn't jump;
             initial load + new arrivals scroll to the bottom explicitly via ScrollToBottomRequested. -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesView"
                        ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepItemsInView"
                        EmptyView="No messages yet. Say hello.">
            <CollectionView.Header>
                <!-- Tap-to-load older history. Collapses (no layout space) when there is nothing older. -->
                <Button Text="Load earlier messages"
                        Margin="16,8"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatConversationViewModel}}, Path=LoadOlderCommand}"
                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatConversationViewModel}}, Path=HasMore}"
                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatConversationViewModel}}, Path=IsLoadingOlder, Converter={StaticResource InvertedBoolConverter}}" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Grid Padding="16,6" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="2">
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="{Binding SenderLabel}" FontFamily="InterSemiBold" FontSize="13" />
                            <Label Text="(edited)" Style="{StaticResource CaptionStyle}" VerticalOptions="Center"
                                   IsVisible="{Binding Edited}" />
                            <Label Text="📌" FontSize="11" VerticalOptions="Center" IsVisible="{Binding IsPinned}" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding TimeDisplay}"
                               Style="{StaticResource CaptionStyle}" />
                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Body}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               IsVisible="{Binding IsDeleted}" />
                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Body}"
                               FontSize="14"
                               IsVisible="{Binding IsDeleted, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Typing indicator -->
        <Label Grid.Row="2"
               Text="Someone is typing…"
               Style="{StaticResource CaptionStyle}"
               Margin="16,0,16,4"
               IsVisible="{Binding SomeoneTyping}" />

        <!-- Composer -->
        <Border Grid.Row="3"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="6,2,6,2"
                Margin="12,4,12,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding Draft}"
                       Placeholder="Write a message…"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendCommand}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Send"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding IsSending, Converter={StaticResource InvertedBoolConverter}}"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.RowSpan="4"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
