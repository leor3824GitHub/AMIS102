<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             xmlns:ctl="clr-namespace:AMIS.Maui.Controls"
             xmlns:helpers="clr-namespace:AMIS.Maui.Helpers"
             x:DataType="vm:PhysicalCountChecklistViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountChecklistPage"
             Title="Checklist"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Row 0: Gradient hero — session identity + live progress on one high-contrast panel that
                 lifts off the light canvas. Labels must set an explicit white/muted-white TextColor because
                 the implicit Label style paints dark text. -->
            <Border Grid.Row="0" Stroke="Transparent" StrokeThickness="0"
                    Background="{StaticResource HeaderGradient}"
                    Padding="20,18,20,22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,28,28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="18" Opacity="0.25" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <!-- Title + status chip -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding SessionCode}" TextColor="{StaticResource White}"
                                   FontFamily="InterBold" FontSize="22" />
                            <Label FontSize="12" TextColor="{StaticResource OnGradientMuted}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}  ·  {1}">
                                        <Binding Path="FundCluster" />
                                        <Binding Path="Scope" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>

                        <Border Grid.Column="1" Stroke="Transparent"
                                BackgroundColor="{StaticResource OnGradientOverlay}"
                                Padding="12,6" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding SessionStatus}" TextColor="{StaticResource White}"
                                   FontFamily="InterSemiBold" FontSize="12" />
                        </Border>
                    </Grid>

                    <!-- Progress -->
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="End">
                            <Label Grid.Column="0" Text="{Binding ProgressSummary}"
                                   TextColor="{StaticResource White}" FontFamily="InterBold" FontSize="24"
                                   VerticalOptions="End" />
                            <Label Grid.Column="1" Text="{Binding RemainingSummary}"
                                   TextColor="{StaticResource OnGradientMuted}" FontFamily="InterSemiBold"
                                   FontSize="12" VerticalOptions="End" />
                        </Grid>

                        <!-- Translucent track; the Border clips the fill to rounded ends -->
                        <Border Stroke="Transparent" HeightRequest="8"
                                BackgroundColor="{StaticResource OnGradientOverlay}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                            <ProgressBar Progress="{Binding CountedFraction}"
                                         ProgressColor="{StaticResource White}"
                                         BackgroundColor="Transparent"
                                         HeightRequest="8" />
                        </Border>

                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsComplete}">
                            <Label Text="{x:Static helpers:MaterialIcons.CheckCircle}" FontFamily="MaterialSymbols"
                                   FontSize="14" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            <Label Text="All in-scope assets accounted for."
                                   FontSize="12" FontFamily="InterSemiBold"
                                   TextColor="{StaticResource White}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Row 1: Cached / error banners -->
            <VerticalStackLayout Grid.Row="1" Spacing="0">
                <Border IsVisible="{Binding CachedBannerText, Converter={StaticResource IsNotNullConverter}}"
                        Stroke="Transparent" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource WarningLight}"
                        Margin="12,10,12,0" Padding="12,8">
                    <Label Text="{Binding CachedBannerText}" FontSize="12" TextColor="{StaticResource Warning}" />
                </Border>
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                       TextColor="{StaticResource Danger}" FontSize="13"
                       Margin="16,8,16,0" />
            </VerticalStackLayout>

            <!-- Row 2: Type segmented control (scroll if tight) + pinned uncounted-only toggle.
                 Segment colors are converter-driven (not DataTriggers): a selected-state trigger can't
                 reliably override a base color in MAUI, which leaves chips rendering blank. The control
                 lives in a horizontal ScrollView so it never squeezes the toggle off a narrow screen;
                 the Switch sits in the Auto column and is always fully visible. -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="12,12,12,4">

                <ScrollView Grid.Column="0" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never" VerticalOptions="Center">
                    <!-- Connected segmented control: three tap targets on one rounded track -->
                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource Gray100}" Padding="3"
                            HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="2">

                            <!-- All -->
                            <Border Stroke="Transparent" StrokeShape="RoundRectangle 13" Padding="16,7"
                                    BackgroundColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='All|bg'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="All" FontSize="12" FontFamily="InterSemiBold"
                                       TextColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='All|text'}" />
                            </Border>

                            <!-- PPE -->
                            <Border Stroke="Transparent" StrokeShape="RoundRectangle 13" Padding="16,7"
                                    BackgroundColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='PPE|bg'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="PPE" />
                                </Border.GestureRecognizers>
                                <Label Text="PPE" FontSize="12" FontFamily="InterSemiBold"
                                       TextColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='PPE|text'}" />
                            </Border>

                            <!-- SE -->
                            <Border Stroke="Transparent" StrokeShape="RoundRectangle 13" Padding="16,7"
                                    BackgroundColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='SE|bg'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTypeCommand}" CommandParameter="SE" />
                                </Border.GestureRecognizers>
                                <Label Text="SE" FontSize="12" FontFamily="InterSemiBold"
                                       TextColor="{Binding SelectedType, Converter={StaticResource SegmentColorConverter}, ConverterParameter='SE|text'}" />
                            </Border>

                        </HorizontalStackLayout>
                    </Border>
                </ScrollView>

                <!-- Uncounted-only toggle (pinned right, never clipped) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Label Text="Uncounted only" FontSize="12" FontFamily="InterSemiBold"
                           TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding UncountedOnly}"
                            OnColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Row 3: Location + officer pickers + search -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="8" RowSpacing="4" Padding="12,4,12,8">
                <Picker Grid.Row="0" Grid.Column="0"
                        Title="Location"
                        ItemsSource="{Binding Locations}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedLocation}"
                        FontSize="13" />
                <Picker Grid.Row="0" Grid.Column="1"
                        Title="Accountable officer"
                        ItemsSource="{Binding Officers}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedOfficer}"
                        FontSize="13" />
                <SearchBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Placeholder="Search property no. or description"
                           Text="{Binding SearchText}" />
            </Grid>

            <!-- Row 4: Grouped checklist -->
            <CollectionView Grid.Row="4"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <ctl:EmptyStateView Glyph="{x:Static helpers:MaterialIcons.FactCheck}"
                                        Title="Nothing to show"
                                        Hint="No assets match the current filters." />
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:ChecklistGroup">
                        <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent"
                              Padding="18,16,18,6">
                            <Label Grid.Column="0" Text="{Binding Title}"
                                   FontFamily="InterBold" FontSize="12" CharacterSpacing="0.8"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource Gray300}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Coverage}"
                                   FontSize="12" FontFamily="InterSemiBold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:PhysicalCountChecklistItemDto">
                        <Border Stroke="{AppThemeBinding Light={StaticResource CardBorderStroke}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Margin="12,5" Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PhysicalCountChecklistViewModel}}, Path=OpenAssetCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="3">

                                <ctl:AssetThumbnail Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                                    Item="{Binding .}"
                                                    AssetType="{Binding AssetType}"
                                                    HasImage="{Binding HasImage}" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding PropertyNo}"
                                       FontFamily="InterSemiBold" FontSize="14"
                                       VerticalOptions="Center" />

                                <!-- Soft status pill: tinted background + matching text, not a solid block.
                                     Base colors are plain StaticResources so the DataTriggers can override
                                     them reliably (an AppThemeBinding base can't be overridden by a trigger). -->
                                <Border Grid.Row="0" Grid.Column="2"
                                        Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        Padding="9,3" VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Counted">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Missing">
                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label FontSize="10" FontFamily="InterSemiBold"
                                           TextColor="{StaticResource Primary}" Text="To count">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Counted">
                                                <Setter Property="Text" Value="Counted" />
                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Missing">
                                                <Setter Property="Text" Value="Missing" />
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="12" TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{Binding LocationOfficerLine}"
                                       IsVisible="{Binding LocationOfficerLine, Converter={StaticResource IsNotNullConverter}}"
                                       FontSize="11" TextColor="{StaticResource Gray400}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </RefreshView>
</ContentPage>
