<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             x:DataType="vm:PhysicalCountFoundAtStationViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountFoundAtStationPage"
             Title="Found at Station"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <!-- Adaptive master-detail: two columns on tablet/desktop, stacked on phone. -->
    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='2*,3*'}"
          RowDefinitions="{OnIdiom Phone='*,*', Default='*'}">

        <!-- ───────────── MASTER: classify the item (live catalog search) ───────────── -->
        <Grid Grid.Row="0" Grid.Column="0"
              RowDefinitions="Auto,Auto,*"
              Padding="16,16,16,8" RowSpacing="10"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="1 · CLASSIFY THE ITEM" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                <Label Text="Search the catalog by item code or name to recognize this asset at close."
                       Style="{StaticResource CaptionStyle}" />
            </VerticalStackLayout>

            <!-- Search box -->
            <Border Grid.Row="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}"
                    Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="&#x1F50D;" FontSize="18" VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Style="{StaticResource SearchEntryStyle}"
                           Text="{Binding CatalogSearchText}"
                           Placeholder="e.g. CHAIR-001 or laptop"
                           ReturnCommand="{Binding SearchCatalogReturnCommand}" />
                    <ActivityIndicator Grid.Column="2"
                                       IsRunning="{Binding IsCatalogSearching}"
                                       IsVisible="{Binding IsCatalogSearching}"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Results (no ScrollView wrapper — CollectionView virtualizes) -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding CatalogResults}"
                            Margin="0,4,0,0">
                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6"
                                             IsVisible="{Binding ShowNoResults}">
                            <Label Text="&#x1F4ED;" FontSize="34" HorizontalOptions="Center" />
                            <Label Text="No catalog items matched."
                                   HorizontalOptions="Center"
                                   Style="{StaticResource SubtitleStyle}" />
                            <Label Text="Try a different code or keyword."
                                   HorizontalOptions="Center"
                                   Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6"
                                             IsVisible="{Binding ShowNoResults, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="&#x1F50E;" FontSize="34" HorizontalOptions="Center" />
                            <Label Text="Start typing to find the item type."
                                   HorizontalOptions="Center"
                                   Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:CatalogItemDto">
                        <Grid Padding="0,4">
                            <Border Style="{StaticResource ResultCardStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PhysicalCountFoundAtStationViewModel}}, Path=SelectCatalogItemCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CodeBadgeStyle}">
                                        <Label Text="{Binding Code}"
                                               FontFamily="InterBold" FontSize="12"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DefaultUnit}"
                                           FontSize="12" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ───────────── DETAIL: capture form ───────────── -->
        <Grid Grid.Row="{OnIdiom Phone=1, Default=0}"
              Grid.Column="{OnIdiom Phone=0, Default=1}"
              RowDefinitions="*,Auto">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16,16,16,8" Spacing="16">

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13" />

                    <!-- Property number — always editable (scanned value pre-fills; damaged sticker → type it) -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="11" FontAttributes="Bold" CharacterSpacing="0.8"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="PROPERTY NO." />
                                        <Span Text=" *" TextColor="{StaticResource Danger}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Entry Text="{Binding PropertyNo}"
                                   FontFamily="InterBold" FontSize="20"
                                   Placeholder="Scan or type the property number" />
                            <Label Text="From the sticker scan — edit if the sticker is damaged or missing."
                                   Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Selected catalog item summary -->
                    <Border IsVisible="{Binding SelectedCatalogItem, Converter={StaticResource IsNotNullConverter}}"
                            Stroke="{StaticResource Primary}" StrokeThickness="1"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 12" Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="SELECTED ITEM" FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="0.8" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding SelectedCatalogItem.Code}"
                                       FontFamily="InterBold" FontSize="15"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding SelectedCatalogItem.Description}"
                                       FontSize="13"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Change"
                                    FontSize="13"
                                    Padding="12,6"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    Command="{Binding SelectCatalogItemCommand}"
                                    CommandParameter="{x:Null}" />
                        </Grid>
                    </Border>

                    <!-- Prompt when nothing selected yet -->
                    <Border IsVisible="{Binding SelectedCatalogItem, Converter={StaticResource IsNullConverter}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1" StrokeDashArray="4,3" StrokeDashOffset="0"
                            StrokeShape="RoundRectangle 12" Padding="16,14"
                            BackgroundColor="Transparent">
                        <Label Text="Select a catalog item from the search on the left — it is required to close the session."
                               Style="{StaticResource CaptionStyle}" />
                    </Border>

                    <!-- Asset details -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout Spacing="4" Padding="0,0,0,14">
                                <Label FontSize="11" FontAttributes="Bold" CharacterSpacing="0.8"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="DESCRIPTION" />
                                            <Span Text=" *" TextColor="{StaticResource Danger}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Entry Text="{Binding Description}"
                                       Placeholder="e.g. Dell Laptop Model XYZ" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                            <VerticalStackLayout Spacing="4" Padding="0,14,0,14">
                                <Label Text="UNIT COST (&#x20B1;)" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Keyboard="Numeric"
                                       Text="{Binding UnitCostText}"
                                       Placeholder="0.00" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                            <VerticalStackLayout Spacing="4" Padding="0,14,0,0">
                                <Label Text="REMARKS (optional)" Style="{StaticResource FieldLabelStyle}" />
                                <Editor Text="{Binding Remarks}"
                                        Placeholder="e.g. found in stock room, sticker missing"
                                        HeightRequest="80"
                                        AutoSize="TextChanges" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Pinned actions -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,2*" ColumnSpacing="12"
                  Padding="16,8,16,16"
                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Text="Add Entry"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
