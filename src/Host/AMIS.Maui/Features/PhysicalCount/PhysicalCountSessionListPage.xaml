<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             x:Name="ThisPage"
             x:DataType="vm:PhysicalCountSessionListViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountSessionListPage"
             Title="Physical Count"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="0,16,0,0">

            <!-- Sync banner: pending / failed + actions -->
            <Border Grid.Row="0"
                    IsVisible="{Binding HasQueuedWork}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource WarningLight}"
                    Padding="14,10"
                    Margin="16,0,16,10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding SyncBannerText}"
                           FontSize="12"
                           TextColor="{StaticResource Warning}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Sync Now"
                            Command="{Binding FlushPendingCommand}"
                            FontSize="11" Padding="10,6" />
                    <Button Grid.Column="2"
                            Text="Discard"
                            IsVisible="{Binding HasFailedSync}"
                            Command="{Binding DiscardFailedCommand}"
                            FontSize="11" Padding="10,6"
                            BackgroundColor="{StaticResource Danger}"
                            TextColor="White" />
                </Grid>
            </Border>

            <!-- Sync status message -->
            <Label Grid.Row="1"
                   Text="{Binding SyncStatusMessage}"
                   IsVisible="{Binding SyncStatusMessage, Converter={StaticResource IsNotNullConverter}}"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"
                   Margin="20,0,20,8" />

            <!-- Error -->
            <Label Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{StaticResource Danger}"
                   FontSize="13"
                   Margin="20,0,20,12" />

            <!-- Section header -->
            <Label Grid.Row="3"
                   Text="SESSIONS"
                   Style="{StaticResource SectionHeaderStyle}" />

            <!-- Sessions list -->
            <CollectionView Grid.Row="4"
                            ItemsSource="{Binding Sessions}"
                            SelectionMode="Single"
                            SelectionChanged="OnSessionSelected"
                            EmptyView="No physical count sessions found.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:PhysicalCountSessionSummaryDto">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Margin="16,4" Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="4">

                                <!-- SessionNo + Status badge -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding SessionNo}"
                                       FontFamily="InterSemiBold" FontSize="15" />
                                <Border Grid.Row="0" Grid.Column="1"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource Gray400}"
                                        Padding="8,3">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Ongoing">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Reconciled">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Closed">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Status}"
                                           TextColor="White"
                                           FontFamily="InterSemiBold" FontSize="11" />
                                </Border>

                                <!-- FundCluster + Scope -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding FundCluster}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Scope}"
                                       Style="{StaticResource CaptionStyle}" />

                                <!-- Date + Progress breakdown -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding CountDate}"
                                       Style="{StaticResource CaptionStyle}" />
                                    <Label Grid.Row="2" Grid.Column="1"
                                        FontSize="11"
                                        TextColor="{StaticResource Gray500}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} found · {1} missing · {2} new">
                                            <Binding Path="Found" />
                                            <Binding Path="Missing" />
                                            <Binding Path="FoundAtStation" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </RefreshView>
</ContentPage>
