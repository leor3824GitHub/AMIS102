<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:zxingcore="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.MAUI"
             x:Name="ThisPage"
             x:DataType="vm:PhysicalCountWalkthroughViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountWalkthroughPage"
             Title="{Binding SessionNo}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <!-- Row 0: Embedded QR scanner (copied from Scan) -->
        <Grid Grid.Row="0">
            <zxing:CameraBarcodeReaderView x:Name="BarcodeReader"
                                           IsVisible="{Binding IsCameraAvailable}"
                                           IsDetecting="False"
                                           HeightRequest="240"
                                           BarcodesDetected="OnBarcodeDetected">
                <zxing:CameraBarcodeReaderView.Options>
                    <zxingcore:BarcodeReaderOptions Formats="QrCode,Code128,Code39,DataMatrix"
                                                    AutoRotate="True"
                                                    Multiple="False" />
                </zxing:CameraBarcodeReaderView.Options>
            </zxing:CameraBarcodeReaderView>

            <!-- QR label badge — floated at the top of the camera area -->
            <Border IsVisible="{Binding IsCameraAvailable}"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="12,12,0,0"
                    Stroke="Transparent"
                    Background="{StaticResource CameraOverlayBg}"
                    Padding="12,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label Text="QR"
                       FontFamily="InterSemiBold" FontSize="12"
                       TextColor="{StaticResource White}" />
            </Border>

            <!-- No camera placeholder (Windows / devices without camera) -->
            <VerticalStackLayout IsVisible="{Binding IsCameraAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="6" Padding="16">
                <Label Text="&#x1F4F7;" FontSize="34" HorizontalOptions="Center" />
                <Label Text="Camera not available — use manual entry below."
                       FontSize="13" TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Row 1: Counting at + manual entry -->
        <Border Grid.Row="1"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Padding="12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Picker Title="Counting at — select location"
                        ItemsSource="{Binding Locations}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedLocation}" />
                <HorizontalStackLayout Spacing="20" RadioButtonGroup.GroupName="CountSearchMode">
                    <RadioButton Content="Property No" IsChecked="True" />
                    <RadioButton Content="Serial No" IsChecked="{Binding SearchBySerial, Mode=TwoWay}" />
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Placeholder="{Binding ManualEntryPlaceholder}"
                           Text="{Binding ManualPropertyNo}"
                           ReturnCommand="{Binding SearchManualCommand}"
                           AutomationId="PropertyNoEntry" />
                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchManualCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Row 2: Filter + Search -->
        <Grid Grid.Row="2"
              Padding="12,8"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
            <Picker Grid.Column="0"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    MinimumWidthRequest="120" />
            <Entry Grid.Column="1"
                   Placeholder="Search property / description"
                   Text="{Binding SearchText}" />
        </Grid>

        <!-- Row 3: Session info header (moved below the filter / search) -->
        <Border Grid.Row="3"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Padding="16,14,16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding FundCluster}"
                       FontAttributes="Bold" FontSize="15" />
                <Label FontSize="12" TextColor="{StaticResource Gray400}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0}  ·  {1}">
                            <Binding Path="Scope" />
                            <Binding Path="Status" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </VerticalStackLayout>
        </Border>

        <!-- Row 4: Progress badges (moved below the filter / search) -->
        <Grid Grid.Row="4" Padding="12,10" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
            <Border Grid.Column="0"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Success}"
                    Padding="8,8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding FoundCount}"
                           TextColor="White" FontAttributes="Bold"
                           HorizontalOptions="Center" FontSize="18" />
                    <Label Text="Found"
                           TextColor="White" FontSize="10"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Danger}"
                    Padding="8,8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding NotFoundCount}"
                           TextColor="White" FontAttributes="Bold"
                           HorizontalOptions="Center" FontSize="18" />
                    <Label Text="Not Found"
                           TextColor="White" FontSize="10"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="8,8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding FoundAtStationCount}"
                           TextColor="White" FontAttributes="Bold"
                           HorizontalOptions="Center" FontSize="18" />
                    <Label Text="@Station"
                           TextColor="White" FontSize="10"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="3"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Gray400}"
                    Padding="8,8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding PendingCount}"
                           TextColor="White" FontAttributes="Bold"
                           HorizontalOptions="Center" FontSize="18" />
                    <Label Text="Pending"
                           TextColor="White" FontSize="10"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Row 5: Sync banner (moved below the filter / search) -->
        <Border Grid.Row="5"
                IsVisible="{Binding SyncBanner, Converter={StaticResource IsNotNullConverter}}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Warning}"
                Margin="12,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding SyncBanner}"
                       TextColor="White" FontSize="12"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Sync Now"
                        Command="{Binding FlushPendingCommand}"
                        FontSize="11"
                        Padding="10,6"
                        BackgroundColor="{StaticResource Tertiary}"
                        TextColor="White" />
            </Grid>
        </Border>

        <!-- Row 6: Checklist CollectionView (fills remaining space) -->
        <CollectionView Grid.Row="6"
                        ItemsSource="{Binding FilteredEntries}"
                        SelectionMode="Single"
                        SelectionChanged="OnEntrySelected"
                        EmptyView="No entries match the current filter.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:PhysicalCountEntryDto">
                    <Border Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Margin="12,4" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding PropertyNumber}"
                                   FontAttributes="Bold" FontSize="14" />
                            <Border Grid.Row="0" Grid.Column="1"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource Gray200}"
                                    Padding="8,3">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Result}" Value="Found">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Result}" Value="NotFound">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Result}" Value="FoundAtStation">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontSize="10" FontAttributes="Bold"
                                       TextColor="White"
                                       Text="{Binding Result, TargetNullValue='Pending'}" />
                            </Border>
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray400}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
