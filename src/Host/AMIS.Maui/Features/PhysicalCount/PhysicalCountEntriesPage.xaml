<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             xmlns:ctl="clr-namespace:AMIS.Maui.Controls"
             xmlns:helpers="clr-namespace:AMIS.Maui.Helpers"
             xmlns:beh="clr-namespace:AMIS.Maui.Behaviors"
             x:DataType="vm:PhysicalCountEntriesViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountEntriesPage"
             Title="{Binding HeaderTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Checklist" Command="{Binding OpenChecklistCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ── Hero: session identity + count breakdown chips ── -->
            <Border Grid.Row="0" Style="{StaticResource HeroBorderStyle}" Padding="{StaticResource HeroPaddingUnderNavBar}">
                <Border.Behaviors>
                    <beh:EntranceAnimationBehavior />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SessionNo}" TextColor="{StaticResource White}"
                               FontFamily="InterBold" FontSize="20" />
                        <Label TextColor="{StaticResource OnGradientMuted}" FontSize="12">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}  ·  {1}  ·  {2}">
                                    <Binding Path="FundCluster" />
                                    <Binding Path="Scope" />
                                    <Binding Path="Status" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Border Style="{StaticResource HeroChipStyle}" Margin="0,0,8,8">
                            <Label Text="{Binding FoundCount, StringFormat='{0} found'}"
                                   TextColor="{StaticResource White}" FontFamily="InterSemiBold" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource HeroChipStyle}" Margin="0,0,8,8">
                            <Label Text="{Binding MissingCount, StringFormat='{0} missing'}"
                                   TextColor="{StaticResource White}" FontFamily="InterSemiBold" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource HeroChipStyle}" Margin="0,0,8,8">
                            <Label Text="{Binding FoundAtStationCount, StringFormat='{0} new'}"
                                   TextColor="{StaticResource White}" FontFamily="InterSemiBold" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource HeroChipStyle}" Margin="0,0,8,8"
                                IsVisible="{Binding QueuedCount, Converter={StaticResource IsNotZeroConverter}}">
                            <Label Text="{Binding QueuedCount, StringFormat='{0} queued'}"
                                   TextColor="{StaticResource White}" FontFamily="InterSemiBold" FontSize="12" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Error -->
            <Label Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{StaticResource Danger}" FontSize="13"
                   Margin="16,10,16,0" />

            <!-- Filter + search -->
            <Grid Grid.Row="2" Padding="12,10,12,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding SelectedFilter}"
                        MinimumWidthRequest="120" />
                <SearchBar Grid.Column="1"
                           Placeholder="Search property no. or description"
                           Text="{Binding SearchText}" />
            </Grid>

            <!-- Entries list — grouped per SE / PPE -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding FilteredEntries}"
                            IsGrouped="True">
                <CollectionView.EmptyView>
                    <ctl:EmptyStateView Glyph="{x:Static helpers:MaterialIcons.FactCheck}"
                                        Title="No matching entries"
                                        Hint="Adjust the filter or search to see recorded entries." />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:EntryGroup">
                        <Grid Padding="16,12,16,6" ColumnDefinitions="*,Auto"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
                            <Label Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontFamily="InterSemiBold" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="12" TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:PhysicalCountEntryDto">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Margin="12,4" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding PropertyNumber}"
                                       FontFamily="InterSemiBold" FontSize="14" />
                                <ctl:StatusPill Grid.Row="0" Grid.Column="1"
                                                Text="{Binding Result, Converter={StaticResource EntryResultLabelConverter}}"
                                                PillBackground="{Binding Result, Converter={StaticResource EntryResultColorConverter}}"
                                                PillTextColor="{StaticResource White}"
                                                FontSize="10" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </RefreshView>
</ContentPage>
