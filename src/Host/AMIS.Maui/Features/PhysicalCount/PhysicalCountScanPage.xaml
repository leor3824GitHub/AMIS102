<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.PhysicalCount"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:zxingcore="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.MAUI"
             x:Name="ThisPage"
             x:DataType="vm:PhysicalCountScanViewModel"
             x:Class="AMIS.Maui.Features.PhysicalCount.PhysicalCountScanPage"
             Title="{Binding SessionNo}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Checklist" Command="{Binding OpenChecklistCommand}" />
        <ToolbarItem Text="Entries" Command="{Binding OpenEntriesCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Root holds the scan content plus the confirm-sheet overlay -->
    <Grid>

        <!-- Row 0 is pinned to 240 units (not Auto): on wide tablets the camera preview aspect-fills
             and would otherwise push the progress tiles below the fold. Clipping keeps it boxed. -->
        <Grid RowDefinitions="240,Auto,Auto,Auto,Auto,*">

            <!-- Row 0: Embedded scanner — barcode (default) + live-text OCR -->
            <Grid Grid.Row="0" IsClippedToBounds="True">
                <zxing:CameraBarcodeReaderView x:Name="BarcodeReader"
                                               IsVisible="{Binding IsBarcodeMode}"
                                               IsDetecting="False"
                                               HeightRequest="240"
                                               BarcodesDetected="OnBarcodeDetected">
                    <zxing:CameraBarcodeReaderView.Options>
                        <zxingcore:BarcodeReaderOptions Formats="QrCode,Code128,Code39,DataMatrix"
                                                        AutoRotate="True"
                                                        Multiple="False" />
                    </zxing:CameraBarcodeReaderView.Options>
                </zxing:CameraBarcodeReaderView>

                <!-- Live text viewfinder host (text mode). The CameraView is created in code-behind on
                     demand so its platform handler is never realized on devices without a camera. -->
                <Grid x:Name="TextCameraHost"
                      HeightRequest="240"
                      IsVisible="{Binding IsTextMode}" />

                <!-- Text-mode hint overlay -->
                <VerticalStackLayout IsVisible="{Binding IsTextMode}"
                                     VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="6" Padding="16"
                                     InputTransparent="True">
                    <ActivityIndicator IsRunning="{Binding IsTextMode}"
                                       Color="{StaticResource White}"
                                       HorizontalOptions="Center" />
                    <Label Text="Point at the printed property number"
                           FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- No camera placeholder (Windows / devices without camera) -->
                <VerticalStackLayout IsVisible="{Binding IsCameraAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                     HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="6" Padding="16">
                    <Label Text="&#x1F4F7;" FontSize="34" HorizontalOptions="Center" />
                    <Label Text="Camera not available — use manual entry below."
                           FontSize="13" TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- QR / Text mode toggle pill — floated at the top of the camera area -->
                <Border IsVisible="{Binding IsCameraAvailable}"
                        HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="12,12,0,0"
                        Stroke="Transparent"
                        Background="{StaticResource CameraOverlayBg}"
                        Padding="3">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="2">

                        <!-- Barcode tab (colors are converter-driven — no DataTriggers) -->
                        <Border Stroke="Transparent" Padding="14,5"
                                BackgroundColor="{Binding IsBarcodeMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|Transparent'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StopTextScanCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="QR" FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="{Binding IsBarcodeMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Gray300'}" />
                        </Border>

                        <!-- Text tab (colors are converter-driven — no DataTriggers) -->
                        <Border Stroke="Transparent" Padding="14,5"
                                BackgroundColor="{Binding IsTextMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|Transparent'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartTextScanCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Text" FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="{Binding IsTextMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Gray300'}" />
                        </Border>

                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Row 1: Counting at + manual entry -->
            <Border Grid.Row="1"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    Padding="12,10">
                <VerticalStackLayout Spacing="8">
                    <Picker Title="Counting at — select location"
                            ItemsSource="{Binding Locations}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedLocation}" />
                    <HorizontalStackLayout Spacing="20" RadioButtonGroup.GroupName="CountSearchMode">
                        <RadioButton Content="Property No" IsChecked="True" />
                        <RadioButton Content="Serial No" IsChecked="{Binding SearchBySerial, Mode=TwoWay}" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="{Binding SearchPlaceholder}"
                               Text="{Binding ManualPropertyNo}"
                               ReturnCommand="{Binding SearchManualCommand}"
                               AutomationId="PropertyNoEntry" />
                        <Button Grid.Column="1"
                                Text="Search"
                                Command="{Binding SearchManualCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Row 2: Session-locked notice (session is not Ongoing) -->
            <Border Grid.Row="2"
                    IsVisible="{Binding ShowStatusLockedNotice}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource WarningLight}"
                    Margin="12,8,12,0"
                    Padding="12,8">
                <Label FontSize="12" TextColor="{StaticResource Warning}">
                    <Label.Text>
                        <MultiBinding StringFormat="This session is {0} — recording is disabled.">
                            <Binding Path="Status" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </Border>

            <!-- Row 3: Feedback banner (add result / errors) -->
            <Border Grid.Row="3"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource SuccessLight}"
                    Margin="12,8,12,0"
                    Padding="12,10">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="Warning">
                        <Setter Property="BackgroundColor" Value="{StaticResource WarningLight}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="Error">
                        <Setter Property="BackgroundColor" Value="{StaticResource DangerLight}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding StatusMessage}" FontSize="13" FontFamily="InterSemiBold"
                       TextColor="{StaticResource Success}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="Warning">
                            <Setter Property="TextColor" Value="{StaticResource Warning}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="Error">
                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <!-- Row 4: Progress tiles (tap → SE/PPE breakdown) + hint -->
            <VerticalStackLayout Grid.Row="4" Padding="12,10" Spacing="6">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource Success}" Padding="8,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowBreakdownCommand}" CommandParameter="Found" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding FoundCount}" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" FontSize="18" />
                            <Label Text="Found" TextColor="White" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource Danger}" Padding="8,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowBreakdownCommand}" CommandParameter="Missing" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding MissingCount}" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" FontSize="18" />
                            <Label Text="Missing" TextColor="White" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            Stroke="Transparent" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource Primary}" Padding="8,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowBreakdownCommand}" CommandParameter="@Station" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding FoundAtStationCount}" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" FontSize="18" />
                            <Label Text="@Station" TextColor="White" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Text="Tap a tile for the SE / PPE breakdown"
                       FontSize="11" TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Row 5: slim pending-sync chip -->
            <Border Grid.Row="5"
                    IsVisible="{Binding HasPendingSync}"
                    VerticalOptions="Start"
                    Stroke="Transparent" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource WarningLight}"
                    Margin="12,0,12,12" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FlushPendingCommand}" />
                </Border.GestureRecognizers>
                <Label FontSize="12" TextColor="{StaticResource Warning}"
                       Text="{Binding PendingSyncCount, StringFormat='{0} queued locally · tap to sync'}" />
            </Border>

        </Grid>

        <!-- ===== Confirm sheet overlay ===== -->
        <Grid IsVisible="{Binding IsConfirmSheetOpen}">
            <!-- Scrim: tap to skip -->
            <BoxView Color="Black" Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SkipCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    Padding="20,18,20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20,20,0,0" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add to count" Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SheetAssetName}" FontFamily="InterSemiBold" FontSize="16" />
                        <Label Text="{Binding SheetPropertyNo}" Style="{StaticResource CaptionStyle}" />
                        <Label Style="{StaticResource CaptionStyle}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}  ·  Counting at {1}">
                                    <Binding Path="SheetUnitCostText" />
                                    <Binding Path="SheetLocationText" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="CONDITION" Style="{StaticResource FieldLabelStyle}" />
                        <Picker ItemsSource="{Binding Conditions}"
                                SelectedIndex="{Binding SelectedConditionIndex}"
                                Title="Select condition" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="REMARKS (optional)" Style="{StaticResource FieldLabelStyle}" />
                        <Entry Text="{Binding SheetRemarks}" Placeholder="e.g. found in storage room" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Skip"
                                Command="{Binding SkipCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Button Grid.Column="1"
                                Text="Add"
                                Command="{Binding ConfirmAddCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
