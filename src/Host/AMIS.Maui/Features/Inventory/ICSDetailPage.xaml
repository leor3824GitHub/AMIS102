<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.Inventory"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             x:DataType="vm:ICSDetailViewModel"
             x:Class="AMIS.Maui.Features.Inventory.ICSDetailPage"
             Title="ICS Detail"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,24,0,16" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="13"
                   Margin="20,16"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <!-- Header card -->
            <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource HeaderGradient}"
                    Margin="16,16,16,0" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ICS NO." Style="{StaticResource FieldLabelStyle}" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding Detail.ICSNo}"
                           FontFamily="InterBold" FontSize="22" TextColor="{StaticResource White}" />
                    <Border Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource White}"
                            Padding="10,4"
                            HorizontalOptions="Start">
                        <Label Text="{Binding Detail.Status}"
                               FontFamily="InterSemiBold" FontSize="12"
                               TextColor="{StaticResource Primary}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Details card -->
            <Label Text="DOCUMENT DETAILS"
                   Style="{StaticResource SectionHeaderStyle}"
                   Margin="20,20,20,10" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="16,0">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="16,14" ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="DATE" Style="{StaticResource FieldLabelStyle}" />
                            <Label Text="{Binding Detail.Date}" FontSize="15" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="FUND CLUSTER" Style="{StaticResource FieldLabelStyle}" />
                            <Label Text="{Binding Detail.FundCluster}" FontSize="15" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                             Margin="16,0"
                             IsVisible="{Binding Detail.ExpiresOn, Converter={StaticResource IsNotNullConverter}}" />

                    <VerticalStackLayout Padding="16,14" Spacing="2"
                                         IsVisible="{Binding Detail.ExpiresOn, Converter={StaticResource IsNotNullConverter}}">
                        <Label Text="EXPIRES ON" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding Detail.ExpiresOn}" FontSize="15" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Items -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,20,20,10">
                <Label Grid.Column="0" Text="ITEMS"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Detail.Items.Count, StringFormat='{0} items'}"
                       Style="{StaticResource CaptionStyle}"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.Items}"
                                 Spacing="0" Margin="16,0,16,24">
                <BindableLayout.EmptyView>
                    <Label Text="No items on this ICS."
                           Style="{StaticResource CaptionStyle}"
                           Margin="4,8" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:ICSItemDto">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,4" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                                <!-- Leading thumbnail: the asset photo, or a type-tinted placeholder tile
                                     (PPE→blue, SE→teal). Border clips the image to rounded corners; the
                                     glyph shows only when there's no photo. Bytes are lazily fetched per
                                     row via the authenticated API. -->
                                <Border Grid.Column="0"
                                        WidthRequest="52" HeightRequest="52"
                                        Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{Binding AssetType, Converter={StaticResource KindToColorConverter}, ConverterParameter=bg}"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="&#x1F4E6;" FontSize="22"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{Binding AssetType, Converter={StaticResource KindToColorConverter}, ConverterParameter=text}"
                                               IsVisible="{Binding HasImage, Converter={StaticResource InvertedBoolConverter}}" />
                                        <Image Aspect="AspectFill"
                                               Source="{Binding ., Converter={StaticResource AssetImageSourceConverter}}"
                                               IsVisible="{Binding HasImage}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding PropertyNo}"
                                           FontFamily="InterSemiBold" FontSize="14" />
                                    <Label Grid.Column="1"
                                           Text="{Binding UnitCost, StringFormat='₱{0:N2}'}"
                                           FontFamily="InterBold" FontSize="14" />
                                </Grid>
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource CaptionStyle}"
                                       IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Tertiary}}"
                                            Padding="8,2" VerticalOptions="Center"
                                            IsVisible="{Binding AssetType, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding AssetType}"
                                               FontFamily="InterSemiBold" FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </Border>
                                    <Label Text="{Binding EstimatedUsefulLifeYears, StringFormat='EUL {0} yrs'}"
                                           Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                                    <Label Text="{Binding DateAcquired, StringFormat='Acq. {0}'}"
                                           Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Accept action — shown only while awaiting the accountable person's acknowledgement -->
            <Button Text="Accept ICS"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Command="{Binding AcceptCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding CanAccept}"
                    Margin="16,0,16,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
