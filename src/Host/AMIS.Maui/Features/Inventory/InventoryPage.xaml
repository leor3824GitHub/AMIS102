<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.Inventory"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             x:DataType="vm:InventoryViewModel"
             x:Class="AMIS.Maui.Features.Inventory.InventoryPage"
             Title="My Inventory"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <!-- ICS card -->
        <DataTemplate x:Key="IcsTemplate" x:DataType="svc:ICSSummaryDto">
            <Border Style="{StaticResource CardBorderStyle}" Margin="16,4" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenIcsCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding ICSNo}"
                           FontFamily="InterSemiBold" FontSize="15" />
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Tertiary}}"
                            Padding="8,3">
                        <Label Text="{Binding Status}"
                               FontFamily="InterSemiBold" FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Border>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding Date}"
                           Style="{StaticResource CaptionStyle}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding ItemCount, StringFormat='{0} items'}"
                           Style="{StaticResource CaptionStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- PAR card -->
        <DataTemplate x:Key="ParTemplate" x:DataType="svc:PARSummaryDto">
            <Border Style="{StaticResource CardBorderStyle}" Margin="16,4" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenParCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding PARNo}"
                           FontFamily="InterSemiBold" FontSize="15" />
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource TealLight}, Dark={StaticResource Tertiary}}"
                            Padding="8,3">
                        <Label Text="{Binding PARType}"
                               FontFamily="InterSemiBold" FontSize="11"
                               TextColor="{StaticResource Teal}" />
                    </Border>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding Date}"
                           Style="{StaticResource CaptionStyle}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding ItemCount, StringFormat='{0} items'}"
                           Style="{StaticResource CaptionStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <vm:InventoryItemTemplateSelector x:Key="InventoryItemTemplateSelector"
                                          IcsTemplate="{StaticResource IcsTemplate}"
                                          ParTemplate="{StaticResource ParTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Gradient hero — custodian identity + accountability totals on one high-contrast
             panel. Labels set explicit white/muted-white TextColor over the implicit dark Label style. -->
        <Border Grid.Row="0" Stroke="Transparent" StrokeThickness="0"
                Background="{StaticResource HeaderGradient}"
                Padding="20,18,20,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="18" Opacity="0.25" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="3">
                    <Label Text="ACCOUNTABLE OFFICER" TextColor="{StaticResource OnGradientMuted}"
                           FontFamily="InterBold" FontSize="11" CharacterSpacing="1.2" />
                    <Label Text="{Binding EmployeeName}" TextColor="{StaticResource White}"
                           FontFamily="InterBold" FontSize="22" />
                    <Label Text="{Binding EmployeeDetail}"
                           IsVisible="{Binding EmployeeDetail, Converter={StaticResource IsNotNullConverter}}"
                           TextColor="{StaticResource OnGradientMuted}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Accountability totals -->
                <HorizontalStackLayout Spacing="10">
                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource OnGradientOverlay}" Padding="14,8">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding IcsCount}" TextColor="{StaticResource White}"
                                   FontFamily="InterBold" FontSize="16" />
                            <Label Text="ICS" TextColor="{StaticResource OnGradientMuted}"
                                   FontFamily="InterSemiBold" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource OnGradientOverlay}" Padding="14,8">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding ParCount}" TextColor="{StaticResource White}"
                                   FontFamily="InterBold" FontSize="16" />
                            <Label Text="PAR" TextColor="{StaticResource OnGradientMuted}"
                                   FontFamily="InterSemiBold" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Row 1: Error banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource DangerLight}"
                Padding="14,10"
                Margin="16,10,16,0">
            <Label Text="{Binding ErrorMessage}"
                   FontSize="12"
                   TextColor="{StaticResource Danger}" />
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            ItemTemplate="{StaticResource InventoryItemTemplateSelector}"
                            EmptyView="No inventory records found.">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:InventoryGroup">
                        <Label Text="{Binding Title}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="20,16,20,10" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
