<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.Inventory"
             xmlns:svc="clr-namespace:AMIS.Maui.Services"
             x:DataType="vm:InventoryViewModel"
             x:Class="AMIS.Maui.Features.Inventory.InventoryPage"
             Title="My Inventory"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <!-- ICS card -->
        <DataTemplate x:Key="IcsTemplate" x:DataType="svc:ICSSummaryDto">
            <Border Style="{StaticResource CardBorderStyle}" Margin="16,4" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenIcsCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding ICSNo}"
                           FontFamily="InterSemiBold" FontSize="15" />
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Tertiary}}"
                            Padding="8,3">
                        <Label Text="{Binding Status}"
                               FontFamily="InterSemiBold" FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Border>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding Date}"
                           Style="{StaticResource CaptionStyle}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding ItemCount, StringFormat='{0} items'}"
                           Style="{StaticResource CaptionStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- PAR card -->
        <DataTemplate x:Key="ParTemplate" x:DataType="svc:PARSummaryDto">
            <Border Style="{StaticResource CardBorderStyle}" Margin="16,4" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenParCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding PARNo}"
                           FontFamily="InterSemiBold" FontSize="15" />
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource TealLight}, Dark={StaticResource Tertiary}}"
                            Padding="8,3">
                        <Label Text="{Binding PARType}"
                               FontFamily="InterSemiBold" FontSize="11"
                               TextColor="{StaticResource Teal}" />
                    </Border>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding Date}"
                           Style="{StaticResource CaptionStyle}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding ItemCount, StringFormat='{0} items'}"
                           Style="{StaticResource CaptionStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <vm:InventoryItemTemplateSelector x:Key="InventoryItemTemplateSelector"
                                          IcsTemplate="{StaticResource IcsTemplate}"
                                          ParTemplate="{StaticResource ParTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Error banner -->
        <Border Grid.Row="0"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource DangerLight}"
                Padding="14,10"
                Margin="16,12,16,0">
            <Label Text="{Binding ErrorMessage}"
                   FontSize="12"
                   TextColor="{StaticResource Danger}" />
        </Border>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            ItemTemplate="{StaticResource InventoryItemTemplateSelector}"
                            EmptyView="No inventory records found.">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:InventoryGroup">
                        <Label Text="{Binding Title}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="20,16,20,10" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
