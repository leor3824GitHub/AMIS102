<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AMIS.Maui.Features.Home"
             x:DataType="vm:HomeViewModel"
             x:Class="AMIS.Maui.Features.Home.HomePage"
             Title="Home"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <x:Double x:Key="AvatarSize">52</x:Double>
        <x:Double x:Key="ActionIconBox">44</x:Double>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ── Zone A: Greeting header ── -->
                <Border Stroke="Transparent"
                        Background="{StaticResource HeaderGradient}"
                        Padding="20,48,20,28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,28,28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="18" Opacity="0.25" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Greeting}" Style="{StaticResource SubtitleStyle}" TextColor="{StaticResource Secondary}" />
                            <Label Text="{Binding FirstName}" Style="{StaticResource DisplayStyle}" TextColor="{StaticResource White}" />
                            <Label Text="{Binding Department}"
                                   Style="{StaticResource CaptionStyle}"
                                   TextColor="{StaticResource Secondary}"
                                   IsVisible="{Binding Department, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>

                        <Grid Grid.Column="1"
                              WidthRequest="{StaticResource AvatarSize}"
                              HeightRequest="{StaticResource AvatarSize}"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                            </Grid.GestureRecognizers>
                            <Ellipse Fill="{StaticResource White}"
                                     Opacity="0.18"
                                     WidthRequest="{StaticResource AvatarSize}"
                                     HeightRequest="{StaticResource AvatarSize}" />
                            <Label Text="{Binding Initials}"
                                   FontFamily="InterBold"
                                   FontSize="18"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Error / offline banner ── -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource DangerLight}"
                        Padding="14,10"
                        Margin="16,16,16,0">
                    <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource Danger}" />
                </Border>

                <!-- ── Zone B: KPI tiles ── -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="16,20,16,0">

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12,16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Gray950}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding IcsCount}" Style="{StaticResource DisplayStyle}" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="ICS" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                            <Label Text="{Binding IcsItemCount, StringFormat='{0} items'}"
                                   Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12,16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource TealLight}, Dark={StaticResource Gray950}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding ParCount}" Style="{StaticResource DisplayStyle}" HorizontalOptions="Center"
                                   TextColor="{StaticResource Teal}" />
                            <Label Text="PAR" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                            <Label Text="{Binding ParItemCount, StringFormat='{0} items'}"
                                   Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ── Zone C: Quick actions ── -->
                <Label Text="QUICK ACTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="20,24,20,10" />

                <Border Style="{StaticResource CardBorderStyle}" Margin="16,0" Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Scan -->
                        <Grid Padding="16,16" ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToScanCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource Tertiary}}"
                                    WidthRequest="{StaticResource ActionIconBox}" HeightRequest="{StaticResource ActionIconBox}">
                                <Image Source="scan.png" WidthRequest="22" HeightRequest="22"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Scan Asset" FontFamily="InterSemiBold" FontSize="15" />
                                <Label Text="Look up by QR or property no." Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" Margin="16,0" />

                        <!-- Physical Count -->
                        <Grid Padding="16,16" ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToCountCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource TealLight}, Dark={StaticResource Tertiary}}"
                                    WidthRequest="{StaticResource ActionIconBox}" HeightRequest="{StaticResource ActionIconBox}">
                                <Image Source="scan.png" WidthRequest="22" HeightRequest="22"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Physical Count" FontFamily="InterSemiBold" FontSize="15" />
                                <Label Text="Record assets as you go" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" Margin="16,0" />

                        <!-- My Inventory -->
                        <Grid Padding="16,16" ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource InfoLight}, Dark={StaticResource Tertiary}}"
                                    WidthRequest="{StaticResource ActionIconBox}" HeightRequest="{StaticResource ActionIconBox}">
                                <Image Source="inventory.png" WidthRequest="22" HeightRequest="22"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="My Inventory" FontFamily="InterSemiBold" FontSize="15" />
                                <Label Text="ICS &amp; PAR assigned to you" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── Zone D: Resume in-progress ── -->
                <Label Text="RESUME" Style="{StaticResource SectionHeaderStyle}"
                       Margin="20,24,20,10"
                       IsVisible="{Binding HasActiveSession}" />

                <Border Style="{StaticResource CardBorderStyle}" Margin="16,0" Padding="16"
                        IsVisible="{Binding HasActiveSession}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ResumeSessionCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Count session" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding ActiveSessionNo}" FontFamily="InterSemiBold" FontSize="16" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ActiveSessionProgressLabel}" Style="{StaticResource CaptionStyle}" />
                            <Label Grid.Column="1"
                                   Text="{Binding PendingSyncCount, StringFormat='{0} pending sync'}"
                                   FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="{StaticResource Warning}"
                                   IsVisible="{Binding HasPendingSync}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Zone E: Recent ── -->
                <Grid ColumnDefinitions="*,Auto" Margin="20,24,20,10" IsVisible="{Binding HasRecent}">
                    <Label Grid.Column="0" Text="RECENT" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <Label Grid.Column="1" Text="See all ›"
                           FontFamily="InterSemiBold" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Margin="16,0,16,24" Padding="0"
                        IsVisible="{Binding HasRecent}">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding RecentItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentItem">
                                <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="3">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecentTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Number}" FontFamily="InterSemiBold" FontSize="15" />
                                    <Border Grid.Row="0" Grid.Column="1" Stroke="Transparent" StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding Kind, Converter={StaticResource KindToColorConverter}, ConverterParameter=bg}"
                                            Padding="8,3" VerticalOptions="Center">
                                        <Label Text="{Binding Kind}" FontFamily="InterSemiBold" FontSize="10"
                                               TextColor="{Binding Kind, Converter={StaticResource KindToColorConverter}, ConverterParameter=text}" />
                                    </Border>
                                    <Label Grid.Row="0" Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" />
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding ItemCount, StringFormat='{0} items'}"
                                           Style="{StaticResource CaptionStyle}" HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
