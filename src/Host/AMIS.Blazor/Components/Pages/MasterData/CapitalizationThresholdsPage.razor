@page "/master-data/capitalization-thresholds"
@implements IDisposable
@using AMIS.Modules.MasterData.Contracts.v1.CapitalizationThresholds
@using AMIS.Modules.MasterData.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@using AMIS.Framework.Blazor.UI.Components.Data
@using MudBlazor
@inject ICapitalizationThresholdClient Client
@inject ICapitalizationThresholdState ThresholdState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Capitalization Thresholds"
               Description="COA circular-based thresholds that determine item classification: Expendable, Semi-Expendable, or PPE">
    <ActionContent>
        @if (_canManage)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                Add New Circular
            </MudButton>
        }
    </ActionContent>
</AMISPageHeader>

<!-- Active Threshold Summary Banner -->
@if (_active is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-left: 4px solid var(--mud-palette-success);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            <MudText Typo="Typo.subtitle1"><b>Currently Active:</b> @_active.CircularName</MudText>
            <MudSpacer />
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.EventAvailable">
                Effective @_active.EffectivityDate.ToString("MMMM dd, yyyy")
            </MudChip>
        </MudStack>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Class="pa-3 text-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">EXPENDABLE</MudText>
                    <MudText Typo="Typo.body2">Consumable items (any cost)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">→ RSMI on issuance</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Class="pa-3 text-center">
                    <MudText Typo="Typo.caption" Color="Color.Warning">SEMI-EXPENDABLE</MudText>
                    <MudText Typo="Typo.body2">
                        Durable, cost &lt; <b>@Money.Symbol@_active.CapitalizationAmount.ToString("N2")</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        Low-valued = @Money.Symbol@_active.SemiExpendableLowValueThreshold.ToString("N2") → ICS
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        High-valued > @Money.Symbol@_active.SemiExpendableLowValueThreshold.ToString("N2") → ICS (enhanced accountability)
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Class="pa-3 text-center">
                    <MudText Typo="Typo.caption" Color="Color.Error">PPE / FIXED ASSET</MudText>
                    <MudText Typo="Typo.body2">
                        Durable, cost = <b>@Money.Symbol@_active.CapitalizationAmount.ToString("N2")</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">→ PAR + depreciation schedule</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>
}
else if (_loaded)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No active threshold is set. Classification logic cannot run until one is activated.
    </MudAlert>
}

<MudGrid Spacing="3">
    <!-- Table -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Circular History</MudText>

                <AMISDataTable T="CapitalizationThresholdDto"
                               Items="@_thresholds"
                               Loading="@(!_loaded)"
                               RowsPerPage="15"
                               EmptyMessage="No threshold records yet"
                               EmptyDescription="Add the first one.">
                    <HeaderContent>
                        <MudTh>Circular</MudTh>
                        <MudTh Style="text-align:right">PPE Threshold</MudTh>
                        <MudTh Style="text-align:right">Low-Value Limit</MudTh>
                        <MudTh>Effectivity</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Circular">
                            <MudText Typo="Typo.body2"><b>@context.CircularName</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="max-width:260px;white-space:normal">
                                @(context.Description.Length > 80 ? context.Description[..80] + "…" : context.Description)
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="PPE Threshold" Style="text-align:right">@Money.Symbol@context.CapitalizationAmount.ToString("N2")</MudTd>
                        <MudTd DataLabel="Low-Value Limit" Style="text-align:right">@Money.Symbol@context.SemiExpendableLowValueThreshold.ToString("N2")</MudTd>
                        <MudTd DataLabel="Effectivity">@context.EffectivityDate.ToString("MMM dd, yyyy")</MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.IsActive)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                         Icon="@Icons.Material.Filled.CheckCircle">Active</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Inactive</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="0">
                                @if (_canManage)
                                {
                                    <MudTooltip Text="Edit">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => OpenEditDialog(context))" />
                                    </MudTooltip>
                                }
                                @if (!context.IsActive && _canManage)
                                {
                                    <MudTooltip Text="Set as Active">
                                        <MudIconButton Icon="@Icons.Material.Filled.TaskAlt"
                                                       Size="Size.Small"
                                                       Color="Color.Success"
                                                       OnClick="@(() => ConfirmSetActiveAsync(context))" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private List<CapitalizationThresholdDto> _thresholds = [];
    private CapitalizationThresholdDto? _active;
    private bool _loaded;

    private bool _canManage => UserProfileState.Permissions.Contains(MasterDataPermissions.CapitalizationThresholds.Manage);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            _thresholds = (await Client.GetAllAsync()).ToList();
            _active = _thresholds.FirstOrDefault(x => x.IsActive);
            ThresholdState.Set(_active);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load thresholds: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canManage) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<CapitalizationThresholdFormDialog>("Add New Circular", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(CapitalizationThresholdDto threshold)
    {
        if (!_canManage) return;

        var parameters = new DialogParameters { ["Existing"] = threshold };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<CapitalizationThresholdFormDialog>($"Edit {threshold.CircularName}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmSetActiveAsync(CapitalizationThresholdDto threshold)
    {
        var result = await DialogService.ShowMessageBox(
            "Activate Circular",
            $"Set \"{threshold.CircularName}\" as the active capitalization threshold? This will deactivate the current one.",
            yesText: "Activate",
            cancelText: "Cancel");

        if (result is not true) return;

        try
        {
            await Client.SetActiveAsync(threshold.Id);
            Snackbar.Add($"{threshold.CircularName} is now active.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to activate: {ex.Message}", Severity.Error);
        }
    }

}

