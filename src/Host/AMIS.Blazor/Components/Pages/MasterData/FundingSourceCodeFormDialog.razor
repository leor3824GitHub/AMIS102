@using AMIS.Modules.MasterData.Contracts.v1.FundClusters
@using AMIS.Modules.MasterData.Contracts.v1.FundingSourceCodes
@using AMIS.Blazor.ApiClient
@inject ISnackbar Snackbar
@inject IFundingSourceCodeClient FundingSourceCodeClient

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.Code" Label="UACS Code" Placeholder="e.g. 01101101"
                              Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_form.FundClusterCode" Label="Fund Cluster" Required="true"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                    @foreach (var c in Clusters)
                    {
                        <MudSelectItem T="string" Value="@c.Code">@c.Code — @c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.FinancingSource" Label="Financing Source"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.Authorization" Label="Authorization"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.FundCategory" Label="Fund Category"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.FundSubCategory" Label="Fund Sub-Category"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.DepartmentName" Label="Department"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.AgencyName" Label="Agency"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Description" Label="Description" Lines="2"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            @if (_isEdit)
            {
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_form.IsActive" Label="Active" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_isLoading">
            @(_isEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public FundingSourceCodeDto? Existing { get; set; }
    [Parameter] public IReadOnlyList<FundClusterDto> Clusters { get; set; } = [];

    private CodeForm _form = new();
    private bool _isLoading = false;

    private bool _isEdit => Existing != null;

    private sealed class CodeForm
    {
        public string Code { get; set; } = string.Empty;
        public string FundClusterCode { get; set; } = string.Empty;
        public string? FinancingSource { get; set; }
        public string? Authorization { get; set; }
        public string? FundCategory { get; set; }
        public string? FundSubCategory { get; set; }
        public string? Description { get; set; }
        public string? DepartmentName { get; set; }
        public string? AgencyName { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override void OnInitialized()
    {
        if (Existing != null)
        {
            _form = new CodeForm
            {
                Code = Existing.Code,
                FundClusterCode = Existing.FundClusterCode,
                FinancingSource = Existing.FinancingSource,
                Authorization = Existing.Authorization,
                FundCategory = Existing.FundCategory,
                FundSubCategory = Existing.FundSubCategory,
                Description = Existing.Description,
                DepartmentName = Existing.DepartmentName,
                AgencyName = Existing.AgencyName,
                IsActive = Existing.IsActive
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Code))
        {
            Snackbar.Add("Code is required.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.FundClusterCode))
        {
            Snackbar.Add("Fund cluster is required.", Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            if (Existing is null)
            {
                await FundingSourceCodeClient.CreateAsync(new CreateFundingSourceCodeCommand(
                    _form.Code.Trim(),
                    _form.FundClusterCode.Trim(),
                    NullIfEmpty(_form.FinancingSource),
                    NullIfEmpty(_form.Authorization),
                    NullIfEmpty(_form.FundCategory),
                    NullIfEmpty(_form.FundSubCategory),
                    NullIfEmpty(_form.Description),
                    NullIfEmpty(_form.DepartmentName),
                    NullIfEmpty(_form.AgencyName)));
                Snackbar.Add("Funding source code created.", Severity.Success);
            }
            else
            {
                await FundingSourceCodeClient.UpdateAsync(new UpdateFundingSourceCodeCommand(
                    Existing.Id,
                    _form.Code.Trim(),
                    _form.FundClusterCode.Trim(),
                    NullIfEmpty(_form.FinancingSource),
                    NullIfEmpty(_form.Authorization),
                    NullIfEmpty(_form.FundCategory),
                    NullIfEmpty(_form.FundSubCategory),
                    NullIfEmpty(_form.Description),
                    NullIfEmpty(_form.DepartmentName),
                    NullIfEmpty(_form.AgencyName),
                    _form.IsActive));
                Snackbar.Add("Funding source code updated.", Severity.Success);
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void Cancel() => Dialog.Cancel();
}
