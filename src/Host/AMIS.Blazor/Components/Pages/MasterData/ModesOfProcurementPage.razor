@page "/master-data/modes-of-procurement"
@implements IDisposable
@using AMIS.Modules.MasterData.Contracts.v1.ModesOfProcurement
@using AMIS.Modules.MasterData.Contracts.Permissions
@using AMIS.Framework.Blazor.UI.Components.Cards
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@inject IModeOfProcurementClient ModeClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Modes of Procurement" Description="Manage procurement modes used across planning and purchasing">
    <ActionContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width: 100%; max-width: 560px;">
            <MudTextField @bind-Value="_searchKeyword" Label="Search" Placeholder="Search modes..."
                          DebounceInterval="300" OnDebounceIntervalElapsed="@(async () => await SearchAsync())"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">
                Search
            </MudButton>
            @if (_canCreate)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    New
                </MudButton>
            }
        </MudStack>
    </ActionContent>
</AMISPageHeader>

<div class="mt-4">
    <MudCard Class="AMIS-card">
        <MudCardContent>
            <MudStack Row="true" Spacing="1" Class="mb-3" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6" Class="flex-grow-1">Modes List</MudText>
                <MasterDataStatusFilterChips Value="_statusFilter" ValueChanged="OnStatusFilterChanged" />
            </MudStack>

            <AMISDataTable T="ModeOfProcurementDto"
                           Items="@_modes"
                           Loading="_isLoading"
                           RowsPerPage="15"
                           EmptyMessage="No modes of procurement found"
                           EmptyDescription="Create one to get started.">
                <HeaderContent>
                    <MudTh Style="cursor:pointer" @onclick='() => SetSort("Name")'>Name @SortIcon("Name")</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            @if (_canUpdate)
                            {
                                <MudTooltip Text="Edit mode">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Primary" OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                            }
                            @if (_canDelete)
                            {
                                <MudTooltip Text="Delete mode">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private List<ModeOfProcurementDto> _modes = [];
    private List<ModeOfProcurementDto> _allModes = [];
    private bool _isLoading;
    private string _searchKeyword = string.Empty;
    private string _statusFilter = "All";
    private string _sortField = "Name";
    private bool _sortAscending = true;


    private bool _canCreate => UserProfileState.Permissions.Contains(MasterDataPermissions.ModesOfProcurement.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(MasterDataPermissions.ModesOfProcurement.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(MasterDataPermissions.ModesOfProcurement.Delete);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync(string? keyword = null)
    {
        try
        {
            _isLoading = true;
            var response = await ModeClient.SearchAsync(keyword: keyword, pageSize: 200);
            _allModes = response?.Items?.ToList() ?? [];
            ApplyLocalFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load modes: {ex.Message}", Severity.Error);
            _modes = [];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SearchAsync()
    {
        await LoadAsync(_searchKeyword);
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ModeOfProcurementFormDialog>("Create Mode", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync(_searchKeyword);
        }
    }

    private async Task OpenEditDialog(ModeOfProcurementDto mode)
    {
        var parameters = new DialogParameters { ["Existing"] = mode };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ModeOfProcurementFormDialog>($"Edit {mode.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync(_searchKeyword);
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!await DialogService.ShowDeleteConfirmAsync("this mode of procurement"))
            return;

        try
        {
            _isLoading = true;
            await ModeClient.DeleteAsync(id);
            Snackbar.Add("Mode deleted.", Severity.Success);
            await LoadAsync(_searchKeyword);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnStatusFilterChanged(string value)
    {
        _statusFilter = value;
        ApplyLocalFilters();
    }

    private void SetSort(string field)
    {
        if (_sortField == field)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortField = field;
            _sortAscending = true;
        }

        ApplyLocalFilters();
    }

    private RenderFragment SortIcon(string field) => builder =>
    {
        if (_sortField != field)
            return;

        builder.OpenComponent<MudIcon>(0);
        builder.AddAttribute(1, "Icon", _sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward);
        builder.AddAttribute(2, "Size", Size.Small);
        builder.CloseComponent();
    };

    private void ApplyLocalFilters()
    {
        IEnumerable<ModeOfProcurementDto> query = _allModes;

        if (_statusFilter == "Active")
            query = query.Where(x => x.IsActive);
        else if (_statusFilter == "Inactive")
            query = query.Where(x => !x.IsActive);

        query = (_sortField, _sortAscending) switch
        {
            ("Name", true) => query.OrderBy(x => x.Name),
            ("Name", false) => query.OrderByDescending(x => x.Name),
            _ => query.OrderBy(x => x.Name)
        };

        _modes = query.ToList();
    }
}
