@using AMIS.Playground.Blazor.ApiClient
@inject ISnackbar Snackbar
@inject IMaster_dataClient MasterDataClient

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Code" Label="Code" Placeholder="Department code"
                          Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Name" Label="Name" Placeholder="Department name"
                          Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Description" Label="Description"
                          Placeholder="Department description" Lines="2"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.FundCluster" Label="Fund Cluster"
                          Placeholder="e.g. GENERAL OPERATING FUND" MaxLength="100"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.ResponsibilityCenterCode" Label="Responsibility Center Code (RCC)"
                          Placeholder="e.g. 07 001 0300000" MaxLength="50"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.OfficeCode" Label="Owner Office Code"
                          Placeholder="e.g. 100, NDO (leave blank for shared)" MaxLength="8"
                          Disabled="@(_isEdit)"
                          HelperText="@(_isEdit ? "Cannot be changed after creation" : null)"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudCheckBox @bind-Value="_form.IsActive" Label="Active" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDepartment" Disabled="_isLoading">
            @(_isEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public DepartmentReferenceDto? Existing { get; set; }

    private DepartmentForm _form = new();
    private bool _isLoading = false;

    private bool _isEdit => Existing != null;

    public class DepartmentForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? FundCluster { get; set; }
        public string? ResponsibilityCenterCode { get; set; }
        public bool IsActive { get; set; } = true;
        public string? OfficeCode { get; set; }
    }

    protected override void OnInitialized()
    {
        if (Existing != null)
        {
            _form = new DepartmentForm
            {
                Code = Existing.Code,
                Name = Existing.Name,
                Description = Existing.Description,
                FundCluster = Existing.FundCluster ?? string.Empty,
                ResponsibilityCenterCode = Existing.ResponsibilityCenterCode ?? string.Empty,
                IsActive = Existing.IsActive,
                OfficeCode = Existing.OfficeCode
            };
        }
    }

    private async Task SaveDepartment()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("Code and Name are required", Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            if (Existing != null)
            {
                var updateCmd = new UpdateDepartmentCommand
                {
                    Id = Existing.Id,
                    Code = _form.Code,
                    Name = _form.Name,
                    Description = _form.Description,
                    FundCluster = _form.FundCluster,
                    ResponsibilityCenterCode = string.IsNullOrWhiteSpace(_form.ResponsibilityCenterCode) ? null : _form.ResponsibilityCenterCode.Trim(),
                    IsActive = _form.IsActive
                };

                var updated = await MasterDataClient.DepartmentsPutAsync(Existing.Id, updateCmd);
                Snackbar.Add("Department updated successfully", Severity.Success);
                Dialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var createCmd = new CreateDepartmentCommand
                {
                    Code = _form.Code,
                    Name = _form.Name,
                    Description = _form.Description,
                    FundCluster = _form.FundCluster,
                    ResponsibilityCenterCode = string.IsNullOrWhiteSpace(_form.ResponsibilityCenterCode) ? null : _form.ResponsibilityCenterCode.Trim(),
                    IsActive = _form.IsActive,
                    OfficeCode = string.IsNullOrWhiteSpace(_form.OfficeCode) ? null : _form.OfficeCode.Trim()
                };

                var created = await MasterDataClient.DepartmentsPostAsync(createCmd);
                Snackbar.Add("Department created successfully", Severity.Success);
                Dialog.Close(DialogResult.Ok(created));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save department: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
