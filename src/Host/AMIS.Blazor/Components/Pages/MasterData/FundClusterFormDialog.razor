@using AMIS.Modules.MasterData.Contracts.v1.FundClusters
@using AMIS.Blazor.ApiClient
@inject ISnackbar Snackbar
@inject IFundClusterClient FundClusterClient

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Code" Label="Code" Placeholder="e.g. 01"
                          Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Name" Label="Name" Placeholder="e.g. Regular Agency Fund"
                          Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Description" Label="Description" Placeholder="Optional description" Lines="3"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            @if (_isEdit)
            {
                <MudCheckBox @bind-Value="_form.IsActive" Label="Active" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_isLoading">
            @(_isEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public FundClusterDto? Existing { get; set; }

    private ClusterForm _form = new();
    private bool _isLoading = false;

    private bool _isEdit => Existing != null;

    private sealed class ClusterForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override void OnInitialized()
    {
        if (Existing != null)
        {
            _form = new ClusterForm
            {
                Code = Existing.Code,
                Name = Existing.Name,
                Description = Existing.Description,
                IsActive = Existing.IsActive
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Code))
        {
            Snackbar.Add("Code is required.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            if (Existing is null)
            {
                await FundClusterClient.CreateAsync(new CreateFundClusterCommand(
                    _form.Code.Trim(), _form.Name.Trim(), NullIfEmpty(_form.Description)));
                Snackbar.Add("Fund cluster created.", Severity.Success);
            }
            else
            {
                await FundClusterClient.UpdateAsync(new UpdateFundClusterCommand(
                    Existing.Id,
                    _form.Code.Trim(),
                    _form.Name.Trim(),
                    NullIfEmpty(_form.Description),
                    _form.IsActive));
                Snackbar.Add("Fund cluster updated.", Severity.Success);
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void Cancel() => Dialog.Cancel();
}
