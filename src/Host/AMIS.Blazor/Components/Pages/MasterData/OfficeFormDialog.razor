@using AMIS.Playground.Blazor.ApiClient
@inject ISnackbar Snackbar
@inject IMaster_dataClient MasterDataClient

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Code" Label="Code" Placeholder="e.g. GSD, 100, NDO"
                          Required="true" Disabled="@(_isEdit)"
                          HelperText="@(_isEdit ? "Code cannot be changed after creation" : null)"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Name" Label="Name" Placeholder="Office name"
                          Required="true" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Address" Label="Address" Placeholder="Office address" Lines="2"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.LocationCode" Label="Location Code" Placeholder="e.g. 8600, 0100, 1301"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.RegProvCode" Label="Reg./Prov. Code"
                          Placeholder="e.g. 100, NDO, 00B (leave blank for Central Office)"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Description" Label="Description" Placeholder="Office description" Lines="2"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.OfficeCode" Label="Owner Office Code"
                          Placeholder="e.g. 100, NDO (leave blank for shared)" MaxLength="8"
                          Disabled="@(_isEdit)"
                          HelperText="@(_isEdit ? "Cannot be changed after creation" : null)"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudCheckBox @bind-Value="_form.IsActive" Label="Active" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveOffice" Disabled="_isLoading">
            @(_isEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public OfficeReferenceDto? Existing { get; set; }

    private OfficeForm _form = new();
    private bool _isLoading = false;

    private bool _isEdit => Existing != null;

    public class OfficeForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? LocationCode { get; set; }
        public string? RegProvCode { get; set; }
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
        public string? OfficeCode { get; set; }
    }

    protected override void OnInitialized()
    {
        if (Existing != null)
        {
            _form = new OfficeForm
            {
                Code = Existing.Code,
                Name = Existing.Name,
                Address = Existing.Address,
                LocationCode = Existing.LocationCode,
                RegProvCode = Existing.RegProvCode,
                Description = Existing.Description,
                IsActive = Existing.IsActive,
                OfficeCode = Existing.OfficeCode
            };
        }
    }

    private async Task SaveOffice()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("Code and Name are required", Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            if (Existing != null)
            {
                var updateCmd = new UpdateOfficeCommand
                {
                    Id = Existing.Id,
                    Code = _form.Code,
                    Name = _form.Name,
                    Address = _form.Address,
                    LocationCode = _form.LocationCode,
                    RegProvCode = _form.RegProvCode,
                    Description = _form.Description,
                    IsActive = _form.IsActive
                };

                var updated = await MasterDataClient.OfficesPutAsync(Existing.Id, updateCmd);
                Snackbar.Add("Office updated successfully", Severity.Success);
                Dialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var createCmd = new CreateOfficeCommand
                {
                    Code = _form.Code,
                    Name = _form.Name,
                    Address = _form.Address,
                    LocationCode = _form.LocationCode,
                    RegProvCode = _form.RegProvCode,
                    Description = _form.Description,
                    IsActive = _form.IsActive,
                    OfficeCode = string.IsNullOrWhiteSpace(_form.OfficeCode) ? null : _form.OfficeCode.Trim()
                };

                var created = await MasterDataClient.OfficesPostAsync(createCmd);
                Snackbar.Add("Office created successfully", Severity.Success);
                Dialog.Close(DialogResult.Ok(created));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save office: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
