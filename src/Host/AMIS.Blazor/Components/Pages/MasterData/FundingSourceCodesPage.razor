@page "/master-data/funding-source-codes"
@implements IDisposable
@using AMIS.Modules.MasterData.Contracts.v1.FundClusters
@using AMIS.Modules.MasterData.Contracts.v1.FundingSourceCodes
@using AMIS.Modules.MasterData.Contracts.Permissions
@using AMIS.Framework.Blazor.UI.Components.Cards
@using AMIS.Blazor.ApiClient
@inject IFundingSourceCodeClient FundingSourceCodeClient
@inject IFundClusterClient FundClusterClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Funding Source Codes" Description="Full UACS funding-source taxonomy used by procurement planning (PPMP/APP)">
    <ActionContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width: 100%; max-width: 720px;">
            <MudTextField @bind-Value="_searchKeyword" Label="Search" Placeholder="Search code or category..."
                          DebounceInterval="300" OnDebounceIntervalElapsed="@(async () => await SearchAsync())"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudSelect T="string" Value="_clusterFilter" Label="Cluster" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Clearable="true" ValueChanged="OnClusterFilterChanged">
                <MudSelectItem T="string" Value="@("")">All clusters</MudSelectItem>
                @foreach (var c in _clusters)
                {
                    <MudSelectItem T="string" Value="@c.Code">@c.Code — @c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">
                Search
            </MudButton>
            @if (_canCreate)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    New
                </MudButton>
            }
        </MudStack>
    </ActionContent>
</AMISPageHeader>

<div class="mt-4">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard Class="AMIS-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Funding Source Code List</MudText>

                    @if (_isLoading)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (_items.Any())
                    {
                        <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto;">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Cluster</th>
                                    <th>Financing Source</th>
                                    <th>Authorization</th>
                                    <th>Fund Category</th>
                                    <th>Fund Sub-Category</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items.Skip((_pageIndex - 1) * PageSize).Take(PageSize))
                                {
                                    <tr>
                                        <td>@item.Code</td>
                                        <td>@item.FundClusterCode</td>
                                        <td>@(Dash(item.FinancingSource))</td>
                                        <td>@(Dash(item.Authorization))</td>
                                        <td>@(Dash(item.FundCategory))</td>
                                        <td>@(Dash(item.FundSubCategory))</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(item.IsActive ? Color.Success : Color.Default)">
                                                @(item.IsActive ? "Active" : "Inactive")
                                            </MudChip>
                                        </td>
                                        <td>
                                            <MudStack Row="true" Spacing="1">
                                                @if (_canUpdate)
                                                {
                                                    <MudTooltip Text="Edit code">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                                       Color="Color.Primary" OnClick="@(() => OpenEditDialog(item))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canDelete)
                                                {
                                                    <MudTooltip Text="Delete code">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                                       Color="Color.Error" OnClick="@(() => DeleteAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                            </MudStack>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>

                        @if (_items.Count > PageSize)
                        {
                            <MudPagination Class="mt-2" Count="@((int)Math.Ceiling(_items.Count / (double)PageSize))"
                                           @bind-Selected="_pageIndex" Color="Color.Primary" ShowFirstButton="true" ShowLastButton="true" />
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">No funding source codes found. Adjust your filter or create one.</MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private const int PageSize = 15;
    private List<FundingSourceCodeDto> _items = [];
    private List<FundClusterDto> _clusters = [];
    private bool _isLoading;
    private string _searchKeyword = string.Empty;
    private string _clusterFilter = string.Empty;
    private int _pageIndex = 1;

    private bool _canCreate => UserProfileState.Permissions.Contains(MasterDataPermissions.FundingSourceCodes.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(MasterDataPermissions.FundingSourceCodes.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(MasterDataPermissions.FundingSourceCodes.Delete);

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        var clusterResponse = await FundClusterClient.SearchAsync(pageSize: 200);
        _clusters = clusterResponse?.Items?.OrderBy(x => x.Code).ToList() ?? [];
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            var response = await FundingSourceCodeClient.SearchAsync(
                keyword: _searchKeyword,
                fundClusterCode: string.IsNullOrWhiteSpace(_clusterFilter) ? null : _clusterFilter,
                pageSize: 500);
            _items = response?.Items?.OrderBy(x => x.Code).ToList() ?? [];

            var maxPage = Math.Max(1, (int)Math.Ceiling(_items.Count / (double)PageSize));
            if (_pageIndex > maxPage)
                _pageIndex = maxPage;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load funding source codes: {ex.Message}", Severity.Error);
            _items = [];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SearchAsync()
    {
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task OnClusterFilterChanged(string value)
    {
        _clusterFilter = value ?? string.Empty;
        _pageIndex = 1;
        await LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var parameters = new DialogParameters { ["Clusters"] = _clusters };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<FundingSourceCodeFormDialog>("Create Funding Source Code", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(FundingSourceCodeDto item)
    {
        var parameters = new DialogParameters { ["Existing"] = item, ["Clusters"] = _clusters };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<FundingSourceCodeFormDialog>($"Edit {item.Code}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!await DialogService.ShowDeleteConfirmAsync("this funding source code"))
            return;

        try
        {
            _isLoading = true;
            await FundingSourceCodeClient.DeleteAsync(id);
            Snackbar.Add("Funding source code deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
