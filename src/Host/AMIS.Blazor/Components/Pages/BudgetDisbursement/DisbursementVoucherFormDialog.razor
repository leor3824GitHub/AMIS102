@using AMIS.Modules.BudgetDisbursement.Contracts.v1.BudgetUtilizationRequests
@using AMIS.Modules.BudgetDisbursement.Contracts.v1.DisbursementVouchers
@using AMIS.Modules.MasterData.Contracts.v1.FundClusters
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseOrders
@using AMIS.Blazor.ApiClient
@inject IDisbursementVoucherClient Client
@inject IBudgetUtilizationRequestClient BurClient
@inject IPurchaseOrderClient PurchaseOrderClient
@inject IFundClusterClient FundClusterClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (Editing is null)
            {
                <MudAutocomplete T="BudgetUtilizationRequestListItemDto"
                                 Value="_selectedBur"
                                 ValueChanged="OnBurChanged"
                                 SearchFunc="SearchBudgetUtilizationRequests"
                                 ToStringFunc="FormatBur"
                                 Label="Budget Utilization Request and Status"
                                 Variant="Variant.Outlined"
                                 Placeholder="Search obligated BUR number..."
                                 Required="true"
                                 Clearable="true"
                                 CoerceValue="true"
                                 ResetValueOnEmptyText="true"
                                 Dense="true" Margin="Margin.Dense"
                                 HelperText="Only obligated BURs can be disbursed" />
                @if (_selectedBur is not null)
                {
                    <MudTextField Value="@_selectedBur.PurchaseOrderNumber" Label="Purchase Order" Variant="Variant.Outlined"
                                  ReadOnly="true" Dense="true" Margin="Margin.Dense" />
                }
            }
            else
            {
                <MudTextField Value="@Editing.BurNumber" Label="Budget Utilization Request and Status" Variant="Variant.Outlined"
                              ReadOnly="true" Dense="true" Margin="Margin.Dense" />
                <MudTextField Value="@Editing.PurchaseOrderNumber" Label="Purchase Order" Variant="Variant.Outlined"
                              ReadOnly="true" Dense="true" Margin="Margin.Dense" />
            }
            <MudDatePicker @bind-Date="_form.DvDateNullable" Label="DV Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Required="true" Dense="true" Margin="Margin.Dense" />
            @* Fund cluster belongs to the BUR (BUR first, then DV). When the BUR carries one it is inherited
               and locked read-only so the DV can never diverge from the obligation — no re-entry, no mismatch.
               The editable select appears only as a fallback for legacy BURs with no cluster on file. *@
            @if (_fundClusterFromBur)
            {
                <MudTextField Value="@FundClusterDisplay" Label="Fund Cluster" Variant="Variant.Outlined"
                              ReadOnly="true" Dense="true" Margin="Margin.Dense"
                              HelperText="Inherited from the selected BUR." />
            }
            else
            {
                <MudSelect @bind-Value="_form.FundCluster" Label="Fund Cluster" Variant="Variant.Outlined" T="string"
                           Required="true" Dense="true" Margin="Margin.Dense" Clearable="true"
                           HelperText="This BUR has no fund cluster on file — select one.">
                    @foreach (var c in _fundClusters)
                    {
                        <MudSelectItem T="string" Value="@c.Code">@c.Code — @c.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle2">Payee Information</MudText>
            <MudTextField @bind-Value="_form.Payee" Label="Payee" Variant="Variant.Outlined" Required="true" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.TinNo" Label="TIN (optional)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.PayeeAddress" Label="Payee Address (optional)" Variant="Variant.Outlined" Lines="2" Dense="true" Margin="Margin.Dense" />
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle2">Payment Details</MudText>
            <MudTextField @bind-Value="_form.Particulars" Label="Particulars" Variant="Variant.Outlined" Required="true" Lines="3" Dense="true" Margin="Margin.Dense" />
            <MudNumericField @bind-Value="_form.Amount" Label="@($"Amount ({Money.Symbol})")" Variant="Variant.Outlined" Required="true" Min="0.01m" Format="N2" Dense="true" Margin="Margin.Dense" />
            <MudSelect @bind-Value="_form.ModeOfPayment" Label="Mode of Payment" Variant="Variant.Outlined" T="string" Dense="true" Margin="Margin.Dense">
                <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                <MudSelectItem Value="@("Check")">Check</MudSelectItem>
                <MudSelectItem Value="@("Bank Transfer")">Bank Transfer</MudSelectItem>
                <MudSelectItem Value="@("LDDAP-ADA")">LDDAP-ADA</MudSelectItem>
                <MudSelectItem Value="@("MDS Check")">MDS Check</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_form.Remarks" Label="Remarks (optional)" Variant="Variant.Outlined" Lines="2" Dense="true" Margin="Margin.Dense" />
            <MudDivider Class="my-1" />
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2">Deductions (tax, withholding, fees)</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDeduction">Add</MudButton>
            </MudStack>
            @if (_form.Deductions.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">No deductions. Amount Due equals the gross amount.</MudText>
            }
            @foreach (var d in _form.Deductions)
            {
                <MudGrid Spacing="1" AlignItems="AlignItems.Center">
                    <MudItem xs="4">
                        <MudTextField @bind-Value="d.Name" Label="Name" Placeholder="e.g. Withholding Tax"
                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="3">
                        <MudSelect @bind-Value="d.Type" Label="Type" T="DvDeductionType"
                                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="DvDeductionType.Percentage">Percentage (%)</MudSelectItem>
                            <MudSelectItem Value="DvDeductionType.FixedAmount">@($"Fixed ({Money.Symbol})")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="2">
                        <MudNumericField @bind-Value="d.Value" Label="@(d.Type == DvDeductionType.Percentage ? "%" : Money.Symbol)"
                                         Variant="Variant.Outlined" Min="0" Format="N2" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center justify-end">
                        <MudText Typo="Typo.body2">@($"{Money.Symbol}{ComputeDeduction(d):N2}")</MudText>
                    </MudItem>
                    <MudItem xs="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveDeduction(d))" />
                    </MudItem>
                </MudGrid>
            }
            @if (_form.Deductions.Count > 0)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">Total Deductions</MudText>
                    <MudText Typo="Typo.body2">@($"{Money.Symbol}{TotalDeductions:N2}")</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Amount Due</MudText>
                    <MudText Typo="Typo.subtitle2" Color="@(AmountDue < 0 ? Color.Error : Color.Default)">@($"{Money.Symbol}{AmountDue:N2}")</MudText>
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
            @if (_busy) { <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" /> }
            @(Editing is null ? "Create DV" : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>When set, the dialog edits this existing (Draft) voucher instead of creating a new one.</summary>
    [Parameter] public DisbursementVoucherDto? Editing { get; set; }

    private readonly DvForm _form = new();
    private BudgetUtilizationRequestListItemDto? _selectedBur;
    private List<FundClusterDto> _fundClusters = [];
    // True when the fund cluster was inherited from the BUR: the field is then shown read-only so the DV
    // can't be re-entered with a value that diverges from the obligation. False only for legacy BURs that
    // carry no cluster, where the editable select is offered as a fallback.
    private bool _fundClusterFromBur;
    private bool _busy;

    // "Code — Name" for the read-only inherited field; falls back to the raw code if the cluster isn't
    // in the loaded list (e.g. later deactivated).
    private string FundClusterDisplay => ClusterDisplay(_form.FundCluster);

    protected override async Task OnInitializedAsync() => await LoadFundClustersAsync();

    private async Task LoadFundClustersAsync()
    {
        try
        {
            var response = await FundClusterClient.SearchAsync(pageSize: 200);
            _fundClusters = response?.Items?
                .Where(c => c.IsActive)
                .OrderBy(c => c.Code, StringComparer.Ordinal)
                .ToList() ?? [];
        }
        catch
        {
            _fundClusters = [];
        }
    }

    protected override void OnInitialized()
    {
        if (Editing is null) return;

        // Edit mode: the BUR/PO link is fixed at creation and shown read-only — only the editable
        // voucher fields are seeded here.
        _form.DvDateNullable = Editing.DvDate.ToDateTime(TimeOnly.MinValue);
        _form.FundCluster = Editing.FundCluster;
        // The BUR/PO link is fixed at creation, so a stored fund cluster stays locked read-only too.
        // Only a legacy DV with no cluster on file falls back to the editable select.
        _fundClusterFromBur = !string.IsNullOrWhiteSpace(Editing.FundCluster);
        _form.Payee = Editing.Payee;
        _form.TinNo = Editing.TinNo;
        _form.PayeeAddress = Editing.PayeeAddress;
        _form.Particulars = Editing.Particulars;
        _form.Amount = Editing.Amount;
        _form.ModeOfPayment = Editing.ModeOfPayment;
        _form.Remarks = Editing.Remarks;
        _form.Deductions = Editing.Deductions
            .Select(d => new DeductionRow { Name = d.Name, Type = d.Type, Value = d.Value })
            .ToList();
    }

    private void AddDeduction() => _form.Deductions.Add(new DeductionRow());

    private void RemoveDeduction(DeductionRow row) => _form.Deductions.Remove(row);

    // Mirrors DvDeduction.ComputeAmount server-side so the previewed figure matches the saved one.
    private decimal ComputeDeduction(DeductionRow row) =>
        row.Type == DvDeductionType.Percentage
            ? Math.Round(_form.Amount * (row.Value / 100m), 2, MidpointRounding.AwayFromZero)
            : row.Value;

    private decimal TotalDeductions => _form.Deductions.Sum(ComputeDeduction);

    private decimal AmountDue => _form.Amount - TotalDeductions;

    // Only well-formed lines are persisted; blank/zero rows the user added but didn't fill are dropped.
    private List<DvDeductionInput> CollectDeductions() =>
        _form.Deductions
            .Where(d => !string.IsNullOrWhiteSpace(d.Name) && d.Value > 0)
            .Select(d => new DvDeductionInput(d.Name.Trim(), d.Type, d.Value))
            .ToList();

    // BUR first, then DV: a voucher is raised against an obligated Budget Utilization Request. Only
    // Obligated BURs are offered — a BUR that already has a DV has moved to Utilized and is excluded.
    private async Task<IEnumerable<BudgetUtilizationRequestListItemDto>> SearchBudgetUtilizationRequests(string value, CancellationToken ct)
    {
        try
        {
            var result = await BurClient.SearchAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                status: BudgetUtilizationRequestStatus.Obligated,
                page: 1,
                pageSize: 20,
                ct: ct);
            return result.Items ?? Enumerable.Empty<BudgetUtilizationRequestListItemDto>();
        }
        catch
        {
            return Enumerable.Empty<BudgetUtilizationRequestListItemDto>();
        }
    }

    private async Task OnBurChanged(BudgetUtilizationRequestListItemDto? bur)
    {
        _selectedBur = bur;
        if (bur is null)
        {
            // BUR cleared: drop the inherited cluster and unlock the field so a fresh selection re-derives it.
            _fundClusterFromBur = false;
            _form.FundCluster = string.Empty;
            return;
        }

        // Pre-fill the voucher from the BUR and its purchase order. Only fill empty fields so a
        // re-selection never clobbers values the user already typed. All fields remain editable.
        if (_form.Amount <= 0) _form.Amount = bur.Amount;

        try
        {
            var burDetail = await BurClient.GetAsync(bur.Id);
            if (burDetail is null) return;

            if (string.IsNullOrWhiteSpace(_form.Particulars))
                _form.Particulars = $"Payment for {burDetail.PurchaseOrderNumber}";

            // Fund cluster is a property of the BUR (BUR first, then DV). When the BUR carries one, adopt it
            // and lock the field read-only — the DV must not re-enter or diverge from the obligation. This
            // overwrites any earlier value (e.g. from a previously selected BUR), because the cluster is
            // funding data, not something the user hand-types. Legacy BURs with no cluster fall through to
            // the PO's cluster and stay editable.
            if (!string.IsNullOrWhiteSpace(burDetail.FundCluster))
            {
                _form.FundCluster = burDetail.FundCluster.Trim();
                _fundClusterFromBur = true;
            }
            else
            {
                _fundClusterFromBur = false;
            }

            var po = await PurchaseOrderClient.GetAsync(burDetail.PurchaseOrderId);
            if (po is not null)
            {
                if (string.IsNullOrWhiteSpace(_form.Payee)) _form.Payee = po.SupplierName;
                if (string.IsNullOrWhiteSpace(_form.PayeeAddress)) _form.PayeeAddress = po.SupplierAddress;
                if (string.IsNullOrWhiteSpace(_form.TinNo)) _form.TinNo = po.SupplierTin;
                if (!_fundClusterFromBur && string.IsNullOrWhiteSpace(_form.FundCluster))
                    _form.FundCluster = ResolveClusterCode(po.FundCluster);
            }
        }
        catch
        {
            // Pre-fill is a convenience; leave fields for manual entry if the lookup fails.
        }
    }

    private static string FormatBur(BudgetUtilizationRequestListItemDto? bur)
    {
        if (bur is null) return string.Empty;
        return $"{bur.BurNumber} — PO {bur.PurchaseOrderNumber}";
    }

    // Resolves a cluster code to "Code — Name" for read-only display; shows the raw code if the cluster
    // isn't in the loaded list (e.g. it was deactivated after the BUR was created).
    private string ClusterDisplay(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return string.Empty;
        var match = _fundClusters.FirstOrDefault(c => string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase));
        return match is null ? code : $"{match.Code} — {match.Name}";
    }

    // Returns the code only when it maps to a loaded, active cluster — so the MudSelect can render it.
    // An unknown/legacy code would otherwise leave the select showing a value with no matching item.
    private string ResolveClusterCode(string? code) =>
        !string.IsNullOrWhiteSpace(code) && _fundClusters.Any(c => string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase))
            ? code!
            : string.Empty;

    private async Task SaveAsync()
    {
        if (!IsFormValid()) { Snackbar.Add("Fill in all required fields.", Severity.Warning); return; }
        _busy = true;
        try
        {
            var tinNo = string.IsNullOrWhiteSpace(_form.TinNo) ? null : _form.TinNo;
            var payeeAddress = string.IsNullOrWhiteSpace(_form.PayeeAddress) ? null : _form.PayeeAddress;
            var remarks = string.IsNullOrWhiteSpace(_form.Remarks) ? null : _form.Remarks;
            var dvDate = ToDateOnly(_form.DvDateNullable)!.Value;
            var deductions = CollectDeductions();

            if (Editing is null)
            {
                await Client.CreateAsync(new CreateDisbursementVoucherCommand(
                    _selectedBur!.Id, _selectedBur.BurNumber, dvDate,
                    _form.FundCluster, _form.Payee, tinNo, payeeAddress,
                    _form.Particulars, _form.Amount, _form.ModeOfPayment, remarks, deductions));
                Snackbar.Add("Disbursement voucher created.", Severity.Success);
            }
            else
            {
                // The BUR/PO link is immutable after creation; re-send the existing PO unchanged.
                await Client.UpdateAsync(Editing.Id, new UpdateDisbursementVoucherCommand(
                    Editing.Id, Editing.PurchaseOrderId, Editing.PurchaseOrderNumber, dvDate,
                    _form.FundCluster, _form.Payee, tinNo, payeeAddress,
                    _form.Particulars, _form.Amount, _form.ModeOfPayment, remarks, deductions));
                Snackbar.Add("Disbursement voucher updated.", Severity.Success);
            }
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Save failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private void Cancel() => Dialog.Cancel();

    private bool IsFormValid() =>
        (Editing is not null || _selectedBur is not null) &&
        _form.DvDateNullable.HasValue &&
        !string.IsNullOrWhiteSpace(_form.FundCluster) &&
        !string.IsNullOrWhiteSpace(_form.Payee) &&
        !string.IsNullOrWhiteSpace(_form.Particulars) &&
        _form.Amount > 0 &&
        !string.IsNullOrWhiteSpace(_form.ModeOfPayment);

    private static DateOnly? ToDateOnly(DateTime? d) => d.HasValue ? DateOnly.FromDateTime(d.Value) : null;

    private sealed class DvForm
    {
        public DateTime? DvDateNullable { get; set; } = DateTime.Today;
        public string FundCluster { get; set; } = string.Empty;
        public string Payee { get; set; } = string.Empty;
        public string? TinNo { get; set; }
        public string? PayeeAddress { get; set; }
        public string Particulars { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string ModeOfPayment { get; set; } = "Check";
        public string? Remarks { get; set; }
        public List<DeductionRow> Deductions { get; set; } = [];
    }

    private sealed class DeductionRow
    {
        public string Name { get; set; } = string.Empty;
        public DvDeductionType Type { get; set; } = DvDeductionType.Percentage;
        public decimal Value { get; set; }
    }
}
