@page "/budget-disbursement/budget-utilization-requests"
@implements IDisposable
@using AMIS.Modules.BudgetDisbursement.Contracts.v1.BudgetUtilizationRequests
@using AMIS.Modules.BudgetDisbursement.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@inject IBudgetUtilizationRequestClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState
@inject IJSRuntime JS

<AMISPageHeader Title="Budget Utilization Request and Status" Description="Create and manage budget utilization request and status (BUR)" />

<MudCard Elevation="1">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudText Typo="Typo.h6" Class="flex-grow-1">Budget Utilization Request and Status</MudText>
            <MudTextField @bind-Value="_keyword" Label="Search" Variant="Variant.Outlined" Size="Size.Small"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="max-width:220px" DebounceInterval="400"
                          OnDebounceIntervalElapsed="@(async () => await ReloadAsync())" />
            @if (_canCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">New BUR</MudButton>
            }
        </MudStack>

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    @foreach (var s in _statusFilters)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_statusFilter == s ? Color.Primary : Color.Default)"
                                 OnClick="@(() => SetStatusFilter(s))">@GetChipLabel(s)</MudChip>
                    }
                </MudStack>

                @if (!_loaded)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No budget utilization request and status records found.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>BUR #</th>
                                <th>Date</th>
                                <th>PO #</th>
                                <th>Allotment Class</th>
                                <th style="text-align:right">Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><b>@item.BurNumber</b></td>
                                    <td>@item.BurDate.ToString("MM/dd/yyyy")</td>
                                    <td><MudText Typo="Typo.caption">@item.PurchaseOrderNumber</MudText></td>
                                    <td><MudText Typo="Typo.caption">@item.AllotmentClass</MudText></td>
                                    <td style="text-align:right">@Money.Symbol@item.Amount.ToString("N2")</td>
                                    <td>@BurStatusChip(item.Status)</td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            @if (item.Status == BudgetUtilizationRequestStatus.Draft && _canDelete)
                                            {
                                                <MudTooltip Text="Delete">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(async () => await DeleteBurAsync(item))" />
                                                </MudTooltip>
                                            }
                                            @if (item.Status == BudgetUtilizationRequestStatus.Draft && _canObligate)
                                            {
                                                <MudTooltip Text="Obligate">
                                                    <MudIconButton Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Info"
                                                                   OnClick="@(async () => await ObligateAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if (item.Status == BudgetUtilizationRequestStatus.Obligated && _canCancel)
                                            {
                                                <MudTooltip Text="Cancel">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(async () => await CancelBurAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if ((item.Status == BudgetUtilizationRequestStatus.Obligated || item.Status == BudgetUtilizationRequestStatus.Utilized) && _canViewSigned)
                                            {
                                                <MudTooltip Text="@(item.HasSignedCopy ? "Signed Copy (uploaded)" : "Signed Copy")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                                   Color="@(item.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                                   OnClick="@(async () => await OpenSignedCopyAsync(item))" />
                                                </MudTooltip>
                                            }
                                            <MudTooltip Text="View Details">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default"
                                                               OnClick="@(async () => await ViewDetailsAsync(item.Id))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@(item.HasSignedCopy ? "Signed copy uploaded — print disabled" : "Print")">
                                                <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Secondary"
                                                               Disabled="@(_busy || item.HasSignedCopy)"
                                                               OnClick="@(async () => await DownloadPdfAsync(item.Id))" />
                                            </MudTooltip>
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_totalCount > _pageSize)
                    {
                        <MudStack Row="true" JustifyContent="JustifyContent.Center" Class="mt-3">
                            <MudPagination Count="@((_totalCount + _pageSize - 1) / _pageSize)"
                                           Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                        </MudStack>
                    }
                }
    </MudCardContent>
</MudCard>

<!-- BUR Detail View -->
@if (_detail is not null)
{
            <MudCard Elevation="1" Class="mt-3">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6" Class="flex-grow-1">@_detail.BurNumber — Details</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _detail = null)" />
                    </MudStack>
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">BUR Date</MudText>
                            <MudText Typo="Typo.body2">@_detail.BurDate.ToString("MMMM dd, yyyy")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Purchase Order</MudText>
                            <MudText Typo="Typo.body2">@_detail.PurchaseOrderNumber</MudText>
                        </MudItem>
                        @if (!string.IsNullOrWhiteSpace(_detail.DisbursementVoucherNumber))
                        {
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Disbursement Voucher</MudText>
                                <MudText Typo="Typo.body2">@_detail.DisbursementVoucherNumber</MudText>
                            </MudItem>
                        }
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                            @BurStatusChip(_detail.Status)
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Allotment Class</MudText>
                            <MudText Typo="Typo.body2">@_detail.AllotmentClass</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">UACS Object Code</MudText>
                            <MudText Typo="Typo.body2">@_detail.UacsObjectCode</MudText>
                        </MudItem>
                        @if (!string.IsNullOrWhiteSpace(_detail.ResponsibilityCenter))
                        {
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Responsibility Center</MudText>
                                <MudText Typo="Typo.body2">@_detail.ResponsibilityCenter</MudText>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Particulars</MudText>
                            <MudText Typo="Typo.body2">@_detail.Particulars</MudText>
                        </MudItem>
                        @if (!string.IsNullOrWhiteSpace(_detail.Remarks))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Remarks</MudText>
                                <MudText Typo="Typo.body2">@_detail.Remarks</MudText>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudDivider />
                            <MudStack Row="true" JustifyContent="JustifyContent.FlexEnd" Class="mt-2">
                                <MudText Typo="Typo.h6">Amount: <b>@Money.Symbol@_detail.Amount.ToString("N2")</b></MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
}

@code {
    private List<BudgetUtilizationRequestListItemDto> _items = [];
    private BudgetUtilizationRequestDto? _detail;
    private bool _busy, _loaded;
    private string _keyword = string.Empty;
    private string _statusFilter = "All";
    private int _page = 1, _pageSize = 15, _totalCount;
    private Dictionary<string, int> _statusCounts = [];

    private static readonly string[] _statusFilters = ["All", "Draft", "Obligated", "Utilized", "Cancelled"];

    private bool _canCreate => UserProfileState.Permissions.Contains(BudgetDisbursementPermissions.BudgetUtilizationRequests.Create);
    private bool _canDelete => UserProfileState.Permissions.Contains(BudgetDisbursementPermissions.BudgetUtilizationRequests.Delete);
    private bool _canObligate => UserProfileState.Permissions.Contains(BudgetDisbursementPermissions.BudgetUtilizationRequests.Obligate);
    private bool _canCancel => UserProfileState.Permissions.Contains(BudgetDisbursementPermissions.BudgetUtilizationRequests.Cancel);
    private bool _canViewSigned => UserProfileState.Permissions.Contains(BudgetDisbursementPermissions.SignedDocuments.View);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await ReloadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<BudgetUtilizationRequestFormDialog>("New Budget Utilization Request and Status", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            BudgetUtilizationRequestStatus? filter = _statusFilter == "All" ? null : Enum.Parse<BudgetUtilizationRequestStatus>(_statusFilter);
            var result = await Client.SearchAsync(_keyword, filter, null, null, _page, _pageSize);
            _items = result.Items?.ToList() ?? [];
            _totalCount = result.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loaded = true; }
    }

    // Reloads the list AND the keyword-scoped chip counts. Called when the matched result set can
    // change: initial load, keyword change, and after mutations. Paging and chip-switch call
    // LoadAsync alone — they don't change the per-status counts for the current keyword.
    private async Task ReloadAsync()
    {
        await LoadAsync();
        await LoadStatusCountsAsync();
    }

    // Grouped query (GROUP BY Status) backing the chip counts, scoped to the current keyword so each
    // badge matches what selecting that status would return.
    private async Task LoadStatusCountsAsync()
    {
        try
        {
            var counts = await Client.GetStatusCountsAsync(_keyword);
            var dict = counts.ToDictionary(c => c.Status.ToString(), c => c.Count);
            dict["All"] = counts.Sum(c => c.Count);
            _statusCounts = dict;
        }
        catch { _statusCounts = []; }
    }

    private string GetChipLabel(string status) =>
        _statusCounts.TryGetValue(status, out var count) && count > 0 ? $"{status} ({count})" : status;

    private async Task SetStatusFilter(string s) { _statusFilter = s; _page = 1; await LoadAsync(); }

    private async Task DeleteBurAsync(BudgetUtilizationRequestListItemDto item)
    {
        if (!await DialogService.ShowDeleteConfirmAsync($"BUR {item.BurNumber}")) return;
        _busy = true;
        try { await Client.DeleteAsync(item.Id); Snackbar.Add("BUR deleted.", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ObligateAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Obligate BUR", "Obligate this budget utilization request and status?", "Obligate", cancelText: "Cancel");
        if (ok is not true) return;
        _busy = true;
        try { await Client.ObligateAsync(id); Snackbar.Add("BUR obligated.", Severity.Success); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add($"Obligate failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task CancelBurAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Cancel BUR", "Cancel this budget utilization request and status?", "Yes, Cancel", cancelText: "No");
        if (ok is not true) return;
        _busy = true;
        try { await Client.CancelAsync(id, "Cancelled by user."); Snackbar.Add("BUR cancelled.", Severity.Info); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ViewDetailsAsync(Guid id)
    {
        _detail = await Client.GetAsync(id);
    }

    private async Task OpenSignedCopyAsync(BudgetUtilizationRequestListItemDto item)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, AMIS.Modules.BudgetDisbursement.Contracts.v1.SignedDocuments.BudgetDisbursementDocumentType.BudgetUtilizationRequest },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.BurNumber) ? "(no BUR number)" : item.BurNumber },
            { x => x.IsTerminalState, true }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == item.Id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    private async Task DownloadPdfAsync(Guid id)
    {
        _busy = true;
        try
        {
            var bytes = await Client.GetPdfAsync(id);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
        }
        catch (Exception ex) { Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private static RenderFragment BurStatusChip(BudgetUtilizationRequestStatus status) => __builder =>
    {
        var (color, icon) = status switch
        {
            BudgetUtilizationRequestStatus.Draft => (Color.Default, Icons.Material.Filled.Edit),
            BudgetUtilizationRequestStatus.Obligated => (Color.Info, Icons.Material.Filled.AccountBalance),
            BudgetUtilizationRequestStatus.Utilized => (Color.Success, Icons.Material.Filled.CheckCircle),
            BudgetUtilizationRequestStatus.Cancelled => (Color.Error, Icons.Material.Filled.Cancel),
            _ => (Color.Default, Icons.Material.Filled.Help)
        };
        __builder.OpenComponent<MudChip<string>>(0);
        __builder.AddAttribute(1, "Size", Size.Small);
        __builder.AddAttribute(2, "Color", color);
        __builder.AddAttribute(3, "Icon", icon);
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, status.ToString())));
        __builder.CloseComponent();
    };
}

