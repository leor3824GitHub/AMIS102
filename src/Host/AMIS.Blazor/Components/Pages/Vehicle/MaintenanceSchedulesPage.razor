@page "/vehicle/maintenance/schedules"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Modules.Vehicle.Contracts.v1.Maintenance
@using AMIS.Modules.Vehicle.Contracts.v1.Vehicles
@using AMIS.Modules.Vehicle.Contracts.Permissions
@inject IVehicleClient VehicleClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Maintenance Schedules" Description="Plan and manage recurring maintenance" />

<MudGrid Spacing="3">
    <!-- List Panel - Full Width -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <!-- Filter toolbar: type search + vehicle / status (date range not applicable) -->
                <AMISFilterBar Keyword="@_query.MaintenanceType" KeywordChanged="OnTypeChanged"
                               SearchLabel="Type" SearchPlaceholder="Search by type"
                               ShowDateRange="false"
                               SearchSm="6" SearchMd="4">
                    <Extra>
                        <MudItem xs="12" sm="6" md="4">
                            <MudAutocomplete T="VehicleDto" Value="_query.SelectedVehicle" ValueChanged="OnVehicleChanged" Label="Vehicle"
                                             Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                             SearchFunc="@SearchVehicles" ToStringFunc="@(v => v == null ? null : $"{v.PlateNumber} - {v.Make} {v.Model} ({v.Year})")"
                                             Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="bool?" Value="_query.IsActive" ValueChanged="OnStatusChanged" Label="Status"
                                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true">
                                <MudSelectItem T="bool?" Value="@((bool?)true)">Active</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)false)">Inactive</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </Extra>
                </AMISFilterBar>

                <!-- Status summary chips + primary action -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Total: @_items.Count</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">Active: @_items.Count(s => s.IsActive)</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">Inactive: @_items.Count(s => !s.IsActive)</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error">Overdue: @_items.Count(IsOverdue)</MudChip>
                    <MudSpacer />
                    @if (_canCreate)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog" Disabled="_busy"
                                   Title="Plan a recurring maintenance schedule">
                            NEW SCHEDULE
                        </MudButton>
                    }
                </MudStack>

                <AMISDataTable T="MaintenanceScheduleDto" Items="_items" Loading="_busy"
                               RowClassFunc="@((row, _) => IsOverdue(row) ? "overdue-row" : string.Empty)"
                               EmptyMessage="No maintenance schedules found."
                               EmptyDescription="Plan a recurring maintenance schedule to get started.">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>Due Date</MudTh>
                        <MudTh>Due Mileage</MudTh>
                        <MudTh>Active</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Type">@context.MaintenanceType</MudTd>
                        <MudTd DataLabel="Due Date">
                            @if (context.DueDate is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(IsOverdue(context) ? Color.Error : Color.Default)">
                                    @context.DueDate.Value.ToString("yyyy-MM-dd")
                                </MudChip>
                            }
                            else
                            {
                                <MudText>-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Due Mileage">@(context.DueMileage?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Active"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip></MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                @if (context.IsActive && _canUpdate)
                                {
                                    <MudTooltip Text="Deactivate schedule">
                                        <MudIconButton Icon="@Icons.Material.Filled.PauseCircle" Color="Color.Warning" Size="Size.Small"
                                                       OnClick="@(() => Deactivate(context.Id))" Disabled="_busy" />
                                    </MudTooltip>
                                }
                                @if (_canDelete)
                                {
                                    <MudTooltip Text="Delete schedule">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => Delete(context.Id))" Disabled="_busy" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    .overdue-row {
        background-color: rgba(244, 67, 54, 0.08);
    }
</style>

@code {
    private readonly List<MaintenanceScheduleDto> _items = [];
    private ScheduleQueryModel _query = new();
    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;
    private bool _busy;

    private bool _canCreate => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Delete);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await Load();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    private async Task<IEnumerable<VehicleDto>> SearchVehicles(string value, CancellationToken ct)
    {
        try
        {
            var result = await VehicleClient.SearchVehiclesAsync(new SearchVehiclesQuery
            {
                Keyword = string.IsNullOrWhiteSpace(value) ? null : value,
                PageNumber = 1,
                PageSize = 20
            }, ct);

            return result.Items ?? [];
        }
        catch (OperationCanceledException)
        {
            return [];
        }
    }

    private async Task Load()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            _busy = true;
            var items = await VehicleClient.SearchMaintenanceSchedulesAsync(new MaintenanceScheduleSearchRequest(
                _query.MaintenanceType,
                _query.SelectedVehicle?.Id,
                _query.IsActive), _cts.Token);

            _items.Clear();
            _items.AddRange(items);
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled requests during navigation/dispose.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add($"Failed to load schedules: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<MaintenanceScheduleFormDialog>("Create Schedule", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await Load();
        }
    }

    private async Task Deactivate(Guid id) => await Do(async () => await VehicleClient.DeactivateMaintenanceScheduleAsync(id), "Schedule deactivated.");
    private async Task Delete(Guid id)
    {
        if (!await DialogService.ShowDeleteConfirmAsync("this maintenance schedule"))
            return;

        await Do(async () => await VehicleClient.DeleteMaintenanceScheduleAsync(id), "Schedule deleted.");
    }

    private async Task Do(Func<Task> action, string success)
    {
        try
        {
            _busy = true;
            await action();

            if (_disposed)
            {
                return;
            }

            Snackbar.Add(success, Severity.Success);
            await Load();
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled requests during navigation/dispose.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsOverdue(MaintenanceScheduleDto schedule) => schedule.DueDate.HasValue && schedule.DueDate.Value < DateOnly.FromDateTime(DateTime.Today);

    private async Task OnTypeChanged(string? value)
    {
        _query.MaintenanceType = value;
        await Load();
    }

    private async Task OnVehicleChanged(VehicleDto? vehicle)
    {
        _query.SelectedVehicle = vehicle;
        await Load();
    }

    private async Task OnStatusChanged(bool? isActive)
    {
        _query.IsActive = isActive;
        await Load();
    }

    public void Dispose()
    {
        UserProfileState.OnProfileChanged -= OnProfileChanged;
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }

    private sealed class ScheduleQueryModel
    {
        public VehicleDto? SelectedVehicle { get; set; }
        public string? MaintenanceType { get; set; }
        public bool? IsActive { get; set; }
    }
}

