@using AMIS.Blazor.ApiClient
@using AMIS.Modules.Vehicle.Contracts.v1.Vehicles
@inject IVehicleClient VehicleClient
@inject IArRepairClient RepairClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.caption" Class="font-weight-bold">Request Pre/Post Repair Inspection (RPRI)</MudText>
            <MudSelect T="VehicleDto" @bind-Value="_vehicle" Label="Vehicle" Required="true"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                       ToStringFunc="@(v => v is null ? string.Empty : $"{v.PlateNumber} — {v.Make} {v.Model} ({v.PropertyNo})")">
                @foreach (var v in _vehicles)
                {
                    <MudSelectItem Value="@v">@v.PlateNumber — @v.Make @v.Model (@v.PropertyNo)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_natureOfWork" Label="Nature & Scope of Work" Lines="2" Required="true"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_parts" Label="Parts to be Supplied / Replaced" Lines="2"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_requestedBy" Label="Requested By" Required="true"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudDatePicker @bind-Date="_requestedOn" Label="Date Requested" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_saving">Request Repair</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private List<VehicleDto> _vehicles = [];
    private VehicleDto? _vehicle;
    private string _natureOfWork = string.Empty;
    private string? _parts;
    private string _requestedBy = string.Empty;
    private DateTime? _requestedOn = DateTime.Today;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await VehicleClient.SearchVehiclesAsync(new SearchVehiclesQuery { PageNumber = 1, PageSize = 200 });
            _vehicles = result.Items?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load vehicles: {ex.Message}", Severity.Error);
        }
    }

    private async Task Submit()
    {
        if (_vehicle is null || string.IsNullOrWhiteSpace(_natureOfWork) || string.IsNullOrWhiteSpace(_requestedBy) || _requestedOn is null)
        {
            Snackbar.Add("Vehicle, nature of work, requested by, and date are required.", Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            await RepairClient.RequestAsync(new ArRequestRepairRequest(
                _vehicle.AssetRegistryId,
                _natureOfWork,
                _requestedBy,
                DateOnly.FromDateTime(_requestedOn.Value),
                _parts,
                _vehicle.MotorNumber,
                _vehicle.ChassisNumber,
                _vehicle.Odometer));

            Snackbar.Add("Repair requested (RPRI created).", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Request failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
