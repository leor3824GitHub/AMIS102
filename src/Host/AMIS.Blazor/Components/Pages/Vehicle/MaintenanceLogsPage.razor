@page "/vehicle/maintenance/logs"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Modules.Vehicle.Contracts.v1.Maintenance
@using AMIS.Modules.Vehicle.Contracts.v1.Vehicles
@using AMIS.Modules.Vehicle.Contracts.Permissions
@inject IVehicleClient VehicleClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Maintenance Logs" Description="Record completed maintenance activities" />

<MudGrid Spacing="3">
    <!-- List Panel - Full Width -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <!-- Filter toolbar: type search + date range + vehicle / schedule.
                     Four filters share one md row, so each takes 3 of the 12 columns (3+3+3+3). -->
                <AMISFilterBar Keyword="@_query.MaintenanceType" KeywordChanged="OnTypeChanged"
                               SearchLabel="Type" SearchPlaceholder="Search by type"
                               FromDate="_query.FromDate" FromDateChanged="OnFromChanged"
                               ToDate="_query.ToDate" ToDateChanged="OnToChanged"
                               SearchSm="6" SearchMd="3"
                               DateRangeSm="6" DateRangeMd="3">
                    <Extra>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete T="VehicleDto" Value="_query.SelectedVehicle" ValueChanged="OnVehicleChanged" Label="Vehicle"
                                             Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                             SearchFunc="@SearchVehicles" ToStringFunc="@(v => v == null ? null : $"{v.PlateNumber} - {v.Make} {v.Model} ({v.Year})")"
                                             Clearable="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField T="string" Value="_query.ScheduleIdText" ValueChanged="OnScheduleIdChanged"
                                          Label="Schedule Id" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                          Immediate="true" DebounceInterval="400" Clearable="true" />
                        </MudItem>
                    </Extra>
                </AMISFilterBar>

                <!-- Summary chips + primary action -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Total: @_items.Count</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">Total Cost: &#8369;@_items.Sum(l => l.Cost ?? 0m).ToString("N2")</MudChip>
                    <MudSpacer />
                    @if (_canCreate)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog"
                                   Title="Record a maintenance activity">
                            NEW LOG
                        </MudButton>
                    }
                </MudStack>

                <AMISDataTable T="MaintenanceLogDto" Items="_items" Loading="_loading"
                               EmptyMessage="No maintenance logs found."
                               EmptyDescription="Record a maintenance activity to get started.">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Vehicle</MudTh>
                        <MudTh>Odometer</MudTh>
                        <MudTh>Performed By</MudTh>
                        <MudTh>Cost</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.PerformedDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="Type">@context.MaintenanceType</MudTd>
                        <MudTd DataLabel="Vehicle">@context.VehicleId</MudTd>
                        <MudTd DataLabel="Odometer">@(context.OdometerAtService?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Performed By">@(string.IsNullOrWhiteSpace(context.PerformedBy) ? "-" : context.PerformedBy)</MudTd>
                        <MudTd DataLabel="Cost">@(context.Cost?.ToString("N2") ?? "-")</MudTd>
                        <MudTd DataLabel="Actions">
                            @if (_canDelete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => Delete(context.Id))" />
                            }
                        </MudTd>
                    </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private readonly List<MaintenanceLogDto> _items = [];
    private LogQueryModel _query = new();
    private bool _loading;

    private bool _canCreate => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Create);
    private bool _canDelete => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Delete);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await Load();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task<IEnumerable<VehicleDto>> SearchVehicles(string value, CancellationToken ct)
    {
        try
        {
            var result = await VehicleClient.SearchVehiclesAsync(new SearchVehiclesQuery
            {
                Keyword = string.IsNullOrWhiteSpace(value) ? null : value,
                PageNumber = 1,
                PageSize = 20
            }, ct);

            return result.Items ?? [];
        }
        catch (OperationCanceledException)
        {
            return [];
        }
    }

    private async Task Load()
    {
        try
        {
            _loading = true;

            var items = await VehicleClient.SearchMaintenanceLogsAsync(new MaintenanceLogSearchRequest(
                _query.MaintenanceType,
                _query.SelectedVehicle?.Id,
                ParseGuid(_query.ScheduleIdText),
                ToDateOnly(_query.FromDate),
                ToDateOnly(_query.ToDate)));

            _items.Clear();
            _items.AddRange(items);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load maintenance logs: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<MaintenanceLogFormDialog>("Log Maintenance", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await Load();
        }
    }

    private async Task Delete(Guid id)
    {
        if (!await DialogService.ShowDeleteConfirmAsync("this maintenance log"))
            return;

        try
        {
            await VehicleClient.DeleteMaintenanceLogAsync(id);
            Snackbar.Add("Log deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Guid? ParseGuid(string? text) => Guid.TryParse(text, out var value) ? value : null;
    private static DateOnly? ToDateOnly(DateTime? date) => date.HasValue ? DateOnly.FromDateTime(date.Value) : null;

    private async Task OnTypeChanged(string? value)
    {
        _query.MaintenanceType = value;
        await Load();
    }

    private async Task OnFromChanged(DateTime? date)
    {
        _query.FromDate = date;
        await Load();
    }

    private async Task OnToChanged(DateTime? date)
    {
        _query.ToDate = date;
        await Load();
    }

    private async Task OnVehicleChanged(VehicleDto? vehicle)
    {
        _query.SelectedVehicle = vehicle;
        await Load();
    }

    private async Task OnScheduleIdChanged(string? value)
    {
        _query.ScheduleIdText = value;
        await Load();
    }

    private sealed class LogQueryModel
    {
        public VehicleDto? SelectedVehicle { get; set; }
        public string? ScheduleIdText { get; set; }
        public string? MaintenanceType { get; set; }
        public DateTime? FromDate { get; set; }
        public DateTime? ToDate { get; set; }
    }
}

