@page "/vehicle/fuel-odometer"
@implements IDisposable
@using AMIS.Framework.Shared.Persistence
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Modules.Vehicle.Contracts.v1.Vehicles
@using AMIS.Modules.Vehicle.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@inject IVehicleClient VehicleClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Fuel & Odometer Monitoring"
               Description="Track and monitor daily fuel usage and odometer movement per vehicle" />

<div class="mt-4">
    @if (_selectedVehicle is not null)
    {
        <MudStack Row="true" Spacing="1" Class="mb-3" Wrap="Wrap.Wrap">
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">Records: @_summary.RecordCount</MudChip>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Distance: @_summary.TotalDistanceKm km
            </MudChip>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">Fuel:
                @_summary.TotalFuelLiters.ToString("N3") L</MudChip>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">Fuel Cost:
                    &#8369;@_summary.TotalFuelCost.ToString("N2")</MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Avg km/L:
                        @_summary.AverageKmPerLiter.ToString("N2")</MudChip>
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Avg Cost/km:
                            &#8369;@_summary.AverageCostPerKm.ToString("N2")</MudChip>
                        </MudStack>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard Class="AMIS-card">
                                <MudCardContent>
                                    <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudAutocomplete T="VehicleDto" Label="Vehicle" Value="_selectedVehicle"
                                                         ValueChanged="OnVehicleChanged" SearchFunc="SearchVehicles"
                                                         ToStringFunc="@(v => v is null ? string.Empty : $"{v.PlateNumber} - {v.Make} {v.Model}")"
                                                         Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true" />
                                        <AMISDateRangePicker @bind-FromDate="_fromDate" @bind-ToDate="_toDate"
                                                             DateFormat="yyyy-MM-dd" />
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadData"
                                                   Disabled="_busy || _selectedVehicle is null">Refresh</MudButton>
                                        @if (_canRecord)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                                                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRecordDialog"
                                                       Disabled="_busy || _selectedVehicle is null">Record</MudButton>
                                        }
                                    </MudStack>

                                    @if (_selectedVehicle is null)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Select a vehicle above to view usage records.</MudAlert>
                                    }
                                    else
                                    {
                                        <AMISDataTable T="VehicleDailyUsageDto" Items="_rows" Loading="_busy"
                                                       EmptyMessage="No usage records found for the selected period."
                                                       EmptyDescription="Record fuel or odometer readings, or widen the date range.">
                                            <HeaderContent>
                                                <MudTh>Date</MudTh>
                                                <MudTh>Start (km)</MudTh>
                                                <MudTh>End (km)</MudTh>
                                                <MudTh>Distance</MudTh>
                                                <MudTh>Fuel (L)</MudTh>
                                                <MudTh>Cost (&#8369;)</MudTh>
                                                <MudTh>km/L</MudTh>
                                                <MudTh>Cost/km</MudTh>
                                                <MudTh>Destination</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                                                <MudTd DataLabel="Start (km)">@context.OdometerStart.ToString("N0")</MudTd>
                                                <MudTd DataLabel="End (km)">@context.OdometerEnd.ToString("N0")</MudTd>
                                                <MudTd DataLabel="Distance">@context.DistanceKm.ToString("N0")</MudTd>
                                                <MudTd DataLabel="Fuel (L)">@context.FuelLiters.ToString("N3")</MudTd>
                                                <MudTd DataLabel="Cost">@context.FuelCost.ToString("N2")</MudTd>
                                                <MudTd DataLabel="km/L">@context.KmPerLiter.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Cost/km">@context.CostPerKm.ToString("N2")</MudTd>
                                                <MudTd DataLabel="Destination">
                                                    @if (!string.IsNullOrWhiteSpace(context.Remarks))
                                                    {
                                                        <MudTooltip Text="@context.Remarks">
                                                            <span>@(context.Destination ?? "-") *</span>
                                                        </MudTooltip>
                                                    }
                                                    else
                                                    {
                                                        @(context.Destination ?? "-")
                                                    }
                                                </MudTd>
                                            </RowTemplate>
                                        </AMISDataTable>
                                    }
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                </MudGrid>
                            </div>

@code {
    private bool _busy;
    private VehicleDto? _selectedVehicle;

    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;

    private readonly List<VehicleDailyUsageDto> _rows = [];
    private VehicleDailyUsageSummaryDto _summary = new(0, 0, 0m, 0m, 0m, 0m, 0m);

    private bool _canCreate => UserProfileState.Permissions.Contains(VehiclePermissions.FuelOdometer.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(VehiclePermissions.FuelOdometer.Update);
    private bool _canRecord => _canCreate || _canUpdate;

    protected override Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        ResetViewForNoVehicle();
        return Task.CompletedTask;
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task<IEnumerable<VehicleDto>> SearchVehicles(string value, CancellationToken token)
    {
        try
        {
            var result = await VehicleClient.SearchVehiclesAsync(new SearchVehiclesQuery
            {
                Keyword = string.IsNullOrWhiteSpace(value) ? null : value,
                PageNumber = 1,
                PageSize = 20
            }, token);

            return result.Items ?? [];
        }
        catch (OperationCanceledException)
        {
            return [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load vehicles: {ex.Message}", Severity.Error);
            return [];
        }
    }

    private Task OnVehicleChanged(VehicleDto? vehicle)
    {
        _selectedVehicle = vehicle;
        return LoadData();
    }

    private async Task OpenRecordDialog()
    {
        if (!_canRecord || _selectedVehicle is null)
            return;

        var parameters = new DialogParameters { ["Vehicle"] = _selectedVehicle };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<VehicleDailyUsageFormDialog>("Record Daily Usage", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        try
        {
            if (_selectedVehicle is null)
            {
                ResetViewForNoVehicle();
                return;
            }

            _busy = true;

            var query = new SearchVehicleDailyUsageQuery
            {
                VehicleId = _selectedVehicle.Id,
                DateFrom = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value.Date) : null,
                DateTo = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value.Date) : null,
                PageNumber = 1,
                PageSize = 200
            };

            var result = await VehicleClient.SearchVehicleDailyUsageAsync(query);
            _rows.Clear();
            _rows.AddRange(result.Items ?? []);

            var summaryQuery = new GetVehicleDailyUsageSummaryQuery
            {
                VehicleId = _selectedVehicle.Id,
                DateFrom = query.DateFrom,
                DateTo = query.DateTo
            };
            _summary = await VehicleClient.GetVehicleDailyUsageSummaryAsync(summaryQuery);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load records: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void ResetViewForNoVehicle()
    {
        _rows.Clear();
        _summary = new VehicleDailyUsageSummaryDto(0, 0, 0m, 0m, 0m, 0m, 0m);
    }
}

