@page "/expendable/warehouse"
@using AMIS.Framework.Blazor.UI.Components.Cards
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Services
@inherits ComponentBase
@inject ISnackbar Snackbar
@inject IInventoryClient InventoryClient
@inject IInventoryDataService InventoryData

<AMISPageHeader Title="Warehouse" Description="Inventory stock levels">
    <ActionContent>
        <HelpLinkButton Href="/help/expendable/03-warehouse-and-reports" />
    </ActionContent>
</AMISPageHeader>

<div class="mt-4">
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

        <!-- ===== INVENTORY TAB ===== -->
        <MudTabPanel Text="Inventory" Icon="@Icons.Material.Filled.Inventory2">

            <!-- Filters -->
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="5">
                        <MudAutocomplete T="WarehouseOption"
                                         Label="Warehouse"
                                         Value="_invWarehouse"
                                         SearchFunc="@SearchWarehouses"
                                         ToStringFunc="@(w => w?.Name ?? string.Empty)"
                                         CoerceValue="true"
                                         Clearable="true"
                                         Placeholder="All warehouses"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         ValueChanged="@(async (WarehouseOption? w) => { _invWarehouse = w; await (_invTable?.ReloadServerData() ?? Task.CompletedTask); })" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="_invSearch" Placeholder="Search by product name..."
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                      DebounceInterval="400" OnDebounceIntervalElapsed="() => _invTable?.ReloadServerData()" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   OnClick="ClearInvFilters">Clear</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <AMISDataTable @ref="_invTable" T="ProductInventoryDto" ServerData="@LoadInventory"
                           EmptyMessage="No inventory records found." Elevation="2">
                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Product</MudTh>
                    <MudTh>Warehouse</MudTh>
                    <MudTh Style="text-align:center">On Hand</MudTh>
                    <MudTh Style="text-align:center">Available</MudTh>
                    <MudTh Style="text-align:center">Reserved</MudTh>
                    <MudTh Style="text-align:center">Issued</MudTh>
                    <MudTh Style="text-align:right">Avg Cost</MudTh>
                    <MudTh Style="text-align:right">Total Value</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">
                        <MudText Typo="Typo.caption" Style="font-family:monospace">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="Product">@context.ProductName</MudTd>
                    <MudTd DataLabel="Warehouse">
                        <MudText Typo="Typo.body2">@context.WarehouseLocationName</MudText>
                    </MudTd>
                    <MudTd DataLabel="On Hand" Style="text-align:center">
                        <MudChip T="string" Size="Size.Small" Color="@(context.QuantityOnHand > 0 ? Color.Primary : Color.Default)">
                            @context.QuantityOnHand
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Available" Style="text-align:center">@context.QuantityAvailable</MudTd>
                    <MudTd DataLabel="Reserved" Style="text-align:center">
                        @if (context.QuantityReserved > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.QuantityReserved</MudChip>
                        }
                        else { <MudText>0</MudText> }
                    </MudTd>
                    <MudTd DataLabel="Issued" Style="text-align:center">@context.QuantityIssued</MudTd>
                    <MudTd DataLabel="Avg Cost" Style="text-align:right">$@context.AverageUnitPrice.ToString("F4")</MudTd>
                    <MudTd DataLabel="Total Value" Style="text-align:right">$@context.TotalValue.ToString("F2")</MudTd>
                    <MudTd DataLabel="Status">
                        @{
                            var (sc, si) = context.Status switch
                            {
                                "Active"       => (Color.Success, Icons.Material.Filled.CheckCircle),
                                "Discontinued" => (Color.Warning, Icons.Material.Filled.Block),
                                "Archived"     => (Color.Default, Icons.Material.Filled.Archive),
                                _              => (Color.Default, Icons.Material.Filled.Help),
                            };
                        }
                        <MudChip T="string" Size="Size.Small" Color="@sc" Icon="@si">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">N/A</MudText>
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

        <!-- ===== LOW STOCK TAB ===== -->
        <MudTabPanel Text="Low Stock" Icon="@Icons.Material.Filled.ReportProblem">

            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <div class="d-flex align-center" style="gap:12px;">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem"
                             Color="@(_lowStock.Count > 0 ? Color.Warning : Color.Success)" />
                    <MudText Typo="Typo.subtitle1">
                        @if (_lowStockLoading)
                        {
                            <text>Checking stock levels…</text>
                        }
                        else if (_lowStock.Count == 0)
                        {
                            <text>All active products are above their minimum stock level.</text>
                        }
                        else
                        {
                            <text><b>@_lowStock.Count</b> product@(_lowStock.Count == 1 ? "" : "s") at or below minimum stock — reorder recommended.</text>
                        }
                    </MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadLowStock">Refresh</MudButton>
                </div>
            </MudPaper>

            <AMISDataTable T="LowStockProductItem" Items="_lowStock" Loading="_lowStockLoading"
                           EmptyMessage="No products below minimum stock." RowsPerPage="15" Elevation="2">
                <HeaderContent>
                    <MudTh>Stock No.</MudTh>
                    <MudTh>Article</MudTh>
                    <MudTh>Product</MudTh>
                    <MudTh Style="text-align:center">On Hand</MudTh>
                    <MudTh Style="text-align:center">Minimum</MudTh>
                    <MudTh Style="text-align:center">Suggested Reorder</MudTh>
                    <MudTh>UoM</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Stock No.">
                        <MudText Typo="Typo.caption" Style="font-family:monospace">@context.StockNo</MudText>
                    </MudTd>
                    <MudTd DataLabel="Article">@context.Article</MudTd>
                    <MudTd DataLabel="Product">@context.Name</MudTd>
                    <MudTd DataLabel="On Hand" Style="text-align:center">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.QuantityOnHand <= 0 ? Color.Error : Color.Warning)">
                            @context.QuantityOnHand
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Minimum" Style="text-align:center">@context.MinimumStockLevel</MudTd>
                    <MudTd DataLabel="Suggested Reorder" Style="text-align:center">@context.ReorderQuantity</MudTd>
                    <MudTd DataLabel="UoM">@context.UnitOfMeasure</MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    private record WarehouseOption(Guid Id, string Name);

    // ===== STATE =====
    private List<WarehouseOption> _warehouses = [];

    // Inventory tab
    private AMISDataTable<ProductInventoryDto>? _invTable;

    private WarehouseOption? _invWarehouse;
    private string _invSearch = string.Empty;

    // Low-stock tab
    private List<LowStockProductItem> _lowStock = [];
    private bool _lowStockLoading;

    // ===== LIFECYCLE =====

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadWarehouses(), LoadLowStock());
    }

    private async Task LoadLowStock()
    {
        try
        {
            _lowStockLoading = true;
            _lowStock = (await InventoryData.GetLowStockProductsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load low-stock products: {ex.Message}", Severity.Error);
            _lowStock = [];
        }
        finally
        {
            _lowStockLoading = false;
        }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var locations = await InventoryData.GetWarehouseLocationsAsync();
            _warehouses = locations
                .Select(l => new WarehouseOption(
                    l.Id,
                    string.IsNullOrWhiteSpace(l.Name) ? $"Warehouse {l.Id.ToString()[..8]}…" : l.Name))
                .ToList();
        }
        catch { _warehouses = []; }
    }

    // ===== AUTOCOMPLETE =====

    private Task<IEnumerable<WarehouseOption>> SearchWarehouses(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_warehouses.AsEnumerable());
        return Task.FromResult(
            _warehouses.Where(w => w.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    // ===== INVENTORY TABLE =====

    private async Task<TableData<ProductInventoryDto>> LoadInventory(TableState state, CancellationToken ct)
    {
        try
        {
            var result = await InventoryClient.SearchAsync(new SearchProductInventoryQuery
            {
                WarehouseLocationId = _invWarehouse?.Id,
                ProductName = string.IsNullOrWhiteSpace(_invSearch) ? null : _invSearch,
                PageNumber = state.Page + 1,
                PageSize = state.PageSize
            }, ct);

            return new TableData<ProductInventoryDto>
            {
                Items = result?.Items?.ToList() ?? [],
                TotalItems = (int)(result?.TotalCount ?? 0)
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load inventory: {ex.Message}", Severity.Error);
            return new TableData<ProductInventoryDto> { Items = [], TotalItems = 0 };
        }
    }

    private void ClearInvFilters()
    {
        _invWarehouse = null;
        _invSearch = string.Empty;
        _invTable?.ReloadServerData();
    }
}

