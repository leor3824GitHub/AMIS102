@page "/expendable/requests"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Cards
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Components.Pages.Procurement
@using AMIS.Modules.Expendable.Contracts.Permissions
@inherits ComponentBase
@inject ISnackbar Snackbar
@inject IExpendableClient ExpendableClient
@inject ISupply_requestsClient SupplyRequestsClient
@inject IInventoryClient InventoryClient
@inject ILookupClient LookupClient
@inject ILookupDataService LookupData
@inject IInventoryDataService InventoryData
@inject IJSRuntime JS
@inject IPdfDownloadService PdfDownload
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Supply Requests" Description="Supply officer — approve, fulfill, and track employee supply requests">
    <ActionContent>
        <HelpLinkButton Href="/help/expendable/02-approve-and-issue" />
    </ActionContent>
</AMISPageHeader>

<div class="mt-4">
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
             @bind-ActivePanelIndex="_activeTab">

        <!-- ===== PENDING APPROVAL ===== -->
        <MudTabPanel Text="Pending Approval" Icon="@Icons.Material.Filled.HourglassTop" BadgeData="@_pendingCount" BadgeColor="Color.Warning">
            <AMISDataTable @ref="_pendingTable" T="SupplyRequestDto"
                           ServerData="@(async (s, ct) => await LoadRequests(s, ct, "Submitted"))"
                           EmptyMessage="No pending requests."
                           EmptyDescription="Requests awaiting approval will appear here.">
                <HeaderContent>
                    <MudTh>Request #</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Items</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request #"><MudText Typo="Typo.body2" Style="font-weight:500">@context.RequestNumber</MudText></MudTd>
                    <MudTd DataLabel="Employee">@GetEmployeeName(context.EmployeeId)</MudTd>
                    <MudTd DataLabel="Department">@GetDepartmentName(context.DepartmentId)</MudTd>
                    <MudTd DataLabel="Date">@context.RequestDate.ToString("MMM d, yyyy")</MudTd>
                    <MudTd DataLabel="Items">@context.Items.Count item(s)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            @if (_canApprove)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="@(() => OpenApproveDialog(context))">Approve</MudButton>
                            }
                            @if (_canReject)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => OpenRejectDialog(context))">Reject</MudButton>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

        <!-- ===== APPROVED — AWAITING ISSUE ===== -->
        <MudTabPanel Text="Approved — Awaiting Issue" Icon="@Icons.Material.Filled.Inventory" BadgeData="@_approvedCount" BadgeColor="Color.Info">
            <AMISDataTable @ref="_approvedTable" T="SupplyRequestDto"
                           ServerData="@(async (s, ct) => await LoadRequests(s, ct, "Approved"))"
                           EmptyMessage="No approved requests awaiting issuance."
                           EmptyDescription="Approved requests ready to issue will appear here.">
                <HeaderContent>
                    <MudTh>Request #</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Items</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request #"><MudText Typo="Typo.body2" Style="font-weight:500">@context.RequestNumber</MudText></MudTd>
                    <MudTd DataLabel="Employee">@GetEmployeeName(context.EmployeeId)</MudTd>
                    <MudTd DataLabel="Department">@GetDepartmentName(context.DepartmentId)</MudTd>
                    <MudTd DataLabel="Date">@context.RequestDate.ToString("MMM d, yyyy")</MudTd>
                    <MudTd DataLabel="Items">@context.Items.Count item(s)</MudTd>
                    <MudTd DataLabel="Actions">
                        @if (_canFulfill)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.LocalShipping"
                                       OnClick="@(() => OpenFulfillDialog(context))">Issue</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

        <!-- ===== FULFILLED ===== -->
        <MudTabPanel Text="Fulfilled" Icon="@Icons.Material.Filled.TaskAlt">
            <AMISDataTable @ref="_fulfilledTable" T="SupplyRequestDto"
                           ServerData="@(async (s, ct) => await LoadRequests(s, ct, "Fulfilled"))"
                           EmptyMessage="No fulfilled requests yet."
                           EmptyDescription="Issued requests will appear here.">
                <HeaderContent>
                    <MudTh>Request #</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Date Issued</MudTh>
                    <MudTh>Items</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:center">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request #"><MudText Typo="Typo.body2" Style="font-weight:500">@context.RequestNumber</MudText></MudTd>
                    <MudTd DataLabel="Employee">@GetEmployeeName(context.EmployeeId)</MudTd>
                    <MudTd DataLabel="Department">@GetDepartmentName(context.DepartmentId)</MudTd>
                    <MudTd DataLabel="Date Issued">@(context.FulfilledOnUtc?.ToString("MMM d, yyyy") ?? context.ApprovedOnUtc?.ToString("MMM d, yyyy") ?? "-")</MudTd>
                    <MudTd DataLabel="Items">@context.Items.Count item(s)</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Done">
                            Issued
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:center">
                        @if (_canPrintRis)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Print" Color="Color.Secondary" Size="Size.Small"
                                     Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                     ToolTip="Print Requisition and Issue Slip">
                                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                             OnClick="@(() => DownloadRisQuestPdfAsync(context.Id))">
                                    View PDF (Quest)
                                </MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                             OnClick="@(() => OpenRisFastReportSetupAsync(context.Id))">
                                    Fast Report – Page Setup…
                                </MudMenuItem>
                            </MudMenu>
                        }
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

        <!-- ===== REJECTED ===== -->
        <MudTabPanel Text="Rejected" Icon="@Icons.Material.Filled.Block">
            <AMISDataTable @ref="_rejectedTable" T="SupplyRequestDto"
                           ServerData="@(async (s, ct) => await LoadRequests(s, ct, "Rejected"))"
                           EmptyMessage="No rejected requests."
                           EmptyDescription="Rejected requests will appear here.">
                <HeaderContent>
                    <MudTh>Request #</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Items</MudTh>
                    <MudTh>Reason</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Request #"><MudText Typo="Typo.body2" Style="font-weight:500">@context.RequestNumber</MudText></MudTd>
                    <MudTd DataLabel="Employee">@GetEmployeeName(context.EmployeeId)</MudTd>
                    <MudTd DataLabel="Department">@GetDepartmentName(context.DepartmentId)</MudTd>
                    <MudTd DataLabel="Date">@context.RequestDate.ToString("MMM d, yyyy")</MudTd>
                    <MudTd DataLabel="Items">@context.Items.Count item(s)</MudTd>
                    <MudTd DataLabel="Reason"><MudText Typo="Typo.caption" Color="Color.Error">@context.RejectionReason</MudText></MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

    </MudTabs>
</div>

<!-- ===== APPROVE DIALOG ===== -->
@if (_showApproveDialog && _approveDialog != null)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="1400">
        <MudPaper Class="pa-4" Elevation="24" Style="width: min(900px, 95vw); max-height: 90vh; overflow: auto;">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                Approve Request — @_approveDialog.RequestNumber
            </MudText>

            <MudStack Spacing="3">
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Employee</MudText>
                        <MudText Typo="Typo.body2">@GetEmployeeName(_approveDialog.EmployeeId)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Department</MudText>
                        <MudText Typo="Typo.body2">@GetDepartmentName(_approveDialog.DepartmentId)</MudText>
                    </MudItem>
                </MudGrid>

                <MudAutocomplete T="WarehouseOption"
                                 Label="Issue From Warehouse"
                                 @bind-Value="_selectedWarehouse"
                                 SearchFunc="@SearchWarehouses"
                                 ToStringFunc="@(wh => wh?.Name ?? string.Empty)"
                                 CoerceValue="true"
                                 Clearable="true"
                                 Variant="Variant.Outlined"
                                 Placeholder="@(_warehouses.Count == 0 ? "No warehouses in inventory yet" : "Search by warehouse name...")"
                                 HelperText="@(_warehouses.Count == 0 ? "Accept supply deliveries (Procurement IAR) to populate the warehouse list" : $"{_warehouses.Count} warehouse(s) available")" />

                <MudText Typo="Typo.subtitle2">Approve Quantities per Item</MudText>
                <MudTable Items="@_approveDialog.Items" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Product</MudTh>
                        <MudTh>Requested</MudTh>
                        <MudTh>Approve Qty</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Product">
                            <MudText Typo="Typo.body2">@GetProductName(context.ProductId)</MudText>
                        </MudTd>
                        <MudTd DataLabel="Requested">@context.RequestedQuantity</MudTd>
                        <MudTd DataLabel="Approve Qty">
                            <MudNumericField T="int"
                                            Value="@GetApproveQty(context.ProductId)"
                                            ValueChanged="@(v => SetApproveQty(context.ProductId, v))"
                                            Min="0" Max="@context.RequestedQuantity"
                                            Style="width: 100px" Dense="true" Margin="Margin.Dense" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton OnClick="@(() => _showApproveDialog = false)">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               OnClick="SubmitApproval" Disabled="@_isActioning">
                        @if (_isActioning) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Approve &amp; Reserve Stock
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

<!-- ===== REJECT DIALOG ===== -->
@if (_showRejectDialog && _rejectDialog != null)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="1400">
        <MudPaper Class="pa-4" Elevation="24" Style="width: min(560px, 95vw);">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Class="mr-2" />
                Reject Request — @_rejectDialog.RequestNumber
            </MudText>
            <MudTextField @bind-Value="_rejectReason" Label="Reason for Rejection" Lines="3"
                          Placeholder="Enter reason..." Variant="Variant.Outlined" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                <MudButton OnClick="@(() => _showRejectDialog = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           OnClick="SubmitRejection" Disabled="@_isActioning">
                    @if (_isActioning) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Reject Request
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

<!-- ===== FULFILL DIALOG ===== -->
@if (_showFulfillDialog && _fulfillDialog != null)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="1400">
        <MudPaper Class="pa-4" Elevation="24" Style="width: min(560px, 95vw);">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Class="mr-2" />
                Issue Supplies — @_fulfillDialog.RequestNumber
            </MudText>
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Stock was reserved at approval. Confirming will deduct from warehouse and record receipt in the employee's inventory.
                </MudAlert>
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Employee</MudText>
                        <MudText Typo="Typo.body2">@GetEmployeeName(_fulfillDialog.EmployeeId)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Department</MudText>
                        <MudText Typo="Typo.body2">@GetDepartmentName(_fulfillDialog.DepartmentId)</MudText>
                    </MudItem>
                </MudGrid>
                <MudDivider />
                @foreach (var item in _fulfillDialog.Items.Where(i => i.ApprovedQuantity > 0))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@GetProductName(item.ProductId)</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@item.ApprovedQuantity units</MudChip>
                    </MudStack>
                }
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                    <MudButton OnClick="@(() => _showFulfillDialog = false)">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SubmitFulfillment" Disabled="@_isActioning">
                        @if (_isActioning) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Confirm Issue
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private AMISDataTable<SupplyRequestDto>? _pendingTable;
    private AMISDataTable<SupplyRequestDto>? _approvedTable;
    private AMISDataTable<SupplyRequestDto>? _fulfilledTable;
    private AMISDataTable<SupplyRequestDto>? _rejectedTable;
    private int _activeTab;
    private int _pendingCount;
    private int _approvedCount;

    private record WarehouseOption(Guid Id, string Name);
    private List<WarehouseOption> _warehouses = [];
    private Dictionary<Guid, string> _productNames = [];
    private Dictionary<Guid, string> _employeeNames = [];
    private Dictionary<Guid, string> _departmentNames = [];

    private bool _showApproveDialog;
    private bool _showRejectDialog;
    private bool _showFulfillDialog;
    private bool _isActioning;

    private SupplyRequestDto? _approveDialog;
    private SupplyRequestDto? _rejectDialog;
    private SupplyRequestDto? _fulfillDialog;

    private WarehouseOption? _selectedWarehouse;
    private Dictionary<Guid, int> _approveQuantities = [];
    private string _rejectReason = string.Empty;

    private const string RisFastReportKey = "expendable-ris";
    private bool _canPrintRis => UserProfileState.Permissions.Contains(ExpendablePermissions.SupplyRequests.View);
    private bool _canApprove => UserProfileState.Permissions.Contains(ExpendablePermissions.SupplyRequests.Approve);
    private bool _canReject => UserProfileState.Permissions.Contains(ExpendablePermissions.SupplyRequests.Reject);
    private bool _canFulfill => UserProfileState.Permissions.Contains(ExpendablePermissions.SupplyRequests.Fulfill);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await Task.WhenAll(LoadWarehouses(), LoadDepartments());
    }

    // Permissions load asynchronously in AMISLayout after first render; re-render when they arrive
    // so permission-gated controls appear on a hard refresh without requiring a user interaction.
    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    // Resolves only the employees on the page just loaded — one batch call, no full-roster prefetch.
    private async Task LoadEmployeeNames(IEnumerable<SupplyRequestDto> requests)
    {
        var unknown = requests
            .Select(r => Guid.TryParse(r.EmployeeId, out var id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty && !_employeeNames.ContainsKey(id))
            .Distinct()
            .ToList();

        if (unknown.Count == 0) return;

        var employees = await LookupData.GetEmployeesByIdsAsync(unknown);
        foreach (var (id, employee) in employees)
            _employeeNames[id] = $"{employee.FirstName} {employee.LastName}";
    }

    private async Task LoadDepartments()
    {
        try
        {
            var departments = await LookupData.GetDepartmentsAsync();
            _departmentNames = departments.ToDictionary(d => d.Id, d => d.Name);
        }
        catch { _departmentNames = []; }
    }

    private async Task<TableData<SupplyRequestDto>> LoadRequests(TableState state, CancellationToken cancellationToken, string status)
    {
        try
        {
            var response = await SupplyRequestsClient.SearchAsync(new SearchSupplyRequestsQuery
            {
                Status = status,
                PageNumber = state.Page + 1,
                PageSize = state.PageSize
            });

            var items = response?.Items?.ToList() ?? [];

            if (status == "Submitted") _pendingCount = (int)(response?.TotalCount ?? 0);
            if (status == "Approved") _approvedCount = (int)(response?.TotalCount ?? 0);

            // Resolve the names this page needs — two batch calls, not one call per row.
            await Task.WhenAll(LoadProductNames(items), LoadEmployeeNames(items));
            StateHasChanged();

            return new TableData<SupplyRequestDto> { Items = items, TotalItems = (int)(response?.TotalCount ?? 0) };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load requests: {ex.Message}", Severity.Error);
            return new TableData<SupplyRequestDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var locations = await InventoryData.GetWarehouseLocationsAsync();
            _warehouses = locations
                .Select(l => new WarehouseOption(
                    l.Id,
                    string.IsNullOrWhiteSpace(l.Name) ? $"Warehouse {l.Id.ToString()[..8]}…" : l.Name))
                .ToList();
        }
        catch { _warehouses = []; }
    }

    private Task<IEnumerable<WarehouseOption>> SearchWarehouses(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_warehouses.AsEnumerable());
        return Task.FromResult(
            _warehouses.Where(w => w.Name.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task LoadProductNames(IEnumerable<SupplyRequestDto> requests)
    {
        var unknown = requests
            .SelectMany(r => r.Items.Select(i => i.ProductId))
            .Where(id => !_productNames.ContainsKey(id))
            .Distinct()
            .ToList();

        if (unknown.Count == 0) return;

        try
        {
            foreach (var product in await InventoryData.GetProductsByIdsAsync(unknown))
                _productNames[product.Id] = product.Name;
        }
        catch
        {
            foreach (var id in unknown)
                _productNames[id] = id.ToString()[..8] + "…";
        }
    }

    private string GetProductName(Guid productId) =>
        _productNames.TryGetValue(productId, out var name) ? name : productId.ToString()[..8] + "…";

    private string GetEmployeeName(string employeeId)
    {
        if (string.IsNullOrWhiteSpace(employeeId) || !Guid.TryParse(employeeId, out var id))
            return employeeId ?? "Unknown";
        return _employeeNames.TryGetValue(id, out var name) ? name : id.ToString()[..8] + "…";
    }

    private string GetDepartmentName(string departmentId)
    {
        if (string.IsNullOrWhiteSpace(departmentId) || !Guid.TryParse(departmentId, out var id))
            return departmentId ?? "Unknown";
        return _departmentNames.TryGetValue(id, out var name) ? name : id.ToString()[..8] + "…";
    }

    // ===== APPROVE =====

    private void OpenApproveDialog(SupplyRequestDto request)
    {
        _approveDialog = request;
        _approveQuantities = request.Items.ToDictionary(i => i.ProductId, i => i.RequestedQuantity);
        _selectedWarehouse = _warehouses.Count > 0 ? _warehouses[0] : null;
        _showApproveDialog = true;
    }

    private int GetApproveQty(Guid productId) =>
        _approveQuantities.TryGetValue(productId, out var qty) ? qty : 0;

    private void SetApproveQty(Guid productId, int value) =>
        _approveQuantities[productId] = value;

    private async Task SubmitApproval()
    {
        if (_approveDialog == null) return;

        var warehouseId = _selectedWarehouse?.Id ?? Guid.Empty;

        if (warehouseId == Guid.Empty)
        {
            Snackbar.Add("Please select or enter a warehouse.", Severity.Warning);
            return;
        }
        if (_approveQuantities.All(kvp => kvp.Value == 0))
        {
            Snackbar.Add("Approve at least one item with quantity > 0.", Severity.Warning);
            return;
        }

        _isActioning = true;
        try
        {
            var command = new ApproveSupplyRequestCommand
            {
                ApprovedQuantities = _approveQuantities.ToDictionary(kvp => kvp.Key.ToString(), kvp => kvp.Value),
                WarehouseLocationId = warehouseId
            };
            await SupplyRequestsClient.ApproveAsync(_approveDialog.Id, command);
            Snackbar.Add($"Request {_approveDialog.RequestNumber} approved — stock reserved.", Severity.Success);
            _showApproveDialog = false;
            await ReloadAllTables();
        }
        catch (Exception ex) { Snackbar.Add($"Approval failed: {ex.Message}", Severity.Error); }
        finally { _isActioning = false; }
    }

    // ===== REJECT =====

    private void OpenRejectDialog(SupplyRequestDto request)
    {
        _rejectDialog = request;
        _rejectReason = string.Empty;
        _showRejectDialog = true;
    }

    private async Task SubmitRejection()
    {
        if (_rejectDialog == null) return;

        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            Snackbar.Add("Rejection reason is required.", Severity.Warning);
            return;
        }

        _isActioning = true;
        try
        {
            await SupplyRequestsClient.RejectAsync(_rejectDialog.Id, new RejectSupplyRequestCommand { Reason = _rejectReason });
            Snackbar.Add($"Request {_rejectDialog.RequestNumber} rejected.", Severity.Info);
            _showRejectDialog = false;
            await ReloadAllTables();
        }
        catch (Exception ex) { Snackbar.Add($"Rejection failed: {ex.Message}", Severity.Error); }
        finally { _isActioning = false; }
    }

    // ===== FULFILL =====

    private void OpenFulfillDialog(SupplyRequestDto request)
    {
        _fulfillDialog = request;
        _showFulfillDialog = true;
    }

    private async Task SubmitFulfillment()
    {
        if (_fulfillDialog == null) return;
        _isActioning = true;
        try
        {
            // WarehouseLocationId stored at approval — pass null so server uses stored value
            await SupplyRequestsClient.FulfillAsync(_fulfillDialog.Id);
            Snackbar.Add($"Supplies issued for {_fulfillDialog.RequestNumber}.", Severity.Success);
            _showFulfillDialog = false;
            await ReloadAllTables();
        }
        catch (Exception ex) { Snackbar.Add($"Issuance failed: {ex.Message}", Severity.Error); }
        finally { _isActioning = false; }
    }

    // ===== FAST REPORT SETUP =====

    private async Task OpenRisFastReportSetupAsync(Guid id)
    {
        var saved = await FastReportSetupPrefs.GetAsync(RisFastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "longbond",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "portrait",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 1,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 12
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(RisFastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        try
        {
            var bytes = await SupplyRequestsClient.GetRISFastReportPdfAsync(id,
                pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            await PdfDownload.OpenInNewTabAsync(bytes);
            Snackbar.Add("RIS PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadRisQuestPdfAsync(Guid id)
    {
        try
        {
            // Note: This calls the Quest PDF endpoint for RIS
            // The endpoint is at api/v1/quest-pdf-reporting/expendable/...
            // For now, we'll use the Expendable client to get the RIS content
            // In the future, we may have a dedicated Quest RIS endpoint
            var bytes = await SupplyRequestsClient.GetRISFastReportPdfAsync(id, "longbond", "portrait");
            await PdfDownload.OpenInNewTabAsync(bytes);
            Snackbar.Add("RIS PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAllTables()
    {
        var tasks = new List<Task>();
        if (_pendingTable is not null) tasks.Add(_pendingTable.ReloadServerData());
        if (_approvedTable is not null) tasks.Add(_approvedTable.ReloadServerData());
        if (_fulfilledTable is not null) tasks.Add(_fulfilledTable.ReloadServerData());
        if (_rejectedTable is not null) tasks.Add(_rejectedTable.ReloadServerData());
        await Task.WhenAll(tasks);
    }
}

