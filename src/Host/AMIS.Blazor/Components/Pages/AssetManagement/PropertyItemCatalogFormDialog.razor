@using AMIS.Blazor.ApiClient
@inject IPropertyItemCatalogClient Client
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width:360px;">
            <MudTextField @bind-Value="_form.Code" Label="Item Code" Variant="Variant.Outlined"
                          MaxLength="50" Disabled="IsEditing" Required="true"
                          Dense="true" Margin="Margin.Dense"
                          Placeholder="e.g., AIT-CMP-001" />
            <MudTextField @bind-Value="_form.Name" Label="Item Name" Variant="Variant.Outlined"
                          MaxLength="200" Required="true" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Description" Label="Description" Variant="Variant.Outlined"
                          MaxLength="500" Lines="2" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.UACSObjectCode" Label="UACS Object Code (optional)" Variant="Variant.Outlined"
                          MaxLength="50" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.UnitOfMeasure" Label="Unit of Measure" Variant="Variant.Outlined"
                          MaxLength="50" Required="true" Dense="true" Margin="Margin.Dense"
                          Placeholder="e.g., pc, set, unit" />
            <MudNumericField @bind-Value="_form.EstimatedUsefulLifeYears" Label="Estimated Useful Life (years)"
                             Variant="Variant.Outlined" Min="1" Max="50" T="int?"
                             Dense="true" Margin="Margin.Dense" />
            @if (IsEditing)
            {
                <MudCheckBox @bind-Value="_form.IsActive" Label="Active" T="bool" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_busy">Cancel</AMISButton>
        <AMISButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
            @if (_busy) { <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" /> }
            @(IsEditing ? "Update" : "Create")
        </AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid? EditingId { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? UACSObjectCode { get; set; }
    [Parameter] public string? UnitOfMeasure { get; set; }
    [Parameter] public int? EstimatedUsefulLifeYears { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;

    private bool IsEditing => EditingId is not null;
    private bool _busy;

    private readonly FormModel _form = new();

    protected override void OnInitialized()
    {
        if (IsEditing)
        {
            _form.Code = Code ?? "";
            _form.Name = Name ?? "";
            _form.Description = Description;
            _form.UACSObjectCode = UACSObjectCode;
            _form.UnitOfMeasure = UnitOfMeasure ?? "Piece";
            _form.EstimatedUsefulLifeYears = EstimatedUsefulLifeYears;
            _form.IsActive = IsActive;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.UnitOfMeasure))
        {
            Snackbar.Add("Item Code, Name, and Unit of Measure are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            if (EditingId is null)
            {
                await Client.CreateForUiAsync(new CreatePropertyItemCatalogRequest(
                    _form.Code, _form.Name, _form.Description,
                    _form.UACSObjectCode, _form.UnitOfMeasure, _form.EstimatedUsefulLifeYears));
                Snackbar.Add("Catalog item created.", Severity.Success);
            }
            else
            {
                await Client.UpdateForUiAsync(EditingId.Value, new UpdatePropertyItemCatalogRequest(
                    _form.Code, _form.Name, _form.Description,
                    _form.UACSObjectCode, _form.UnitOfMeasure, _form.EstimatedUsefulLifeYears, _form.IsActive));
                Snackbar.Add("Catalog item updated.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? UACSObjectCode { get; set; }
        public string UnitOfMeasure { get; set; } = "Piece";
        public int? EstimatedUsefulLifeYears { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
