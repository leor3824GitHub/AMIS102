@page "/asset-management/item-catalog"
@implements IDisposable
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetManagement.Contracts.Permissions
@inject IPropertyItemCatalogClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Property Item Catalog"
               Description="Unified item catalog for all property types (semi-expendable and PPE). Capitalization threshold determines classification at receipt." />

<MudCard Elevation="1">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudTextField @bind-Value="_keyword" Label="Search" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                          OnKeyDown="OnSearchKeyDown" Style="flex:1;" />
            <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                        OnClick="LoadAsync" Disabled="_loading">Search</AMISButton>
            <MudSelect Value="_activeFilter" Label="Status" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                       T="bool?" Style="max-width:120px" ValueChanged="@(v => { _activeFilter = v; _ = LoadAsync(); })">
                <MudSelectItem T="bool?" Value="null">All</MudSelectItem>
                <MudSelectItem T="bool?" Value="true">Active</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Inactive</MudSelectItem>
            </MudSelect>
            @if (_canCreate)
            {
                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenCreateDialog" Disabled="_loading">New Catalog Item</AMISButton>
            }
        </MudStack>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>UOM</th>
                        <th>Useful Life</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td>@item.UnitOfMeasure</td>
                            <td>@(item.EstimatedUsefulLifeYears.HasValue ? $"{item.EstimatedUsefulLifeYears} yr(s)" : "-")</td>
                            <td>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(item.IsActive ? Color.Success : Color.Default)"
                                         Variant="Variant.Filled">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </MudChip>
                            </td>
                            <td>
                                @if (_canUpdate)
                                {
                                    <AMISIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                    Color="Color.Primary" OnClick="@(() => OpenEditDialog(item))" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="1">
                <MudText Typo="Typo.caption">@_totalCount items total</MudText>
                <MudSpacer />
                <MudPagination Count="@TotalPages" Selected="_page" ShowFirstButton="true" ShowLastButton="true"
                               SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<PropertyItemCatalogSummary> _items = [];
    private string? _keyword;
    private bool? _activeFilter = true;
    private bool _loading;
    private string? _error;
    private int _page = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetManagementPermissions.SemiExpendableItems.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetManagementPermissions.SemiExpendableItems.Update);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Client.SearchForUiAsync(_keyword, _activeFilter, _page, PageSize);
            _items = [.. response.Items];
            _totalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OpenCreateDialog() => OpenFormDialog(null);

    private Task OpenEditDialog(PropertyItemCatalogSummary item) => OpenFormDialog(item);

    private async Task OpenFormDialog(PropertyItemCatalogSummary? editing)
    {
        var parameters = new DialogParameters<PropertyItemCatalogFormDialog>
        {
            { x => x.EditingId, editing?.Id },
            { x => x.Code, editing?.Code },
            { x => x.Name, editing?.Name },
            { x => x.Description, editing?.Description },
            { x => x.UACSObjectCode, editing?.UACSObjectCode },
            { x => x.UnitOfMeasure, editing?.UnitOfMeasure },
            { x => x.EstimatedUsefulLifeYears, editing?.EstimatedUsefulLifeYears },
            { x => x.IsActive, editing?.IsActive ?? true }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var title = editing is null ? "New Catalog Item" : $"Edit: {editing.Code}";

        var dialog = await DialogService.ShowAsync<PropertyItemCatalogFormDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }
}
