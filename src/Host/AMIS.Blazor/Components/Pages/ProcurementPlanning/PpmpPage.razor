    private async Task PromoteToFinalAsync()
    {
        if (_editing is null) return;
        var confirmed = await DialogService.ShowMessageBox(
            "Promote to Final",
            $"Promote {_editing.PpmpNumber} to Final? A Final draft is created with the same items and the Indicative " +
            "version is superseded. Revise quantities and budgets to the GAA-approved allocation, then Save and Submit.",
            yesText: "Promote", cancelText: "Cancel");
        if (confirmed != true) return;
        _busy = true;
        try
        {
            _editing = await PpmpClient.PromoteToFinalAsync(_editing.Id);
            _versions = (await PpmpClient.GetVersionsAsync(_editing.VersionChainId)).ToList();
            _selectedVersionId = _editing.Id;
            PopulateForm(_editing);
            await LoadBaselineAsync();
            Snackbar.Add("Final draft created. Revise items to the approved allocation, then Save.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ShowCreateUpdateDialogAsync()
    {
        if (_editing is null) return;
        var parameters = new DialogParameters<AmendDialog>
        {
            { x => x.DocumentNumber, _editing.PpmpNumber },
            { x => x.CurrentVersion, _editing.VersionNumber }
        };
        var dialog = await DialogService.ShowAsync<AmendDialog>("Create Update PPMP", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string reason)
        {
            _busy = true;
            try
            {
                _editing = await PpmpClient.CreateUpdateAsync(_editing.Id, reason);
                _versions = (await PpmpClient.GetVersionsAsync(_editing.VersionChainId)).ToList();
                _selectedVersionId = _editing.Id;
                PopulateForm(_editing);
                await LoadBaselineAsync();
                Snackbar.Add($"Updated v{_editing.VersionNumber} created.", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
            finally { _busy = false; }
        }
    }

    // -- Filters (the table owns paging) -------------------------------
    private async Task OnFilterChanged(int? val) { _filterFiscalYear = val; await LoadAsync(); }
    private async Task OnStatusFilterChanged(PpmpStatus? val) { _filterStatus = val; await LoadAsync(); }

    // -- Helpers ------------------------------------------------------
    private RenderFragment StatusChip(PpmpStatus status) =>
        @<MudChip T="string" Size="Size.Small" Color="@StatusColor(status)" Icon="@StatusIcon(status)" Label="true">@status
        </MudChip>;

    private static Color StatusColor(PpmpStatus s) => s switch
    {
        PpmpStatus.Draft => Color.Default,
        PpmpStatus.Submitted => Color.Info,
        PpmpStatus.Approved => Color.Success,
        PpmpStatus.Consolidated => Color.Primary,
        PpmpStatus.Superseded => Color.Warning,
        PpmpStatus.Returned => Color.Error,
        _ => Color.Default
    };

    private static string StatusIcon(PpmpStatus s) => s switch
    {
        PpmpStatus.Draft => Icons.Material.Outlined.EditNote,
        PpmpStatus.Submitted => Icons.Material.Outlined.HourglassTop,
        PpmpStatus.Approved => Icons.Material.Filled.CheckCircle,
        PpmpStatus.Consolidated => Icons.Material.Filled.LibraryAddCheck,
        PpmpStatus.Superseded => Icons.Material.Outlined.History,
        PpmpStatus.Returned => Icons.Material.Filled.Undo,
        _ => Icons.Material.Outlined.Circle
    };
}

