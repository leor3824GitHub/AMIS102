@page "/procurement-planning/ppmps"
@implements IDisposable
@using AMIS.Modules.ProcurementPlanning.Contracts.v1.Ppmps
@using AMIS.Modules.ProcurementPlanning.Contracts.Permissions
@using AMIS.Modules.MasterData.Contracts.v1.FundingSourceCodes
@using AMIS.Framework.Shared.Persistence
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Components.Shared
@using AMIS.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IPpmpClient PpmpClient
@inject ILookupDataService LookupData
@inject IModeOfProcurementClient ModeOfProcurementClient
@inject IFundingSourceCodeClient FundingSourceCodeClient
@inject IOrganizationProfileClient OrgProfileClient
@inject ILookupClient LookupClient
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Project Procurement Management Plan (PPMP)"
               Description="Manage per-section procurement plans for the fiscal year">
    <ActionContent>
        <HelpLinkButton Href="/help/procurement-planning/01-ppmp" />
    </ActionContent>
</AMISPageHeader>

<!-- -- Add / Edit Line Item Dialog ---------------------------------- -->
<MudDialog @bind-Visible="_itemDialogOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_editingItemIdx.HasValue? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)"
                     Class="mr-2" Style="vertical-align:middle" />
            @(_editingItemIdx.HasValue ? "Edit Line Item" : "Add Line Item")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (ItemErrors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1 mb-2">
                <strong>@ItemErrors.Count field@(ItemErrors.Count == 1 ? "" : "s") need@(ItemErrors.Count == 1 ? "s" : "") attention:</strong>
                <ul style="margin:4px 0 0 18px; padding:0">
                    @foreach (var message in ItemErrors.Values)
                    {
                        <li>@message</li>
                    }
                </ul>
            </MudAlert>
        }
        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12">
                @* Plain multi-line text box (normal cursor/arrow/Home/End editing); previous descriptions are offered
                   as chips below instead of an autocomplete popover, which hijacked arrow keys and select-all on focus. *@
                <MudTextField T="string" @bind-Value="_itemForm.GeneralDescription" Label="Description / Objective"
                              Variant="Variant.Outlined" Required="true"
                              Lines="2" AutoGrow="true" MaxLines="5" MaxLength="1000" Counter="1000"
                              Immediate="true" DebounceInterval="200"
                              Margin="Margin.Dense"
                              Error="@HasItemError(nameof(PpmpItemFormModel.GeneralDescription))"
                              ErrorText="@ItemError(nameof(PpmpItemFormModel.GeneralDescription))"
                              HelperText="Type freely, or pick a previously used description below"
                              Placeholder="Describe the procurement item or objective" />
                @{ var suggestions = DescriptionSuggestions(); }
                @if (suggestions.Count > 0)
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudText Typo="Typo.caption" Class="text-muted">Previously used:</MudText>
                        @foreach (var suggestion in suggestions)
                        {
                            <MudTooltip Text="@suggestion" Disabled="@(suggestion.Length <= 60)">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Icon="@Icons.Material.Outlined.History"
                                         OnClick="@(() => _itemForm.GeneralDescription = suggestion)">
                                    @(suggestion.Length > 60 ? suggestion[..57] + "…" : suggestion)
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_itemForm.ProjectType" Label="Type" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" T="ProjectType">
                    <MudSelectItem Value="ProjectType.Goods">Goods</MudSelectItem>
                    <MudSelectItem Value="ProjectType.Infrastructure">Infrastructure</MudSelectItem>
                    <MudSelectItem Value="ProjectType.ConsultingServices">Consulting Services</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string" @bind-Value="_itemForm.ModeOfProcurement" Label="Mode of Procurement"
                                 Variant="Variant.Outlined" SearchFunc="SearchModesOfProcurement"
                                 ResetValueOnEmptyText="false" CoerceText="true" CoerceValue="true" Required="true"
                                 Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                 Error="@HasItemError(nameof(PpmpItemFormModel.ModeOfProcurement))"
                                 ErrorText="@ItemError(nameof(PpmpItemFormModel.ModeOfProcurement))"
                                 Placeholder="Select mode of procurement"
                                 HelperText="Sourced from Master Data" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_itemForm.Quantity" Label="Quantity" Variant="Variant.Outlined"
                                 Dense="true" Margin="Margin.Dense" Size="Size.Small" Min="0.01m" Required="true"
                                 Error="@HasItemError(nameof(PpmpItemFormModel.Quantity))"
                                 ErrorText="@ItemError(nameof(PpmpItemFormModel.Quantity))" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudAutocomplete T="string" @bind-Value="_itemForm.Unit" Label="Unit of Measure"
                                 Variant="Variant.Outlined" SearchFunc="SearchUnits" ResetValueOnEmptyText="false" CoerceText="true"
                                 CoerceValue="true" Dense="true" Margin="Margin.Dense" Size="Size.Small" Placeholder="e.g. LOT, PCS, BOX..."
                                 Required="true"
                                 Error="@HasItemError(nameof(PpmpItemFormModel.Unit))"
                                 ErrorText="@ItemError(nameof(PpmpItemFormModel.Unit))"
                                 HelperText="Select from master data or type a unit" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_itemForm.EstimatedBudget" Label="@($"Estimated Budget ({Money.Symbol})")"
                                 Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" Min="0m" Format="N2"
                                 Required="true"
                                 Error="@HasItemError(nameof(PpmpItemFormModel.EstimatedBudget))"
                                 ErrorText="@ItemError(nameof(PpmpItemFormModel.EstimatedBudget))" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_itemForm.ProcurementStart" Label="Procurement Start"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" Placeholder="MM/YYYY"
                              Required="true"
                              Error="@HasItemError(nameof(PpmpItemFormModel.ProcurementStart))"
                              ErrorText="@ItemError(nameof(PpmpItemFormModel.ProcurementStart))" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_itemForm.ProcurementEnd" Label="Procurement End" Variant="Variant.Outlined"
                              Dense="true" Margin="Margin.Dense" Size="Size.Small" Placeholder="MM/YYYY"
                              Required="true"
                              Error="@HasItemError(nameof(PpmpItemFormModel.ProcurementEnd))"
                              ErrorText="@ItemError(nameof(PpmpItemFormModel.ProcurementEnd))" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_itemForm.ExpectedDelivery" Label="Expected Delivery"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" Placeholder="MM/YYYY"
                              Required="true"
                              Error="@HasItemError(nameof(PpmpItemFormModel.ExpectedDelivery))"
                              ErrorText="@ItemError(nameof(PpmpItemFormModel.ExpectedDelivery))" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string" Value="_itemForm.FundingSourceCode" ValueChanged="OnFundingSourceCodeChanged"
                                 Label="Funding Source (UACS)" Variant="Variant.Outlined"
                                 SearchFunc="SearchFundingSourceCodes" ResetValueOnEmptyText="true"
                                 CoerceText="true" Clearable="true"
                                 Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                 Placeholder="Search UACS code or category..."
                                 HelperText="Full UACS code — its first 2 digits are the fund cluster">
                    <ItemTemplate Context="uacs">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2"><strong>@uacs</strong>@FundingSourceSuffix(uacs)</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_itemForm.SourceOfFunds" Label="Source of Funds"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" Required="true"
                              Error="@HasItemError(nameof(PpmpItemFormModel.SourceOfFunds))"
                              ErrorText="@ItemError(nameof(PpmpItemFormModel.SourceOfFunds))"
                              HelperText="Auto-filled from the UACS code; editable" />
            </MudItem>

            <MudItem xs="12" sm="3" Style="display:flex;align-items:center">
                <MudCheckBox @bind-Value="_itemForm.PreProcurementConference" Label="Pre-Proc Conference"
                             Color="Color.Primary" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_itemForm.Remarks" Label="Remarks" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Size="Size.Small" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseItemDialog" Variant="Variant.Text" Size="Size.Small">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveItemDialog">
            @(_editingItemIdx.HasValue ? "Update Item" : "Add Item")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudCard Elevation="1">
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             PanelClass="pa-4" Color="Color.Primary">

        <!-- -- LIST TAB -------------------------------------------------- -->
        <MudTabPanel Text="List" Icon="@Icons.Material.Outlined.ListAlt">
            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_search" Placeholder="Search PPMP number or unit..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                                        Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                        Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="LoadAsync" Class="flex-1" />
                <MudSelect Value="@_filterFiscalYear" Label="FY" Variant="Variant.Outlined" T="int?" Style="width:100px"
                                    Dense="true" Margin="Margin.Dense" Size="Size.Small" ValueChanged="OnFilterChanged">
                    <MudSelectItem T="int?" Value="null">All</MudSelectItem>
                    @foreach (var fy in _fiscalYears)
                    {
                        <MudSelectItem T="int?" Value="fy">@fy</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect Value="@_filterStatus" Label="Status" Variant="Variant.Outlined" T="PpmpStatus?"
                           Dense="true" Margin="Margin.Dense" Size="Size.Small" Style="width:150px" ValueChanged="OnStatusFilterChanged">
                    <MudSelectItem T="PpmpStatus?" Value="null">All</MudSelectItem>
                    @foreach (PpmpStatus s in Enum.GetValues<PpmpStatus>())
                    {
                        <MudSelectItem T="PpmpStatus?" Value="s">@s</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="StartNew">
                    New PPMP
                </MudButton>
            </MudStack>

            <AMISDataTable @ref="_table" T="PpmpSummaryDto" ServerData="LoadServerData"
                           RowClass="cursor-pointer"
                           OnRowClick="@(async (TableRowClickEventArgs<PpmpSummaryDto> e) => { if (e.Item is not null) await SelectPpmpAsync(e.Item.Id); })"
                           EmptyMessage="No PPMPs found."
                           EmptyDescription="Create a PPMP to plan next year's procurement.">
                <HeaderContent>
                    <MudTh>PPMP No.</MudTh>
                    <MudTh>FY</MudTh>
                    <MudTh>Office</MudTh>
                    <MudTh>End-User / Section</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Ver.</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Total Budget</MudTh>
                    <MudTh Style="width:110px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="PPMP No."><strong>@context.PpmpNumber</strong></MudTd>
                    <MudTd DataLabel="FY">@context.FiscalYear</MudTd>
                    <MudTd DataLabel="Office">@context.OfficeCode</MudTd>
                    <MudTd DataLabel="End-User / Section">@context.EndUserUnit</MudTd>
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Phase == PpmpPhase.Final ? Color.Primary : Color.Default)">
                            @context.Phase
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Ver.">v@(context.VersionNumber)</MudTd>
                    <MudTd DataLabel="Status">@StatusChip(context.Status)</MudTd>
                    <MudTd DataLabel="Total Budget">@Money.Symbol@context.TotalEstimatedBudget.ToString("N2")</MudTd>
                    <MudTd @onclick:stopPropagation="true">
                        @if (context.Status is PpmpStatus.Draft or PpmpStatus.Returned)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => SelectPpmpAsync(context.Id))" />
                        }
                        @if ((context.Status is PpmpStatus.Draft or PpmpStatus.Returned) && _canSubmit)
                        {
                            <MudTooltip Text="Submit for Approval">
                                <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Info"
                                               OnClick="@(() => QuickSubmitAsync(context))" />
                            </MudTooltip>
                        }
                        @if (context.Status == PpmpStatus.Draft && context.VersionNumber == 1 && context.Phase == PpmpPhase.Indicative && _canDelete)
                        {
                            <MudTooltip Text="Delete Draft">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => DeleteDraftAsync(context))" />
                            </MudTooltip>
                        }
                        @if (context.Status == PpmpStatus.Submitted && _canSubmit)
                        {
                            <MudTooltip Text="Recall (return to Draft)">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               Color="Color.Warning" OnClick="@(() => QuickRecallAsync(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudTabPanel>

        <!-- -- FORM TAB -------------------------------------------------- -->
        <MudTabPanel Text="@(_editing is null ? "New PPMP" : $"Edit {_editing.PpmpNumber}")"
                     Icon="@(_editing is null ? Icons.Material.Outlined.Add : Icons.Material.Outlined.Edit)">

            <!-- -- Action bar ------------------------------------------- -->
            <MudPaper Elevation="0" Class="pa-3 mb-3 rounded"
                      Style="background:var(--mud-palette-background-grey); border:1px solid var(--mud-palette-lines-default)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">

                    @if (_editing is not null)
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700">@_editing.PpmpNumber</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">v@(_editing.VersionNumber)</MudText>
                        </MudStack>
                        @StatusChip(_editing.Status)
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700">New PPMP</MudText>
                    }

                    @if (_versions.Count > 1)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                        <MudChipSet T="Guid" @bind-SelectedValue="_selectedVersionId"
                                    SelectionMode="SelectionMode.SingleSelection">
                            @foreach (var v in _versions)
                            {
                                <MudChip T="Guid" Value="v.Id" Size="Size.Small"
                                         Color="@(v.IsCurrentVersion ? Color.Primary : Color.Default)"
                                         OnClick="@(() => LoadVersionAsync(v.Id))">
                                    v@(v.VersionNumber) — @v.Status
                                </MudChip>
                            }
                        </MudChipSet>
                    }

                    <MudSpacer />

                    <!-- Workflow actions -->
                    @if (_hasUnsavedChanges)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Outlined.EditNote" Label="true">
                            Unsaved changes
                        </MudChip>
                    }
                    @if (_editing is not null && _editing.Status is PpmpStatus.Draft or PpmpStatus.Returned && _canSubmit)
                    {
                        <MudTooltip Text="@(_hasUnsavedChanges ? "Saves your changes, then submits for approval" : "Submit for approval")">
                            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="SubmitAsync" Disabled="_busy" Size="Size.Small">
                                @(_hasUnsavedChanges && _canEdit ? "Save & Submit" : "Submit for Approval")
                            </MudButton>
                        </MudTooltip>
                    }
                    @if (_editing is not null && _editing.Status == PpmpStatus.Submitted && _canSubmit)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Undo"
                                   OnClick="RecallAsync" Disabled="_busy" Size="Size.Small">
                            Recall
                        </MudButton>
                    }
                    @if (_editing is not null && _editing.Phase == PpmpPhase.Indicative && _editing.IsCurrentVersion
                         && _editing.Status is PpmpStatus.Approved or PpmpStatus.Consolidated && _canPromote)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.MoveUp" OnClick="PromoteToFinalAsync" Disabled="_busy"
                                   Size="Size.Small">
                            Promote to Final
                        </MudButton>
                    }
                    @if (_editing is not null && _editing.Phase is PpmpPhase.Final or PpmpPhase.Updated
                                                                 && _editing.Status is PpmpStatus.Approved or PpmpStatus.Consolidated && _canCreateUpdate)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="ShowCreateUpdateDialogAsync" Disabled="_busy" Size="Size.Small">
                            Create Update
                        </MudButton>
                    }

                    <!-- Edit actions -->
                    @if (!_isReadOnly && _canEdit)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                        @* Save is only meaningful when the form differs from the saved draft; Create is always available. *@
                        <MudTooltip Text="@(_editing is null ? "Create this PPMP as a Draft" : _hasUnsavedChanges ? "Save your changes to the draft" : "No changes to save")">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveAsync" Disabled="@(_busy || (_editing is not null && !_hasUnsavedChanges))" Size="Size.Small">
                                @if (_busy)
                                {
                                    <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" />
                                }
                                @(_editing is null ? "Create" : "Save")
                            </MudButton>
                        </MudTooltip>
                        <MudButton Variant="Variant.Text" OnClick="CloseOrDiscardAsync" Disabled="_busy" Size="Size.Small"
                                   Color="@(_hasUnsavedChanges ? Color.Error : Color.Default)">
                            @(_editing is null ? "Cancel" : _hasUnsavedChanges ? "Discard Changes" : "Close")
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>

            <!-- -- Return reason alert ---------------------------------- -->
            @if (_editing is not null && _editing.Status == PpmpStatus.Returned)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Undo">
                    <strong>Returned for revision</strong> — please address the feedback and resubmit.
                    @if (!string.IsNullOrWhiteSpace(_editing.ReturnReason))
                    {
                        <div Class="mt-1"><em>"@_editing.ReturnReason"</em></div>
                    }
                </MudAlert>
            }
            else if (_editing is not null && _editing.Status is PpmpStatus.Submitted or PpmpStatus.Approved or
            PpmpStatus.Consolidated or PpmpStatus.Superseded)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    This PPMP is <strong>@_editing.Status</strong> and cannot be edited.
                    @if (_editing.Status is PpmpStatus.Approved or PpmpStatus.Consolidated)
                    {
                        @if (_editing.Phase == PpmpPhase.Indicative && _editing.Status == PpmpStatus.Consolidated)
                        {
                            <span> It is part of the Indicative APP. Once the GAA is enacted and the Indicative APP is approved,
                                use <strong>Promote to Final</strong> to revise it to the approved allocation.</span>
                        }
                        else if (_editing.Phase == PpmpPhase.Indicative)
                        {
                            <span> Use <strong>Promote to Final</strong> to create the Final phase.</span>
                        }
                        else
                        {
                            <span> Use <strong>Create Update</strong> to create a new version.</span>
                        }
                    }
                </MudAlert>
            }

            @if (_baseline is not null && !_isReadOnly)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.EditNote">
                    Revising from <strong>@_baseline.Phase v@(_baseline.VersionNumber)</strong>. Adjust quantities and budgets to the
                    approved allocation. Changes are not saved until you click <strong>Save</strong>.
                </MudAlert>
            }

            <!-- -- Details row ------------------------------------------ -->
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6" sm="3">
                    <MudNumericField @bind-Value="_form.FiscalYear" Label="Fiscal Year" Variant="Variant.Outlined" Immediate="true"
                                     Dense="true" Margin="Margin.Dense" Size="Size.Small" Min="2000" Max="2100" Disabled="_isReadOnly" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect @bind-Value="_form.Phase" Label="PPMP Phase" Variant="Variant.Outlined" T="PpmpPhase"
                               Dense="true" Margin="Margin.Dense" Size="Size.Small" Disabled="_isReadOnly">
                        <MudSelectItem Value="PpmpPhase.Indicative">Indicative</MudSelectItem>
                        <MudSelectItem Value="PpmpPhase.Final">Final</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudTextField @bind-Value="_form.OfficeCode" Label="Office Code" Variant="Variant.Outlined" Immediate="true" DebounceInterval="300"
                                  Dense="true" Margin="Margin.Dense" Size="Size.Small" Required="true" Disabled="_isReadOnly"
                                  HelperText="@(_orgOfficeCode != null ? "From Organization Profile" : null)" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudTextField @bind-Value="_form.EndUserUnit" Label="End-User / Section" Variant="Variant.Outlined" Immediate="true" DebounceInterval="300"
                                  Dense="true" Margin="Margin.Dense" Size="Size.Small" Required="true" Disabled="_isReadOnly"
                                  HelperText="@(_employeeDepartment != null ? "From your employee profile" : null)" />
                </MudItem>
            </MudGrid>

            <!-- -- Line Items (full width) ------------------------------ -->
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600">Line Items</MudText>
                    <MudSpacer />
                    @if (!_isReadOnly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Small" OnClick="OpenAddItemDialog">
                            Add Item
                        </MudButton>
                    }
                </MudStack>

                @if (_form.Items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @(!_isReadOnly ? "Click \"+ Add Item\" to add procurement line items." : "No items.")
                    </MudAlert>
                }
                else
                {
                    <div style="overflow-x:auto">
                        <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="min-width:900px">
                            <thead>
                                <tr>
                                    <th style="width:36px">#</th>
                                    <th style="min-width:220px">Description / Objective</th>
                                    <th style="min-width:110px">Type</th>
                                    <th style="width:60px; text-align:right">Qty</th>
                                    <th style="width:70px">Unit</th>
                                    <th style="min-width:130px">Mode of Procurement</th>
                                    <th style="width:55px; text-align:center">Pre-Proc</th>
                                    <th style="width:130px; text-align:right">Est. Budget (@Money.Symbol)</th>
                                    @if (!_isReadOnly)
                                    {
                                        <th style="width:80px; text-align:center">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _form.Items.Count; i++)
                                {
                                    var idx = i;
                                    var item = _form.Items[idx];
                                    <tr>
                                        <td style="vertical-align:middle; color:var(--mud-palette-text-secondary)">
                                            @(idx + 1)
                                        </td>
                                        <td style="vertical-align:middle">
                                            <MudText Typo="Typo.body2">@item.GeneralDescription</MudText>
                                            @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Remarks</MudText>
                                            }
                                        </td>
                                        <td style="vertical-align:middle">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Label="true">
                                                @item.ProjectType
                                            </MudChip>
                                        </td>
                                        <td style="vertical-align:middle; text-align:right">@item.Quantity.ToString("N2")</td>
                                        <td style="vertical-align:middle">
                                            <MudText Typo="Typo.body2" Style="font-family:monospace">@item.Unit</MudText>
                                        </td>
                                        <td style="vertical-align:middle">
                                            <MudText Typo="Typo.caption">@item.ModeOfProcurement</MudText>
                                            @if (!string.IsNullOrWhiteSpace(item.FundingSourceCode))
                                            {
                                                <MudTooltip Text="@item.SourceOfFunds" Inline="false">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block; font-family:monospace">@item.FundingSourceCode</MudText>
                                                </MudTooltip>
                                            }
                                        </td>
                                        <td style="vertical-align:middle; text-align:center">
                                            @if (item.PreProcurementConference)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small"
                                                         Color="Color.Success" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Size="Size.Small"
                                                         Color="Color.Default" />
                                            }
                                        </td>
                                        <td style="vertical-align:middle; text-align:right; font-weight:600">
                                            @Money.Symbol@item.EstimatedBudget.ToString("N2")
                                            @if (_baseline is not null)
                                            {
                                                var prior = BaselineItemFor(idx);
                                                <MudText Typo="Typo.caption" Class="text-muted" Style="display:block; font-weight:400">
                                                    @(prior is null ? "New item" : $"{_baseline.Phase}: {Money.Symbol}{prior.EstimatedBudget:N2}")
                                                </MudText>
                                            }
                                        </td>
                                        @if (!_isReadOnly)
                                        {
                                            <td style="vertical-align:middle; text-align:center">
                                                <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small"
                                                               Color="Color.Primary" OnClick="@(() => OpenEditItemDialog(idx))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                               Color="Color.Error" OnClick="@(() => RemoveItem(idx))" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>

                    <MudStack Row="true" Class="mt-2 pa-2 rounded" Style="background:var(--mud-palette-background-grey)"
                              AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2">Total Estimated Budget</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                            @Money.Symbol@_form.Items.Sum(i => i.EstimatedBudget).ToString("N2")
                        </MudText>
                    </MudStack>
                    @if (_baseline is not null)
                    {
                        var change = _form.Items.Sum(i => i.EstimatedBudget) - _baseline.TotalEstimatedBudget;
                        <MudStack Row="true" Class="px-2 pt-1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Class="text-muted">
                                @_baseline.Phase v@(_baseline.VersionNumber) total @Money.Symbol@_baseline.TotalEstimatedBudget.ToString("N2")
                            </MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.caption"
                                     Color="@(change > 0 ? Color.Error : change < 0 ? Color.Success : Color.Default)">
                                Change @(change > 0 ? "+" : change < 0 ? "−" : "")@Money.Symbol@Math.Abs(change).ToString("N2")
                            </MudText>
                        </MudStack>
                    }
                }
            </MudItem>
        </MudTabPanel>
    </MudTabs>
</MudCard>

@code {
    // -- State --------------------------------------------------------
    private int _activeTab;
    private AMISDataTable<PpmpSummaryDto>? _table;
    private List<PpmpSummaryDto> _versions = [];
    private PpmpDto? _editing;
    private PpmpDto? _baseline;
    private bool _busy;
    private bool _isReadOnly => _editing is not null &&
        _editing.Status is not (PpmpStatus.Draft or PpmpStatus.Returned);
    private string? _search;
    private int? _filterFiscalYear;
    private PpmpStatus? _filterStatus;
    private Guid _selectedVersionId;

    private string? _orgOfficeCode;
    private string? _employeeDepartment;
    private Guid _preparedById;

    private readonly int[] _fiscalYears = Enumerable.Range(DateTime.Now.Year - 2, 5).ToArray();

    // -- Master data for autocomplete ---------------------------------
    private List<string> _unitCodes = [];
    private List<string> _modeOfProcurementNames = [];
    private readonly HashSet<string> _usedDescriptions = new(StringComparer.OrdinalIgnoreCase);

    // -- Item dialog state --------------------------------------------
    private bool _itemDialogOpen;
    private int? _editingItemIdx;
    private PpmpItemFormModel _itemForm = new();

    // -- Form model ---------------------------------------------------
    private PpmpFormModel _form = new();

    private sealed class PpmpFormModel
    {
        public int FiscalYear { get; set; } = DateTime.Now.Year + 1;
        public PpmpPhase Phase { get; set; } = PpmpPhase.Indicative;
        public string OfficeCode { get; set; } = string.Empty;
        public string EndUserUnit { get; set; } = string.Empty;
        public List<PpmpItemFormModel> Items { get; set; } = [];
    }

    private sealed class PpmpItemFormModel
    {
        public string GeneralDescription { get; set; } = string.Empty;
        public ProjectType ProjectType { get; set; } = ProjectType.Goods;
        public decimal Quantity { get; set; } = 1;
        public string Unit { get; set; } = "LOT";
        public string ModeOfProcurement { get; set; } = string.Empty;
        public bool PreProcurementConference { get; set; }
        public string ProcurementStart { get; set; } = $"01/{DateTime.Now.Year + 1}";
        public string ProcurementEnd { get; set; } = $"03/{DateTime.Now.Year + 1}";
        public string ExpectedDelivery { get; set; } = $"04/{DateTime.Now.Year + 1}";
        public string SourceOfFunds { get; set; } = "General Fund";
        // Full UACS funding source code (e.g. 01101101). Its first two digits are the fund cluster
        // (01 = Regular Agency Fund). Nullable while the picker is optional.
        public string? FundingSourceCode { get; set; }
        public decimal EstimatedBudget { get; set; }
        public string Remarks { get; set; } = string.Empty;
    }

    // code → dto cache from the funding-source picker, used for item templates and auto-fill.
    private readonly Dictionary<string, FundingSourceCodeDto> _fundingSourceCache = new(StringComparer.OrdinalIgnoreCase);

    private async Task<IEnumerable<string>> SearchFundingSourceCodes(string? value, CancellationToken ct)
    {
        try
        {
            var response = await FundingSourceCodeClient.SearchAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                pageSize: 30,
                cancellationToken: ct);
            var items = response?.Items ?? [];
            foreach (var dto in items)
                _fundingSourceCache[dto.Code] = dto;
            return items.Select(i => i.Code);
        }
        catch
        {
            return [];
        }
    }

    private void OnFundingSourceCodeChanged(string? code)
    {
        _itemForm.FundingSourceCode = code;
        if (!string.IsNullOrWhiteSpace(code) && _fundingSourceCache.TryGetValue(code, out var dto))
        {
            // Keep the printed "Source of Funds" column consistent with the chosen UACS code.
            var label = FirstNonEmpty(dto.FinancingSource, dto.FundCategory, dto.Description);
            if (!string.IsNullOrWhiteSpace(label))
                _itemForm.SourceOfFunds = label!;
        }
    }

    private string FundingSourceSuffix(string code)
    {
        if (_fundingSourceCache.TryGetValue(code, out var dto))
        {
            var label = FirstNonEmpty(dto.FundSubCategory, dto.FundCategory, dto.FinancingSource);
            if (!string.IsNullOrWhiteSpace(label))
                return $" — {label}";
        }
        return string.Empty;
    }

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    // -- Lifecycle ----------------------------------------------------
    private bool _canCreate => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.Update);
    private bool _canEdit => _canCreate || _canUpdate;
    private bool _canDelete => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.Delete);
    private bool _canSubmit => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.Submit);
    private bool _canPromote => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.PromoteToFinal);
    private bool _canCreateUpdate => UserProfileState.Permissions.Contains(ProcurementPlanningPermissions.Ppmps.CreateUpdate);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await Task.WhenAll(LoadDefaultsAsync(), LoadUnitsAsync(), LoadModesOfProcurementAsync(), LoadAsync());
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadModesOfProcurementAsync()
    {
        try
        {
            var result = await ModeOfProcurementClient.SearchAsync(pageSize: 200);
            _modeOfProcurementNames = result?.Items?
                .Where(x => x.IsActive && !string.IsNullOrWhiteSpace(x.Name))
                .Select(x => x.Name.Trim())
                .ToList() ?? [];
        }
        catch
        {
            _modeOfProcurementNames = [];
        }
    }

    private async Task LoadDefaultsAsync()
    {
        try
        {
            var profile = await OrgProfileClient.GetAsync();
            if (!string.IsNullOrWhiteSpace(profile?.AnnexECode))
            {
                _orgOfficeCode = profile.AnnexECode;
                if (string.IsNullOrWhiteSpace(_form.OfficeCode))
                    _form.OfficeCode = _orgOfficeCode;
            }
        }
        catch { /* non-critical */ }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var identityUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrWhiteSpace(identityUserId))
            {
                var result = await LookupClient.EmployeesGetAsync(identityUserId: identityUserId, pageSize: 1);
                var employee = result.Items?.FirstOrDefault();
                if (employee is not null)
                {
                    _preparedById = employee.Id;
                    if (!string.IsNullOrWhiteSpace(employee.DepartmentName))
                    {
                        _employeeDepartment = employee.DepartmentName;
                        if (string.IsNullOrWhiteSpace(_form.EndUserUnit))
                            _form.EndUserUnit = _employeeDepartment;
                    }
                }
            }
        }
        catch { /* non-critical */ }
    }

    private async Task LoadUnitsAsync()
    {
        try
        {
            _unitCodes = (await LookupData.GetUnitOfMeasuresAsync())
                .Where(u => !string.IsNullOrWhiteSpace(u.Code))
                .Select(u => u.Code!)
                .OrderBy(c => c)
                .ToList();
        }
        catch { /* non-critical */ }
    }

    private async Task<TableData<PpmpSummaryDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var result = await PpmpClient.SearchAsync(
                keyword: _search, fiscalYear: _filterFiscalYear,
                status: _filterStatus, page: state.Page + 1, pageSize: state.PageSize);

            return new TableData<PpmpSummaryDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading PPMPs: {ex.Message}", Severity.Error);
            return new TableData<PpmpSummaryDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task LoadAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    // -- Navigation ---------------------------------------------------
    private void StartNew()
    {
        _editing = null;
        _baseline = null;
        _versions.Clear();
        _form = new PpmpFormModel
        {
            OfficeCode = _orgOfficeCode ?? string.Empty,
            EndUserUnit = _employeeDepartment ?? string.Empty
        };
        _activeTab = 1;
    }

    // -- Select / version loading -------------------------------------
    private async Task SelectPpmpAsync(Guid id)
    {
        _busy = true;
        try
        {
            _editing = await PpmpClient.GetAsync(id);
            if (_editing is null) return;
            _selectedVersionId = _editing.Id;
            _versions = (await PpmpClient.GetVersionsAsync(_editing.VersionChainId)).ToList();
            PopulateForm(_editing);
            await LoadBaselineAsync();
            _activeTab = 1;
        }
        catch (Exception ex) { Snackbar.Add($"Error loading PPMP: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task LoadVersionAsync(Guid id)
    {
        if (id == _editing?.Id) return;
        _busy = true;
        try
        {
            _editing = await PpmpClient.GetAsync(id);
            if (_editing is not null) PopulateForm(_editing);
            await LoadBaselineAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    // Previous version of a Final/Updated PPMP — shown beside each item so revisions are easy to see.
    private async Task LoadBaselineAsync()
    {
        _baseline = null;
        if (_editing is not { PreviousVersionId: { } previousId, Phase: PpmpPhase.Final or PpmpPhase.Updated })
            return;
        try { _baseline = await PpmpClient.GetAsync(previousId); }
        catch (Exception ex) { Snackbar.Add($"Could not load previous version: {ex.Message}", Severity.Warning); }
    }

    private PpmpItemDto? BaselineItemFor(int idx)
    {
        if (_baseline is null) return null;
        var item = _form.Items[idx];
        var byDescription = _baseline.Items.FirstOrDefault(b => SameDescription(b.GeneralDescription, item.GeneralDescription));
        if (byDescription is not null) return byDescription;

        // Description was edited: fall back to the same position, unless that prior item still matches another row.
        var ordered = _baseline.Items.OrderBy(b => b.ItemNo).ToList();
        if (idx >= ordered.Count) return null;
        var positional = ordered[idx];
        return _form.Items.Any(f => SameDescription(f.GeneralDescription, positional.GeneralDescription)) ? null : positional;
    }

    private static bool SameDescription(string? a, string? b) =>
        string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);

    private void PopulateForm(PpmpDto dto)
    {
        _form = new PpmpFormModel
        {
            FiscalYear = dto.FiscalYear,
            Phase = dto.Phase,
            OfficeCode = dto.OfficeCode,
            EndUserUnit = dto.EndUserUnit,
            Items = dto.Items.Select(i => new PpmpItemFormModel
            {
                GeneralDescription = i.GeneralDescription,
                ProjectType = i.ProjectType,
                Quantity = i.Quantity,
                Unit = i.Unit,
                ModeOfProcurement = i.ModeOfProcurement,
                PreProcurementConference = i.PreProcurementConference,
                ProcurementStart = i.ProcurementStart,
                ProcurementEnd = i.ProcurementEnd,
                ExpectedDelivery = i.ExpectedDelivery,
                SourceOfFunds = i.SourceOfFunds,
                FundingSourceCode = i.FundingSourceCode,
                EstimatedBudget = i.EstimatedBudget,
                Remarks = i.Remarks ?? string.Empty
            }).ToList()
        };

        foreach (var item in _form.Items.Where(i => !string.IsNullOrWhiteSpace(i.GeneralDescription)))
            _usedDescriptions.Add(item.GeneralDescription);

        MarkFormSaved();
    }

    // -- Unsaved-changes tracking: snapshot of the form as last loaded/saved -------------
    private string? _savedSnapshot;
    private string FormSnapshot() => System.Text.Json.JsonSerializer.Serialize(_form);
    private void MarkFormSaved() => _savedSnapshot = FormSnapshot();
    private bool _hasUnsavedChanges => _editing is not null && !_isReadOnly && _savedSnapshot != FormSnapshot();

    // -- Item dialog --------------------------------------------------
    private void OpenAddItemDialog()
    {
        _editingItemIdx = null;
        _itemForm = new PpmpItemFormModel();
        _itemSubmitAttempted = false;
        _itemDialogOpen = true;
    }

    private void OpenEditItemDialog(int idx)
    {
        var src = _form.Items[idx];
        _editingItemIdx = idx;
        _itemForm = new PpmpItemFormModel
        {
            GeneralDescription = src.GeneralDescription,
            ProjectType = src.ProjectType,
            Quantity = src.Quantity,
            Unit = src.Unit,
            ModeOfProcurement = src.ModeOfProcurement,
            PreProcurementConference = src.PreProcurementConference,
            ProcurementStart = src.ProcurementStart,
            ProcurementEnd = src.ProcurementEnd,
            ExpectedDelivery = src.ExpectedDelivery,
            SourceOfFunds = src.SourceOfFunds,
            FundingSourceCode = src.FundingSourceCode,
            EstimatedBudget = src.EstimatedBudget,
            Remarks = src.Remarks
        };
        _itemSubmitAttempted = false;
        _itemDialogOpen = true;
    }

    // -- Item validation (mirrors the API's PpmpItemRequestValidator) ---
    private bool _itemSubmitAttempted;

    private Dictionary<string, string> ValidateItem()
    {
        var f = _itemForm;
        var errors = new Dictionary<string, string>();

        if (string.IsNullOrWhiteSpace(f.GeneralDescription)) errors[nameof(f.GeneralDescription)] = "Description is required.";
        else if (f.GeneralDescription.Length > 1000) errors[nameof(f.GeneralDescription)] = "Description must be 1,000 characters or fewer.";
        if (string.IsNullOrWhiteSpace(f.ModeOfProcurement)) errors[nameof(f.ModeOfProcurement)] = "Select a mode of procurement.";
        if (f.Quantity <= 0) errors[nameof(f.Quantity)] = "Quantity must be greater than zero.";
        if (string.IsNullOrWhiteSpace(f.Unit)) errors[nameof(f.Unit)] = "Unit of measure is required.";
        if (f.EstimatedBudget <= 0) errors[nameof(f.EstimatedBudget)] = "Estimated budget must be greater than zero.";
        if (string.IsNullOrWhiteSpace(f.SourceOfFunds)) errors[nameof(f.SourceOfFunds)] = "Source of funds is required.";

        var start = ParseMonth(f.ProcurementStart, nameof(f.ProcurementStart), "Procurement start", errors);
        var end = ParseMonth(f.ProcurementEnd, nameof(f.ProcurementEnd), "Procurement end", errors);
        var delivery = ParseMonth(f.ExpectedDelivery, nameof(f.ExpectedDelivery), "Expected delivery", errors);
        if (start is not null && end is not null && end < start)
            errors[nameof(f.ProcurementEnd)] = "Procurement end cannot be before procurement start.";
        if (start is not null && delivery is not null && delivery < start)
            errors[nameof(f.ExpectedDelivery)] = "Expected delivery cannot be before procurement start.";

        return errors;
    }

    private static DateOnly? ParseMonth(string? value, string field, string label, Dictionary<string, string> errors)
    {
        if (string.IsNullOrWhiteSpace(value)) { errors[field] = $"{label} is required (MM/YYYY)."; return null; }
        if (DateOnly.TryParseExact(value.Trim(), "MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var month))
            return month;
        errors[field] = $"{label} must be a valid month in MM/YYYY format (e.g. 03/{DateTime.Now.Year + 1}).";
        return null;
    }

    // Errors show only after the first Add/Update click, then update live as the user fixes fields.
    private Dictionary<string, string> ItemErrors => _itemSubmitAttempted ? ValidateItem() : [];
    private bool HasItemError(string field) => ItemErrors.ContainsKey(field);
    private string? ItemError(string field) => ItemErrors.GetValueOrDefault(field);

    private void SaveItemDialog()
    {
        _itemSubmitAttempted = true;
        var errors = ValidateItem();
        if (errors.Count > 0)
        {
            Snackbar.Add(errors.Count == 1
                    ? $"Please fix the highlighted field: {errors.Values.First()}"
                    : $"Please fix the {errors.Count} highlighted fields before adding the item.",
                Severity.Warning);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_itemForm.GeneralDescription))
            _usedDescriptions.Add(_itemForm.GeneralDescription);

        if (_editingItemIdx.HasValue)
        {
            var target = _form.Items[_editingItemIdx.Value];
            target.GeneralDescription = _itemForm.GeneralDescription;
            target.ProjectType = _itemForm.ProjectType;
            target.Quantity = _itemForm.Quantity;
            target.Unit = _itemForm.Unit;
            target.ModeOfProcurement = _itemForm.ModeOfProcurement;
            target.PreProcurementConference = _itemForm.PreProcurementConference;
            target.ProcurementStart = _itemForm.ProcurementStart;
            target.ProcurementEnd = _itemForm.ProcurementEnd;
            target.ExpectedDelivery = _itemForm.ExpectedDelivery;
            target.SourceOfFunds = _itemForm.SourceOfFunds;
            target.FundingSourceCode = _itemForm.FundingSourceCode;
            target.EstimatedBudget = _itemForm.EstimatedBudget;
            target.Remarks = _itemForm.Remarks;
        }
        else
        {
            _form.Items.Add(new PpmpItemFormModel
            {
                GeneralDescription = _itemForm.GeneralDescription,
                ProjectType = _itemForm.ProjectType,
                Quantity = _itemForm.Quantity,
                Unit = _itemForm.Unit,
                ModeOfProcurement = _itemForm.ModeOfProcurement,
                PreProcurementConference = _itemForm.PreProcurementConference,
                ProcurementStart = _itemForm.ProcurementStart,
                ProcurementEnd = _itemForm.ProcurementEnd,
                ExpectedDelivery = _itemForm.ExpectedDelivery,
                SourceOfFunds = _itemForm.SourceOfFunds,
                FundingSourceCode = _itemForm.FundingSourceCode,
                EstimatedBudget = _itemForm.EstimatedBudget,
                Remarks = _itemForm.Remarks
            });
        }

        _itemDialogOpen = false;
    }

    private void CloseItemDialog() => _itemDialogOpen = false;

    // -- Autocomplete search functions --------------------------------
    private Task<IEnumerable<string>> SearchUnits(string value, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(_unitCodes.Take(20));

        var matches = _unitCodes
            .Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(20);
        return Task.FromResult<IEnumerable<string>>(matches);
    }

    // Up to 5 previously used descriptions matching what's typed (all recent ones when empty); hides an exact match.
    private List<string> DescriptionSuggestions()
    {
        var typed = _itemForm.GeneralDescription?.Trim() ?? string.Empty;
        var all = _usedDescriptions
            .Concat(_form.Items.Select(i => i.GeneralDescription))
            .Where(d => !string.IsNullOrWhiteSpace(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(d => !string.Equals(d.Trim(), typed, StringComparison.OrdinalIgnoreCase));

        if (typed.Length > 0)
            all = all.Where(d => d.Contains(typed, StringComparison.OrdinalIgnoreCase));

        return all.Take(5).ToList();
    }

    private Task<IEnumerable<string>> SearchModesOfProcurement(string value, CancellationToken _)
    {
        var source = _modeOfProcurementNames.Count > 0 ? _modeOfProcurementNames : [];

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(source.Take(20));

        var matches = source
            .Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(20);

        return Task.FromResult<IEnumerable<string>>(matches);
    }

    // -- CRUD ---------------------------------------------------------
    private void RemoveItem(int idx) => _form.Items.RemoveAt(idx);

    // Close when clean; ask before throwing away unsaved edits (or items on a not-yet-created PPMP).
    private async Task CloseOrDiscardAsync()
    {
        var losing = _editing is null ? _form.Items.Count > 0 : _hasUnsavedChanges;
        if (losing)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Discard Changes",
                _editing is null
                    ? "Discard this new PPMP? The line items you added have not been created yet and will be lost."
                    : $"Discard your unsaved changes to {_editing.PpmpNumber}? The draft keeps its last saved version.",
                yesText: "Discard", cancelText: "Keep Editing");
            if (confirmed != true) return;
        }
        ClearForm();
    }

    private void ClearForm()
    {
        _editing = null;
        _baseline = null;
        _versions.Clear();
        _form = new PpmpFormModel
        {
            OfficeCode = _orgOfficeCode ?? string.Empty,
            EndUserUnit = _employeeDepartment ?? string.Empty
        };
        _activeTab = 0;
    }

    private async Task SaveAsync()
    {
        if (_form.Items.Count == 0) { Snackbar.Add("Add at least one line item.", Severity.Warning); return; }
        if (_editing is null && _preparedById == Guid.Empty)
        {
            Snackbar.Add("Unable to resolve the preparer profile. Please ensure your employee record is linked to your account.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            if (_editing is null)
            {
                var cmd = new CreatePpmpCommand(_form.FiscalYear, _form.Phase,
                    _form.OfficeCode, _form.EndUserUnit, _preparedById, BuildItemRequests());
                _editing = await PpmpClient.CreateAsync(cmd);
                Snackbar.Add($"PPMP {_editing.PpmpNumber} created.", Severity.Success);
            }
            else
            {
                await SaveFormToEditingAsync();
                Snackbar.Add("PPMP updated.", Severity.Success);
            }
            MarkFormSaved();
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private List<PpmpItemRequest> BuildItemRequests() =>
        _form.Items.Select(i => new PpmpItemRequest(
            i.GeneralDescription, i.ProjectType, i.Quantity, i.Unit,
            i.ModeOfProcurement, i.PreProcurementConference,
            i.ProcurementStart, i.ProcurementEnd, i.ExpectedDelivery,
            i.SourceOfFunds, i.EstimatedBudget,
            null, i.Remarks, i.FundingSourceCode)).ToList();

    // Persists the open form onto the existing PPMP (Draft/Returned only).
    private async Task SaveFormToEditingAsync()
    {
        if (_editing is null) return;
        var cmd = new UpdatePpmpCommand(_editing.Id, _form.FiscalYear,
            _form.OfficeCode, _form.EndUserUnit, _editing.PreparedById, BuildItemRequests());
        _editing = await PpmpClient.UpdateAsync(_editing.Id, cmd);
    }

    private async Task SubmitAsync()
    {
        if (_editing is null) return;
        if (_form.Items.Count == 0) { Snackbar.Add("Add at least one line item.", Severity.Warning); return; }

        // Submit sends the server copy, so unsaved edits are saved first — explicitly, via "Save & Submit".
        var saveFirst = _hasUnsavedChanges;
        if (saveFirst && !_canEdit)
        {
            Snackbar.Add("You have unsaved changes but no permission to save them. Cancel your edits, then submit.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            saveFirst ? "Save & Submit for Approval" : "Submit for Approval",
            saveFirst
                ? $"Save your changes and submit {_editing.PpmpNumber} for approval? It will become read-only until approved or recalled."
                : $"Submit {_editing.PpmpNumber} for approval? It will become read-only until approved or recalled.",
            yesText: saveFirst ? "Save & Submit" : "Submit", cancelText: "Cancel");
        if (confirmed != true) return;

        _busy = true;
        try
        {
            if (saveFirst)
            {
                try
                {
                    await SaveFormToEditingAsync();
                    MarkFormSaved();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Could not save changes — nothing was submitted. {ex.Message}", Severity.Error);
                    return;
                }
            }

            try
            {
                _editing = await PpmpClient.SubmitAsync(_editing!.Id);
            }
            catch (Exception ex)
            {
                Snackbar.Add(saveFirst
                    ? $"Changes saved, but submit failed: {ex.Message}"
                    : $"Submit failed: {ex.Message}", Severity.Error);
                await LoadAsync();
                return;
            }

            PopulateForm(_editing);
            Snackbar.Add(saveFirst ? "Changes saved and PPMP submitted for approval." : "PPMP submitted for approval.", Severity.Success);
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RecallAsync()
    {
        if (_editing is null) return;
        var confirmed = await DialogService.ShowMessageBox(
            "Recall Submission",
            $"Recall {_editing.PpmpNumber}? It will return to Draft and can be edited again.",
            yesText: "Recall", cancelText: "Cancel");
        if (confirmed != true) return;

        _busy = true;
        try
        {
            _editing = await PpmpClient.RecallAsync(_editing.Id);
            Snackbar.Add("PPMP recalled to draft.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

