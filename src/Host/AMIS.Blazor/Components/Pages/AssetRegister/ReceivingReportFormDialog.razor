@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.v1.Transfers
@using ReceivingDocumentKind = AMIS.Modules.AssetRegister.Contracts.v1.ReceivingDocumentKind

<MudDialog>
    <DialogContent>
        <ReceivingReportForm DocumentKind="DocumentKind"
                             Title="@Title"
                             Embedded="true"
                             PrefillFromOffer="PrefillFromOffer"
                             OnCreated="HandleCreated"
                             OnCancel="HandleCancel" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public ReceivingDocumentKind DocumentKind { get; set; }
    [Parameter] public string Title { get; set; } = "Create Receiving Report";

    /// <summary>Set when the form is opened from an incoming inter-agency transfer offer.</summary>
    [Parameter] public AssetTransferOfferDto? PrefillFromOffer { get; set; }

    private void HandleCreated(ArReceivingReportDto created) => Dialog.Close(DialogResult.Ok(created));

    private void HandleCancel() => Dialog.Cancel();
}
