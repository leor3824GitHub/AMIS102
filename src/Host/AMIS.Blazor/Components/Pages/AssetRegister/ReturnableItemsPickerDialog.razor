@using AMIS.Blazor.ApiClient
@using AccountabilityLineStatus = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityLineStatus
@inject IArAccountabilityClient AccountabilityClient

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width:560px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Showing <strong>active</strong> items on <strong>@DocumentNo</strong> eligible for return. Tick the items to add, then choose <strong>Add</strong>.
            </MudText>

            <MudTextField @bind-Value="_keyword" Label="Filter / Property No." Variant="Variant.Outlined"
                          Dense="true" Margin="Margin.Dense" Immediate="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search" />

            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            else
            {
                <MudTable Items="_filtered" Dense="true" Hover="true" Striped="true" T="ArAccountabilityLineDto">
                    <HeaderContent>
                        <MudTh Style="width:48px"></MudTh>
                        <MudTh>Property No.</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var disabled = ExcludeIds.Contains(context.Id);
                        }
                        <MudTd>
                            <MudCheckBox T="bool" Dense="true" Disabled="disabled"
                                         Value="@(_selected.ContainsKey(context.Id) || disabled)"
                                         ValueChanged="@((bool v) => Toggle(context, v))" />
                        </MudTd>
                        <MudTd>
                            <strong>@context.Snapshot.PropertyNo</strong>
                            @if (disabled)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">(already added)</MudText>
                            }
                        </MudTd>
                        <MudTd>@context.Snapshot.Description</MudTd>
                        <MudTd>@context.Snapshot.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.Snapshot.UnitCost.ToString("N2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">No active items found.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</AMISButton>
        <AMISButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSelected" Disabled="_selected.Count == 0">
            Add @(_selected.Count > 0 ? $"{_selected.Count} item(s)" : "items")
        </AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid AccountabilityId { get; set; }
    [Parameter] public string DocumentNo { get; set; } = "";
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    private bool _busy;
    private string? _error;
    private string? _keyword;
    private List<ArAccountabilityLineDto> _lines = [];
    private readonly Dictionary<Guid, ArAccountabilityLineDto> _selected = [];

    private IEnumerable<ArAccountabilityLineDto> _filtered =>
        string.IsNullOrWhiteSpace(_keyword)
            ? _lines
            : _lines.Where(l =>
                l.Snapshot.PropertyNo.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                || l.Snapshot.Description.Contains(_keyword, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        try
        {
            var accountability = await AccountabilityClient.GetAsync(AccountabilityId);
            _lines = accountability?.Lines
                .Where(l => l.LineStatus == AccountabilityLineStatus.Active)
                .ToList() ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Toggle(ArAccountabilityLineDto item, bool selected)
    {
        if (ExcludeIds.Contains(item.Id)) return;
        if (selected) _selected[item.Id] = item;
        else _selected.Remove(item.Id);
    }

    private void AddSelected() => MudDialog.Close(DialogResult.Ok(_selected.Values.ToList()));
    private void Cancel() => MudDialog.Cancel();
}
