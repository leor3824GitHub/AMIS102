@using AMIS.Blazor.ApiClient
@using AccountabilityLineStatus = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityLineStatus
@inject IArAccountabilityClient AccountabilityClient

@* In-memory picker of the active lines on an accountability eligible for return. Returns List<ArAccountabilityLineDto>. *@
<EntityPickerDialog T="ArAccountabilityLineDto"
                    KeySelector="l => l.Id"
                    ItemsLoader="LoadLinesAsync"
                    SearchTextSelector="SearchText"
                    ExcludeIds="ExcludeIds"
                    SearchLabel="Filter / Property No."
                    EmptyText="No active items found."
                    ConfirmText="Add">
    <Caption>
        Showing <strong>active</strong> items on <strong>@DocumentNo</strong> eligible for return. Tick the items to add, then choose <strong>Add</strong>.
    </Caption>
    <HeaderTemplate>
        <MudTh>Property No.</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Unit</MudTh>
        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
    </HeaderTemplate>
    <RowTemplate Context="row">
        <MudTd>
            <strong>@row.Item.Snapshot.PropertyNo</strong>
            @if (row.IsExcluded)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">(already added)</MudText>
            }
        </MudTd>
        <MudTd>@row.Item.Snapshot.Description</MudTd>
        <MudTd>@row.Item.Snapshot.Unit</MudTd>
        <MudTd Style="text-align:right">@row.Item.Snapshot.UnitCost.ToString("N2")</MudTd>
    </RowTemplate>
</EntityPickerDialog>

@code {
    [Parameter] public Guid AccountabilityId { get; set; }
    [Parameter] public string DocumentNo { get; set; } = "";
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    private async Task<IReadOnlyList<ArAccountabilityLineDto>> LoadLinesAsync()
    {
        var accountability = await AccountabilityClient.GetAsync(AccountabilityId);
        return accountability?.Lines
            .Where(l => l.LineStatus == AccountabilityLineStatus.Active)
            .ToList() ?? [];
    }

    private static string SearchText(ArAccountabilityLineDto line) =>
        $"{line.Snapshot.PropertyNo} {line.Snapshot.Description}";
}
