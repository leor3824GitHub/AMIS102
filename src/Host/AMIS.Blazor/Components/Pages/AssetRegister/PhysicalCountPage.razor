@page "/asset-register/physical-count"
@implements IDisposable
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using PhysicalCountStatus = AMIS.Modules.AssetRegister.Contracts.v1.PhysicalCountStatus
@using PhysicalCountScope = AMIS.Modules.AssetRegister.Contracts.v1.PhysicalCountScope
@using PhysicalCountCondition = AMIS.Modules.AssetRegister.Contracts.v1.PhysicalCountCondition
@using AssetCondition = AMIS.Modules.AssetRegister.Contracts.v1.AssetCondition
@using AMIS.Modules.AssetRegister.Contracts.v1.SignedDocuments
@inject IArPhysicalCountClient Client
@inject IArCatalogClient CatalogClient
@inject IAssetRegistryClient AssetClient
@inject ILocationLookupClient LocationClient
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IJSRuntime JS
@inject IDialogService DialogService

<AMISPageHeader Title="Physical Count Sessions (RPCSEMEX / RPCPPE)"
               Description="Manage physical count sessions per COA 2022-004. Produces RPCSEMEX (SE) and RPCPPE (PPE) reports." />

<MudGrid Spacing="3">
    <!-- Filters -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Session Code" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                        Search
                    </AMISButton>
                    @if (_canCreate)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.PlayCircle" OnClick="OpenStartDialogAsync">
                            Start Session
                        </AMISButton>
                    }
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                    <AMISEnumChips TEnum="PhysicalCountStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                                   Label="Status" LabelFunc="FormatCountStatus" Class="mb-0" />
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                    <AMISEnumChips TEnum="PhysicalCountScope" Value="_scopeFilter" ValueChanged="OnScopeChanged"
                                   Label="Scope" LabelFunc="FormatScope" Class="mb-0" />
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Results -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else
                {
                    <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                              OnRowClick="OnRowClick" T="ArPhysicalCountSummaryDto" RowClass="cursor-pointer">
                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Scope</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>As At</MudTh>
                            <MudTh>Started On</MudTh>
                            <MudTh>Closed On</MudTh>
                            <MudTh Style="text-align:right">Entries</MudTh>
                            <MudTh Style="text-align:center">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.Code</strong></MudTd>
                            <MudTd>@FormatScope(context.Scope)</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@CountStatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @FormatCountStatus(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.AsAt.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@context.StartedOn.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@(context.ClosedOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                            <MudTd Style="text-align:right">@context.EntryCount</MudTd>
                            <MudTd Style="text-align:center" @onclick:stopPropagation="true">
                                @if (IsSigned(context.Status) && (context.HasSignedCopy ? _canViewSigned : _canUploadSigned))
                                {
                                    <MudTooltip Text="@(context.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                        Color="@(context.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                        OnClick="@(() => OpenSignedCopyAsync(context))" />
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No physical count sessions found.</MudText>
                        </NoRecordsContent>
                    </MudTable>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <MudText Typo="Typo.caption">Page @_page of @_totalPages (@_totalCount total)</MudText>
                        <MudStack Row="true" Spacing="1">
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                            Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                            Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                        </MudStack>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Detail Panel -->
    @if (_selected is not null)
    {
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">Session: @_selected.Code</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@CountStatusColor(_selected.Status)" Variant="Variant.Filled">
                                @FormatCountStatus(_selected.Status)
                            </MudChip>
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <AMISIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="@(() => _selected = null)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-3">
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Scope</MudText>
                            <MudText Typo="Typo.body2">@FormatScope(_selected.Scope)</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                            <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">As At</MudText>
                            <MudText Typo="Typo.body2">@_selected.AsAt.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Conducted By</MudText>
                            <MudText Typo="Typo.body2">@string.Join(", ", _selected.ConductedBy.Select(c => c.PrintedName))</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Office Order No.</MudText>
                            <MudText Typo="Typo.body2">@(_selected.OfficeOrderNo ?? "—")</MudText>
                        </MudItem>
                        @if (_selected.FrozenOnUtc is not null)
                        {
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Ledger Frozen</MudText>
                                <MudText Typo="Typo.body2">@_selected.FrozenOnUtc.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText>
                            </MudItem>
                        }
                        @if (_selected.ApprovedBy is not null)
                        {
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Approved By</MudText>
                                <MudText Typo="Typo.body2">@_selected.ApprovedBy.PrintedName</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_selected.Remarks))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Remarks</MudText>
                                <MudText Typo="Typo.body2">@_selected.Remarks</MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    <!-- Entries summary -->
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        Count Entries (@_selected.Entries.Count)
                    </MudText>

                    <MudTable Items="_selected.Entries.Take(10)" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Property No.</MudTh>
                            <MudTh>Article</MudTh>
                            <MudTh>Unit</MudTh>
                            <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                            <MudTh>Condition</MudTh>
                            <MudTh>Scanned On</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(context.Snapshot?.PropertyNo ?? "—")</MudTd>
                            <MudTd>@context.SnapshotArticle</MudTd>
                            <MudTd>@context.SnapshotUnit</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotUnitCost.ToString("N2")</MudTd>
                            <MudTd>@FormatCountCondition(context.Condition)</MudTd>
                            <MudTd>@(context.ScannedOnUtc?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (_selected.Entries.Count > 10)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            Showing first 10 of @_selected.Entries.Count entries.
                        </MudText>
                    }

                    <!-- Draft → Freeze the ledger -->
                    @if (_selected.Status == PhysicalCountStatus.Draft && _canFreeze)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Activate Ledger Freeze</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Freezing locks all covered asset movements (issue / transfer / return / disposal) for fund
                            cluster <strong>@_selected.FundCluster</strong> (@FormatScope(_selected.Scope)) until the count is closed.
                        </MudAlert>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="_freezeOfficeOrderNo" Label="Office Order No." Variant="Variant.Outlined"
                                          Dense="true" Margin="Margin.Dense" MaxLength="100" Required="true"
                                          Placeholder="@(_selected.OfficeOrderNo ?? "e.g. OO-2026-014")" Style="flex:1;" />
                            <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                        StartIcon="@Icons.Material.Outlined.AcUnit" OnClick="FreezeAsync" Disabled="_busy">
                                Freeze Ledger
                            </AMISButton>
                        </MudStack>
                    }

                    <!-- Ongoing → record counted assets / add found-at-station + move to reconciliation -->
                    @if (_selected.Status == PhysicalCountStatus.Ongoing && _canRecord)
                    {
                        <MudDivider Class="my-3" />

                        <!-- Record a known registry asset by Property No. -->
                        <MudExpansionPanels Elevation="0" Class="mb-2">
                            <MudExpansionPanel Text="Record Counted Asset (by Property No.)" Expanded="true">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudTextField @bind-Value="_recordPropertyNo" Label="Property No." Variant="Variant.Outlined"
                                                  Dense="true" Margin="Margin.Dense" MaxLength="64" Immediate="true"
                                                  Placeholder="Scan or type, then Look Up"
                                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                                  OnAdornmentClick="LookupAssetAsync" OnKeyUp="OnRecordPropertyKeyUp" Style="flex:1;" />
                                    <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LookupAssetAsync" Disabled="_busy">
                                        Look Up
                                    </AMISButton>
                                </MudStack>

                                @if (_recordLookupTried && _recordedAsset is null)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                        <strong>@_recordPropertyNo</strong> is not in the registry. Add it as a Found-at-Station item below.
                                    </MudAlert>
                                }
                                @if (_recordedAsset is not null)
                                {
                                    <MudPaper Outlined="true" Class="pa-3 mt-2">
                                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                                            <MudItem xs="12" md="5">
                                                <MudText Typo="Typo.subtitle2">@_recordedAsset.PropertyNo</MudText>
                                                <MudText Typo="Typo.body2">@_recordedAsset.Description</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @_recordedAsset.Unit &nbsp;·&nbsp; @Money.Symbol@_recordedAsset.UnitCost.ToString("N2")
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudSelect T="PhysicalCountCondition" @bind-Value="_recordCondition" Label="Condition"
                                                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                    <MudSelectItem Value="PhysicalCountCondition.InGoodCondition">Good</MudSelectItem>
                                                    <MudSelectItem Value="PhysicalCountCondition.NeedingRepair">Needs Repair</MudSelectItem>
                                                    <MudSelectItem Value="PhysicalCountCondition.Unserviceable">Unserviceable</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="4">
                                                <MudAutocomplete T="LocationLookupDto" Label="Location" Variant="Variant.Outlined"
                                                                 Dense="true" Margin="Margin.Dense"
                                                                 @bind-Value="_recordLocation"
                                                                 SearchFunc="SearchLocationsAsync"
                                                                 ToStringFunc="@(l => l is null ? string.Empty : $"{l.Code} — {l.Name}")"
                                                                 ResetValueOnEmptyText="true" CoerceText="true"
                                                                 HelperText="Defaults to the asset's current location" />
                                            </MudItem>
                                            <MudItem xs="12" Class="d-flex justify-end">
                                                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                            StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="RecordCountedAsync" Disabled="_busy">
                                                    Record as Counted
                                                </AMISButton>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                    Look up an asset already in the registry and record its counted condition. Items not found are captured as Found-at-Station below.
                                </MudText>
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <MudExpansionPanels Elevation="0" Class="mb-2">
                            <MudExpansionPanel Text="Add Found-at-Station Item">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="ArCatalogItemDto" Label="Catalog Item" Variant="Variant.Outlined"
                                                         Dense="true" Margin="Margin.Dense" Required="true"
                                                         Value="_fasCatalog" ValueChanged="OnFasCatalogSelected"
                                                         SearchFunc="SearchCatalogAsync"
                                                         ToStringFunc="@(c => c is null ? string.Empty : $"{c.Code} — {c.Description}")"
                                                         ResetValueOnEmptyText="true" CoerceText="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudAutocomplete T="LocationLookupDto" Label="Location" Variant="Variant.Outlined"
                                                         Dense="true" Margin="Margin.Dense" Required="true"
                                                         @bind-Value="_fasLocation"
                                                         SearchFunc="SearchLocationsAsync"
                                                         ToStringFunc="@(l => l is null ? string.Empty : $"{l.Code} — {l.Name}")"
                                                         ResetValueOnEmptyText="true" CoerceText="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_fasForm.PropertyNo" Label="Assigned Property No." Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" MaxLength="64" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_fasForm.Article" Label="Article / Description" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" MaxLength="256" Required="true" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudTextField @bind-Value="_fasForm.Unit" Label="Unit" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" MaxLength="50" Required="true" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudNumericField @bind-Value="_fasForm.UnitCost" Label="Appraised Unit Cost" Variant="Variant.Outlined"
                                                         Dense="true" Margin="Margin.Dense" Min="0" T="decimal" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudDatePicker @bind-Date="_fasForm.AcquisitionDateNullable" Label="Acquisition Date (optional)"
                                                       Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" />
                                    </MudItem>
                                    <MudItem xs="6" md="3" Class="d-flex align-end">
                                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                                    StartIcon="@Icons.Material.Outlined.AddLocationAlt" OnClick="AddFoundAtStationAsync" Disabled="_busy">
                                            Add Item
                                        </AMISButton>
                                    </MudItem>
                                </MudGrid>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                    Property No. + catalog item are required so the item is recognized into the registry at close.
                                </MudText>
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        @if (_canSubmit)
                        {
                            <AMISButton Variant="Variant.Filled" Color="Color.Warning"
                                        StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="ReconcileAsync" Disabled="_busy">
                                Move to Reconciliation
                            </AMISButton>
                        }
                    }

                    <!-- Reconciliation variance panel (Ongoing or Reconciling) -->
                    @if (_selected.Status is PhysicalCountStatus.Ongoing or PhysicalCountStatus.Reconciled && _canView)
                    {
                        <MudDivider Class="my-3" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                            <MudText Typo="Typo.subtitle2">Reconciliation (Book vs Counted)</MudText>
                            <MudStack Row="true" Spacing="1">
                                <AMISButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadReconciliationAsync" Disabled="_busy">
                                    Compute Variances
                                </AMISButton>
                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                            StartIcon="@Icons.Material.Outlined.PictureAsPdf" OnClick="DownloadIcfAsync" Disabled="_busy">
                                    ICF
                                </AMISButton>
                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                            StartIcon="@Icons.Material.Outlined.PictureAsPdf" OnClick="@(() => DownloadAnnexAsync("b"))" Disabled="_busy">
                                    Annex B
                                </AMISButton>
                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                            StartIcon="@Icons.Material.Outlined.PictureAsPdf" OnClick="@(() => DownloadAnnexAsync("c"))" Disabled="_busy">
                                    Annex C
                                </AMISButton>
                            </MudStack>
                        </MudStack>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            For PPE items without a Property No., provide in the <strong>Remarks</strong> column other
                            information such as Serial No. / Model No. / brief description that can be useful during the
                            reconciliation process.
                        </MudAlert>
                        @if (_recon is not null)
                        {
                            <MudStack Row="true" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Matched: @_recon.MatchedCount</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Shortages: @_recon.ShortageCount</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Overages: @_recon.OverageCount</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Uncounted: @_recon.UncountedCount</MudChip>
                            </MudStack>
                            <MudTable Items="_recon.Rows" Dense="true" Striped="true" FixedHeader="true" Height="320px" T="ArReconciliationRowDto">
                                <HeaderContent>
                                    <MudTh>Property No.</MudTh>
                                    <MudTh>Article</MudTh>
                                    <MudTh Style="text-align:right">Book</MudTh>
                                    <MudTh Style="text-align:right">Counted</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Action</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@(context.PropertyNo ?? "—")</MudTd>
                                    <MudTd>@context.Article</MudTd>
                                    <MudTd Style="text-align:right">@context.BookQty</MudTd>
                                    <MudTd Style="text-align:right">@context.CountedQty</MudTd>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@RowStatusColor(context.RowStatus)">
                                            @RowStatusLabel(context.RowStatus)
                                        </MudChip>
                                        @if (context.NeedsRecount)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-1">Recount</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd>
                                        @if (_selected.Status == PhysicalCountStatus.Ongoing
                                             && context.RowStatus == ArReconciliationRowStatus.Uncounted
                                             && context.AssetRegistryId is not null && context.LocationId is not null && _canRecord)
                                        {
                                            <AMISButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                        OnClick="@(() => MarkMissingAsync(context))" Disabled="_busy">Mark Missing</AMISButton>
                                        }
                                        else if (_selected.Status == PhysicalCountStatus.Reconciled
                                                 && context.EntryId is not null && !context.NeedsRecount && _canSubmit)
                                        {
                                            <AMISButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                        OnClick="@(() => TriggerRecountAsync(context))" Disabled="_busy">Trigger Recount</AMISButton>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }

                    <!-- Reconciling → Close / sign off -->
                    @if (_selected.Status == PhysicalCountStatus.Reconciled && _canClose)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Finalize &amp; Sign Off</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Closing recognizes found-at-station items into the registry, drops missing &amp; uncounted
                            assets to investigation, and lifts the freeze. Found-at-station items must have an assigned
                            Property No. and catalog item, or close is rejected.
                        </MudAlert>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_closeForm.ApprovedByName" Label="Approved By (Name)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" MaxLength="100" Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_closeForm.ApprovedByDesignation" Label="Designation" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" MaxLength="100" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_closeForm.Station" Label="Station / Office (optional)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudDatePicker @bind-Date="_closeForm.ClosedOnNullable" Label="Closed On" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-end">
                                <AMISButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                            OnClick="CloseSessionAsync" Disabled="_busy">
                                    Finalize &amp; Sign Off
                                </AMISButton>
                            </MudItem>
                        </MudGrid>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private bool _busy;
    private string? _error;
    private string? _keyword;
    private PhysicalCountStatus? _statusFilter;
    private PhysicalCountScope? _scopeFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private IReadOnlyList<ArPhysicalCountSummaryDto> _items = [];
    private ArPhysicalCountSessionDto? _selected;

    private CloseFormModel _closeForm = new();

    private sealed class CloseFormModel
    {
        public string ApprovedByName { get; set; } = "";
        public string? ApprovedByDesignation { get; set; }
        public string? Station { get; set; }
        public DateTime? ClosedOnNullable { get; set; }
    }

    private string? _freezeOfficeOrderNo;
    private ArReconciliationReportDto? _recon;

    private FoundAtStationFormModel _fasForm = new();
    private ArCatalogItemDto? _fasCatalog;
    private LocationLookupDto? _fasLocation;

    // Record-counted-asset (by Property No.) panel
    private string _recordPropertyNo = "";
    private AssetRegistryDto? _recordedAsset;
    private bool _recordLookupTried;
    private PhysicalCountCondition _recordCondition = PhysicalCountCondition.InGoodCondition;
    private LocationLookupDto? _recordLocation;

    private sealed class FoundAtStationFormModel
    {
        public string PropertyNo { get; set; } = "";
        public string Article { get; set; } = "";
        public string Unit { get; set; } = "pc";
        public decimal UnitCost { get; set; }
        public DateTime? AcquisitionDateNullable { get; set; }
    }

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.Create);
    private bool _canFreeze => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.Freeze);
    private bool _canView   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.View);
    private bool _canRecord => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.Record);
    private bool _canSubmit => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.Submit);
    private bool _canClose  => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Count.Close);
    private bool _canViewSigned   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.View);
    private bool _canUploadSigned => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.Upload);

    // The RPCPPE/RPCSE is signed off when the count is Closed.
    private static bool IsSigned(PhysicalCountStatus s) => s == PhysicalCountStatus.Closed;

    private async Task OpenSignedCopyAsync(ArPhysicalCountSummaryDto item)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, AssetRegisterDocumentType.PhysicalCountReport },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.Code) ? "(no count code)" : item.Code },
            { x => x.IsTerminalState, IsSigned(item.Status) }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == item.Id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.SearchAsync(_keyword, _statusFilter, _scopeFilter, _page, PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<ArPhysicalCountSummaryDto> args)
    {
        _busy = true;
        try
        {
            _selected = await Client.GetAsync(args.Item.Id);
            _closeForm = new();
            _recon = null;
            _freezeOfficeOrderNo = _selected?.OfficeOrderNo;
            if (_selected is not null && _selected.Status is PhysicalCountStatus.Ongoing or PhysicalCountStatus.Reconciled && _canView)
                await LoadReconciliationAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenStartDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<StartPhysicalCountDialog>("Start Physical Count Session", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: true })
            await LoadAsync();
    }

    private async Task CloseSessionAsync()
    {
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_closeForm.ApprovedByName) || !_closeForm.ClosedOnNullable.HasValue)
        {
            Snackbar.Add("Approved By and Closed On are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var approvedBy = new ArEmployeeRefDto(Guid.Empty, _closeForm.ApprovedByName.Trim(), _closeForm.ApprovedByDesignation);
            var req = new ClosePhysicalCountRequest(approvedBy, null, DateOnly.FromDateTime(_closeForm.ClosedOnNullable.Value),
                string.IsNullOrWhiteSpace(_closeForm.Station) ? null : _closeForm.Station.Trim());
            _selected = await Client.CloseAsync(_selected.Id, req);
            Snackbar.Add("Session signed off. Found-at-station items recognized; missing & uncounted assets routed to investigation.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FreezeAsync()
    {
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_freezeOfficeOrderNo))
        {
            Snackbar.Add("An Office Order No. is required to freeze the ledger.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            _selected = await Client.FreezeAsync(_selected.Id, _freezeOfficeOrderNo.Trim());
            Snackbar.Add("Ledger frozen. Covered asset movements are now blocked.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task<IEnumerable<ArCatalogItemDto>> SearchCatalogAsync(string? value, CancellationToken ct)
    {
        var result = await CatalogClient.SearchAsync(value, isActive: true, page: 1, pageSize: 20, ct);
        return result.Items;
    }

    private void OnFasCatalogSelected(ArCatalogItemDto? catalog)
    {
        _fasCatalog = catalog;
        // Pre-fill article/unit from the catalog default to reduce typing; operator can override.
        if (catalog is not null)
        {
            if (string.IsNullOrWhiteSpace(_fasForm.Article)) _fasForm.Article = catalog.Description;
            if (string.IsNullOrWhiteSpace(_fasForm.Unit) || _fasForm.Unit == "pc") _fasForm.Unit = catalog.DefaultUnit;
        }
    }

    private async Task<IEnumerable<LocationLookupDto>> SearchLocationsAsync(string? value, CancellationToken ct) =>
        await LocationClient.SearchAsync(value, pageSize: 20, ct);

    private async Task AddFoundAtStationAsync()
    {
        if (_selected is null) return;
        if (_fasCatalog is null || _fasLocation is null
            || string.IsNullOrWhiteSpace(_fasForm.PropertyNo) || string.IsNullOrWhiteSpace(_fasForm.Article)
            || string.IsNullOrWhiteSpace(_fasForm.Unit))
        {
            Snackbar.Add("Catalog item, location, Property No., article and unit are required.", Severity.Warning);
            return;
        }
        if (_fasForm.UnitCost <= 0)
        {
            Snackbar.Add("An appraised unit cost greater than zero is required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var req = new ArAddFoundAtStationRequest(
                _selected.Id,
                _fasForm.Article.Trim(),
                _fasForm.Unit.Trim(),
                _fasForm.UnitCost,
                _fasLocation.Id,
                ProposedUnitCost: _fasForm.UnitCost,
                ProposedAcquisitionDate: _fasForm.AcquisitionDateNullable is { } d ? DateOnly.FromDateTime(d) : null,
                ProposedPropertyNo: _fasForm.PropertyNo.Trim().ToUpperInvariant(),
                ProposedCatalogItemId: _fasCatalog.Id);
            _selected = await Client.AddFoundAtStationAsync(_selected.Id, req);
            await LoadReconciliationAsync();
            Snackbar.Add($"Found-at-station item '{_fasForm.Article}' added.", Severity.Success);
            _fasForm = new();
            _fasCatalog = null;
            _fasLocation = null;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task OnRecordPropertyKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await LookupAssetAsync();
    }

    private async Task LookupAssetAsync()
    {
        var pno = _recordPropertyNo.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(pno)) { Snackbar.Add("Enter a property number to look up.", Severity.Warning); return; }

        _busy = true;
        _recordLookupTried = false;
        _recordedAsset = null;
        try
        {
            _recordPropertyNo = pno;
            _recordedAsset = await AssetClient.GetByPropertyNoAsync(pno);
            _recordLookupTried = true;
            if (_recordedAsset is not null)
            {
                _recordCondition = MapAssetConditionToCount(_recordedAsset.CurrentCondition);
                _recordLocation = null; // falls back to the asset's current location on record
            }
        }
        catch (Exception ex) { Snackbar.Add($"Lookup failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RecordCountedAsync()
    {
        if (_selected is null || _recordedAsset is null) return;

        var locationId = _recordLocation?.Id ?? _recordedAsset.CurrentLocationId ?? Guid.Empty;
        if (locationId == Guid.Empty)
        {
            Snackbar.Add("Select a location — this asset has no current location on record.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var req = new ArRecordPhysicalCountEntryRequest(
                _recordedAsset.Id,
                _recordedAsset.Description,
                _recordedAsset.Unit,
                _recordedAsset.UnitCost,
                _recordCondition,
                locationId);
            _selected = await Client.RecordEntryAsync(_selected.Id, req);
            await LoadReconciliationAsync();
            Snackbar.Add($"Recorded '{_recordedAsset.PropertyNo}' as counted.", Severity.Success);
            _recordPropertyNo = "";
            _recordedAsset = null;
            _recordLookupTried = false;
            _recordLocation = null;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private static PhysicalCountCondition MapAssetConditionToCount(AssetCondition c) => c switch
    {
        AssetCondition.NeedingRepair => PhysicalCountCondition.NeedingRepair,
        AssetCondition.Unserviceable => PhysicalCountCondition.Unserviceable,
        _ => PhysicalCountCondition.InGoodCondition
    };

    private async Task ReconcileAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            _selected = await Client.ReconcileAsync(_selected.Id);
            await LoadReconciliationAsync();
            Snackbar.Add("Session moved to reconciliation.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task LoadReconciliationAsync()
    {
        if (_selected is null) return;
        try { _recon = await Client.GetReconciliationAsync(_selected.Id); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task MarkMissingAsync(ArReconciliationRowDto row)
    {
        if (_selected is null || row.AssetRegistryId is null || row.LocationId is null) return;
        _busy = true;
        try
        {
            _selected = await Client.MarkMissingAsync(_selected.Id,
                new ArMarkMissingRequest(_selected.Id, row.AssetRegistryId.Value, row.LocationId.Value));
            await LoadReconciliationAsync();
            Snackbar.Add($"'{row.Article}' marked missing.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task TriggerRecountAsync(ArReconciliationRowDto row)
    {
        if (_selected is null || row.EntryId is null) return;
        _busy = true;
        try
        {
            _selected = await Client.RequestRecountAsync(_selected.Id, row.EntryId.Value, null);
            await LoadReconciliationAsync();
            Snackbar.Add($"'{row.Article}' flagged for recount.", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DownloadIcfAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            var bytes = await Client.GetInventoryCountFormPdfAsync(_selected.Id);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("Inventory Count Form (Annex A) ready.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DownloadAnnexAsync(string annexKind)
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            var bytes = await Client.GetCountAnnexPdfAsync(_selected.Id, annexKind);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add($"Annex {annexKind.ToUpperInvariant()} ready.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private static Color RowStatusColor(ArReconciliationRowStatus s) => s switch
    {
        ArReconciliationRowStatus.Matched => Color.Success,
        ArReconciliationRowStatus.Shortage => Color.Error,
        ArReconciliationRowStatus.Overage => Color.Warning,
        ArReconciliationRowStatus.Uncounted => Color.Default,
        _ => Color.Default
    };

    private static string RowStatusLabel(ArReconciliationRowStatus s) => s switch
    {
        ArReconciliationRowStatus.Matched => "Matched",
        ArReconciliationRowStatus.Shortage => "Shortage",
        ArReconciliationRowStatus.Overage => "Overage",
        ArReconciliationRowStatus.Uncounted => "Uncounted",
        _ => s.ToString()
    };

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private async Task OnStatusChanged(PhysicalCountStatus? value) { _statusFilter = value; _page = 1; await LoadAsync(); }
    private async Task OnScopeChanged(PhysicalCountScope? value) { _scopeFilter = value; _page = 1; await LoadAsync(); }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private static string FormatScope(PhysicalCountScope v) => v switch
    {
        PhysicalCountScope.PPEOnly => "PPE",
        PhysicalCountScope.SEOnly => "Semi-Expendable",
        PhysicalCountScope.Both => "All Assets",
        _ => v.ToString()
    };
    private static string FormatCountStatus(PhysicalCountStatus v) => v switch
    {
        PhysicalCountStatus.Draft => "Draft",
        PhysicalCountStatus.Ongoing => "Frozen / Counting",
        PhysicalCountStatus.Reconciled => "Reconciling",
        PhysicalCountStatus.Closed => "Closed",
        _ => v.ToString()
    };
    private static Color CountStatusColor(PhysicalCountStatus v) => v switch
    {
        PhysicalCountStatus.Draft => Color.Default,
        PhysicalCountStatus.Ongoing => Color.Info,
        PhysicalCountStatus.Reconciled => Color.Warning,
        PhysicalCountStatus.Closed => Color.Success,
        _ => Color.Default
    };
    private static string FormatCountCondition(PhysicalCountCondition v) => v switch
    {
        PhysicalCountCondition.InGoodCondition => "Good",
        PhysicalCountCondition.NeedingRepair => "Needs Repair",
        PhysicalCountCondition.Unserviceable => "Unserviceable",
        PhysicalCountCondition.Missing => "Missing",
        PhysicalCountCondition.FoundAtStation => "Found at Station",
        _ => v.ToString()
    };
}

