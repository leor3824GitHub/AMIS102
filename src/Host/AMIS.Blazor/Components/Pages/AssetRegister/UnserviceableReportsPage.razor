@page "/asset-register/unserviceable"
@implements IDisposable
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using ArContracts = AMIS.Modules.AssetRegister.Contracts.v1
@using UnserviceableReportType = AMIS.Modules.AssetRegister.Contracts.v1.UnserviceableReportType
@using UnserviceableReportStatus = AMIS.Modules.AssetRegister.Contracts.v1.UnserviceableReportStatus
@using DisposalMethod = AMIS.Modules.AssetRegister.Contracts.v1.DisposalMethod
@using AMIS.Modules.AssetRegister.Contracts.v1.SignedDocuments
@inject IArUnserviceableReportClient Client
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IDialogService DialogService

<AMISPageHeader Title="Unserviceable Property Reports (IIRUSP / IIRUP)"
               Description="Report, inspect, and dispose of unserviceable property per COA 2022-004 Annex A.10." />

<MudGrid Spacing="3">
    <!-- Filters -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Report No. / Keyword" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                        Search
                    </AMISButton>
                    @if (_canFile)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreateDialogAsync">
                            New Report
                        </AMISButton>
                    }
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                    <AMISEnumChips TEnum="UnserviceableReportType" Value="_typeFilter" ValueChanged="OnTypeChanged"
                                   Label="Report Type" Class="mb-0" />
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                    <AMISEnumChips TEnum="UnserviceableReportStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                                   Label="Status" LabelFunc="FormatUnserviceableStatus" Class="mb-0" />
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Results -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else
                {
                    <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                              OnRowClick="OnRowClick" T="ArUnserviceableReportSummaryDto" RowClass="cursor-pointer">
                        <HeaderContent>
                            <MudTh>Report No.</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>As At</MudTh>
                            <MudTh Style="text-align:right">Items</MudTh>
                            <MudTh Style="text-align:center">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.ReportNo</strong></MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.ReportType == UnserviceableReportType.IIRUSP ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(context.ReportType == UnserviceableReportType.IIRUSP ? "IIRUSP" : "IIRUP")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@UnserviceableStatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @FormatUnserviceableStatus(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.AsAt.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd Style="text-align:right">@context.ItemCount</MudTd>
                            <MudTd Style="text-align:center" @onclick:stopPropagation="true">
                                @if (IsSigned(context.Status) && (context.HasSignedCopy ? _canViewSigned : _canUploadSigned))
                                {
                                    <MudTooltip Text="@(context.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                        Color="@(context.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                        OnClick="@(() => OpenSignedCopyAsync(context))" />
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No unserviceable reports found.</MudText>
                        </NoRecordsContent>
                    </MudTable>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <MudText Typo="Typo.caption">Page @_page of @_totalPages (@_totalCount total)</MudText>
                        <MudStack Row="true" Spacing="1">
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                            Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                            Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                        </MudStack>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Detail panel -->
    @if (_selected is not null)
    {
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@_selected.ReportNo</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@UnserviceableStatusColor(_selected.Status)" Variant="Variant.Filled">
                                @FormatUnserviceableStatus(_selected.Status)
                            </MudChip>
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <AMISIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="@(() => _selected = null)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-3">
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Report Type</MudText>
                            <MudText Typo="Typo.body2">@(_selected.ReportType == UnserviceableReportType.IIRUSP ? "IIRUSP (SE)" : "IIRUP (PPE)")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">As At</MudText>
                            <MudText Typo="Typo.body2">@_selected.AsAt.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                            <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Station</MudText>
                            <MudText Typo="Typo.body2">@_selected.Station</MudText>
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Accountable Officer</MudText>
                            <MudText Typo="Typo.body2">@_selected.AccountableOfficer.PrintedName (@(_selected.AccountableOfficer.Designation ?? "—"))</MudText>
                        </MudItem>
                        @if (_selected.ApprovedBy is not null)
                        {
                            <MudItem xs="6" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Approved By</MudText>
                                <MudText Typo="Typo.body2">@_selected.ApprovedBy.PrintedName</MudText>
                            </MudItem>
                        }
                        @if (_selected.InspectedBy is not null)
                        {
                            <MudItem xs="6" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Inspected By / On</MudText>
                                <MudText Typo="Typo.body2">@_selected.InspectedBy.PrintedName — @_selected.InspectedOn?.ToString("yyyy-MM-dd")</MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Property Items (@_selected.Items.Count)</MudText>
                    <MudTable Items="_selected.Items" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Property No.</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Date Acquired</MudTh>
                            <MudTh Style="text-align:right">Acq. Cost (@Money.Symbol)</MudTh>
                            <MudTh Style="text-align:right">Accum. Depr. (@Money.Symbol)</MudTh>
                            <MudTh Style="text-align:right">Carrying Amt (@Money.Symbol)</MudTh>
                            <MudTh>Disposal Method</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Snapshot.PropertyNo</MudTd>
                            <MudTd>@context.Snapshot.Description</MudTd>
                            <MudTd>@context.SnapshotDateAcquired.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotAcquisitionCost.ToString("N2")</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotAccumulatedDepreciation.ToString("N2")</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotCarryingAmount.ToString("N2")</MudTd>
                            <MudTd>@(context.DisposalMethod.HasValue ? FormatDisposalMethod(context.DisposalMethod.Value) : "Pending")</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <!-- Add item (Draft only) -->
                    @if (_selected.Status == UnserviceableReportStatus.Draft && _canFile)
                    {
                        <MudDivider Class="my-3" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                            <MudText Typo="Typo.subtitle2">Add Asset Items</MudText>
                            <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                        StartIcon="@Icons.Material.Outlined.PlaylistAddCheck"
                                        OnClick="OpenCandidatesPickerAsync" Disabled="_busy">
                                Add unserviceable candidates
                            </AMISButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            Pull assets already returned and inspected as Unserviceable (back in the Available pool),
                            or paste a specific Asset Registry Id below.
                        </MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                            <MudTextField @bind-Value="_addItemAssetId" Label="Asset Registry Id (GUID)" Variant="Variant.Outlined"
                                          Style="flex:1;" Placeholder="Paste asset registry id" />
                            <MudTextField @bind-Value="_addItemRemarks" Label="Remarks (optional)" Variant="Variant.Outlined"
                                          Style="flex:1;" MaxLength="500" />
                            <AMISButton Variant="Variant.Outlined" Color="Color.Primary"
                                        OnClick="AddItemAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_addItemAssetId)">
                                Add Item
                            </AMISButton>
                        </MudStack>
                    }

                    <!-- Submit (Draft → Submitted) -->
                    @if (_selected.Status == UnserviceableReportStatus.Draft && _selected.Items.Count > 0 && _canFile)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Submit for Approval</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                            <MudTextField @bind-Value="_submitApprovedByName" Label="Approved By (Name)" Variant="Variant.Outlined"
                                          Style="flex:1;" MaxLength="100" Required="true" />
                            <MudTextField @bind-Value="_submitApprovedByDesignation" Label="Designation" Variant="Variant.Outlined"
                                          Style="width:200px;" MaxLength="100" />
                            <AMISButton Variant="Variant.Filled" Color="Color.Warning"
                                        OnClick="SubmitReportAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_submitApprovedByName)">
                                Submit
                            </AMISButton>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private bool _busy;
    private string? _error;
    private string? _keyword;
    private UnserviceableReportType? _typeFilter;
    private UnserviceableReportStatus? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private IReadOnlyList<ArUnserviceableReportSummaryDto> _items = [];
    private ArUnserviceableReportDto? _selected;

    // Add item
    private string? _addItemAssetId;
    private string? _addItemRemarks;

    // Submit
    private string? _submitApprovedByName;
    private string? _submitApprovedByDesignation;

    private bool _canFile => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Unserviceable.File);
    private bool _canViewSigned   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.View);
    private bool _canUploadSigned => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.Upload);

    // The IIRUP/IIRUSP is fully signed once the inspection/disposal is recorded (or the report is closed).
    private static bool IsSigned(UnserviceableReportStatus s) =>
        s is UnserviceableReportStatus.DisposalRecorded or UnserviceableReportStatus.Closed;

    private async Task OpenSignedCopyAsync(ArUnserviceableReportSummaryDto item)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, AssetRegisterDocumentType.UnserviceableReport },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.ReportNo) ? "(no report number)" : item.ReportNo },
            { x => x.IsTerminalState, IsSigned(item.Status) }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == item.Id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.SearchAsync(_keyword, _typeFilter, _statusFilter, _page, PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<ArUnserviceableReportSummaryDto> args)
    {
        _busy = true;
        try
        {
            _selected = await Client.GetAsync(args.Item.Id);
            _addItemAssetId = null;
            _addItemRemarks = null;
            _submitApprovedByName = null;
            _submitApprovedByDesignation = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<CreateUnserviceableReportDialog>("Create Unserviceable Report", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ArUnserviceableReportDto created })
        {
            _selected = created;
            _addItemAssetId = null;
            _addItemRemarks = null;
            _submitApprovedByName = null;
            _submitApprovedByDesignation = null;
            await LoadAsync();
        }
    }

    private async Task OpenCandidatesPickerAsync()
    {
        if (_selected is null) return;

        // IIRUSP holds SE assets; IIRUP holds PPE. Restrict the candidate list to the report's type.
        var reportId = _selected.Id;
        var assetType = _selected.ReportType == UnserviceableReportType.IIRUSP
            ? ArContracts.AssetType.SE
            : ArContracts.AssetType.PPE;
        var excludeIds = _selected.Items.Select(i => i.AssetRegistryId).ToList();

        var parameters = new DialogParameters<UnserviceableCandidatesPickerDialog>
        {
            { x => x.AssetType, assetType },
            { x => x.ExcludeIds, excludeIds }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<UnserviceableCandidatesPickerDialog>("Add Unserviceable Candidates", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: List<AssetRegistrySummaryDto> picked } || picked.Count == 0)
            return;

        _busy = true;
        try
        {
            // AddItem is one call per asset; each returns the refreshed report, so _selected stays current.
            foreach (var asset in picked)
                _selected = await Client.AddItemAsync(reportId, new AddUnserviceableReportItemRequest(asset.Id));
            Snackbar.Add($"Added {picked.Count} item(s).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddItemAsync()
    {
        if (_selected is null || !Guid.TryParse(_addItemAssetId, out var assetId))
        {
            Snackbar.Add("Enter a valid Asset Registry Id.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            _selected = await Client.AddItemAsync(_selected.Id, new AddUnserviceableReportItemRequest(assetId, _addItemRemarks));
            _addItemAssetId = null;
            _addItemRemarks = null;
            Snackbar.Add("Item added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitReportAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_submitApprovedByName)) return;
        _busy = true;
        try
        {
            var req = new SubmitUnserviceableReportRequest(
                new ArEmployeeRefDto(Guid.Empty, _submitApprovedByName.Trim(), _submitApprovedByDesignation));
            _selected = await Client.SubmitAsync(_selected.Id, req);
            Snackbar.Add("Report submitted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private async Task OnTypeChanged(UnserviceableReportType? value) { _typeFilter = value; _page = 1; await LoadAsync(); }
    private async Task OnStatusChanged(UnserviceableReportStatus? value) { _statusFilter = value; _page = 1; await LoadAsync(); }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private static string FormatUnserviceableStatus(UnserviceableReportStatus v) => v switch
    {
        UnserviceableReportStatus.Draft => "Draft",
        UnserviceableReportStatus.Submitted => "Submitted",
        UnserviceableReportStatus.InspectionDone => "Inspection Done",
        UnserviceableReportStatus.DisposalRecorded => "Disposal Recorded",
        UnserviceableReportStatus.Closed => "Closed",
        _ => v.ToString()
    };
    private static Color UnserviceableStatusColor(UnserviceableReportStatus v) => v switch
    {
        UnserviceableReportStatus.Draft => Color.Default,
        UnserviceableReportStatus.Submitted => Color.Warning,
        UnserviceableReportStatus.InspectionDone => Color.Info,
        UnserviceableReportStatus.DisposalRecorded => Color.Primary,
        UnserviceableReportStatus.Closed => Color.Success,
        _ => Color.Default
    };
    private static string FormatDisposalMethod(DisposalMethod v) => v switch
    {
        DisposalMethod.Sale => "Sale",
        DisposalMethod.Transfer => "Transfer",
        DisposalMethod.Destruction => "Destruction",
        DisposalMethod.Other => "Other",
        _ => v.ToString()
    };
}

