@page "/asset-register/accountability"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.v1.SignedDocuments
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Services.AssetRegister
@using AMIS.Blazor.Components.Pages.Procurement
@inject IArAccountabilityClient Client
@inject IAssetRegisterReportsClient ReportsClient
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS
@inject IPdfDownloadService PdfDownload

<AMISPageHeader Title="Property Accountability (ICS / PAR)"
               Description="Unified accountability tracking for Semi-Expendable (ICS) and PPE (PAR) per COA 2022-004." />

<!-- Filters + Results -->
<div>
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Keyword / Document No." Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync">
                        Search
                    </AMISButton>
                    @if (_canIssue)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenIssueDialogAsync">
                            New ICS / PAR
                        </AMISButton>
                    }
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                    <AMISEnumChips TEnum="AccountabilityType" Value="_typeFilter" ValueChanged="OnTypeChanged"
                                   Label="Type" LabelFunc="AccountabilityTypeLabel" Class="mb-0" />
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                    <AMISEnumChips TEnum="AccountabilityStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                                   Label="Status" LabelFunc="FormatStatus" Class="mb-0" />
                </MudStack>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                <AMISDataTable @ref="_table" T="ArAccountabilitySummaryDto" ServerData="LoadServerData"
                               EmptyMessage="No accountability documents found.">
                        <HeaderContent>
                            <MudTh>Document No.</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Issued On</MudTh>
                            <MudTh>Expires On</MudTh>
                            <MudTh Style="text-align:right">Lines</MudTh>
                            <MudTh Style="text-align:center">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Document No."><strong>@context.DocumentNo</strong></MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.AccountabilityType == AccountabilityType.SE_ICS ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@StatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @FormatStatus(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Issued On">@context.IssuedOn.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Expires On">@(context.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                            <MudTd DataLabel="Lines" Style="text-align:right">@context.LineCount</MudTd>
                            <MudTd DataLabel="Actions" Style="text-align:center">
                                <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                                    <MudTooltip Text="View">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                        Color="Color.Default" OnClick="@(() => OpenViewDialogAsync(context.Id))" />
                                    </MudTooltip>
                                    <MudMenu Icon="@Icons.Material.Filled.PictureAsPdf"
                                             Color="Color.Secondary"
                                             Size="Size.Small"
                                             Dense="true"
                                             AnchorOrigin="Origin.BottomLeft"
                                             TransformOrigin="Origin.TopLeft"
                                             ToolTip="@($"Print {(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")}")"
                                             Disabled="@(_printingId == context.Id)">
                                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                     OnClick="@(() => PrintRowAsync(context))">
                                            Print @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Tune"
                                                     OnClick="@(() => OpenPrintSetupAsync(context))">
                                            Page Setup…
                                        </MudMenuItem>
                                    </MudMenu>
                                    <MudMenu Icon="@Icons.Material.Filled.QrCode2"
                                             Color="Color.Default"
                                             Size="Size.Small"
                                             Dense="true"
                                             AnchorOrigin="Origin.BottomLeft"
                                             TransformOrigin="Origin.TopLeft"
                                             ToolTip="Print property stickers (choose paper size)"
                                             Disabled="@(_stickersId == context.Id)">
                                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                     OnClick="@(() => PrintStickersAsync(context, "longbond"))">
                                            Stickers - Long Bond (8.5 x 13)
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                     OnClick="@(() => PrintStickersAsync(context, "a4"))">
                                            Stickers - A4
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                     OnClick="@(() => PrintStickersAsync(context, "legal"))">
                                            Stickers - Legal (8.5 x 14)
                                        </MudMenuItem>
                                    </MudMenu>
                                    @if (context.Status == AccountabilityStatus.PendingAcceptance && _canUpdate)
                                    {
                                        <MudTooltip Text="Edit">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                            Color="Color.Primary" OnClick="@(() => OpenEditDialogAsync(context.Id))" />
                                        </MudTooltip>
                                    }
                                    @if (context.Status == AccountabilityStatus.PendingAcceptance && _canDelete)
                                    {
                                        <MudTooltip Text="Delete">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                            Color="Color.Error" OnClick="@(() => DeleteRowAsync(context))" />
                                        </MudTooltip>
                                    }
                                    @if (IsAccepted(context.Status) && (context.HasSignedCopy ? _canViewSigned : _canUploadSigned))
                                    {
                                        <MudTooltip Text="@(context.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                            Color="@(context.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                            OnClick="@(() => OpenSignedCopyAsync(context))" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
</div>

@code {
    private AMISDataTable<ArAccountabilitySummaryDto>? _table;
    private Guid? _printingId;
    private Guid? _stickersId;
    private string? _keyword;
    private AccountabilityType? _typeFilter;
    private AccountabilityStatus? _statusFilter;

    [SupplyParameterFromQuery(Name = "id")]
    public Guid? QueryId { get; set; }

    private bool _canIssue  => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Issue);
    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Delete);
    private bool _canViewSigned   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.View);
    private bool _canUploadSigned => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.Upload);

    // The ICS/PAR is wet-signed once the accountable employee accepts it — i.e. any post-PendingAcceptance,
    // non-Cancelled state. Mirrors the server's AcceptedOn guard.
    private static bool IsAccepted(AccountabilityStatus s) =>
        s is AccountabilityStatus.Active or AccountabilityStatus.Renewed or AccountabilityStatus.Returned;

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        // AMISDataTable auto-loads via ServerData on first render.
        if (QueryId.HasValue)
            await OpenViewDialogAsync(QueryId.Value);
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task<TableData<ArAccountabilitySummaryDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var result = await Client.SearchAsync(_keyword, _typeFilter, _statusFilter, page: state.Page + 1, pageSize: state.PageSize);
            return new TableData<ArAccountabilitySummaryDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load accountability: {ex.Message}", Severity.Error);
            return new TableData<ArAccountabilitySummaryDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task LoadAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    // ── Create ICS / PAR ─────────────────────────────────────────────────────

    private async Task OpenIssueDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueAccountabilityDialog>("New ICS / PAR", options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return;

        await LoadAsync();
    }

    // ── Row actions ──────────────────────────────────────────────────────────

    private async Task OpenViewDialogAsync(Guid id)
    {
        var parameters = new DialogParameters<AccountabilityDetailDialog> { { x => x.Id, id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AccountabilityDetailDialog>("Accountability Detail", parameters, options);
        var result = await dialog.Result;
        // Renew/Cancel inside the dialog mutate the record — reload the list if anything changed.
        if (result is not null && !result.Canceled && result.Data is true)
            await LoadAsync();
    }

    private async Task OpenEditDialogAsync(Guid id)
    {
        var parameters = new DialogParameters<EditAccountabilityDialog> { { x => x.Id, id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditAccountabilityDialog>("Edit Accountability", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task DeleteRowAsync(ArAccountabilitySummaryDto item)
    {
        var label = item.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR";
        var confirmed = await DialogService.ShowMessageBox(
            $"Delete {label}?",
            $"Permanently delete {label} {item.DocumentNo} and release its reserved assets back to Available? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            await Client.DeleteAsync(item.Id);
            Snackbar.Add($"{label} {item.DocumentNo} deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    // Both ICS and PAR use a single landscape "2-up" Fast Report template (two copies
    // side by side, cut down the middle). Landscape = 2 per page; portrait = 1 per page.
    private const string FastReportKey = "accountability";

    private async Task PrintRowAsync(ArAccountabilitySummaryDto item)
    {
        _printingId = item.Id;
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await Client.GetFastReportPdfAsync(item.Id, item.AccountabilityType,
                pageWidth: saved?.PaperSize ?? "longbond",
                orientation: saved?.Orientation ?? "landscape",
                minRows: saved?.MinRows ?? 15);
            await PdfDownload.OpenInNewTabAsync(bytes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _printingId = null;
        }
    }

    private async Task OpenPrintSetupAsync(ArAccountabilitySummaryDto item)
    {
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "longbond",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "landscape",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 2,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 15,
            [nameof(FastReportPageSetupDialog.ShowOrientation)] = false
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        _printingId = item.Id;
        try
        {
            var bytes = await Client.GetFastReportPdfAsync(item.Id, item.AccountabilityType,
                pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _printingId = null;
        }
    }

    private async Task PrintStickersAsync(ArAccountabilitySummaryDto item, string paperSize)
    {
        _stickersId = item.Id;
        try
        {
            var bytes = item.AccountabilityType == AccountabilityType.SE_ICS
                ? await ReportsClient.GetIcsStickersPdfAsync(item.Id, paperSize)
                : await ReportsClient.GetParStickersPdfAsync(item.Id, paperSize);
            await PdfDownload.OpenInNewTabAsync(bytes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sticker generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _stickersId = null;
        }
    }

    private async Task OpenSignedCopyAsync(ArAccountabilitySummaryDto item)
    {
        var label = item.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR";
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, AssetRegisterDocumentType.PropertyAccountability },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.DocumentNo) ? $"(no {label} number)" : item.DocumentNo },
            { x => x.IsTerminalState, IsAccepted(item.Status) }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — reload so the row's HasSignedCopy (computed server-side
        // via EXISTS) turns the icon green.
        if (result is { Canceled: false, Data: true })
        {
            await LoadAsync();
        }
    }

    private async Task OnTypeChanged(AccountabilityType? value) { _typeFilter = value; await LoadAsync(); }
    private async Task OnStatusChanged(AccountabilityStatus? value) { _statusFilter = value; await LoadAsync(); }

    private static string AccountabilityTypeLabel(AccountabilityType t) => t switch
    {
        AccountabilityType.SE_ICS => "ICS (SE)",
        AccountabilityType.PPE_PAR => "PAR (PPE)",
        _ => t.ToString()
    };

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private static string FormatStatus(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => "Active",
        AccountabilityStatus.Renewed => "Renewed",
        AccountabilityStatus.Returned => "Returned",
        AccountabilityStatus.Cancelled => "Cancelled",
        AccountabilityStatus.PendingAcceptance => "Pending Acceptance",
        _ => v.ToString()
    };
    private static Color StatusColor(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => Color.Success,
        AccountabilityStatus.Renewed => Color.Warning,
        AccountabilityStatus.Returned => Color.Info,
        AccountabilityStatus.Cancelled => Color.Error,
        AccountabilityStatus.PendingAcceptance => Color.Warning,
        _ => Color.Default
    };
}
