@using System.IO
@using AMIS.Blazor.ApiClient
@using Microsoft.AspNetCore.Components.Forms
@inject IAssetRegistryClient Client
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 420px;">
            @if (CanEdit)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Photo of the physical unit — JPG / PNG / GIF / WebP, max 5 MB.
                </MudText>
            }

            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center" Wrap="Wrap.Wrap">
                @if (!string.IsNullOrEmpty(_displaySrc))
                {
                    <MudImage Src="@_displaySrc" Alt="Asset photo" ObjectFit="ObjectFit.Cover"
                              Width="200" Height="200" Class="rounded" />
                }
                else
                {
                    <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center rounded gap-2"
                              Style="width:200px; height:200px; border:1px dashed var(--mud-palette-lines-default);">
                        <MudIcon Icon="@Icons.Material.Outlined.Image" Color="Color.Default" Size="Size.Large" />
                        @if (!CanEdit)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">No photo uploaded.</MudText>
                        }
                    </MudPaper>
                }
            </MudStack>

            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }

            @if (CanEdit)
            {
                <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                    <MudFileUpload T="IBrowserFile" OnFilesChanged="HandleImageUpload"
                                   Accept=".jpg,.jpeg,.png,.gif,.webp" MaxFileSize="MaxUploadBytes">
                        <ActivatorContent>
                            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="_busy">
                                @(_hasPhoto ? "Replace Photo" : "Upload Photo")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (_hasPhoto)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Outlined.Delete"
                                   OnClick="RemoveImageAsync" Disabled="_busy">Remove</MudButton>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close(DialogResult.Ok(_changed)))">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public Guid AssetId { get; set; }
    /// <summary>Base64/data-URL photo already in hand (the detail dialog passes this). When set it is
    /// shown directly; otherwise <see cref="HasImage"/> drives lazy loading from the image proxy.</summary>
    [Parameter] public string? CurrentImageUrl { get; set; }
    /// <summary>Whether the asset has a photo when no <see cref="CurrentImageUrl"/> is supplied (the
    /// search list passes this instead of the bytes). Drives loading from /bff/asset-image/{id}.</summary>
    [Parameter] public bool HasImage { get; set; }
    /// <summary>When false, the dialog is view-only: upload/replace/remove controls are hidden.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    private const long MaxUploadBytes = 5L * 1024 * 1024;
    // Longest edge after in-browser downscale — display-quality for an asset photo, tiny payload.
    private const int MaxImageEdge = 1280;

    /// <summary>What the &lt;img&gt; shows: a base64 data URL (freshly uploaded or passed in) or the
    /// same-origin proxy URL. Null renders the empty placeholder.</summary>
    private string? _displaySrc;
    /// <summary>Whether a photo currently exists (drives Upload vs Replace + the Remove button).</summary>
    private bool _hasPhoto;
    private bool _busy;
    /// <summary>Set true once the photo is uploaded/replaced/removed, so the caller knows to refresh the asset.</summary>
    private bool _changed;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(CurrentImageUrl))
        {
            _displaySrc = CurrentImageUrl;
            _hasPhoto = true;
        }
        else if (HasImage)
        {
            // Lazy-load the existing photo through the cookie-authenticated proxy.
            _displaySrc = $"/bff/asset-image/{AssetId}";
            _hasPhoto = true;
        }
    }

    // Resize in-browser, then persist as a JPEG data URL. The server writes a file + thumbnail and keeps
    // only the keys — so a property photo never needs full camera resolution client-side either.
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        var validTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
        if (!validTypes.Contains(file.ContentType))
        {
            Snackbar.Add("Please choose a JPG, PNG, GIF or WebP image.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            // Downscale to a sane max edge and re-encode to JPEG in the browser: a full phone photo is
            // multiple MB, but the stored/uploaded image only needs to be display-quality (~<200 KB).
            var resized = await file.RequestImageFileAsync("image/jpeg", MaxImageEdge, MaxImageEdge);
            using var stream = resized.OpenReadStream(MaxUploadBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var dataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
            var updated = await Client.UpdateImageAsync(AssetId, dataUrl);
            // Server stored a file + thumbnail; preview the just-uploaded bytes directly (no proxy round-trip).
            _hasPhoto = updated.HasImage;
            _displaySrc = updated.HasImage ? dataUrl : null;
            _changed = true;
            Snackbar.Add("Photo updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveImageAsync()
    {
        _busy = true;
        try
        {
            var updated = await Client.UpdateImageAsync(AssetId, null);
            _hasPhoto = updated.HasImage;
            _displaySrc = updated.HasImage ? _displaySrc : null;
            _changed = true;
            Snackbar.Add("Photo removed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
