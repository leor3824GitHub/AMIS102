@page "/asset-register/assets"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AssetType = AMIS.Modules.AssetRegister.Contracts.v1.AssetType
@using AssetCondition = AMIS.Modules.AssetRegister.Contracts.v1.AssetCondition
@using LifecycleState = AMIS.Modules.AssetRegister.Contracts.v1.LifecycleState
@using AccountabilityType = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityType
@inject IAssetRegistryClient Client
@inject IArDepreciationClient DepreciationClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Asset Registry"
               Description="Master ledger of individual physical units — one row per asset (COA 2020-006, 2022-004)." />

@if (_canUpdate)
{
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                    StartIcon="@Icons.Material.Outlined.Calculate" OnClick="RunDepreciationAsync" Disabled="_busy">
            Run Depreciation
        </AMISButton>
    </MudStack>
}

<MudGrid Spacing="3">
    <!-- Search filters -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Keyword / Property No." Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                        Search
                    </AMISButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                    <AMISEnumChips TEnum="AssetType" Value="_assetTypeFilter" ValueChanged="OnAssetTypeChanged"
                                   Label="Asset Type" Class="mb-0" />
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                    <AMISEnumChips TEnum="LifecycleState" Value="_lifecycleFilter" ValueChanged="OnLifecycleChanged"
                                   Label="Lifecycle State" Class="mb-0" />
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Results table -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_canIssue && _picked.Count > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudText Typo="Typo.body2"><strong>@_picked.Count</strong> item(s) selected</MudText>
                        @if (SelectedSingleType() is null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                Mixed SE + PPE — select one type per document
                            </MudChip>
                        }
                        <MudSpacer />
                        <AMISButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                    OnClick="ClearSelection" Disabled="_busy">Clear</AMISButton>
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.AssignmentInd"
                                    OnClick="OpenIssueDialogAsync"
                                    Disabled="_busy || SelectedSingleType() is null">
                            Issue @IssueLabel()
                        </AMISButton>
                    </MudStack>
                }
                <AMISDataTable @ref="_table" T="AssetRegistrySummaryDto" ServerData="LoadServerData"
                               OnRowClick="OnRowClick" RowClass="cursor-pointer"
                               EmptyMessage="No assets found.">
                    <HeaderContent>
                        @if (_canIssue)
                        {
                            <MudTh Style="width:48px"></MudTh>
                        }
                        <MudTh Style="width:56px"></MudTh>
                        <MudTh>Property No.</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Acquisition Date</MudTh>
                        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                        <MudTh>Lifecycle</MudTh>
                        <MudTh>Condition</MudTh>
                        @if (_canView)
                        {
                            <MudTh Style="width:64px; text-align:center">Actions</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        @if (_canIssue)
                        {
                            <MudTd DataLabel="Select">
                                @{
                                    var selectable = context.LifecycleState == LifecycleState.Available;
                                }
                                @* Stop the tick from bubbling to OnRowClick (which opens the detail panel). *@
                                <div @onclick:stopPropagation="true">
                                    <MudTooltip Text="@(selectable ? "Select for ICS / PAR issuance" : "Only Available assets can be issued")">
                                        <MudCheckBox T="bool" Dense="true" Disabled="!selectable"
                                                     Value="@_picked.ContainsKey(context.Id)"
                                                     ValueChanged="@((bool v) => TogglePick(context, v))" />
                                    </MudTooltip>
                                </div>
                            </MudTd>
                        }
                        <MudTd DataLabel="Photo">
                            @if (context.HasImage)
                            {
                                @* Lazily fetched per visible row from the same-origin proxy — the browser
                                   caches by URL and only loads on-screen thumbnails. No base64 in the payload. *@
                                <img src="@($"/bff/asset-image/{context.Id}?variant=thumb")" alt="Asset thumbnail" loading="lazy"
                                     width="40" height="40" style="object-fit:cover;border-radius:4px;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Color="Color.Default" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Property No.">
                            <MudText Typo="Typo.body2"><strong>@context.PropertyNo</strong></MudText>
                        </MudTd>
                        <MudTd DataLabel="Type">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(context.AssetType == AssetType.SE ? Color.Info : Color.Secondary)"
                                     Variant="Variant.Outlined">
                                @FormatAssetType(context.AssetType)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Description">@context.Description</MudTd>
                        <MudTd DataLabel="Acquisition Date">@context.AcquisitionDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="@($"Unit Cost ({Money.Symbol})")" Style="text-align:right">@context.UnitCost.ToString("N2")</MudTd>
                        <MudTd DataLabel="Lifecycle">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@LifecycleColor(context.LifecycleState)"
                                     Variant="Variant.Filled">
                                @FormatLifecycle(context.LifecycleState)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Condition">@FormatCondition(context.CurrentCondition)</MudTd>
                        @if (_canView)
                        {
                            <MudTd DataLabel="Actions" Style="text-align:center">
                                @* Stop the click from bubbling to OnRowClick (which opens the detail dialog). *@
                                <div @onclick:stopPropagation="true">
                                    <MudTooltip Text="@PhotoActionLabel(context)">
                                        <AMISIconButton Icon="@(_canUpdate ? Icons.Material.Outlined.AddAPhoto : Icons.Material.Outlined.Image)"
                                                        Size="Size.Small" Color="Color.Primary"
                                                        OnClick="@(() => OpenPhotoDialogAsync(context))" />
                                    </MudTooltip>
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private AMISDataTable<AssetRegistrySummaryDto>? _table;
    private bool _busy;
    private string? _keyword;
    private AssetType? _assetTypeFilter;
    private LifecycleState? _lifecycleFilter;

    // Assets ticked for issuance. Keyed by Id so selection survives paging/searching; only
    // Available assets are selectable (enforced in the checkbox + when launching the dialog).
    private readonly Dictionary<Guid, AssetRegistrySummaryDto> _picked = [];

    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.Update);
    private bool _canView => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.View);
    private bool _canIssue => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Issue);

    protected override void OnInitialized()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        // AMISDataTable auto-loads via ServerData on first render.
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task<TableData<AssetRegistrySummaryDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var result = await Client.SearchAsync(_keyword, _assetTypeFilter, _lifecycleFilter, state.Page + 1, state.PageSize);
            return new TableData<AssetRegistrySummaryDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load assets: {ex.Message}", Severity.Error);
            return new TableData<AssetRegistrySummaryDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task LoadAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    // Open the full asset detail (grid + photo + depreciation + condition) in a dialog. The dialog
    // persists its own changes and returns true when the asset changed, so we reload the ledger then.
    private async Task OnRowClick(TableRowClickEventArgs<AssetRegistrySummaryDto> args)
    {
        var parameters = new DialogParameters<AssetRegistryDetailDialog>
        {
            { x => x.Id, args.Item.Id }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssetRegistryDetailDialog>($"{args.Item.PropertyNo} — Detail", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LoadAsync();
        }
    }

    // ── Selection → issue ICS / PAR ──────────────────────────────────────────

    private void TogglePick(AssetRegistrySummaryDto item, bool selected)
    {
        if (item.LifecycleState != LifecycleState.Available) return;
        if (selected) _picked[item.Id] = item;
        else _picked.Remove(item.Id);
    }

    private void ClearSelection() => _picked.Clear();

    // ICS is for Semi-Expendable, PAR for PPE — a single document can't mix the two. Returns the
    // common type, or null when the selection is empty or mixed (issue button stays disabled).
    private AssetType? SelectedSingleType()
    {
        if (_picked.Count == 0) return null;
        var types = _picked.Values.Select(a => a.AssetType).Distinct().ToList();
        return types.Count == 1 ? types[0] : null;
    }

    private string IssueLabel() => SelectedSingleType() switch
    {
        AssetType.SE => "ICS",
        AssetType.PPE => "PAR",
        _ => "ICS / PAR"
    };

    private async Task OpenIssueDialogAsync()
    {
        var type = SelectedSingleType();
        if (type is null)
        {
            Snackbar.Add("Select only Semi-Expendable (ICS) or only PPE (PAR) items — a document can't mix both.", Severity.Warning);
            return;
        }

        var accountabilityType = type == AssetType.SE ? AccountabilityType.SE_ICS : AccountabilityType.PPE_PAR;
        var parameters = new DialogParameters<IssueAccountabilityDialog>
        {
            { x => x.InitialType, accountabilityType },
            { x => x.PreselectedAssets, _picked.Values.ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueAccountabilityDialog>(
            accountabilityType == AccountabilityType.SE_ICS ? "New ICS" : "New PAR", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        // Issued — the picked assets are now Assigned; clear selection and refresh the ledger.
        ClearSelection();
        await LoadAsync();
    }

    // Tooltip for the row photo action. Users who can update see upload/manage; view-only users see view.
    private string PhotoActionLabel(AssetRegistrySummaryDto item) => _canUpdate
        ? (item.HasImage ? "Manage photo" : "Upload photo")
        : "View photo";

    // Open the asset photo straight from its row, without opening the detail dialog. Editable for users
    // with Update (upload/replace/remove) and read-only otherwise. The dialog persists changes itself
    // and returns true when the photo changed, so we reload the ledger to refresh the row thumbnail.
    private async Task OpenPhotoDialogAsync(AssetRegistrySummaryDto item)
    {
        var parameters = new DialogParameters<AssetPhotoDialog>
        {
            { x => x.AssetId, item.Id },
            { x => x.HasImage, item.HasImage },
            { x => x.CanEdit, _canUpdate }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssetPhotoDialog>($"Asset Photo — {item.PropertyNo}", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not true) return;

        await LoadAsync();
    }

    private async Task RunDepreciationAsync()
    {
        _busy = true;
        try
        {
            var result = await DepreciationClient.RunAsync();
            Snackbar.Add($"Depreciation posted: {result.EntriesPosted} entries across {result.AssetsProcessed} asset(s) through {result.Period:yyyy-MM}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OnAssetTypeChanged(AssetType? value) { _assetTypeFilter = value; await LoadAsync(); }
    private async Task OnLifecycleChanged(LifecycleState? value) { _lifecycleFilter = value; await LoadAsync(); }

    private static string FormatAssetType(AssetType v) => v switch
    {
        AssetType.SE => "SE",
        AssetType.PPE => "PPE",
        _ => v.ToString()
    };
    private static string FormatLifecycle(LifecycleState v) => v switch
    {
        LifecycleState.Available => "Available",
        LifecycleState.Assigned => "Assigned",
        LifecycleState.UnderInvestigation => "Under Investigation",
        LifecycleState.Unserviceable => "Unserviceable",
        LifecycleState.Disposed => "Disposed",
        _ => v.ToString()
    };
    private static Color LifecycleColor(LifecycleState v) => v switch
    {
        LifecycleState.Available => Color.Default,
        LifecycleState.Assigned => Color.Success,
        LifecycleState.UnderInvestigation => Color.Warning,
        LifecycleState.Unserviceable => Color.Error,
        LifecycleState.Disposed => Color.Dark,
        _ => Color.Default
    };
    private static string FormatCondition(AssetCondition v) => v switch
    {
        AssetCondition.InGoodCondition => "Good",
        AssetCondition.NeedingRepair => "Needs Repair",
        AssetCondition.Unserviceable => "Unserviceable",
        _ => v.ToString()
    };
}

