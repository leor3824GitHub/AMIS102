@page "/asset-register/my-accountability"
@implements IDisposable
@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Components.Pages.Procurement
@inject IArAccountabilityClient Client
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS
@inject IPdfDownloadService PdfDownload

<AMISPageHeader Title="My Accountability (ICS / PAR)"
               Description="Property issued to you — Inventory Custodian Slips (ICS) and Property Acknowledgement Receipts (PAR) where you are the accountable person." />

@if (!_canView)
{
    <MudAlert Severity="Severity.Warning" Dense="true">You don't have permission to view this page.</MudAlert>
}
else if (UserProfileState.EmployeeId == Guid.Empty)
{
    <MudAlert Severity="Severity.Info" Dense="true">
        No employee profile is linked to your account, so there is no accountability to show.
        Ask your administrator to link your user to an employee record.
    </MudAlert>
}
else
{
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true"
             PanelClass="pt-4" ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChangedAsync">
    <MudTabPanel Text="By Document (ICS / PAR)" Icon="@Icons.Material.Outlined.Description">
    <MudGrid Spacing="3">
        <!-- Filters -->
        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField @bind-Value="_keyword" Label="Keyword / Document No." Variant="Variant.Outlined"
                                      Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                      OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Outlined.Search" OnClick="SearchAsync" Disabled="_busy">
                            Search
                        </AMISButton>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                        <AMISEnumChips TEnum="AccountabilityType" Value="_typeFilter" ValueChanged="OnTypeChanged"
                                       Label="Type" LabelFunc="AccountabilityTypeLabel" Class="mb-0" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                        <AMISEnumChips TEnum="AccountabilityStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                                       Label="Status" LabelFunc="FormatStatus" Class="mb-0" />
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Results -->
        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent>
                    @if (_busy)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                                  OnRowClick="OnRowClick" T="ArAccountabilitySummaryDto" RowClass="cursor-pointer">
                            <HeaderContent>
                                <MudTh>Document No.</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Issued On</MudTh>
                                <MudTh>Expires On</MudTh>
                                <MudTh Style="text-align:right">Lines</MudTh>
                                <MudTh Style="text-align:center">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><strong>@context.DocumentNo</strong></MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.AccountabilityType == AccountabilityType.SE_ICS ? Color.Info : Color.Secondary)"
                                             Variant="Variant.Outlined">
                                        @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@StatusColor(context.Status)"
                                             Variant="Variant.Filled">
                                        @FormatStatus(context.Status)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.IssuedOn.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@(context.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                                <MudTd Style="text-align:right">@context.LineCount</MudTd>
                                <MudTd DataLabel="Actions" Style="text-align:center" @onclick:stopPropagation="true">
                                    <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                                        <MudTooltip Text="View">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                            Color="Color.Default" OnClick="@(() => OpenDetailDialogAsync(context.Id))" />
                                        </MudTooltip>
                                        <MudMenu Icon="@Icons.Material.Filled.PictureAsPdf"
                                                 Color="Color.Secondary"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomLeft"
                                                 TransformOrigin="Origin.TopLeft"
                                                 ToolTip="@($"Print {(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")}")"
                                                 Disabled="@(_printingId == context.Id)">
                                            <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                         OnClick="@(() => PrintRowAsync(context))">
                                                Print @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Tune"
                                                         OnClick="@(() => OpenPrintSetupAsync(context))">
                                                Page Setup…
                                            </MudMenuItem>
                                        </MudMenu>
                                        @if (context.Status == AccountabilityStatus.PendingAcceptance && _canAcknowledge)
                                        {
                                            <MudTooltip Text="@($"Accept {(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")}")">
                                                <AMISIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                                                Color="Color.Success" OnClick="@(() => AcceptRowAsync(context))"
                                                                Disabled="@(_acceptingId == context.Id)" />
                                            </MudTooltip>
                                        }
                                        @if (context.Status == AccountabilityStatus.Active && _canRequestReturn)
                                        {
                                            <MudTooltip Text="Request Return">
                                                <AMISIconButton Icon="@Icons.Material.Filled.AssignmentReturn" Size="Size.Small"
                                                                Color="Color.Warning" OnClick="@(() => OpenReturnDialogAsync(context))" />
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Color="Color.Secondary">No property is currently issued to you.</MudText>
                            </NoRecordsContent>
                        </MudTable>

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                            <MudText Typo="Typo.caption">
                                Page @_page of @_totalPages (@_totalCount total)
                            </MudText>
                            <MudStack Row="true" Spacing="1">
                                <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                                Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                                <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                                Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                            </MudStack>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>
    </MudTabPanel>

    <!-- ── Tab 2: per-asset view (asset-registry style) ── -->
    <MudTabPanel Text="By Asset" Icon="@Icons.Material.Outlined.Inventory2">
    <MudGrid Spacing="3">
        <!-- Filters -->
        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField @bind-Value="_assetKeyword" Label="Keyword / Property No." Variant="Variant.Outlined"
                                      Dense="true" Margin="Margin.Dense" Size="Size.Small"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                      OnKeyDown="OnAssetSearchKeyDown" Immediate="false" Style="flex:1;" />
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Outlined.Search" OnClick="SearchAssetsAsync" Disabled="_assetBusy">
                            Search
                        </AMISButton>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                        <AMISEnumChips TEnum="AssetType" Value="_assetTypeFilter" ValueChanged="OnAssetTypeChanged"
                                       Label="Asset Type" Class="mb-0" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                        <AMISEnumChips TEnum="LifecycleState" Value="_lifecycleFilter" ValueChanged="OnLifecycleChanged"
                                       Label="Lifecycle State" Class="mb-0" />
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Results -->
        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent>
                    @if (_assetBusy)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!string.IsNullOrEmpty(_assetError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_assetError</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_assets" Dense="true" Hover="true" Striped="true" T="AssetRegistrySummaryDto">
                            <HeaderContent>
                                <MudTh>Property No.</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh>Description</MudTh>
                                <MudTh>Acquisition Date</MudTh>
                                <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                                <MudTh>Lifecycle</MudTh>
                                <MudTh>Condition</MudTh>
                                <MudTh Style="text-align:center">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><strong>@context.PropertyNo</strong></MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.AssetType == AssetType.SE ? Color.Info : Color.Secondary)"
                                             Variant="Variant.Outlined">
                                        @FormatAssetType(context.AssetType)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.Description</MudTd>
                                <MudTd>@context.AcquisitionDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd Style="text-align:right">@context.UnitCost.ToString("N2")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@LifecycleColor(context.LifecycleState)"
                                             Variant="Variant.Filled">
                                        @FormatLifecycle(context.LifecycleState)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@FormatCondition(context.CurrentCondition)</MudTd>
                                <MudTd Style="text-align:center">
                                    @if (_canRequestRepair)
                                    {
                                        <MudTooltip Text="Request Repair (RPRI)">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Build" Size="Size.Small"
                                                            Color="Color.Primary" OnClick="@(() => OpenRepairDialogAsync(context))" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Color="Color.Secondary">No individual assets are currently issued to you.</MudText>
                            </NoRecordsContent>
                        </MudTable>

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                            <MudText Typo="Typo.caption">
                                Page @_assetPage of @_assetTotalPages (@_assetTotalCount total)
                            </MudText>
                            <MudStack Row="true" Spacing="1">
                                <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                                Disabled="_assetPage <= 1 || _assetBusy" OnClick="PrevAssetPage" />
                                <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                                Disabled="_assetPage >= _assetTotalPages || _assetBusy" OnClick="NextAssetPage" />
                            </MudStack>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
    </MudTabPanel>
    </MudTabs>
}

@code {
    private bool _busy;
    private Guid? _printingId;
    private Guid? _acceptingId;
    private string? _error;
    private string? _keyword;
    private AccountabilityType? _typeFilter;
    private AccountabilityStatus? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private IReadOnlyList<ArAccountabilitySummaryDto> _items = [];

    private bool _canView => UserProfileState.Permissions.Contains(AssetRegisterPermissions.MyAccountability.View);
    private bool _canAcknowledge => UserProfileState.Permissions.Contains(AssetRegisterPermissions.MyAccountability.Acknowledge);
    private bool _canRequestReturn => UserProfileState.Permissions.Contains(AssetRegisterPermissions.ReturnedProperty.Create);
    private bool _canRequestRepair => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Repair.Request);

    // ── Tab 2: per-asset view ────────────────────────────────────────────────
    private int _activeTab;
    private bool _assetsLoaded;  // lazy-load guard — the asset list is fetched on first activation
    private bool _assetBusy;
    private string? _assetError;
    private string? _assetKeyword;
    private AssetType? _assetTypeFilter;
    private LifecycleState? _lifecycleFilter;
    private int _assetPage = 1;
    private int _assetTotalPages = 1;
    private int _assetTotalCount;
    private IReadOnlyList<AssetRegistrySummaryDto> _assets = [];

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        if (_canView && UserProfileState.EmployeeId != Guid.Empty)
            await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.GetMineAsync(_keyword, _typeFilter, _statusFilter, page: _page, pageSize: PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private Task OnRowClick(TableRowClickEventArgs<ArAccountabilitySummaryDto> args)
        => OpenDetailDialogAsync(args.Item.Id);

    private async Task OpenDetailDialogAsync(Guid id)
    {
        var parameters = new DialogParameters<MyAccountabilityDetailDialog> { { x => x.Id, id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<MyAccountabilityDetailDialog>("Accountability Detail", parameters, options);
        var result = await dialog.Result;
        // Accept inside the dialog mutates the record — reload the list if anything changed.
        if (result is not null && !result.Canceled && result.Data is true)
            await LoadAsync();
    }

    private async Task AcceptRowAsync(ArAccountabilitySummaryDto item)
    {
        var label = item.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR";
        var confirmed = await DialogService.ShowMessageBox(
            $"Accept {label}?",
            $"Accept {label} {item.DocumentNo}? This confirms you have received the property listed.",
            yesText: "Accept", cancelText: "Cancel");
        if (confirmed != true) return;

        _acceptingId = item.Id;
        try
        {
            await Client.AcceptAsync(item.Id, DateOnly.FromDateTime(DateTime.Today));
            Snackbar.Add($"{label} {item.DocumentNo} accepted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            // Cross-client race (e.g. already accepted on MAUI): refresh so the row reflects the
            // current status instead of still offering an Accept button that will keep failing.
            await LoadAsync();
        }
        finally
        {
            _acceptingId = null;
        }
    }

    private async Task OpenReturnDialogAsync(ArAccountabilitySummaryDto item)
    {
        var parameters = new DialogParameters<ReturnedPropertyFormDialog>
        {
            { x => x.PreselectedAccountabilityId, item.Id }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReturnedPropertyFormDialog>("Request a Return", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    // Both ICS and PAR use a single landscape "2-up" Fast Report template (two copies
    // side by side, cut down the middle). Landscape = 2 per page; portrait = 1 per page.
    private const string FastReportKey = "accountability";

    private async Task PrintRowAsync(ArAccountabilitySummaryDto item)
    {
        _printingId = item.Id;
        try
        {
