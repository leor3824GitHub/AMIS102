    }

    private async Task OpenPrintSetupAsync(ArAccountabilitySummaryDto item)
    {
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "longbond",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "landscape",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 2,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 15,
            [nameof(FastReportPageSetupDialog.ShowOrientation)] = false
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        _printingId = item.Id;
        try
        {
            var bytes = await Client.GetFastReportPdfAsync(item.Id, item.AccountabilityType,
                pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _printingId = null;
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private async Task OnTypeChanged(AccountabilityType? value) { _typeFilter = value; _page = 1; await LoadAsync(); }
    private async Task OnStatusChanged(AccountabilityStatus? value) { _statusFilter = value; _page = 1; await LoadAsync(); }

    // ── Tab 2: per-asset view ────────────────────────────────────────────────

    private async Task OnTabChangedAsync(int index)
    {
        _activeTab = index;
        // Lazy-load the asset list the first time the "By Asset" tab is opened.
        if (index == 1 && !_assetsLoaded)
            await LoadAssetsAsync();
    }

    private async Task LoadAssetsAsync()
    {
        _assetBusy = true;
        _assetError = null;
        try
        {
            var result = await Client.GetMineAssetsAsync(_assetKeyword, _assetTypeFilter, _lifecycleFilter, page: _assetPage, pageSize: PageSize);
            _assets = result.Items;
            _assetTotalCount = result.TotalCount;
            _assetTotalPages = result.TotalPages > 0 ? result.TotalPages : 1;
            _assetsLoaded = true;
        }
        catch (Exception ex)
        {
            _assetError = ex.Message;
        }
        finally
        {
            _assetBusy = false;
        }
    }

    private async Task SearchAssetsAsync()
    {
        _assetPage = 1;
        await LoadAssetsAsync();
    }

    private async Task PrevAssetPage() { _assetPage--; await LoadAssetsAsync(); }
    private async Task NextAssetPage() { _assetPage++; await LoadAssetsAsync(); }

    private async Task OpenRepairDialogAsync(AssetRegistrySummaryDto asset)
    {
        var parameters = new DialogParameters<RepairFormDialog> { { x => x.PreselectedAsset, asset } };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<RepairFormDialog>($"Request Repair — {asset.PropertyNo}", parameters, options);
        await dialog.Result;
    }
    private async Task OnAssetTypeChanged(AssetType? value) { _assetTypeFilter = value; _assetPage = 1; await LoadAssetsAsync(); }
    private async Task OnLifecycleChanged(LifecycleState? value) { _lifecycleFilter = value; _assetPage = 1; await LoadAssetsAsync(); }

    private async Task OnAssetSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _assetPage = 1; await LoadAssetsAsync(); }
    }

    private static string FormatAssetType(AssetType v) => v switch
    {
        AssetType.SE => "SE",
        AssetType.PPE => "PPE",
        _ => v.ToString()
    };
    private static string FormatLifecycle(LifecycleState v) => v switch
    {
        LifecycleState.Available => "Available",
        LifecycleState.Assigned => "Assigned",
        LifecycleState.UnderInvestigation => "Under Investigation",
        LifecycleState.Unserviceable => "Unserviceable",
        LifecycleState.Disposed => "Disposed",
        _ => v.ToString()
    };
    private static Color LifecycleColor(LifecycleState v) => v switch
    {
        LifecycleState.Available => Color.Default,
        LifecycleState.Assigned => Color.Success,
        LifecycleState.UnderInvestigation => Color.Warning,
        LifecycleState.Unserviceable => Color.Error,
        LifecycleState.Disposed => Color.Dark,
        _ => Color.Default
    };
    private static string FormatCondition(AssetCondition v) => v switch
    {
        AssetCondition.InGoodCondition => "Good",
        AssetCondition.NeedingRepair => "Needs Repair",
        AssetCondition.Unserviceable => "Unserviceable",
        _ => v.ToString()
    };

    private static string AccountabilityTypeLabel(AccountabilityType t) => t switch
    {
        AccountabilityType.SE_ICS => "ICS (SE)",
        AccountabilityType.PPE_PAR => "PAR (PPE)",
        _ => t.ToString()
    };

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private static string FormatStatus(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => "Active",
        AccountabilityStatus.Renewed => "Renewed",
        AccountabilityStatus.Returned => "Returned",
        AccountabilityStatus.Cancelled => "Cancelled",
        AccountabilityStatus.PendingAcceptance => "Pending Acceptance",
        _ => v.ToString()
    };
    private static Color StatusColor(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => Color.Success,
        AccountabilityStatus.Renewed => Color.Warning,
        AccountabilityStatus.Returned => Color.Info,
        AccountabilityStatus.Cancelled => Color.Error,
        AccountabilityStatus.PendingAcceptance => Color.Warning,
        _ => Color.Default
    };
}
