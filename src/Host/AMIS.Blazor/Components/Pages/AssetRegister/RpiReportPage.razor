@page "/asset-register/reports/rpi"
@using AMIS.Blazor.Services.AssetRegister
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@inject IAssetRegisterReportsClient ReportsClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Report on Property Issued (RPI)"
               Description="Property, plant &amp; equipment issued to accountable officers via PAR." />

@if (!_canView)
{
    <MudAlert Severity="Severity.Warning" Dense="true">You don't have permission to view this report.</MudAlert>
}
else
{
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_from" Label="Date From" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_to" Label="Date To" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">
                            Generate Report
                        </AMISButton>
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdfAsync"
                                    Disabled="_busy || _report is null || _report.Items.Count == 0">
                            Download PDF
                        </AMISButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }
    else if (_report is not null)
    {
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_report.Items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No property issued for the selected filters.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>PAR No.</th>
                                <th>Date</th>
                                <th>Accountable Officer</th>
                                <th>Property No.</th>
                                <th>Description</th>
                                <th>Unit</th>
                                <th class="text-right">Qty</th>
                                <th class="text-right">Unit Cost (@Money.Symbol)</th>
                                <th class="text-right">Amount (@Money.Symbol)</th>
                                <th class="text-right">EUL</th>
                                <th>Date Acq.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var i = 1; }
                            @foreach (var r in _report.Items)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@r.DocumentNo</td>
                                    <td>@r.IssuedOn.ToString("yyyy-MM-dd")</td>
                                    <td>@r.ReceivedByName</td>
                                    <td>@r.PropertyNo</td>
                                    <td>@r.Description</td>
                                    <td>@r.Unit</td>
                                    <td class="text-right">@r.Quantity</td>
                                    <td class="text-right">@r.UnitCost.ToString("N2")</td>
                                    <td class="text-right">@r.Amount.ToString("N2")</td>
                                    <td class="text-right">@r.EstimatedUsefulLifeYears</td>
                                    <td>@r.DateAcquired.ToString("yyyy-MM-dd")</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_report.Items.Count < _report.TotalCount)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                            Showing the first @_report.Items.Count of @_report.TotalCount rows — narrow the date range, or use Download PDF for the complete report.
                        </MudAlert>
                    }

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                        <MudText Typo="Typo.subtitle2">
                            Total items: @_report.TotalCount &nbsp;·&nbsp; Total amount: @Money.Symbol@_report.OverallAmountTotal.ToString("N2")
                        </MudText>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    }
}

@code {
    private bool _busy;
    private string? _error;
    private DateTime? _from;
    private DateTime? _to;
    private RpiReportDto? _report;

    private bool _canView => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.View);

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        _to = today;
        _from = today.AddMonths(-1);
    }

    private static DateOnly? ToDateOnly(DateTime? value) => value is { } v ? DateOnly.FromDateTime(v) : null;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _report = await ReportsClient.GetRpiReportAsync(
                ToDateOnly(_from), ToDateOnly(_to), pageNumber: 1, pageSize: 1000);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (_report is null || _report.Items.Count == 0) return;
        try
        {
            var bytes = await ReportsClient.GetRpiPdfAsync(ToDateOnly(_from), ToDateOnly(_to));
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }
}
