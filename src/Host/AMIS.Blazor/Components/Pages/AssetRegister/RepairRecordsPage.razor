@page "/asset-register/repairs"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.v1.Repairs
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@inject IArRepairClient RepairClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState
@inject IJSRuntime JS
@inject IPdfDownloadService PdfDownload

<AMISPageHeader Title="Repairs (RPRI)" Description="Request for Pre/Post Repair Inspection — Exhibit 6 (PPE-wide)" />

<div class="mt-4">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard Class="AMIS-card">
                <MudCardContent>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudTextField @bind-Value="_keyword" Label="Search" Placeholder="RPRI no, description, nature of work"
                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudSelect T="string" @bind-Value="_status" Label="Status"
                                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem Value="@RepairStatusValues.Requested">Requested</MudSelectItem>
                            <MudSelectItem Value="@RepairStatusValues.PreInspected">Pre-Inspected</MudSelectItem>
                            <MudSelectItem Value="@RepairStatusValues.PostInspected">Post-Inspected</MudSelectItem>
                            <MudSelectItem Value="@RepairStatusValues.Accepted">Accepted</MudSelectItem>
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Search</MudButton>
                        @if (_canRequest)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRequestDialog">Request Repair</MudButton>
                        }
                    </MudStack>

                    <AMISDataTable T="PropertyRepairSummaryDto" Items="_repairs"
                                   EmptyMessage="No repair records found."
                                   EmptyDescription="Request a repair to get started.">
                        <HeaderContent>
                            <MudTh>RPRI No</MudTh>
                            <MudTh>Property No</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Nature of Work</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Requested</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="RPRI No">@context.RpriNo</MudTd>
                            <MudTd DataLabel="Property No">@context.PropertyNo</MudTd>
                            <MudTd DataLabel="Description">@context.Description</MudTd>
                            <MudTd DataLabel="Nature of Work">@context.NatureOfWork</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@DisplayStatus(context.Status)</MudChip></MudTd>
                            <MudTd DataLabel="Requested">@context.RequestedOn.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Actions">
                                <MudStack Row="true" Spacing="0">
                                    @if (CanAct(context.Status))
                                    {
                                        <MudTooltip Text="@ActionTooltip(context.Status)">
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => OpenWorkflow(context.Id))" />
                                        </MudTooltip>
                                    }
                                    <MudTooltip Text="Print RPRI (Exhibit 6)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Secondary" Size="Size.Small"
                                                       OnClick="@(() => DownloadPdf(context.Id))" />
                                    </MudTooltip>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </AMISDataTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private readonly List<PropertyRepairSummaryDto> _repairs = [];
    private string? _keyword;
    private string? _status;

    private bool _canRequest => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Repair.Request);
    private bool _canInspect => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Repair.Inspect);
    private bool _canAccept => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Repair.Accept);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await Load();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task Load()
    {
        try
        {
            var result = await RepairClient.SearchAsync(status: _status, keyword: _keyword, page: 1, pageSize: 100);
            _repairs.Clear();
            _repairs.AddRange(result.Items);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load repairs: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenRequestDialog()
    {
        if (!_canRequest) return;
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<RepairFormDialog>("Request Repair", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task OpenWorkflow(Guid id)
    {
        var full = await RepairClient.GetAsync(id);
        if (full is null) { Snackbar.Add("Repair not found.", Severity.Error); return; }

        var parameters = new DialogParameters<RepairWorkflowDialog> { { x => x.Repair, full } };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<RepairWorkflowDialog>("RPRI Workflow", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task DownloadPdf(Guid id)
    {
        try
        {
            var bytes = await RepairClient.GetPdfAsync(id, "longbond");
            await PdfDownload.OpenInNewTabAsync(bytes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private bool CanAct(string status) => status switch
    {
        RepairStatusValues.Requested => _canInspect,
        RepairStatusValues.PreInspected or RepairStatusValues.Repaired => _canInspect,
        RepairStatusValues.PostInspected => _canAccept,
        _ => false
    };

    private static string ActionTooltip(string status) => status switch
    {
        RepairStatusValues.Requested => "Record pre-repair inspection",
        RepairStatusValues.PreInspected or RepairStatusValues.Repaired => "Record post-repair inspection",
        RepairStatusValues.PostInspected => "Accept repair",
        _ => "View"
    };

    private static Color StatusColor(string status) => status switch
    {
        RepairStatusValues.Requested => Color.Warning,
        RepairStatusValues.PreInspected => Color.Info,
        RepairStatusValues.Repaired => Color.Info,
        RepairStatusValues.PostInspected => Color.Primary,
        RepairStatusValues.Accepted => Color.Success,
        _ => Color.Default
    };

    private static string DisplayStatus(string status) => status switch
    {
        RepairStatusValues.PreInspected => "Pre-Inspected",
        RepairStatusValues.PostInspected => "Post-Inspected",
        _ => status
    };
}
