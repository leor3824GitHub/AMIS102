@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Components.Pages.Procurement
@inject IArAccountabilityClient Client
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS
@inject IPdfDownloadService PdfDownload

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_selected is null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@(_error ?? "Document could not be loaded.")</MudAlert>
        }
        else
        {
            <MudStack Spacing="2" Style="min-width:720px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6">
                        @(_selected.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR") — @_selected.DocumentNo
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(_selected.Status)" Variant="Variant.Filled">
                        @FormatStatus(_selected.Status)
                    </MudChip>
                    <MudSpacer />
                    <MudTooltip Text="Refresh — pull the latest status (e.g. if accepted on mobile)">
                        <AMISIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                        Color="Color.Default" OnClick="RefreshAsync" Disabled="_busy" />
                    </MudTooltip>
                    <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                OnClick="PrintAsync" Disabled="_printing">
                        @if (_printing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                        Print @(_selected.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                    </AMISButton>
                    <MudTooltip Text="Page setup — paper size, 1 or 2 per page">
                        <AMISIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                                        Color="Color.Secondary" OnClick="OpenPrintSetupAsync" Disabled="_printing" />
                    </MudTooltip>
                </MudStack>

                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Issued On</MudText>
                        <MudText Typo="Typo.body2">@_selected.IssuedOn.ToString("yyyy-MM-dd")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Expires On</MudText>
                        <MudText Typo="Typo.body2">@(_selected.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Accepted On</MudText>
                        <MudText Typo="Typo.body2">@(_selected.AcceptedOn?.ToString("yyyy-MM-dd") ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                        <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Issued By</MudText>
                        <MudText Typo="Typo.body2">@_selected.IssuedBy.PrintedName (@(_selected.IssuedBy.Designation ?? "—"))</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Received By</MudText>
                        <MudText Typo="Typo.body2">@_selected.ReceivedBy.PrintedName (@(_selected.ReceivedBy.Designation ?? "—"))</MudText>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_selected.CancellationReason))
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Cancellation reason: @_selected.CancellationReason
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>

                @if (_selected.Status == AccountabilityStatus.PendingAcceptance)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Awaiting acceptance by @_selected.ReceivedBy.PrintedName. It is editable/deletable until accepted.
                    </MudAlert>
                }

                <MudText Typo="Typo.subtitle2">Line Items</MudText>
                <MudTable Items="_selected.Lines" Dense="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Property No.</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align:right">Issued</MudTh>
                        <MudTh Style="text-align:right">Returned</MudTh>
                        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Returned On</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Snapshot.PropertyNo</MudTd>
                        <MudTd>@context.Snapshot.Description</MudTd>
                        <MudTd>@context.Snapshot.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.IssuedQty</MudTd>
                        <MudTd Style="text-align:right">@context.ReturnedQty</MudTd>
                        <MudTd Style="text-align:right">@context.Snapshot.UnitCost.ToString("N2")</MudTd>
                        <MudTd>@FormatLineStatus(context.LineStatus)</MudTd>
                        <MudTd>@(context.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>

                @* Renew action (Active only). ICS = user-set expiry; PAR = fixed 3-year renewal. *@
                @if (_selected.Status == AccountabilityStatus.Active && _canIssue)
                {
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2">Renew @(_selected.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudDatePicker Date="_renewIssuedOn" DateChanged="OnRenewIssuedOnChanged" Label="New Issued On"
                                       Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Dense="true" Margin="Margin.Dense" Style="flex:1;" />
                        <MudDatePicker @bind-Date="_renewExpiresOn" Label="New Expires On" Variant="Variant.Outlined"
                                       DateFormat="MM/dd/yyyy" Dense="true" Margin="Margin.Dense" Style="flex:1;"
                                       ReadOnly="@(_selected.AccountabilityType == AccountabilityType.PPE_PAR)"
                                       HelperText="@(_selected.AccountabilityType == AccountabilityType.PPE_PAR ? "Expires three (3) years after the issued date." : null)" />
                        <AMISButton Variant="Variant.Outlined" Color="Color.Primary"
                                    OnClick="RenewAsync" Disabled="_busy || _renewIssuedOn is null || _renewExpiresOn is null">
                            Renew
                        </AMISButton>
                    </MudStack>
                }

                @* Cancel action (only for Active) *@
                @if (_selected.Status == AccountabilityStatus.Active && _canCancel)
                {
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2">Cancel Accountability</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudTextField @bind-Value="_cancelReason" Label="Reason" Variant="Variant.Outlined"
                                      Dense="true" Margin="Margin.Dense" Style="flex:1;" MaxLength="500" />
                        <AMISButton Variant="Variant.Outlined" Color="Color.Error"
                                    OnClick="CancelAccountabilityAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_cancelReason)">
                            Cancel ICS/PAR
                        </AMISButton>
                    </MudStack>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Close">Close</AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _printing;
    private bool _changed;
    private string? _error;
    private ArAccountabilityDto? _selected;
    private string? _cancelReason;
    private DateTime? _renewIssuedOn = DateTime.Today;
    private DateTime? _renewExpiresOn = DateTime.Today.AddYears(3);

    private bool _canIssue => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Issue);
    private bool _canCancel => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Cancel);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _selected = await Client.GetAsync(Id);
            if (_selected is null) { _error = "Document not found."; return; }
            _renewIssuedOn = DateTime.Today;
            ApplyRenewExpiryPolicy();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            var previousStatus = _selected?.Status;
            var fresh = await Client.GetAsync(Id);
            if (fresh is null) { _error = "Document not found."; _selected = null; return; }
            _selected = fresh;
            ApplyRenewExpiryPolicy();
            // If the status moved on (e.g. the custodian accepted on MAUI), tell the parent list to
            // reload on close so its row reflects the new status instead of the stale one.
            if (previousStatus is not null && previousStatus != fresh.Status)
                _changed = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

