@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AssetType = AMIS.Modules.AssetRegister.Contracts.v1.AssetType
@using AssetCategory = AMIS.Modules.AssetRegister.Contracts.v1.AssetCategory
@using AssetCondition = AMIS.Modules.AssetRegister.Contracts.v1.AssetCondition
@using LifecycleState = AMIS.Modules.AssetRegister.Contracts.v1.LifecycleState
@inject IAssetRegistryClient Client
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_selected is null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@(_error ?? "Asset could not be loaded.")</MudAlert>
        }
        else
        {
            <MudStack Spacing="0" Style="min-width:760px;">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText>
                        <MudText Typo="Typo.body2">@_selected.Description</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Asset Type</MudText>
                        <MudText Typo="Typo.body2">@FormatAssetType(_selected.AssetType)</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Category</MudText>
                        <MudText Typo="Typo.body2">@FormatCategory(_selected.Category)</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                        <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">UACS Object Code</MudText>
                        <MudText Typo="Typo.body2">@(_selected.UacsObjectCode ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Unit Cost (@Money.Symbol)</MudText>
                        <MudText Typo="Typo.body2">@_selected.UnitCost.ToString("N2")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Carrying Amount (@Money.Symbol)</MudText>
                        <MudText Typo="Typo.body2">@_selected.CarryingAmount.ToString("N2")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Accum. Depreciation (@Money.Symbol)</MudText>
                        <MudText Typo="Typo.body2">@_selected.AccumulatedDepreciation.ToString("N2")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Useful Life (years)</MudText>
                        <MudText Typo="Typo.body2">@_selected.EstimatedUsefulLifeYears</MudText>
                    </MudItem>
                    @if (_selected.SerialNo is not null)
                    {
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Serial No.</MudText>
                            <MudText Typo="Typo.body2">@_selected.SerialNo</MudText>
                        </MudItem>
                    }
                    @if (_selected.Brand is not null)
                    {
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Brand / Model</MudText>
                            <MudText Typo="Typo.body2">@_selected.Brand @_selected.Model</MudText>
                        </MudItem>
                    }
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Lifecycle</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@LifecycleColor(_selected.LifecycleState)" Variant="Variant.Filled">
                            @FormatLifecycle(_selected.LifecycleState)
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Condition</MudText>
                        <MudText Typo="Typo.body2">@FormatCondition(_selected.CurrentCondition)</MudText>
                    </MudItem>
                    @if (_selected.CurrentCustodianId.HasValue)
                    {
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Custodian Id</MudText>
                            <MudText Typo="Typo.body2">@_selected.CurrentCustodianId</MudText>
                        </MudItem>
                    }
                    @if (_selected.CurrentAccountabilityId.HasValue)
                    {
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Current Accountability</MudText>
                            <MudLink Href="@($"/asset-register/accountability?id={_selected.CurrentAccountabilityId}")">
                                @_selected.CurrentAccountabilityId
                            </MudLink>
                        </MudItem>
                    }
                </MudGrid>

                <!-- Asset Photo -->
                <MudDivider Class="my-3" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Asset Photo</MudText>
                    <MudSpacer />
                    @if (_canUpdate)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Outlined.CloudUpload"
                                    OnClick="OpenPhotoDialogAsync" Disabled="_busy">
                            @(string.IsNullOrEmpty(_selected.ImageUrl) ? "Upload Photo" : "Manage Photo")
                        </AMISButton>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2">
                    @if (!string.IsNullOrEmpty(_selected.ImageUrl))
                    {
                        <MudImage Src="@_selected.ImageUrl" Alt="Asset photo" ObjectFit="ObjectFit.Cover"
                                  Width="160" Height="160" Class="rounded" />
                    }
                    else
                    {
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center rounded"
                                  Style="width:160px; height:160px; border:1px dashed var(--mud-palette-lines-default);">
                            <MudIcon Icon="@Icons.Material.Outlined.Image" Color="Color.Default" Size="Size.Large" />
                        </MudPaper>
                    }
                </MudStack>

                <!-- Depreciation: policy display, cards, per-asset override -->
                <MudDivider Class="my-3" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle2">Depreciation</MudText>
                    @if (_selected.AssetType == AssetType.PPE)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Residual: @Money.Symbol@_selected.ResidualValue.ToString("N2")</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Method: @_selected.DepreciationMethod</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Semi-expendable — not depreciated.</MudText>
                    }
                    <MudSpacer />
                    @if (_canView)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.History"
                                    OnClick="OpenPropertyCard">@(_selected.AssetType == AssetType.SE ? "SPC" : "Property Card")</AMISButton>
                    }
                    @if (_selected.AssetType == AssetType.PPE)
                    {
                        @if (_canView)
                        {
                            <AMISButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.TableChart"
                                        OnClick="OpenLedgerCard">Ledger Card</AMISButton>
                        }
                        @if (_canUpdate)
                        {
                            <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                        StartIcon="@Icons.Material.Outlined.Tune" OnClick="OpenOverrideAsync">Override</AMISButton>
                        }
                    }
                </MudStack>

                <!-- Update condition inline -->
                @if (_canUpdate)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Update Condition</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudSelect @bind-Value="_newCondition" Label="New Condition" Variant="Variant.Outlined" T="AssetCondition" Style="min-width:200px;">
                            <MudSelectItem Value="AssetCondition.InGoodCondition">In Good Condition</MudSelectItem>
                            <MudSelectItem Value="AssetCondition.NeedingRepair">Needing Repair</MudSelectItem>
                            <MudSelectItem Value="AssetCondition.Unserviceable">Unserviceable</MudSelectItem>
                        </MudSelect>
                        <AMISButton Variant="Variant.Outlined" Color="Color.Primary"
                                    OnClick="UpdateConditionAsync" Disabled="_busy">
                            Save Condition
                        </AMISButton>
                    </MudStack>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Close">Close</AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private AssetRegistryDto? _selected;
    private AssetCondition _newCondition;

    // Set true whenever an action changes the asset (photo, condition, depreciation override) so the
    // parent list reloads on close and reflects the new thumbnail / condition.
    private bool _changed;

    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.Update);
    private bool _canView => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.View);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _selected = await Client.GetAsync(Id);
            if (_selected is null) { _error = "Asset not found."; return; }
            _newCondition = _selected.CurrentCondition;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateConditionAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            _selected = await Client.UpdateConditionAsync(_selected.Id, _newCondition);
            _changed = true;
            Snackbar.Add("Condition updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // Upload / replace / remove the asset photo in a dialog. The dialog persists changes itself and
    // returns true when the photo changed, so we re-fetch the detail here and flag the parent to refresh.
    private async Task OpenPhotoDialogAsync()
    {
        if (_selected is null) return;
        var parameters = new DialogParameters<AssetPhotoDialog>
        {
            { x => x.AssetId, _selected.Id },
            { x => x.CurrentImageUrl, _selected.ImageUrl },
            { x => x.CanEdit, _canUpdate }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssetPhotoDialog>($"Asset Photo — {_selected.PropertyNo}", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not true) return;

        _selected = await Client.GetAsync(_selected.Id);
        _changed = true;
    }

    private Task OpenPropertyCard()
    {
        if (_selected is null) return Task.CompletedTask;
        var parameters = new DialogParameters<PropertyCardDialog> { { x => x.PropertyNo, _selected.PropertyNo } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var formTitle = _selected.AssetType == AssetType.SE ? "Semi-Expendable Property Card" : "Property Card";
        return DialogService.ShowAsync<PropertyCardDialog>($"{formTitle} — {_selected.PropertyNo}", parameters, options);
    }

    private Task OpenLedgerCard()
    {
        if (_selected is null) return Task.CompletedTask;
        var parameters = new DialogParameters<PpeLedgerCardDialog> { { x => x.PropertyNo, _selected.PropertyNo } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        return DialogService.ShowAsync<PpeLedgerCardDialog>($"PPE Ledger Card — {_selected.PropertyNo}", parameters, options);
    }

    private async Task OpenOverrideAsync()
    {
        if (_selected is null) return;
        var parameters = new DialogParameters<AssetDepreciationDialog>
        {
            { x => x.AssetId, _selected.Id },
            { x => x.PropertyNo, _selected.PropertyNo },
            { x => x.UnitCost, _selected.UnitCost },
            { x => x.ResidualValue, _selected.ResidualValue },
            { x => x.EstimatedUsefulLifeYears, _selected.EstimatedUsefulLifeYears },
            { x => x.Method, _selected.DepreciationMethod }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssetDepreciationDialog>($"Override Depreciation — {_selected.PropertyNo}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            _selected = await Client.GetAsync(_selected.Id);
            _changed = true;
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(_changed));

    private static string FormatAssetType(AssetType v) => v switch
    {
        AssetType.SE => "SE",
        AssetType.PPE => "PPE",
        _ => v.ToString()
    };
    private static string FormatCategory(AssetCategory v) => v switch
    {
        AssetCategory.LowValuedSemi => "Low-Valued Semi",
        AssetCategory.HighValuedSemi => "High-Valued Semi",
        AssetCategory.PPE => "PPE",
        _ => v.ToString()
    };
    private static string FormatLifecycle(LifecycleState v) => v switch
    {
        LifecycleState.Available => "Available",
        LifecycleState.Assigned => "Assigned",
        LifecycleState.UnderInvestigation => "Under Investigation",
        LifecycleState.Unserviceable => "Unserviceable",
        LifecycleState.Disposed => "Disposed",
        _ => v.ToString()
    };
    private static Color LifecycleColor(LifecycleState v) => v switch
    {
        LifecycleState.Available => Color.Default,
        LifecycleState.Assigned => Color.Success,
        LifecycleState.UnderInvestigation => Color.Warning,
        LifecycleState.Unserviceable => Color.Error,
        LifecycleState.Disposed => Color.Dark,
        _ => Color.Default
    };
    private static string FormatCondition(AssetCondition v) => v switch
    {
        AssetCondition.InGoodCondition => "Good",
        AssetCondition.NeedingRepair => "Needs Repair",
        AssetCondition.Unserviceable => "Unserviceable",
        _ => v.ToString()
    };
}
