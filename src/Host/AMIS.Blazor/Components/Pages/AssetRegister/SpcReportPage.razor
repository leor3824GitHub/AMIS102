@page "/asset-register/reports/spc"
@using AMIS.Blazor.ApiClient
@using AMIS.Blazor.Services.AssetRegister
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.v1.Reports
@inject IArDepreciationClient DepreciationClient
@inject IAssetRegisterReportsClient ReportsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Semi-Expendable Property Card (SPC)"
               Description="COA chronological movement history for a semi-expendable asset — acquisition, issue/return, transfer, disposal." />

@if (!_canView)
{
    <MudAlert Severity="Severity.Warning" Dense="true">You don't have permission to view this report.</MudAlert>
}
else
{
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_propertyNo" Label="Property No." Placeholder="e.g. 2026-01-0001"
                              Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="flex-grow-0"
                              Immediate="true" OnKeyDown="OnKeyDownAsync" Style="width: 320px;" />
                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.ManageSearch" OnClick="BrowseAsync" Disabled="_busy">
                    Browse
                </AMISButton>
                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_busy">
                    Load
                </AMISButton>
                @if (_card is not null && _card.AssetType == AssetType.SE)
                {
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdfAsync" Disabled="_busy">
                        View PDF
                    </AMISButton>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }
    else if (_card is not null)
    {
        @if (_card.AssetType != AssetType.SE)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @_card.PropertyNo is registered as PPE —
                <MudLink Href="@($"/asset-register/reports/pc?propertyNo={_card.PropertyNo}")">open the Property Card (PC) report</MudLink> instead.
            </MudAlert>
        }
        else
        {
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudGrid Spacing="2" Class="mb-2">
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Property No.</MudText>
                            <MudText Typo="Typo.body2"><strong>@_card.PropertyNo</strong></MudText>
                        </MudItem>
                        <MudItem xs="5">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText>
                            <MudText Typo="Typo.body2">@_card.Description</MudText>
                        </MudItem>
                        <MudItem xs="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Current State</MudText>
                            <MudText Typo="Typo.body2">@_card.CurrentState</MudText>
                        </MudItem>
                    </MudGrid>

                    @if (_card.Movements.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">No movements recorded for this asset.</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Striped="true">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Movement</th>
                                    <th>Source</th>
                                    <th>Document No.</th>
                                    <th>Party</th>
                                    <th style="text-align:right">Amount (@Money.Symbol)</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in _card.Movements)
                                {
                                    <tr>
                                        <td>@m.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@m.MovementType</td>
                                        <td>@m.Source</td>
                                        <td>@(m.DocumentNo ?? "—")</td>
                                        <td>@(m.Party ?? "—")</td>
                                        <td style="text-align:right">@(m.Amount?.ToString("N2") ?? "—")</td>
                                        <td>@(m.Remarks ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudCardContent>
            </MudCard>
        }
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="0">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Enter a Property No. and click <b>Load</b> to view the Semi-Expendable Property Card.
            </MudText>
        </MudPaper>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "propertyNo")]
    public string? PropertyNoQuery { get; set; }

    private string _propertyNo = "";
    private bool _busy;
    private string? _error;
    private PropertyCardDto? _card;

    private bool _canView => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.View);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(PropertyNoQuery))
        {
            _propertyNo = PropertyNoQuery.Trim().ToUpperInvariant();
            await LoadAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task BrowseAsync()
    {
        var parameters = new DialogParameters<AssetLookupPickerDialog>
        {
            { x => x.AssetType, AssetType.SE }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AssetLookupPickerDialog>("Find Semi-Expendable Asset", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AssetRegistrySummaryDto picked)
            return;

        _propertyNo = picked.PropertyNo;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var normalized = _propertyNo.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            Snackbar.Add("Enter a Property No. first.", Severity.Warning);
            return;
        }

        _propertyNo = normalized;
        _busy = true;
        _error = null;
        _card = null;
        try
        {
            _card = await DepreciationClient.GetPropertyCardAsync(normalized);
            if (_card is null)
                _error = $"No asset found with Property No. \"{normalized}\".";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (_card is null) return;
        try
        {
            var bytes = await ReportsClient.GetPropertyCardPdfAsync(_card.PropertyNo);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }
}
