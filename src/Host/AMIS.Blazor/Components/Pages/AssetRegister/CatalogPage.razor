@page "/asset-register/catalog"
@implements IDisposable
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@inject IArCatalogClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Property Item Catalog (Asset Register)"
               Description="Manage the local SKU catalog used to mint property numbers and default asset attributes." />

<MudGrid Spacing="3">
    <!-- List -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudTextField @bind-Value="_keyword" Label="Search" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                OnClick="LoadAsync" Disabled="_busy">Search</AMISButton>
                    @if (_canCreate)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.Add"
                                    OnClick="OpenCreateDialog" Disabled="_busy">New Catalog Item</AMISButton>
                    }
                </MudStack>

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.caption" Class="text-muted me-1">Active</MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_activeFilter is null ? Color.Primary : Color.Default)"
                             Variant="@(_activeFilter is null ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => OnActiveChanged(null))" Clickable="true">All</MudChip>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_activeFilter == true ? Color.Primary : Color.Default)"
                             Variant="@(_activeFilter == true ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => OnActiveChanged(true))" Clickable="true">Active</MudChip>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_activeFilter == false ? Color.Primary : Color.Default)"
                             Variant="@(_activeFilter == false ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => OnActiveChanged(false))" Clickable="true">Inactive</MudChip>
                </MudStack>

                <AMISDataTable @ref="_table" T="ArCatalogItemDto" ServerData="LoadServerData"
                               EmptyMessage="No catalog items found.">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align:right">Life (yr)</MudTh>
                        <MudTh Style="text-align:right">Residual %</MudTh>
                        <MudTh>Active</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code"><strong>@context.Code</strong></MudTd>
                        <MudTd DataLabel="Description">@context.Description</MudTd>
                        <MudTd DataLabel="Unit">@context.DefaultUnit</MudTd>
                        <MudTd DataLabel="Life (yr)" Style="text-align:right">@context.EstimatedUsefulLifeYears</MudTd>
                        <MudTd DataLabel="Residual %" Style="text-align:right">@context.ResidualValuePercent.ToString("0.##")%</MudTd>
                        <MudTd DataLabel="Active">
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(context.IsActive ? Color.Success : Color.Default)"
                                     Variant="Variant.Filled">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="0">
                                @if (_canUpdate)
                                {
                                    <AMISIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                    Color="Color.Primary" Title="Edit" OnClick="@(() => EditItem(context))" />
                                    <AMISIconButton Icon="@(context.IsActive ? Icons.Material.Outlined.ToggleOff : Icons.Material.Outlined.ToggleOn)"
                                                    Size="Size.Small" Color="@(context.IsActive ? Color.Warning : Color.Success)"
                                                    Title="@(context.IsActive ? "Deactivate" : "Activate")"
                                                    OnClick="@(() => ToggleActivationAsync(context))" />
                                }
                                @if (_canDelete)
                                {
                                    <AMISIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                                    Color="Color.Error" Title="Delete" OnClick="@(() => DeleteAsync(context))" />
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </AMISDataTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private AMISDataTable<ArCatalogItemDto>? _table;
    private bool _busy;
    private string? _keyword;
    private bool? _activeFilter = true;

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Catalog.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Catalog.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Catalog.Delete);

    protected override void OnInitialized()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        // AMISDataTable auto-loads via ServerData on first render.
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task<TableData<ArCatalogItemDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var result = await Client.SearchAsync(_keyword, _activeFilter, state.Page + 1, state.PageSize);
            return new TableData<ArCatalogItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load catalog: {ex.Message}", Severity.Error);
            return new TableData<ArCatalogItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task LoadAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task OpenCreateDialog() => OpenFormDialog(null);

    private Task EditItem(ArCatalogItemDto item) => OpenFormDialog(item);

    private async Task OpenFormDialog(ArCatalogItemDto? editing)
    {
        var parameters = new DialogParameters<CatalogItemFormDialog>
        {
            { x => x.EditingId, editing?.Id },
            { x => x.Code, editing?.Code },
            { x => x.Description, editing?.Description },
            { x => x.DefaultPropertyClass, editing?.DefaultPropertyClass },
            { x => x.DefaultCategoryCode, editing?.DefaultCategoryCode },
            { x => x.DefaultUnit, editing?.DefaultUnit },
            { x => x.UacsObjectCode, editing?.UacsObjectCode },
            { x => x.EstimatedUsefulLifeYears, editing?.EstimatedUsefulLifeYears },
            { x => x.ResidualValuePercent, editing?.ResidualValuePercent },
            { x => x.Method, editing?.DepreciationMethod }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var title = editing is null ? "New Catalog Item" : $"Edit: {editing.Code}";

        var dialog = await DialogService.ShowAsync<CatalogItemFormDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ToggleActivationAsync(ArCatalogItemDto item)
    {
        _busy = true;
        try
        {
            await Client.SetActivationAsync(item.Id, !item.IsActive);
            Snackbar.Add(item.IsActive ? "Item deactivated." : "Item activated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ArCatalogItemDto item)
    {
        if (!await DialogService.ShowDeleteConfirmAsync($"catalog item \"{item.Code}\""))
            return;

        _busy = true;
        try
        {
            await Client.DeleteAsync(item.Id);
            Snackbar.Add("Catalog item deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OnActiveChanged(bool? value) { _activeFilter = value; await LoadAsync(); }
}

