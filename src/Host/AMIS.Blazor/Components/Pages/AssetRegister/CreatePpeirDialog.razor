@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Modules.AssetRegister.Contracts.v1.Transfers
@using IssuanceReportType = AMIS.Modules.AssetRegister.Contracts.v1.IssuanceReportType
@using IssuanceNature = AMIS.Modules.AssetRegister.Contracts.v1.IssuanceNature
@inject IArIssuanceReportClient Client
@inject IArTransferOfferClient TransferClient
@inject ILookupClient LookupClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState
@inject IOrganizationProfileState OrgProfileState

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2" Style="min-width: 640px;">
            <!-- Header fields -->
            <MudItem xs="12" md="3">
                <MudTextField Value="@NextPpeirNumber" Label="PPEIR No." Variant="Variant.Outlined"
                              ReadOnly="true" Dense="true" Margin="Margin.Dense"
                              HelperText="From the active pre-numbered accountable form series" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect Value="_form.Nature" ValueChanged="OnNatureChanged" Label="Nature of Issuance"
                           Variant="Variant.Outlined"
                           T="IssuanceNature" Required="true" Dense="true" Margin="Margin.Dense">
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferCO">Transfer to C.O.</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferRO">Transfer to R.O.</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferPO">Transfer to P.O.</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Donation">Donation</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Dumping">Dumping</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Destruction">Destruction</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Sale">Sale</MudSelectItem>
                    <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Others">Others</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_form.FundCluster" Label="Fund Cluster" Variant="Variant.Outlined"
                              MaxLength="50" Required="true" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_form.DateNullable" Label="Date" Variant="Variant.Outlined"
                               DateFormat="MM/dd/yyyy" Required="true" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            @if (_activeSeries is null || _activeSeries.IsExhausted)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Outlined.Warning">
                        No active PPEIR form series. The report number will be auto-generated.
                        <MudLink Href="/asset-register/ppeir-series" Class="ml-1">Manage Series</MudLink>
                    </MudAlert>
                </MudItem>
            }
            @* The destination agency is derived from the recipient below, not asked for separately — the two
               used to be independent inputs that could disagree. It stays on screen as a confirmation because
               a transfer moves assets onto another agency's books and cannot be undone. *@
            @if (IsTransferNature(_form.Nature) && _canOffer)
            {
                <MudItem xs="12">
                    @if (_resolvingDestination)
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true">
                            Checking the recipient's agency…
                        </MudAlert>
                    }
                    else if (EffectiveDestination is { } destination)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true"
                                  Icon="@Icons.Material.Outlined.SwapHoriz">
                            <MudText Typo="Typo.body2">
                                Linked transfer to <b>@destination.AgencyName</b>@(_overrideDestination is null ? " — from the recipient's office" : " — chosen manually")
                            </MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">
                                They receive an offer to accept, carrying the book values across with no re-keying.
                            </MudText>
                            <MudCheckBox @bind-Value="_sendLinkedOffer" T="bool" Dense="true" Size="Size.Small"
                                         Label="Send the linked offer" />
                        </MudAlert>
                    }
                    else if (_sendLinkedOffer && _form.IssuedToEmployee is not null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            The recipient's office is not linked to an agency on AMIS — this will be posted as a
                            manual paper handshake.
                        </MudAlert>
                    }

                    @* Escape hatch for the case the derivation cannot cover: the destination agency is on AMIS
                       but the named recipient is not, so there is no employee row to derive from. *@
                    @if (_sendLinkedOffer && _destinations.Count > 0)
                    {
                        @if (_showDestinationOverride)
                        {
                            <MudSelect @bind-Value="_overrideDestination" Label="Destination Agency"
                                       Variant="Variant.Outlined" T="string?" Clearable="true"
                                       Dense="true" Margin="Margin.Dense" Class="mt-2"
                                       HelperText="Overrides the agency derived from the recipient. Clear it to go back to the derived one.">
                                @foreach (var d in _destinations)
                                {
                                    <MudSelectItem T="string?" Value="@d.TenantId">@d.AgencyName</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudLink Component="button" Typo="Typo.caption" Class="mt-1"
                                     OnClick="@(() => _showDestinationOverride = true)">
                                Choose a different agency
                            </MudLink>
                        }
                    }
                </MudItem>
            }

            <!-- Officers row -->
            <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mt-1">Signatories</MudText></MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Issued from: <b>@UserProfileState.EmployeeFullName</b>@(string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName) ? "" : $" — {UserProfileState.EmployeePositionName}") — captured automatically as the supply officer.
                </MudAlert>
            </MudItem>
            <MudItem xs="12">
                @if (!string.IsNullOrWhiteSpace(OrgProfileState.Profile?.ApprovingOfficialName))
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Approved by: <b>@OrgProfileState.Profile!.ApprovingOfficialName</b>@(string.IsNullOrWhiteSpace(OrgProfileState.Profile!.ApprovingOfficialDesignation) ? "" : $" — {OrgProfileState.Profile!.ApprovingOfficialDesignation}") — captured automatically from the organization profile.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        No approving official is set in the Organization Profile. Set it there before creating this report.
                    </MudAlert>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                @* Employee records are deliberately shared across tenants, so the recipient at the
                   destination agency is searchable here. Free text is still accepted — a transfer to an
                   agency that is not on AMIS has no employee row to pick. *@
                <MudAutocomplete T="EmployeeReferenceDto"
                                 Value="_form.IssuedToEmployee"
                                 ValueChanged="OnIssuedToEmployeeSelected"
                                 Text="@_form.IssuedToName"
                                 TextChanged="OnIssuedToNameChanged"
                                 SearchFunc="SearchEmployeesAsync"
                                 ToStringFunc="FormatEmployee"
                                 Label="Issued To (Name)" Variant="Variant.Outlined"
                                 Required="true" Clearable="true"
                                 CoerceValue="false" CoerceText="false"
                                 ResetValueOnEmptyText="false" MinCharacters="0" MaxLength="200"
                                 Dense="true" Margin="Margin.Dense"
                                 HelperText="Search an employee, or type any name for an agency not on AMIS">
                    <ItemTemplate Context="e">
                        <MudText Typo="Typo.body2">@FormatEmployee(e)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @e.EmployeeNumber@(string.IsNullOrWhiteSpace(e.PositionName) ? "" : $" — {e.PositionName}")@(string.IsNullOrWhiteSpace(e.OfficeName) ? "" : $" — {e.OfficeName}")
                        </MudText>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_form.IssuedToDesignation" Label="Issued To (Designation)" Variant="Variant.Outlined"
                              MaxLength="200" Dense="true" Margin="Margin.Dense" />
            </MudItem>
            <!-- Sits under the recipient it is filled in from, so the autofill reads top-down -->
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.IssuedToOfficeAddress" Label="Issued To — Office/Address" Variant="Variant.Outlined"
                              MaxLength="500" Required="true" Dense="true" Margin="Margin.Dense"
                              HelperText="Filled in from the selected employee's office — edit it if the assets go elsewhere" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Remarks" Label="Remarks (optional)" Variant="Variant.Outlined"
                              MaxLength="1000" Lines="2" Dense="true" Margin="Margin.Dense" />
            </MudItem>

            <!-- Asset selection -->
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                    <MudText Typo="Typo.subtitle2">
                        PPE Assets to Transfer
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">
                            — only Available PPE assets (no active PAR) may be issued
                        </MudText>
                    </MudText>
                    <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search"
                                OnClick="BrowseAssetsAsync">
                        Browse Assets…
                    </AMISButton>
                </MudStack>
            </MudItem>

            @if (_form.SelectedAssets.Count > 0)
            {
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mb-1">@_form.SelectedAssets.Count asset(s) selected:</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>Property No.</th>
                            <th>Description</th>
                            <th class="text-right">Unit Cost (@Money.Symbol)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in _form.SelectedAssets)
                        {
                            <tr>
                                <td><strong>@asset.PropertyNo</strong></td>
                                <td>@asset.Description</td>
                                <td class="text-right">@asset.UnitCost.ToString("N2")</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => _form.SelectedAssets.Remove(asset))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            }

            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Warning">
                    This action is irreversible. Assets will be permanently transferred out of this office.
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end">
                <AMISButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default"
                            Class="mr-2" Disabled="_busy">Cancel</AMISButton>
                <AMISButton Variant="Variant.Filled" Color="Color.Error"
                            OnClick="CreateAsync" Disabled="@(_busy || _form.SelectedAssets.Count == 0)">
                    Save
                </AMISButton>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private const IssuanceReportType PpeirReportType = IssuanceReportType.PPEIR;

    private bool _busy;
    private readonly CreateFormModel _form = new();
    private ArPPEIRFormSeriesDto? _activeSeries;

    private IReadOnlyList<TransferDestinationDto> _destinations = [];

    // Resolved from the recipient's office. Null means no agency on AMIS owns that office — or the
    // recipient is in our own agency, which is an ordinary internal issuance rather than a transfer.
    private TransferDestinationDto? _derivedDestination;
    private bool _resolvingDestination;

    // Unchecking posts the report with no linked offer, i.e. the manual paper handshake.
    private bool _sendLinkedOffer = true;

    private bool _showDestinationOverride;
    private string? _overrideDestination;

    // A manual override wins over the derived agency; clearing it falls back to the recipient's own.
    private TransferDestinationDto? EffectiveDestination
    {
        get
        {
            if (!_sendLinkedOffer)
                return null;

            return _overrideDestination is { Length: > 0 } chosen
                ? _destinations.FirstOrDefault(d => d.TenantId == chosen)
                : _derivedDestination;
        }
    }

    // The last value this dialog wrote into the office/address field, so a hand-typed one is
    // distinguishable from an autofill and never overwritten.
    private string? _autoFilledOfficeAddress;

    private bool _canOffer => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Transfers.Offer);

    // The PPEIR number comes from the active pre-numbered accountable form series — shown
    // here before saving. When no active series exists the warning alert above guides setup.
    private string NextPpeirNumber =>
        _activeSeries is { IsExhausted: false } s
            ? s.NextSerial.ToString($"D{s.EndSerial.ToString().Length}")
            : "No active series";

    protected override async Task OnInitializedAsync()
    {
        try { _activeSeries = await Client.GetActiveSeriesAsync(); }
        catch { /* non-critical — the warning alert covers the no-series case */ }

        // Only fetched for users who may actually offer a transfer; the endpoint is gated the same way.
        if (_canOffer)
        {
            try { _destinations = await TransferClient.GetDestinationsAsync(); }
            catch { /* non-critical — the picker stays empty and the manual handshake still works */ }
        }
    }

    private sealed class CreateFormModel
    {
        public IssuanceNature Nature { get; set; }
        public string FundCluster { get; set; } = "";
        public DateTime? DateNullable { get; set; } = DateTime.Today;
        public string IssuedToName { get; set; } = "";
        public string? IssuedToDesignation { get; set; }
        // Set only when the name was picked from the employee lookup. Null for a hand-typed
        // recipient, which is why the printed name — not this — is the authoritative field.
        public EmployeeReferenceDto? IssuedToEmployee { get; set; }
        public string IssuedToOfficeAddress { get; set; } = "";
        public string? Remarks { get; set; }
        public List<AssetRegistrySummaryDto> SelectedAssets { get; set; } = [];
    }

    private async Task<IEnumerable<EmployeeReferenceDto>> SearchEmployeesAsync(string? value, CancellationToken ct)
    {
        try
        {
            var result = await LookupClient.EmployeesGetAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                isActive: true,
                pageNumber: 1,
                pageSize: 20,
                cancellationToken: ct);
            return result?.Items ?? [];
        }
        catch { return []; }
    }

    // The printed name only — the employee number and position are shown in the dropdown's
    // ItemTemplate instead, so that picking someone never drags an ID into the printed form.
    private static string FormatEmployee(EmployeeReferenceDto? e) =>
        e is null ? "" : $"{e.FirstName} {e.LastName}".Trim();

    private async Task OnIssuedToEmployeeSelected(EmployeeReferenceDto? employee)
    {
        _form.IssuedToEmployee = employee;
        if (employee is null)
        {
            _derivedDestination = null;
            return;
        }

        _form.IssuedToName = FormatEmployee(employee);
        if (!string.IsNullOrWhiteSpace(employee.PositionName))
            _form.IssuedToDesignation = employee.PositionName;

        FillOfficeAddress(employee);
        await ResolveDestinationAsync();
    }

    // Who the property is issued to decides which agency's books it lands on, so the destination is looked
    // up from the recipient rather than asked for a second time. Resolution is server-side because the
    // office-to-agency mapping lives in the tenant registry, which the client cannot see.
    private async Task ResolveDestinationAsync()
    {
        var employeeId = _form.IssuedToEmployee?.Id;
        if (!_canOffer || employeeId is null || !IsTransferNature(_form.Nature))
        {
            _derivedDestination = null;
            return;
        }

        _resolvingDestination = true;
        try
        {
            _derivedDestination = await TransferClient.ResolveDestinationForEmployeeAsync(employeeId.Value);
        }
        catch
        {
            // Non-critical: without a derived agency the report still posts as a manual handshake, and the
            // override picker is still available.
            _derivedDestination = null;
        }
        finally
        {
            _resolvingDestination = false;
        }
    }

    private async Task OnNatureChanged(IssuanceNature nature)
    {
        _form.Nature = nature;

        // Switching away from a transfer nature must not leave a stale destination behind — the server
        // rejects a destination on any other nature.
        if (!IsTransferNature(nature))
        {
            _derivedDestination = null;
            _overrideDestination = null;
            _showDestinationOverride = false;
            return;
        }

        await ResolveDestinationAsync();
    }

    // The recipient's office is the destination the form is printed against, so picking an employee
    // fills it in. A value the user typed themselves is never clobbered — only a blank field or a
    // previous autofill is replaced, so re-picking a different employee still updates it.
    private void FillOfficeAddress(EmployeeReferenceDto employee)
    {
        if (!string.IsNullOrWhiteSpace(_form.IssuedToOfficeAddress) &&
            !string.Equals(_form.IssuedToOfficeAddress, _autoFilledOfficeAddress, StringComparison.Ordinal))
        {
            return;
        }

        // Offices with no address on file still yield a usable value — just the office name.
        var address = string.IsNullOrWhiteSpace(employee.OfficeAddress)
            ? employee.OfficeName
            : $"{employee.OfficeName}, {employee.OfficeAddress}";

        if (string.IsNullOrWhiteSpace(address))
            return;

        if (address.Length > 500)
            address = address[..500];

        _form.IssuedToOfficeAddress = address;
        _autoFilledOfficeAddress = address;
    }

    private void OnIssuedToNameChanged(string? text)
    {
        _form.IssuedToName = text ?? "";

        // Editing the name after picking someone breaks the link: the snapshot must never claim an
        // employee id whose name is not the one being printed on the form.
        if (_form.IssuedToEmployee is not null &&
            !string.Equals(_form.IssuedToName, FormatEmployee(_form.IssuedToEmployee), StringComparison.Ordinal))
        {
            _form.IssuedToEmployee = null;

            // The destination was derived from that employee, so it must not outlive the link. An explicit
            // manual override is the user's own choice and is deliberately left standing.
            _derivedDestination = null;
        }
    }

    private static bool IsTransferNature(IssuanceNature nature) =>
        nature is IssuanceNature.TransferCO or IssuanceNature.TransferRO or IssuanceNature.TransferPO;

    private void Cancel() => Dialog.Cancel();

    private async Task BrowseAssetsAsync()
    {
        var parameters = new DialogParameters<AvailableAssetsPickerDialog>
        {
            { x => x.AssetType, AMIS.Modules.AssetRegister.Contracts.v1.AssetType.PPE },
            { x => x.ExcludeIds, (IReadOnlyCollection<Guid>)_form.SelectedAssets.Select(a => a.Id).ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AvailableAssetsPickerDialog>("Available PPE Assets", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<AssetRegistrySummaryDto> picked || picked.Count == 0)
            return;

        foreach (var asset in picked.Where(a => _form.SelectedAssets.All(x => x.Id != a.Id)))
            _form.SelectedAssets.Add(asset);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FundCluster) ||
            string.IsNullOrWhiteSpace(_form.IssuedToName) ||
            string.IsNullOrWhiteSpace(_form.IssuedToOfficeAddress) ||
            !_form.DateNullable.HasValue)
        {
            Snackbar.Add("All required fields must be filled.", Severity.Warning);
            return;
        }

        var approvingOfficialName = OrgProfileState.Profile?.ApprovingOfficialName;
        if (string.IsNullOrWhiteSpace(approvingOfficialName))
        {
            Snackbar.Add("No approving official is set in the Organization Profile. Set it there before creating this report.", Severity.Warning);
            return;
        }

        if (_form.SelectedAssets.Count == 0)
        {
            Snackbar.Add("At least one asset must be selected.", Severity.Warning);
            return;
        }

        if (UserProfileState.EmployeeId == Guid.Empty)
        {
            Snackbar.Add("Your account is not linked to an employee record. Cannot prepare a report.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var req = new CreateIssuanceReportRequest(
                PpeirReportType,
                DateOnly.FromDateTime(_form.DateNullable.Value),
                _form.FundCluster,
                _form.Nature,
                new ArEmployeeRefDto(
                    UserProfileState.EmployeeId,
                    UserProfileState.EmployeeFullName.Trim(),
                    string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName) ? null : UserProfileState.EmployeePositionName.Trim()),
                // A hand-typed recipient has no employee row, so the id stays empty — the printed
                // name is what the form is signed against either way.
                new ArEmployeeRefDto(
                    _form.IssuedToEmployee?.Id ?? Guid.Empty,
                    _form.IssuedToName.Trim(),
                    _form.IssuedToDesignation),
                _form.IssuedToOfficeAddress.Trim(),
                _form.Remarks?.Trim(),
                _form.SelectedAssets.Select(a => a.Id).ToList(),
                // Derived from the recipient (or overridden by hand), and only meaningful on a Transfer*
                // nature for a user who may offer — the server rejects it otherwise.
                IsTransferNature(_form.Nature) && _canOffer ? EffectiveDestination?.TenantId : null);

            var created = await Client.CreateAsync(req);
            Snackbar.Add($"PPEIR {created.ReportNo} created. Assets transferred out.", Severity.Success);
            Dialog.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
