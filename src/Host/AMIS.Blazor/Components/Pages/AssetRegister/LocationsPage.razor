@page "/asset-register/locations"
@using AMIS.Framework.Blazor.UI.Components.Data
@using AMIS.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILocationClient LocationClient
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Locations" Description="Manage locations where assets are placed and kept">
    <ActionContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width: 100%; max-width: 560px;">
            <MudTextField @bind-Value="_searchKeyword" Label="Search" Placeholder="Search locations..."
                          DebounceInterval="300" OnDebounceIntervalElapsed="@(async () => await LoadAsync())"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" Disabled="_isLoading">
                Search
            </AMISButton>
            @if (_canCreate)
            {
                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                            StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    New
                </AMISButton>
            }
        </MudStack>
    </ActionContent>
</AMISPageHeader>

<div class="mt-4">
    <MudCard Class="AMIS-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Locations List</MudText>

            <AMISDataTable T="LocationModel" Items="_locations" Loading="_isLoading" RowsPerPage="10"
                           EmptyMessage="No locations yet."
                           EmptyDescription='Create one to get started (e.g. "Supply Room").'>
                <HeaderContent>
                    <MudTh>Code</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Label="true"
                                 Style="font-family: monospace;">@context.Code</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Type"><MudChip T="string" Size="Size.Small" Color="Color.Default" Label="true">@context.Type</MudChip></MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Actions">
                        @if (_canUpdate || _canDelete)
                        {
                            <MudStack Row="true" Spacing="1">
                                @if (_canUpdate)
                                {
                                    <MudTooltip Text="Edit location">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                        Color="Color.Primary" OnClick="@(() => OpenEditDialog(context))" />
                                    </MudTooltip>
                                }
                                @if (_canDelete)
                                {
                                    <MudTooltip Text="Delete location">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                        Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        }
                    </MudTd>
                </RowTemplate>
            </AMISDataTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private List<LocationModel> _locations = new();
    private bool _isLoading;
    private string _searchKeyword = string.Empty;

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Locations.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Locations.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Locations.Delete);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            var result = await LocationClient.ListAsync(
                keyword: string.IsNullOrWhiteSpace(_searchKeyword) ? null : _searchKeyword,
                pageSize: 200);
            _locations = result.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load locations: {ex.Message}", Severity.Error);
            _locations = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<LocationFormDialog>("Create Location", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialog(LocationModel loc)
    {
        var parameters = new DialogParameters<LocationFormDialog> { { x => x.Existing, loc } };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<LocationFormDialog>($"Edit {loc.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task DeleteAsync(LocationModel loc)
    {
        if (!await DialogService.ShowDeleteConfirmAsync($"location \"{loc.Name}\""))
            return;

        try
        {
            await LocationClient.DeleteAsync(loc.Id);
            Snackbar.Add("Location deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete location: {ex.Message}", Severity.Error);
        }
    }
}
