@using AMIS.Blazor.ApiClient
@using ArContracts = AMIS.Modules.AssetRegister.Contracts.v1
@inject IAssetRegistryClient AssetClient

@* Server-paged picker of Available assets eligible for issuance. Returns List<AssetRegistrySummaryDto>. *@
<EntityPickerDialog T="AssetRegistrySummaryDto"
                    KeySelector="a => a.Id"
                    DataProvider="LoadAsync"
                    ExcludeIds="ExcludeIds"
                    ConfirmText="Add">
    <Caption>
        Showing <strong>Available</strong> @(AssetType == ArContracts.AssetType.SE ? "Semi-Expendable" : "PPE") assets eligible for issuance. Tick the items to add, then choose <strong>Add</strong>.
    </Caption>
    <HeaderTemplate>
        <MudTh>Property No.</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Condition</MudTh>
        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
    </HeaderTemplate>
    <RowTemplate Context="row">
        <MudTd>
            <strong>@row.Item.PropertyNo</strong>
            @if (row.IsExcluded)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">(already added)</MudText>
            }
        </MudTd>
        <MudTd>@row.Item.Description</MudTd>
        <MudTd>@row.Item.CurrentCondition</MudTd>
        <MudTd Style="text-align:right">@row.Item.UnitCost.ToString("N2")</MudTd>
    </RowTemplate>
</EntityPickerDialog>

@code {
    [Parameter] public ArContracts.AssetType AssetType { get; set; }
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    private async Task<EntityPickerResult<AssetRegistrySummaryDto>> LoadAsync(EntityPickerRequest request)
    {
        var result = await AssetClient.SearchAsync(
            keyword: request.Keyword,
            assetType: AssetType,
            lifecycleState: ArContracts.LifecycleState.Available,
            page: request.Page,
            pageSize: request.PageSize);

        return new EntityPickerResult<AssetRegistrySummaryDto>(result.Items, result.TotalCount);
    }
}
