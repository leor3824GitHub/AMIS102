@using AMIS.Blazor.ApiClient
@using ArContracts = AMIS.Modules.AssetRegister.Contracts.v1
@inject IAssetRegistryClient AssetClient

@* Server-paged picker of Available assets eligible for issuance. Returns List<AssetRegistrySummaryDto>. *@
<EntityPickerDialog T="AssetRegistrySummaryDto"
                    KeySelector="a => a.Id"
                    DataProvider="LoadAsync"
                    ExcludeIds="ExcludeIds"
                    RowSelectable="CanSelect"
                    ConfirmText="Add">
    <Caption>
        Showing <strong>Available</strong> @(AssetType == ArContracts.AssetType.SE ? "Semi-Expendable" : "PPE") assets eligible for issuance. Tick the items to add, then choose <strong>Add</strong>.
        @if (AssetType == ArContracts.AssetType.SE && LockedCategory is not null)
        {
            <span>
                This ICS already contains <strong>@CategoryLabel(LockedCategory.Value)</strong> items —
                only <strong>@CategoryLabel(LockedCategory.Value)</strong> items may be added. Low- and high-valued
                semi-expendable items are issued on separate ICS documents (COA 2022-004 §4.14).
            </span>
        }
        @if (LockedFundCluster is { Length: > 0 } lockedCluster)
        {
            <span>
                This report is under fund cluster <strong>@lockedCluster</strong> — only assets from that cluster
                may be added.
            </span>
        }
    </Caption>
    <HeaderTemplate>
        <MudTh>Property No.</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Condition</MudTh>
        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
    </HeaderTemplate>
    <RowTemplate Context="row">
        <MudTd Style="@RowStyle(row)">
            <strong>@row.Item.PropertyNo</strong>
            @if (row.IsExcluded)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">(already added)</MudText>
            }
            else if (row.IsLocked)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">@LockReason(row.Item)</MudText>
            }
        </MudTd>
        <MudTd Style="@RowStyle(row)">@row.Item.Description</MudTd>
        <MudTd Style="@RowStyle(row)">@row.Item.CurrentCondition</MudTd>
        <MudTd Style="@($"text-align:right;{RowStyle(row)}")">@row.Item.UnitCost.ToString("N2")</MudTd>
    </RowTemplate>
</EntityPickerDialog>

@code {
    [Parameter] public ArContracts.AssetType AssetType { get; set; }
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    /// <summary>
    /// When the caller (the Issue dialog) already holds semi-expendable items of one category, the picker
    /// opens pre-locked to that category so a mix can't be introduced. Null = no items yet, so the first
    /// item ticked in the picker sets the category. Only meaningful for SE/ICS.
    /// </summary>
    [Parameter] public ArContracts.AssetCategory? LockedCategory { get; set; }

    /// <summary>
    /// The fund cluster the caller's report is already committed to, so assets from another cluster can't
    /// be ticked. Null = no assets on the report yet, and the first item ticked here sets the cluster.
    /// </summary>
    [Parameter] public string? LockedFundCluster { get; set; }

    private async Task<EntityPickerResult<AssetRegistrySummaryDto>> LoadAsync(EntityPickerRequest request)
    {
        var result = await AssetClient.SearchAsync(
            keyword: request.Keyword,
            assetType: AssetType,
            lifecycleState: ArContracts.LifecycleState.Available,
            page: request.Page,
            pageSize: request.PageSize);

        return new EntityPickerResult<AssetRegistrySummaryDto>(result.Items, result.TotalCount);
    }

    // Two cross-row rules, each following the same shape: the active value is whatever the calling dialog
    // already holds, or failing that the first item ticked here; rows that disagree stay disabled.
    //
    // 1. COA 2022-004 §4.14 — one ICS may not mix low- and high-valued semi-expendable items (SE only).
    // 2. Fund cluster — a property form is filed under exactly one cluster. Since the report inherits its
    //    cluster from these assets, letting a mixed set through would force the user to pick one by hand
    //    and thereby file the rest under a cluster they were never procured under.
    private bool CanSelect(AssetRegistrySummaryDto item, IReadOnlyCollection<AssetRegistrySummaryDto> selected)
    {
        // Depends only on the selection, so it is the same for every row in a render pass. The picker calls
        // this for a row immediately before rendering that row's template, so LockReason can read it back.
        _activeCluster = LockedFundCluster is { Length: > 0 } locked
            ? locked
            : selected.Select(a => a.FundCluster).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c));

        if (_activeCluster is { Length: > 0 } cluster &&
            !string.Equals(item.FundCluster, cluster, StringComparison.OrdinalIgnoreCase))
            return false;

        if (AssetType != ArContracts.AssetType.SE) return true;

        var activeCategory = LockedCategory ?? selected.FirstOrDefault()?.Category;
        return activeCategory is null || item.Category == activeCategory;
    }

    private string? _activeCluster;

    // Which of the two rules disabled this row — the cluster mismatch is checked first, mirroring CanSelect.
    private string LockReason(AssetRegistrySummaryDto item) =>
        _activeCluster is { Length: > 0 } cluster &&
        !string.Equals(item.FundCluster, cluster, StringComparison.OrdinalIgnoreCase)
            ? $"Fund cluster {item.FundCluster} — separate report"
            : $"{CategoryLabel(item.Category)} — separate ICS";

    private static string RowStyle(EntityPickerRow<AssetRegistrySummaryDto> row) => row.IsLocked ? "opacity:0.5;" : "";

    private static string CategoryLabel(ArContracts.AssetCategory category) => category switch
    {
        ArContracts.AssetCategory.LowValuedSemi => "low-valued",
        ArContracts.AssetCategory.HighValuedSemi => "high-valued",
        _ => category.ToString()
    };
}
