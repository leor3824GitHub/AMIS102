@page "/procurement/purchase-requests"
@implements IDisposable
@using AMIS.Modules.ProcurementAcquisition.Contracts.Permissions
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.SignedDocuments
@using AMIS.Framework.Shared.Persistence
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Playground.Blazor.Components.Shared
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IPurchaseRequestClient Client
@inject IMaster_dataClient MasterDataClient
@inject ILookupClient LookupClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject IEmployeesClient EmployeesClient
@inject IUserProfileState UserProfileState
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS

<AMISPageHeader Title="Purchase Requests" Description="Manage procurement purchase requests (PR)" />

<MudGrid Spacing="3">
    <!-- List Panel - Full Width -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <!-- Header: title + primary action -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Purchase Requests</MudText>
                    @if (_canCreate)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            NEW PURCHASE REQUEST
                        </MudButton>
                    }
                </MudStack>

                <!-- Filter toolbar: search + date range -->
                <AMISFilterBar Keyword="@_keyword" KeywordChanged="OnKeywordChanged"
                               SearchPlaceholder="Search for PR"
                               FromDate="_fromDate" FromDateChanged="OnFromDateChanged"
                               ToDate="_toDate" ToDateChanged="OnToDateChanged" />

                <!-- Status filter chips -->
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    @foreach (var (index, label) in _statusTabs)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_activeTabIndex == index ? Color.Primary : Color.Default)"
                                 Variant="@(_activeTabIndex == index ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => OnTabChanged(index))">@GetTabLabel(index, label)</MudChip>
                    }
                </MudStack>

                @if (!_loaded)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No purchase requests found.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>PR #</th>
                                <th>Date</th>
                                <th>Purpose</th>
                                <th>Type</th>
                                <th style="text-align:right">Est. Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="pa-0 text-none"
                                                   OnClick="@(async () => await ShowDetailsAsync(item.Id))">
                                            <b>@item.PrNumber</b>
                                        </MudButton>
                                    </td>
                                    <td>@item.PrDate.ToString("MM/dd/yyyy")</td>
                                    <td style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@item.Purpose">@item.Purpose</td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(item.PrType == PrType.Unplanned ? Color.Warning : Color.Info)">
                                            @item.PrType
                                        </MudChip>
                                    </td>
                                    <td style="text-align:right">@Money.Symbol@item.TotalEstimatedCost.ToString("N2")</td>
                                    <td>
                                        @StatusChip(item.Status)
                                    </td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            <MudTooltip Text="View Details">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default"
                                                               OnClick="@(async () => await ShowDetailsAsync(item.Id))" />
                                            </MudTooltip>
                                            <MudMenu Icon="@Icons.Material.Filled.Print"
                                                     Color="Color.Secondary"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     AnchorOrigin="Origin.BottomLeft"
                                                     TransformOrigin="Origin.TopLeft"
                                                     ToolTip="Print">
                                                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                             OnClick="@(() => DownloadFastReportPdfAsync(item.Id))">
                                                    Download PDF
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.ContentCut"
                                                             OnClick="@(() => OpenFastReportSetupAsync(item.Id))">
                                                    Fast Report – Page Setup…
                                                </MudMenuItem>
                                            </MudMenu>
                                            @if (item.Status == PurchaseRequestStatus.Draft)
                                            {
                                                @if (_canUpdate)
                                                {
                                                    <MudTooltip Text="Edit">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                                       OnClick="@(async () => await OpenEditDialog(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canSubmit)
                                                {
                                                    <MudTooltip Text="Submit for Approval">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Info"
                                                                       OnClick="@(async () => await SubmitAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canCancel)
                                                {
                                                    <MudTooltip Text="Cancel">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="@(async () => await CancelPrAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                            }
                                            @if (item.Status == PurchaseRequestStatus.PendingFundsAvailable)
                                            {
                                                @if (_canCertifyFundsAvailable)
                                                {
                                                    <MudTooltip Text="Certify Funds Available (Accountant)">
                                                        <MudIconButton Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Info"
                                                                       OnClick="@(async () => await CertifyFundsAvailableAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canReturnForRevision)
                                                {
                                                    <MudTooltip Text="Return for Revision">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Warning"
                                                                       OnClick="@(async () => await ReturnForRevisionAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                            }
                                            @if (item.Status == PurchaseRequestStatus.PendingApproval)
                                            {
                                                @if (_canApprove)
                                                {
                                                    <MudTooltip Text="Approve (HoPE)">
                                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                                                       OnClick="@(async () => await ApproveAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canReturnForRevision)
                                                {
                                                    <MudTooltip Text="Return for Revision">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Warning"
                                                                       OnClick="@(async () => await ReturnForRevisionAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canReject)
                                                {
                                                    <MudTooltip Text="Reject">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="@(async () => await RejectAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                            }
                                            @if (IsSignedPr(item.Status) && (item.HasSignedCopy ? _canViewSignedCopy : _canUploadSignedCopy))
                                            {
                                                <MudTooltip Text="@(item.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                                   Color="@(item.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                                   OnClick="@(() => OpenSignedCopyAsync(item))" />
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_totalCount > _pageSize)
                    {
                        <MudStack Row="true" JustifyContent="JustifyContent.Center" Class="mt-3">
                            <MudPagination Count="@((_totalCount + _pageSize - 1) / _pageSize)"
                                           Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                        </MudStack>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _canCreate => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Update);
    private bool _canSubmit => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Submit);
    private bool _canCancel => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Cancel);
    private bool _canCertifyFundsAvailable => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.CertifyFundsAvailable);
    private bool _canApprove => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Approve);
    private bool _canReturnForRevision => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.ReturnForRevision);
    private bool _canReject => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseRequests.Reject);
    private bool _canViewSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.View);
    private bool _canUploadSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.Upload);

    private List<PurchaseRequestSummaryDto> _items = [];
    private bool _loaded;
    private string _keyword = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _activeTabIndex = 0;
    private int _page = 1, _pageSize = 15, _totalCount;

    // Status filter chips — index mirrors GetStatusFromTabIndex / _statusCounts keys (tab 0 = "All").
    private static readonly (int Index, string Label)[] _statusTabs =
    [
        (0, "All"),
        (1, "Draft"),
        (2, "Pending Funds"),
        (3, "Pending Approval"),
        (4, "Approved"),
        (5, "Rejected"),
        (6, "Cancelled"),
        (7, "Completed"),
    ];
    private string _currentUserEmployeeName = string.Empty;
    private List<DepartmentReferenceDto> _departments = [];
    private Dictionary<int, int> _statusCounts = [];

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadDepartmentsAsync();
        await LoadCurrentUserAsync();
        await LoadStatusCountsAsync();
        await LoadAsync();
    }

    // Permissions load asynchronously in PlaygroundLayout after first render; re-render when they arrive
    // so permission-gated controls appear on a hard refresh without requiring a user interaction.
    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadDepartmentsAsync()
    {
        try
        {
            var response = await LookupClient.DepartmentsAsync(pageSize: 1000, isActive: true);
            _departments = response?.Items?.ToList() ?? [];
        }
        catch { _departments = []; }
    }

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var idStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrWhiteSpace(idStr))
            {
                var employee = await EmployeesClient.ByIdentityAsync(idStr);
                if (employee is not null)
                    _currentUserEmployeeName = $"{employee.FirstName} {employee.LastName}";
            }
        }
        catch { _currentUserEmployeeName = string.Empty; }
    }

    private async Task LoadStatusCountsAsync()
    {
        try
        {
            _statusCounts.Clear();

            // Single grouped query (GROUP BY Status) instead of one count request per status tab.
            var counts = await Client.GetStatusCountsAsync(ToDateOnly(_fromDate), ToDateOnly(_toDate));
            var byStatus = counts.ToDictionary(c => c.Status, c => c.Count);

            // Tab index → status mapping mirrors GetStatusFromTabIndex (tab 0 = "All").
            _statusCounts[1] = byStatus.GetValueOrDefault(PurchaseRequestStatus.Draft);
            _statusCounts[2] = byStatus.GetValueOrDefault(PurchaseRequestStatus.PendingFundsAvailable);
            _statusCounts[3] = byStatus.GetValueOrDefault(PurchaseRequestStatus.PendingApproval);
            _statusCounts[4] = byStatus.GetValueOrDefault(PurchaseRequestStatus.Approved);
            _statusCounts[5] = byStatus.GetValueOrDefault(PurchaseRequestStatus.Rejected);
            _statusCounts[6] = byStatus.GetValueOrDefault(PurchaseRequestStatus.Cancelled);
            _statusCounts[7] = byStatus.GetValueOrDefault(PurchaseRequestStatus.Completed);
            _statusCounts[0] = byStatus.Values.Sum(); // Tab 0 "All"
        }
        catch { _statusCounts = []; }
    }

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            PurchaseRequestStatus? filter = GetStatusFromTabIndex(_activeTabIndex);
            var result = await Client.SearchAsync(_keyword, filter, _page, _pageSize, ToDateOnly(_fromDate), ToDateOnly(_toDate));
            _items = result.Items?.ToList() ?? [];
            _totalCount = (int)result.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loaded = true; }
    }

    private async Task OnTabChanged(int index)
    {
        _activeTabIndex = index;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnKeywordChanged(string? keyword)
    {
        _keyword = keyword ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _fromDate = date;
        _page = 1;
        await LoadAsync();
        await RefreshTabCountsAsync();
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _toDate = date;
        _page = 1;
        await LoadAsync();
        await RefreshTabCountsAsync();
    }

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is null ? null : DateOnly.FromDateTime(value.Value);

    private async Task RefreshTabCountsAsync()
    {
        await LoadStatusCountsAsync();
        StateHasChanged();
    }

    private static PurchaseRequestStatus? GetStatusFromTabIndex(int index) =>
        index switch
        {
            0 => null, // All
            1 => PurchaseRequestStatus.Draft,
            2 => PurchaseRequestStatus.PendingFundsAvailable,
            3 => PurchaseRequestStatus.PendingApproval,
            4 => PurchaseRequestStatus.Approved,
            5 => PurchaseRequestStatus.Rejected,
            6 => PurchaseRequestStatus.Cancelled,
            7 => PurchaseRequestStatus.Completed,
            _ => null
        };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<PurchaseRequestFormDialog>
        {
            { x => x.PurchaseRequest, null }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await OpenFormDialog(parameters, options);
    }

    private async Task OpenEditDialog(Guid id)
    {
        var pr = await Client.GetAsync(id);
        if (pr is null) { Snackbar.Add("PR not found.", Severity.Error); return; }

        var parameters = new DialogParameters<PurchaseRequestFormDialog>
        {
            { x => x.PurchaseRequest, pr }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await OpenFormDialog(parameters, options);
    }

    private async Task OpenFormDialog(DialogParameters<PurchaseRequestFormDialog> parameters, DialogOptions options)
    {
        var dialog = await DialogService.ShowAsync<PurchaseRequestFormDialog>("Purchase Request", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            await RefreshTabCountsAsync();
        }
    }

    private async Task ShowDetailsAsync(Guid id)
    {
        try
        {
            var pr = await Client.GetAsync(id);
            if (pr is null) { Snackbar.Add("PR not found.", Severity.Error); return; }

            var departmentName = _departments.FirstOrDefault(d => d.Id == pr.DepartmentId)?.Name;
            if (string.IsNullOrEmpty(departmentName) && pr.DepartmentId != Guid.Empty)
            {
                try { departmentName = (await MasterDataClient.DepartmentsGetAsync(pr.DepartmentId))?.Name; }
                catch { }
            }
            if (!string.IsNullOrEmpty(departmentName))
                pr = pr with { DepartmentName = departmentName };

            var parameters = new DialogParameters<PurchaseRequestDetailsDialog>
            {
                { x => x.PurchaseRequest, pr }
            };

            var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
            await DialogService.ShowAsync<PurchaseRequestDetailsDialog>($"PR Details - {pr.PrNumber}", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load PR details: {ex.Message}", Severity.Error);
        }
    }

    private static bool IsSignedPr(PurchaseRequestStatus status) =>
        status is PurchaseRequestStatus.Approved or PurchaseRequestStatus.Completed;

    private async Task OpenSignedCopyAsync(PurchaseRequestSummaryDto item)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, ProcurementDocumentType.PurchaseRequest },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, item.PrNumber },
            { x => x.IsTerminalState, IsSignedPr(item.Status) }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == item.Id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    private async Task SubmitAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Submit PR", "Submit this purchase request for approval?", "Submit", cancelText: "Cancel");
        if (ok is not true) return;
        try { await Client.SubmitAsync(id); Snackbar.Add("PR submitted.", Severity.Success); await LoadAsync(); await RefreshTabCountsAsync(); }
        catch (Exception ex) { Snackbar.Add($"Submit failed: {ex.Message}", Severity.Error); }
    }

    private async Task CertifyFundsAvailableAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_currentUserEmployeeName))
        {
            Snackbar.Add("Cannot determine current user identity. Please re-login.", Severity.Warning);
            return;
        }

        PurchaseRequestDto? pr;
        try { pr = await Client.GetAsync(id); }
        catch (Exception ex) { Snackbar.Add($"Load PR failed: {ex.Message}", Severity.Error); return; }
        if (pr is null) { Snackbar.Add("PR not found.", Severity.Warning); return; }

        var parameters = new DialogParameters<CertifyFundsAvailableDialog>
        {
            { x => x.PurchaseRequest, pr },
            { x => x.CertifiedByName, _currentUserEmployeeName }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CertifyFundsAvailableDialog>($"Funds Available — {pr.PrNumber}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            await RefreshTabCountsAsync();
        }
    }

    private async Task ApproveAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_currentUserEmployeeName))
        {
            Snackbar.Add("Cannot determine current user identity. Please re-login.", Severity.Warning);
            return;
        }
        var ok = await DialogService.ShowMessageBox("Approve PR", "Approve this purchase request as Head of Procuring Entity?", "Approve", cancelText: "Cancel");
        if (ok is not true) return;
        try
        {
            await Client.ApproveAsync(id, _currentUserEmployeeName);
            Snackbar.Add("PR approved.", Severity.Success);
            await LoadAsync();
            await RefreshTabCountsAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Approve failed: {ex.Message}", Severity.Error); }
    }

    private async Task ReturnForRevisionAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_currentUserEmployeeName))
        {
            Snackbar.Add("Cannot determine current user identity. Please re-login.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ReasonInputDialog>
        {
            { x => x.Title, "Return for Revision" },
            { x => x.Label, "Reason for Return" },
            { x => x.ConfirmText, "Return" }
        };
        var dialog = await DialogService.ShowAsync<ReasonInputDialog>("Return for Revision", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason || string.IsNullOrWhiteSpace(reason))
            return;

        try
        {
            await Client.ReturnForRevisionAsync(id, _currentUserEmployeeName, reason);
            Snackbar.Add("PR returned to requester for revision.", Severity.Info);
            await LoadAsync();
            await RefreshTabCountsAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Return failed: {ex.Message}", Severity.Error); }
    }

    private async Task RejectAsync(Guid id)
    {
        var parameters = new DialogParameters<ReasonInputDialog>
        {
            { x => x.Title, "Reject Purchase Request" },
            { x => x.Label, "Rejection Reason" },
            { x => x.ConfirmText, "Reject" }
        };
        var dialog = await DialogService.ShowAsync<ReasonInputDialog>("Reject PR", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason || string.IsNullOrWhiteSpace(reason))
            return;

        try { await Client.RejectAsync(id, reason); Snackbar.Add("PR rejected.", Severity.Info); await LoadAsync(); await RefreshTabCountsAsync(); }
        catch (Exception ex) { Snackbar.Add($"Reject failed: {ex.Message}", Severity.Error); }
    }

    private async Task CancelPrAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Cancel PR", "Cancel this purchase request?", "Yes, Cancel", cancelText: "No");
        if (ok is not true) return;
        try { await Client.CancelAsync(id); Snackbar.Add("PR cancelled.", Severity.Info); await LoadAsync(); await RefreshTabCountsAsync(); }
        catch (Exception ex) { Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error); }
    }

    private async Task DownloadFastReportPdfAsync(Guid id)
    {
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await Client.GetFastReportPdfAsync(id,
                pageWidth: saved?.PaperSize ?? "a4",
                copies: saved?.Copies ?? 2,
                orientation: saved?.Orientation ?? "landscape",
                minRows: saved?.MinRows ?? 10);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private const string FastReportKey = "purchase-request";

    private async Task OpenFastReportSetupAsync(Guid id)
    {
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "a4",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "landscape",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 2,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 10,
            [nameof(FastReportPageSetupDialog.SupportsPortraitTwoCopies)] = true
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        try
        {
            var bytes = await Client.GetFastReportPdfAsync(id, pageWidth: r.PaperSize, copies: r.Copies, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }

    private string GetTabLabel(int tabIndex, string label)
    {
        if (_statusCounts.TryGetValue(tabIndex, out var count) && count > 0)
            return $"{label} ({count})";
        return label;
    }

    private static RenderFragment StatusChip(PurchaseRequestStatus status) => __builder =>
    {
        var (color, icon) = status switch
        {
            PurchaseRequestStatus.Draft => (Color.Default, Icons.Material.Filled.Edit),
            PurchaseRequestStatus.PendingFundsAvailable => (Color.Info, Icons.Material.Filled.AccountBalance),
            PurchaseRequestStatus.PendingApproval => (Color.Secondary, Icons.Material.Filled.HourglassBottom),
            PurchaseRequestStatus.ReturnedForRevision => (Color.Warning, Icons.Material.Filled.Reply),
            PurchaseRequestStatus.Approved => (Color.Success, Icons.Material.Filled.CheckCircle),
            PurchaseRequestStatus.Rejected => (Color.Error, Icons.Material.Filled.Cancel),
            PurchaseRequestStatus.Cancelled => (Color.Warning, Icons.Material.Filled.Block),
            PurchaseRequestStatus.Completed => (Color.Tertiary, Icons.Material.Filled.TaskAlt),
            _ => (Color.Default, Icons.Material.Filled.Help)
        };
        __builder.OpenComponent<MudChip<string>>(0);
        __builder.AddAttribute(1, "Size", Size.Small);
        __builder.AddAttribute(2, "Color", color);
        __builder.AddAttribute(3, "Icon", icon);
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, status.ToString())));
        __builder.CloseComponent();
    };
}
