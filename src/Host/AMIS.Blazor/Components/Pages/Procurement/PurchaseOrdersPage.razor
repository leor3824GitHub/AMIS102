@page "/procurement/purchase-orders"
@implements IDisposable
@using AMIS.Modules.ProcurementAcquisition.Contracts.Permissions
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.Canvass
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseOrders
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.SignedDocuments
@using AMIS.Framework.Shared.Persistence
@using AMIS.Playground.Blazor.ApiClient
@using PurchaseOrderContracts = AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseOrders
@inject IPurchaseOrderClient Client
@inject IPurchaseRequestClient PurchaseRequestClient
@inject ICanvassRequestClient CanvassClient
@inject IMaster_dataClient MasterDataClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS

<AMISPageHeader Title="Purchase Orders" Description="Create and manage purchase orders (PO)" />

<MudGrid Spacing="3">
    <!-- List Panel - Full Width -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <!-- Header: title + primary action -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Purchase Orders</MudText>
                    @if (_canCreate)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog"
                                   Title="Create a new purchase order">
                            NEW PURCHASE ORDER
                        </MudButton>
                    }
                </MudStack>

                <!-- Filter toolbar: search + date range -->
                <AMISFilterBar Keyword="@_keyword" KeywordChanged="OnKeywordChanged"
                               SearchPlaceholder="Search for PO"
                               FromDate="_fromDate" FromDateChanged="OnFromDateChanged"
                               ToDate="_toDate" ToDateChanged="OnToDateChanged" />

                <!-- Status filter chips -->
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    @foreach (var s in _statusFilters)
                    {
                        var isActive = _statusFilter == s;
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(isActive ? Color.Primary : Color.Default)"
                                 Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => SetStatusFilter(s))"
                                 Title="@($"Filter by {s} status")"
                                 Clickable="true">
                            @GetStatusChipLabel(s)
                        </MudChip>
                    }
                </MudStack>

                @if (!_loaded)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        @if (!string.IsNullOrWhiteSpace(_keyword) || _statusFilter != "All")
                        {
                            <text>No purchase orders match your filters. Try adjusting your search or status filter.</text>
                        }
                        else if (_canCreate)
                        {
                            <text>No purchase orders yet. <MudLink Href="#" OnClick="OpenCreateDialog" Style="cursor:pointer;">Create your first PO</MudLink></text>
                        }
                        else
                        {
                            <text>No purchase orders yet.</text>
                        }
                    </MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>PO #</th>
                                <th>Date</th>
                                <th>Supplier</th>
                                <th>Mode</th>
                                <th style="text-align:right">Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><b>@item.PoNumber</b></td>
                                    <td>@item.PoDate.ToString("MM/dd/yyyy")</td>
                                    <td>@item.SupplierName</td>
                                    <td><MudText Typo="Typo.caption">@item.ModeOfProcurement.ToString().Replace("_"," ")</MudText></td>
                                    <td style="text-align:right">@Money.Symbol@item.TotalAmount.ToString("N2")</td>
                                    <td>@PoStatusChip(item.Status)</td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            @if (item.Status == PurchaseOrderStatus.Draft)
                                            {
                                                @if (_canUpdate)
                                                {
                                                    <MudTooltip Text="Edit draft">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                                       OnClick="@(async () => await OpenEditDialog(item.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canSubmit)
                                                {
                                                    <MudTooltip Text="Submit for Funds Available certification">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary"
                                                                       OnClick="@(async () => await SubmitAsync(item.Id))" />
                                                    </MudTooltip>
                                                }
                                            }
                                            @if (item.Status == PurchaseOrderStatus.PendingFundsAvailable && _canCertifyFundsAvailable)
                                            {
                                                <MudTooltip Text="Certify Funds Available">
                                                    <MudIconButton Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Info"
                                                                   OnClick="@(async () => await CertifyFundsAvailableAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if (item.Status == PurchaseOrderStatus.PendingApproval && _canIssue)
                                            {
                                                <MudTooltip Text="Issue this PO">
                                                    <MudIconButton Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" Color="Color.Success"
                                                                   OnClick="@(async () => await IssueAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if ((item.Status == PurchaseOrderStatus.Draft
                                                  || item.Status == PurchaseOrderStatus.PendingFundsAvailable
                                                  || item.Status == PurchaseOrderStatus.PendingApproval
                                                  || item.Status == PurchaseOrderStatus.Issued)
                                                 && _canCancel)
                                            {
                                                <MudTooltip Text="Cancel this PO">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(async () => await CancelPoAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            <MudTooltip Text="View full details">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default"
                                                               OnClick="@(async () => await ViewDetailsAsync(item.Id))" />
                                            </MudTooltip>
                                            @if (IsSignedPo(item.Status) && (item.HasSignedCopy ? _canViewSignedCopy : _canUploadSignedCopy))
                                            {
                                                <MudTooltip Text="@(item.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                                   Color="@(item.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                                   OnClick="@(() => OpenSignedCopyAsync(item.Id, item.PoNumber, item.Status))" />
                                                </MudTooltip>
                                            }
                                            <MudMenu Icon="@Icons.Material.Filled.Print"
                                                     Color="Color.Secondary"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     AnchorOrigin="Origin.BottomLeft"
                                                     TransformOrigin="Origin.TopLeft"
                                                     ToolTip="Print or export">
                                                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                             OnClick="@(() => DownloadFastReportPdfAsync(item.Id))">
                                                    Download PDF
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                             OnClick="@(() => OpenFastReportSetupAsync(item.Id))">
                                                    Page Setup…
                                                </MudMenuItem>
                                            </MudMenu>
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_totalCount > _pageSize)
                    {
                        <MudStack Row="true" JustifyContent="JustifyContent.Center" Class="mt-3">
                            <MudPagination Count="@((_totalCount + _pageSize - 1) / _pageSize)"
                                           Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                        </MudStack>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _canCreate => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Update);
    private bool _canSubmit => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Submit);
    private bool _canCertifyFundsAvailable => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.CertifyFundsAvailable);
    private bool _canIssue => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Issue);
    private bool _canCancel => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Cancel);
    private bool _canViewSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.View);
    private bool _canUploadSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.Upload);

    // Issued and every post-issue state — the PO is a signed record once issued, including while deliveries land.
    private static bool IsSignedPo(PurchaseOrderStatus status) =>
        status is PurchaseOrderStatus.Issued or PurchaseOrderStatus.PartiallyDelivered or PurchaseOrderStatus.Fulfilled;

    private async Task OpenSignedCopyAsync(Guid id, string poNumber, PurchaseOrderStatus status)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, ProcurementDocumentType.PurchaseOrder },
            { x => x.DocumentId, id },
            { x => x.DocumentNumber, poNumber },
            { x => x.IsTerminalState, IsSignedPo(status) }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var dialog = await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false });
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    private string? _currentUserEmployeeName => UserProfileState.EmployeeFullName;

    [SupplyParameterFromQuery(Name = "canvassId")]
    public Guid? CanvassId { get; set; }

    private List<PurchaseOrderSummaryDto> _items = [];
    private bool _loaded;
    private string _keyword = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _statusFilter = "All";
    private int _page = 1, _pageSize = 15, _totalCount;
    private Guid? _appliedCanvassId;
    private Dictionary<string, int> _statusCounts = [];

    private static readonly string[] _statusFilters = ["All", "Draft", "PendingFundsAvailable", "PendingApproval", "Issued", "PartiallyDelivered", "Fulfilled", "Cancelled"];

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadStatusCountsAsync();
        await LoadAsync();
    }

    // Permissions load asynchronously in PlaygroundLayout after first render; re-render when they arrive
    // so permission-gated controls appear on a hard refresh without requiring a user interaction.
    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (CanvassId.HasValue && CanvassId.Value != _appliedCanvassId)
        {
            _appliedCanvassId = CanvassId.Value;
            await OpenCreateDialogWithCanvass(CanvassId.Value);
        }
    }

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            PurchaseOrderStatus? filter = _statusFilter == "All" ? null : Enum.Parse<PurchaseOrderStatus>(_statusFilter);
            var result = await Client.SearchAsync(_keyword, filter, _page, _pageSize, fromDate: ToDateOnly(_fromDate), toDate: ToDateOnly(_toDate));
            _items = result.Items?.ToList() ?? [];
            _totalCount = (int)result.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loaded = true; }
    }

    private async Task SetStatusFilter(string s)
    {
        _statusFilter = s;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnKeywordChanged(string? keyword)
    {
        _keyword = keyword ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _fromDate = date;
        _page = 1;
        await LoadAsync();
        await RefreshStatusCountsAsync();
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _toDate = date;
        _page = 1;
        await LoadAsync();
        await RefreshStatusCountsAsync();
    }

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is null ? null : DateOnly.FromDateTime(value.Value);

    private async Task LoadStatusCountsAsync()
    {
        try
        {
            _statusCounts.Clear();

            // Load all status counts in parallel (7 statuses, excluding "All")
            var statusesToLoad = _statusFilters.Skip(1).ToArray(); // Skip "All"
            var tasks = new Task<(string status, int count)>[statusesToLoad.Length];

            for (int i = 0; i < statusesToLoad.Length; i++)
            {
                var status = statusesToLoad[i];
                var filter = Enum.Parse<PurchaseOrderStatus>(status);
                tasks[i] = LoadStatusCountAsync(status, filter);
            }

            var results = await Task.WhenAll(tasks);

            // Store counts and calculate "All" as sum
            int allCount = 0;
            foreach (var (status, count) in results)
            {
                _statusCounts[status] = count;
                allCount += count;
            }

            _statusCounts["All"] = allCount;
        }
        catch { _statusCounts = []; }
    }

    private async Task<(string status, int count)> LoadStatusCountAsync(string status, PurchaseOrderStatus filter)
    {
        var result = await Client.SearchAsync(string.Empty, filter, 1, 1, fromDate: ToDateOnly(_fromDate), toDate: ToDateOnly(_toDate));
        return (status, (int)result.TotalCount);
    }

    private string GetStatusChipLabel(string status)
    {
        if (_statusCounts.TryGetValue(status, out var count) && count > 0)
            return $"{status} ({count})";
        return status;
    }

    private async Task RefreshStatusCountsAsync()
    {
        await LoadStatusCountsAsync();
        StateHasChanged();
    }

    private void OpenCreateDialog()
    {
        var parameters = new DialogParameters<PurchaseOrderFormDialog>
        {
            { x => x.PurchaseOrder, null },
            { x => x.PrefilledCanvassId, null }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        OpenFormDialog(parameters, options);
    }

    private async Task OpenCreateDialogWithCanvass(Guid canvassId)
    {
        var parameters = new DialogParameters<PurchaseOrderFormDialog>
        {
            { x => x.PurchaseOrder, null },
            { x => x.PrefilledCanvassId, canvassId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        OpenFormDialog(parameters, options);
        _appliedCanvassId = canvassId;
    }

    private async Task OpenEditDialog(Guid id)
    {
        var po = await Client.GetAsync(id);
        if (po is null) { Snackbar.Add("PO not found.", Severity.Error); return; }

        var parameters = new DialogParameters<PurchaseOrderFormDialog>
        {
            { x => x.PurchaseOrder, po },
            { x => x.PrefilledCanvassId, null }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        OpenFormDialog(parameters, options);
    }

    private async void OpenFormDialog(DialogParameters<PurchaseOrderFormDialog> parameters, DialogOptions options)
    {
        var dialog = await DialogService.ShowAsync<PurchaseOrderFormDialog>("Purchase Order", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            await RefreshStatusCountsAsync();
        }
    }

    private async Task SubmitAsync(Guid id)
    {
        var po = _items.FirstOrDefault(x => x.Id == id);
        var message = $"Submit purchase order {po?.PoNumber} for Funds Available certification?";
        var ok = await DialogService.ShowMessageBox("Submit PO", message, "Submit", cancelText: "Cancel");
        if (ok is not true) return;
        try
        {
            await Client.SubmitAsync(id);
            Snackbar.Add("PO submitted for Funds Available certification.", Severity.Success);
            await LoadAsync();
            await RefreshStatusCountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submit failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CertifyFundsAvailableAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_currentUserEmployeeName))
        {
            Snackbar.Add("Cannot determine current user identity. Please re-login.", Severity.Warning);
            return;
        }

        PurchaseOrderDto? po;
        try { po = await Client.GetAsync(id); }
        catch (Exception ex) { Snackbar.Add($"Load PO failed: {ex.Message}", Severity.Error); return; }
        if (po is null) { Snackbar.Add("PO not found.", Severity.Warning); return; }

        var parameters = new DialogParameters<CertifyPurchaseOrderFundsAvailableDialog>
        {
            { x => x.PurchaseOrder, po },
            { x => x.CertifiedByName, _currentUserEmployeeName }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CertifyPurchaseOrderFundsAvailableDialog>($"Funds Available — {po.PoNumber}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            await RefreshStatusCountsAsync();
        }
    }

    private async Task IssueAsync(Guid id)
    {
        var po = _items.FirstOrDefault(x => x.Id == id);
        var message = $"Issue purchase order {po?.PoNumber}? This will notify the supplier to proceed with delivery.";
        var ok = await DialogService.ShowMessageBox("Issue Purchase Order", message, "Issue", cancelText: "Cancel");
        if (ok is not true) return;
        try
        {
            await Client.IssueAsync(id);
            Snackbar.Add("Purchase order issued successfully.", Severity.Success);
            await LoadAsync();
            await RefreshStatusCountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Issue failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelPoAsync(Guid id)
    {
        var po = _items.FirstOrDefault(x => x.Id == id);
        var message = $"Cancel purchase order {po?.PoNumber}? This action cannot be undone.";
        var ok = await DialogService.ShowMessageBox("Cancel PO", message, "Yes, Cancel", cancelText: "No");
        if (ok is not true) return;
        try
        {
            await Client.CancelAsync(id);
            Snackbar.Add("Purchase order cancelled.", Severity.Info);
            await LoadAsync();
            await RefreshStatusCountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewDetailsAsync(Guid id)
    {
        PurchaseOrderDto? po;
        try { po = await Client.GetAsync(id); }
        catch (Exception ex) { Snackbar.Add($"Unable to load PO details: {ex.Message}", Severity.Error); return; }
        if (po is null) { Snackbar.Add("PO not found.", Severity.Warning); return; }

        var parameters = new DialogParameters<PurchaseOrderDetailsDialog>
        {
            { x => x.PurchaseOrder, po }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PurchaseOrderDetailsDialog>($"PO Details - {po.PoNumber}", parameters, options);
    }

    private async Task DownloadFastReportPdfAsync(Guid id)
    {
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await Client.GetFastReportPdfAsync(id,
                pageWidth: saved?.PaperSize ?? "a4",
                orientation: saved?.Orientation ?? "portrait",
                minRows: saved?.MinRows ?? 8);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private const string FastReportKey = "purchase-order";

    private async Task OpenFastReportSetupAsync(Guid id)
    {
        // PO is always 1 copy per page; the dialog's Copies field is ignored on submit.
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "a4",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "portrait",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 1,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 8
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        try
        {
            var bytes = await Client.GetFastReportPdfAsync(id, pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }

    private static RenderFragment PoStatusChip(PurchaseOrderStatus status) => __builder =>
    {
        var (color, icon) = status switch
        {
            PurchaseOrderStatus.Draft => (Color.Default, Icons.Material.Filled.Edit),
            PurchaseOrderStatus.PendingFundsAvailable => (Color.Warning, Icons.Material.Filled.AccountBalance),
            PurchaseOrderStatus.PendingApproval => (Color.Warning, Icons.Material.Filled.HourglassBottom),
            PurchaseOrderStatus.Issued => (Color.Info, Icons.Material.Filled.Send),
            PurchaseOrderStatus.PartiallyDelivered => (Color.Warning, Icons.Material.Filled.LocalShipping),
            PurchaseOrderStatus.Fulfilled => (Color.Success, Icons.Material.Filled.CheckCircle),
            PurchaseOrderStatus.Cancelled => (Color.Error, Icons.Material.Filled.Cancel),
            _ => (Color.Default, Icons.Material.Filled.Help)
        };
        __builder.OpenComponent<MudChip<string>>(0);
        __builder.AddAttribute(1, "Size", Size.Small);
        __builder.AddAttribute(2, "Color", color);
        __builder.AddAttribute(3, "Icon", icon);
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, status.ToString())));
        __builder.CloseComponent();
    };
}

