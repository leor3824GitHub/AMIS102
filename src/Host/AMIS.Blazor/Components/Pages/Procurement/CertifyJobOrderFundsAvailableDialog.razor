@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.JobOrders
@using AMIS.Blazor.ApiClient
@inject IJobOrderClient Client
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Sign <b>Funds Available</b> and optionally capture the BUR/ORS reference and Fund Cluster.
                </MudAlert>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Value="@JobOrder.JoNumber" Label="JO Number" ReadOnly="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Value="@CertifiedByName" T="string" Label="Funds Available — Signatory (Accountant)" ReadOnly="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_oursBursNumber" Label="BUR/ORS Number (optional)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" MaxLength="100" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_oursBursDate" Label="BUR/ORS Date (optional)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_fundCluster" Label="Fund Cluster (optional)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" MaxLength="100" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mt-2"><b>Particulars</b></MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th>Description</th>
                            <th style="width:90px;text-align:right">Qty</th>
                            <th style="width:90px">Unit</th>
                            <th style="width:130px;text-align:right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in JobOrder.LineItems)
                        {
                            <tr>
                                <td>@line.ItemNo</td>
                                <td>@line.Description</td>
                                <td style="text-align:right">@line.Quantity.ToString("N2")</td>
                                <td>@(line.Unit ?? "—")</td>
                                <td style="text-align:right">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="CertifyAsync" Disabled="_busy">
            Certify &amp; Send for Issue
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public JobOrderDto JobOrder { get; set; } = default!;
    [Parameter] public string CertifiedByName { get; set; } = string.Empty;

    private string? _oursBursNumber;
    private DateTime? _oursBursDate;
    private string? _fundCluster;
    private bool _busy;

    protected override void OnInitialized()
    {
        _oursBursNumber = JobOrder.OursBursNumber;
        _oursBursDate = JobOrder.OursBursDate?.ToDateTime(TimeOnly.MinValue);
        _fundCluster = JobOrder.FundCluster;
    }

    private async Task CertifyAsync()
    {
        if (string.IsNullOrWhiteSpace(CertifiedByName))
        {
            Snackbar.Add("Could not resolve your employee name. Please re-login.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var oursBursDate = _oursBursDate is null ? (DateOnly?)null : DateOnly.FromDateTime(_oursBursDate.Value);

            var result = await Client.CertifyFundsAvailableAsync(
                JobOrder.Id,
                new CertifyJobOrderFundsAvailableCommand(
                    JobOrder.Id,
                    CertifiedByName,
                    _oursBursNumber,
                    oursBursDate,
                    _fundCluster));

            Snackbar.Add("Funds Available certified. JO ready for Issue.", Severity.Success);
            Dialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Certify failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
