@using AMIS.Framework.Shared.Constants
@using AMIS.Framework.Shared.Multitenancy
@using AMIS.Modules.Chat.Contracts.Permissions
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Blazor.Components.Layout.Nav
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserProfileState UserProfileState

<nav class="AMIS-nav">
    <MudNavMenu Class="pa-2" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
        <!-- Home - Root Item -->
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">
            Home
        </MudNavLink>

        <!-- Unified inspection worklist — everything awaiting the current user across modules -->
        <MudNavLink Href="/inspections" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FactCheck">
            My Inspections
        </MudNavLink>

        <!-- Administration Section
             Audit Logs, Health and Logs live here rather than as top-level entries: they are
             admin-only concerns, and three separate root rows cost more scan cost than they earn. -->
        <MudNavGroup Title="Administration" Icon="@Icons.Material.Outlined.AdminPanelSettings"
                     @bind-Expanded="_administrationExpanded">
            <div class="AMIS-nav-subsection-title">Access</div>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Person">
                Users
            </MudNavLink>
            <MudNavLink Href="/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Badge">
                Roles
            </MudNavLink>
            <MudNavLink Href="/groups" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Groups">
                Groups
            </MudNavLink>

            @if (_isRootTenantAdmin)
            {
                <div class="AMIS-nav-subsection-title">Tenancy</div>
                <MudNavLink Href="/tenants" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CorporateFare">
                    Tenants
                </MudNavLink>
                <MudNavLink Href="/tenants/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Tune">
                    Tenant Settings
                </MudNavLink>
            }

            <div class="AMIS-nav-subsection-title">Monitoring</div>
            <MudNavLink Href="/audits" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.History">
                Audit Logs
            </MudNavLink>
            <MudNavLink Href="/health" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.MonitorHeart">
                Health
            </MudNavLink>
            <MudNavLink Href="/logs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Terminal">
                Logs
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Procurement Planning" Icon="@Icons.Material.Outlined.Assignment"
                     @bind-Expanded="_procurementPlanningExpanded">
            <MudNavLink Href="/procurement-planning/ppmps" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.ListAlt">
                PPMP
            </MudNavLink>
            <MudNavLink Href="/procurement-planning/ppmp-approvals" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.HowToReg">
                PPMP Approvals
            </MudNavLink>
            <MudNavLink Href="/procurement-planning/apps" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Description">
                Annual Procurement Plan (APP)
            </MudNavLink>
            <MudNavLink Href="/procurement-planning/app-approvals" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.LibraryAddCheck">
                APP Approvals
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Procurement Acquisition" Icon="@Icons.Material.Outlined.ShoppingBag"
                     @bind-Expanded="_procurementExpanded">
            <MudNavLink Href="/procurement/purchase-requests" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Description">
                Purchase Requests
            </MudNavLink>
            <MudNavLink Href="/procurement/canvass-requests" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.RequestQuote">
                Canvass (RIV)
            </MudNavLink>
            <MudNavLink Href="/procurement/purchase-orders" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Receipt">
                Purchase Orders
            </MudNavLink>
            <MudNavLink Href="/procurement/job-orders" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Handyman">
                Job Orders
            </MudNavLink>
            <MudNavLink Href="/procurement/inspection-acceptance-reports" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.RuleFolder">
                Inspection &amp; Acceptance (IAR)
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="PPE & SE" Icon="@Icons.Material.Outlined.FolderSpecial"
                     @bind-Expanded="_assetRegisterExpanded">
            <MudNavLink Href="/asset-register/my-accountability" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.AssignmentInd">
                My Accountability
            </MudNavLink>
            @* Every lifecycle stage is a peer sub-group, so none of them reads as arbitrarily
               more important than the others. Document-numbering config lives in Setup, not
               inline with the transactions it numbers. *@
            <MudNavGroup Title="Receiving" Icon="@Icons.Material.Outlined.MoveToInbox"
                         @bind-Expanded="_arReceivingExpanded">
                <MudNavLink Href="/asset-register/receiving/ppe" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.MoveToInbox">
                    PPERR
                </MudNavLink>
                <MudNavLink Href="/asset-register/receiving/smrr" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.MoveToInbox">
                    SMRR
                </MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Issuance" Icon="@Icons.Material.Outlined.Receipt"
                         @bind-Expanded="_arIssuanceExpanded">
                <MudNavLink Href="/asset-register/issuance/ppeir" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Receipt">
                    PPEIR
                </MudNavLink>
                <MudNavLink Href="/asset-register/issuance/smir" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Receipt">
                    SMIR
                </MudNavLink>
                <MudNavLink Href="/asset-register/accountability" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.AssignmentInd">
                    ICS / PAR
                </MudNavLink>
            </MudNavGroup>
            @* A transfer is not an issuance — different document, different counterparty,
               its own permission. Grouped with returns as asset movement. *@
            <MudNavGroup Title="Movement" Icon="@Icons.Material.Outlined.SwapHoriz"
                         @bind-Expanded="_arMovementExpanded">
                @if (UserProfileState.Permissions.Contains(AssetRegisterPermissions.Transfers.View))
                {
                    <MudNavLink Href="/asset-register/transfers" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.CompareArrows">
                        Inter-Agency Transfers
                    </MudNavLink>
                }
                <MudNavLink Href="/asset-register/returned-property" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.AssignmentReturn">
                    Returned (RRSP / RRP)
                </MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Maintenance &amp; Disposal" Icon="@Icons.Material.Outlined.Handyman"
                         @bind-Expanded="_arMaintenanceExpanded">
                @if (UserProfileState.Permissions.Contains(AssetRegisterPermissions.Repair.View))
                {
                    <MudNavLink Href="/asset-register/repairs" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.Build">
                        Repairs (RPRI)
                    </MudNavLink>
                }
                <MudNavLink Href="/asset-register/incidents" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.ReportProblem">
                    Incident Reports
                </MudNavLink>
                <MudNavLink Href="/asset-register/unserviceable" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.DeleteSweep">
                    Unserviceable Reports
                </MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Registry" Icon="@Icons.Material.Outlined.Storage"
                         @bind-Expanded="_arRegistryExpanded">
                <MudNavLink Href="/asset-register/assets" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.Inventory2">
                    Asset Registry
                </MudNavLink>
                <MudNavLink Href="/asset-register/catalog" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.LibraryBooks">
                    Asset Catalog
                </MudNavLink>
                <MudNavLink Href="/asset-register/locations" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.Place">
                    Locations
                </MudNavLink>
                @* Physical Count sits with the records it verifies rather than with the
                   transaction stages. *@
                <MudNavLink Href="/asset-register/physical-count" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.FactCheck">
                    Physical Count
                </MudNavLink>
            </MudNavGroup>

            @* Every child here is permission-gated, so the group itself must be gated on the
               union — otherwise a user with none of them gets an empty chevron. *@
            @if (HasAny(AssetRegisterPermissions.Accountability.View,
                        AssetRegisterPermissions.Issuance.View,
                        AssetRegisterPermissions.Assets.View))
            {
            <MudNavGroup Title="Reports" Icon="@Icons.Material.Outlined.Assessment"
                         @bind-Expanded="_arReportsExpanded">
                @if (UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.View))
                {
                    <MudNavLink Href="/asset-register/reports/rspi" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.Assessment">
                        RSPI (SE Issued)
                    </MudNavLink>
                    <MudNavLink Href="/asset-register/reports/rpi" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.Assessment">
                        RPI (PPE Issued)
                    </MudNavLink>
                    <MudNavLink Href="/asset-register/reports/regspi" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.MenuBook">
                        RegSPI (SE Registry)
                    </MudNavLink>
                    <MudNavLink Href="/asset-register/reports/regppei" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.MenuBook">
                        RegPPEI (PPE Registry)
                    </MudNavLink>
                }
                @if (UserProfileState.Permissions.Contains(AssetRegisterPermissions.Issuance.View))
                {
                    <MudNavLink Href="/asset-register/reports/ptr" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.SwapHoriz">
                        PTR (Property Transfer)
                    </MudNavLink>
                }
                @if (UserProfileState.Permissions.Contains(AssetRegisterPermissions.Assets.View))
                {
                    <MudNavLink Href="/asset-register/reports/pc" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.CreditCard">
                        PC (Property Card)
                    </MudNavLink>
                    <MudNavLink Href="/asset-register/reports/spc" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Outlined.CreditCard">
                        SPC (SE Property Card)
                    </MudNavLink>
                }
            </MudNavGroup>
            }

            @* Configure-once numbering setup, kept out of the daily transaction stages.
               Property Code Generator keeps its /master-data/* route because the page is
               backed by MasterData APIs and permissions. *@
            <MudNavGroup Title="Setup" Icon="@Icons.Material.Outlined.Settings"
                         @bind-Expanded="_arSetupExpanded">
                <MudNavLink Href="/asset-register/pperr-series" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.FormatListNumbered">
                    PPERR Form Series
                </MudNavLink>
                <MudNavLink Href="/asset-register/ppeir-series" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.FormatListNumbered">
                    PPEIR Form Series
                </MudNavLink>
                <MudNavLink Href="/master-data/property-code-generator" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Outlined.QrCode2">
                    Property Code Generator
                </MudNavLink>
            </MudNavGroup>

        </MudNavGroup>

        <MudNavGroup Title="Expendable" Icon="@Icons.Material.Outlined.Inventory2" @bind-Expanded="_expendableExpanded">
            @* Split by audience: the first three are what a regular employee touches, the rest
               is supply-officer work. Labels rather than nested groups — at 10 links this is
               Master Data's size, so everything stays one click away. *@
            <div class="AMIS-nav-subsection-title">Self-Service</div>
            <MudNavLink Href="/expendable/my-requests" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Inbox">
                My Requests
            </MudNavLink>
            <MudNavLink Href="/expendable/shopping" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.ShoppingBag">
                Shop
            </MudNavLink>
            <MudNavLink Href="/expendable/cart" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.ShoppingCart">
                Basket
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Supply Management</div>
            <MudNavLink Href="/expendable/requests" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Description">
                Supply Requests
            </MudNavLink>
            <MudNavLink Href="/expendable/warehouse" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Warehouse">
                Warehouse
            </MudNavLink>
            <MudNavLink Href="/expendable/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Label">
                Products
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Reports</div>
            @* Named as a pair: both are the same issuance report cut a different way, which
               the old "Issuance Report" / "Employee Issuance" labels hid. *@
            <MudNavLink Href="/expendable/reports/department" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Assessment">
                Issuance by Department
            </MudNavLink>
            <MudNavLink Href="/expendable/reports/employee" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.PersonSearch">
                Issuance by Employee
            </MudNavLink>
            <MudNavLink Href="/expendable/reports/stock-card" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Inventory">
                Stock Card
            </MudNavLink>
            <MudNavLink Href="/expendable/reports/physical-count" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.FactCheck">
                Physical Count
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Budget & Disbursement" Icon="@Icons.Material.Outlined.AccountBalanceWallet"
                     @bind-Expanded="_financeExpanded">
            <MudNavLink Href="/budget-disbursement/budget-utilization-requests" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.AccountBalance">
                Budget Utilization Request and Status
            </MudNavLink>
            <MudNavLink Href="/budget-disbursement/disbursement-vouchers" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Receipt">
                Disbursement Vouchers
            </MudNavLink>
            @if (UserProfileState.Permissions.Contains("Permissions.BudgetDisbursement.Settings.View"))
            {
                <MudNavLink Href="/budget-disbursement/settings" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Outlined.Settings">
                    Budget Disbursement Settings
                </MudNavLink>
            }
        </MudNavGroup>

        @* Vehicle is the data-driven prototype — its entries are declared in VehicleNav and
           rendered generically. Empty groups are impossible here, and expansion tracks the
           route on every navigation rather than once at circuit start. *@
        <NavEntries Entries="@_vehicleNav" Permissions="@UserProfileState.Permissions"
                    Path="@_path" State="@_navExpansion" />

        <!-- Master Data Section
             Grouped with inline section labels rather than nested MudNavGroups: reference data is
             visited rarely, so a third collapse level would hide the very label the user is hunting
             for. Labels chunk the list while keeping every page one click away. -->
        <MudNavGroup Title="Master Data" Icon="@Icons.Material.Outlined.Dataset" HideExpandIcon="false"
                     @bind-Expanded="_masterDataExpanded">
            <div class="AMIS-nav-subsection-title">Agency</div>
            <MudNavLink Href="/master-data/organization-profile" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.AccountBalance">
                Organization Profile
            </MudNavLink>
            <MudNavLink Href="/master-data/report-signatories" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Draw">
                Report Signatories
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Organization Structure</div>
            <MudNavLink Href="/master-data/departments" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Business">
                Departments
            </MudNavLink>
            <MudNavLink Href="/master-data/offices" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.LocationCity">
                Offices
            </MudNavLink>
            <MudNavLink Href="/master-data/positions" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.WorkOutline">
                Positions
            </MudNavLink>
            <MudNavLink Href="/master-data/employees" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Person3">
                Employees
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Procurement</div>
            <MudNavLink Href="/master-data/suppliers" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.LocalShipping">
                Suppliers
            </MudNavLink>
            <MudNavLink Href="/master-data/modes-of-procurement" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Rule">
                Modes of Procurement
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Budget &amp; Funds</div>
            <MudNavLink Href="/master-data/fund-clusters" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.AccountBalanceWallet">
                Fund Clusters
            </MudNavLink>
            <MudNavLink Href="/master-data/funding-source-codes" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Numbers">
                Funding Source Codes
            </MudNavLink>

            <div class="AMIS-nav-subsection-title">Property &amp; Classification</div>
            <MudNavLink Href="/master-data/categories" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Category">
                Categories
            </MudNavLink>
            <MudNavLink Href="/master-data/unit-of-measures" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Straighten">
                Units of Measure
            </MudNavLink>
            <MudNavLink Href="/master-data/capitalization-thresholds" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.Policy">
                Capitalization Thresholds
            </MudNavLink>
            <MudNavLink Href="/master-data/property-classes" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.AccountTree">
                Property Class Library
            </MudNavLink>
        </MudNavGroup>

        <!-- Communication Section — heading sits inside the permission check, otherwise a user
             without Chat access gets a bare "COMMUNICATION" label with nothing under it. -->
        @if (UserProfileState.Permissions.Contains(ChatPermissions.Channels.View))
        {
            <div class="AMIS-nav-section-title">Communication</div>

            <MudNavLink Href="/chat" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Chat">
                Chat
            </MudNavLink>
        }

        @* Notifications surface as a top-bar bell (cross-cutting workflow alerts), not a nav item. See Phase 3. *@

        @* System (Health, Logs) folded into Administration — see that group. *@

        <!-- Settings Section -->
        <div class="AMIS-nav-section-title">Settings</div>

        <MudNavLink Href="/settings/profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ManageAccounts">
            Account
        </MudNavLink>
        <MudNavLink Href="/settings/theme" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Palette">
            Theme
        </MudNavLink>
        <MudNavLink Href="/settings/security" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Security">
            Security
        </MudNavLink>
        <MudNavLink Href="/sessions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Devices">
            Sessions
        </MudNavLink>

        <MudNavLink Href="/about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Info">
            About
        </MudNavLink>
    </MudNavMenu>
</nav>

@code {
    private bool _isRootTenantAdmin;
    private bool _administrationExpanded;
    private bool _expendableExpanded;
    private bool _masterDataExpanded;
    private bool _procurementPlanningExpanded;
    private bool _procurementExpanded;
    private bool _financeExpanded;
    private bool _assetRegisterExpanded;

    // PPE & SE sub-groups. Without these the active page can sit behind a collapsed
    // chevron with no visible highlight after a full page load.
    private bool _arReceivingExpanded;
    private bool _arIssuanceExpanded;
    private bool _arMovementExpanded;
    private bool _arMaintenanceExpanded;
    private bool _arRegistryExpanded;
    private bool _arReportsExpanded;
    private bool _arSetupExpanded;

    // --- Data-driven nav (Vehicle prototype) ---------------------------------------------
    // One declaration drives visibility, nesting and expansion. No per-group bool, no
    // hand-maintained route prefix list, no risk of an empty container.
    private static readonly INavEntry[] _vehicleNav = [VehicleNav.Section];
    private readonly NavExpansionState _navExpansion = new();
    private string _path = "/";

    // A sub-group whose children are ALL permission-gated renders as an empty chevron for
    // users holding none of them. Gate the group itself on the union of its children.
    private bool HasAny(params string[] permissions) =>
        permissions.Any(UserProfileState.Permissions.Contains);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _path = CurrentPath();

        // Match on the app-relative path, not the raw URI. A bare Contains("/logs") also matches
        // /vehicle/maintenance/logs and would wrongly expand Administration; anchoring to a path
        // segment also keeps /procurement-planning from triggering the /procurement group.
        var path = _path;

        bool IsUnder(params string[] prefixes) => prefixes.Any(p =>
            path.Equals(p, StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));

        _administrationExpanded = IsUnder("/users", "/roles", "/groups", "/tenants",
                                          "/audits", "/health", "/logs");
        _expendableExpanded = IsUnder("/expendable");
        _procurementPlanningExpanded = IsUnder("/procurement-planning");
        _procurementExpanded = IsUnder("/procurement");
        _financeExpanded = IsUnder("/budget-disbursement");

        // Property Code Generator keeps its /master-data/* route but is presented under PPE & SE,
        // so it must expand that group instead of Master Data.
        var isPropertyCodeGenerator = IsUnder("/master-data/property-code-generator");
        _masterDataExpanded = IsUnder("/master-data") && !isPropertyCodeGenerator;
        _assetRegisterExpanded = IsUnder("/asset-register") || isPropertyCodeGenerator;

        _arReceivingExpanded = IsUnder("/asset-register/receiving");
        _arIssuanceExpanded = IsUnder("/asset-register/issuance", "/asset-register/accountability");
        _arMovementExpanded = IsUnder("/asset-register/transfers", "/asset-register/returned-property");
        _arMaintenanceExpanded = IsUnder("/asset-register/repairs", "/asset-register/incidents",
                                         "/asset-register/unserviceable");
        _arRegistryExpanded = IsUnder("/asset-register/assets", "/asset-register/catalog",
                                      "/asset-register/locations", "/asset-register/physical-count");
        _arReportsExpanded = IsUnder("/asset-register/reports");
        _arSetupExpanded = IsUnder("/asset-register/pperr-series", "/asset-register/ppeir-series")
                        || isPropertyCodeGenerator;
        await CheckRootTenantAdmin();
    }

    private static readonly char[] PathDelimiters = ['?', '#'];

    /// <summary>Current app-relative path with a leading slash, query and fragment stripped.</summary>
    private string CurrentPath() =>
        "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split(PathDelimiters)[0].TrimStart('/');

    // Only the data-driven section reacts to this; the hand-written groups above still compute
    // their expansion once at circuit start and go stale after client-side navigation.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _path = CurrentPath();
        InvokeAsync(StateHasChanged);
    }

    private async Task CheckRootTenantAdmin()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                _isRootTenantAdmin = false;
                return;
            }

            var tenant = user.FindFirst(CustomClaims.Tenant)?.Value;
            var isRootTenant = string.Equals(tenant, MultitenancyConstants.Root.Id, StringComparison.OrdinalIgnoreCase);

            var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            var isAdmin = roles.Any(r => string.Equals(r, RoleConstants.Admin, StringComparison.OrdinalIgnoreCase));

            _isRootTenantAdmin = isRootTenant && isAdmin;
        }
        catch
        {
            _isRootTenantAdmin = false;
        }
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserProfileState.OnProfileChanged -= OnProfileChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

