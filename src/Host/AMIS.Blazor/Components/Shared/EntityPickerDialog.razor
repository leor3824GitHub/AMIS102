@*
    Reusable "pick items from a searchable, paged list" dialog.

    Owns all the chrome — search box, checkbox column, selection state, ExcludeIds handling,
    pagination and Cancel/Confirm actions. Consumers supply only the variable parts: the data
    source, the columns (HeaderTemplate + RowTemplate), the caption and the confirm-button text.

    Two data-source modes (supply exactly one):
      • DataProvider  — server-side paging/search. Called on every search + page change.
      • ItemsLoader   — async load-all-once; the dialog filters (SearchTextSelector) + pages in memory.
      • Items         — sync load-all; same in-memory filter + page as ItemsLoader.

    Returns via DialogResult.Ok: List<T> (Multiple) or a single T / null (Single).
*@
@typeparam T

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="@($"min-width:{MinWidth};")">
            @if (Caption is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Caption</MudText>
            }

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_keyword" Label="@SearchLabel" Variant="Variant.Outlined"
                              Dense="true" Margin="Margin.Dense" Class="flex-grow-1"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                              OnKeyDown="OnSearchKeyDown" Immediate="true" />
                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Outlined.Search" OnClick="SearchAsync" Disabled="_busy">
                    Search
                </AMISButton>
            </MudStack>

            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            else
            {
                <MudTable Items="_items" Dense="true" Hover="true" Striped="true" T="T">
                    <HeaderContent>
                        <MudTh Style="width:48px"></MudTh>
                        @HeaderTemplate
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var id = KeySelector(context);
                            var excluded = ExcludeIds.Contains(id);
                            var selected = _selected.ContainsKey(id) || excluded;
                            // A row is locked when a cross-row rule (RowSelectable) rejects it given the
                            // current selection. Already-selected rows stay toggleable so they can be cleared.
                            var locked = !excluded && !selected
                                         && RowSelectable is not null && !RowSelectable(context, _selected.Values);
                        }
                        <MudTd>
                            <MudCheckBox T="bool" Dense="true" Disabled="excluded || locked"
                                         Value="selected"
                                         ValueChanged="@((bool v) => Toggle(context, v))" />
                        </MudTd>
                        @RowTemplate(new EntityPickerRow<T>(context, excluded, selected, locked))
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">@EmptyText</MudText>
                    </NoRecordsContent>
                </MudTable>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption">Page @_page of @_totalPages (@_totalCount total)</MudText>
                    <MudStack Row="true" Spacing="1">
                        <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                        Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                        <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                        Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</AMISButton>
        <AMISButton Variant="Variant.Filled" Color="@ConfirmColor" OnClick="Confirm" Disabled="_selected.Count == 0">
            @ConfirmButtonLabel()
        </AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Extracts the stable identity used for selection + exclusion. Required.</summary>
    [Parameter, EditorRequired] public Func<T, Guid> KeySelector { get; set; } = default!;

    /// <summary>Server-side paged/searched source. Mutually exclusive with <see cref="ItemsLoader"/> / <see cref="Items"/>.</summary>
    [Parameter] public Func<EntityPickerRequest, Task<EntityPickerResult<T>>>? DataProvider { get; set; }

    /// <summary>Async load-all source, called once; the dialog filters + pages the result in memory.</summary>
    [Parameter] public Func<Task<IReadOnlyList<T>>>? ItemsLoader { get; set; }

    /// <summary>Sync load-all source; the dialog filters + pages it in memory.</summary>
    [Parameter] public IReadOnlyList<T>? Items { get; set; }

    /// <summary>Projects an item to the text matched against the keyword for in-memory (Items/ItemsLoader) modes.</summary>
    [Parameter] public Func<T, string>? SearchTextSelector { get; set; }

    /// <summary>Ids already picked elsewhere — rendered checked + disabled, never selectable.</summary>
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    /// <summary>
    /// Optional cross-row rule. Given a candidate row's item and the current selection, returns whether
    /// that row may still be selected. Rows that fail render with a disabled checkbox and
    /// <c>IsLocked=true</c> on their <see cref="EntityPickerRow{T}"/> so the RowTemplate can grey them.
    /// Already-selected rows stay toggleable (so the user can clear back to zero and reset the rule).
    /// Used e.g. to keep one ICS to a single semi-expendable category (COA §4.14).
    /// </summary>
    [Parameter] public Func<T, IReadOnlyCollection<T>, bool>? RowSelectable { get; set; }

    /// <summary>Optional caption shown above the search box.</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    /// <summary>The data-column headers (&lt;MudTh&gt;…). The checkbox column is added automatically. Required.</summary>
    [Parameter, EditorRequired] public RenderFragment HeaderTemplate { get; set; } = default!;

    /// <summary>The data-column cells (&lt;MudTd&gt;…) for a row. The checkbox cell is added automatically. Required.</summary>
    [Parameter, EditorRequired] public RenderFragment<EntityPickerRow<T>> RowTemplate { get; set; } = default!;

    [Parameter] public string SearchLabel { get; set; } = "Keyword / Property No.";
    [Parameter] public string EmptyText { get; set; } = "No records found.";
    [Parameter] public string MinWidth { get; set; } = "560px";
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EntityPickerSelection SelectionMode { get; set; } = EntityPickerSelection.Multiple;

    /// <summary>Base confirm text. In Multiple mode the running count is appended (e.g. "Add 3 item(s)").</summary>
    [Parameter] public string ConfirmText { get; set; } = "Add";

    /// <summary>Full override of the confirm-button label given the current selection count.</summary>
    [Parameter] public Func<int, string>? ConfirmLabel { get; set; }

    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;

    private bool _busy;
    private string? _error;
    private string? _keyword;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private bool _sourceLoaded;
    private List<T> _allItems = [];
    private IReadOnlyList<T> _items = [];
    private readonly Dictionary<Guid, T> _selected = [];

    protected override void OnParametersSet()
    {
        if (DataProvider is null && ItemsLoader is null && Items is null)
            throw new InvalidOperationException(
                $"{nameof(EntityPickerDialog<T>)} requires one of {nameof(DataProvider)}, {nameof(ItemsLoader)} or {nameof(Items)}.");
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (DataProvider is not null)
            {
                var result = await DataProvider(new EntityPickerRequest(NormalizedKeyword(), _page, PageSize));
                _items = result.Items;
                _totalCount = result.TotalCount;
            }
            else
            {
                if (!_sourceLoaded)
                {
                    _allItems = ItemsLoader is not null
                        ? (await ItemsLoader()).ToList()
                        : (Items ?? []).ToList();
                    _sourceLoaded = true;
                }

                var filtered = FilterInMemory(_allItems);
                _totalCount = filtered.Count;
                _items = filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
            }

            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string? NormalizedKeyword() => string.IsNullOrWhiteSpace(_keyword) ? null : _keyword;

    private List<T> FilterInMemory(IReadOnlyList<T> source)
    {
        var keyword = NormalizedKeyword();
        if (keyword is null || SearchTextSelector is null)
            return source.ToList();

        return source
            .Where(x => SearchTextSelector(x).Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private void Toggle(T item, bool selected)
    {
        var id = KeySelector(item);
        if (ExcludeIds.Contains(id)) return;

        if (selected)
        {
            if (SelectionMode == EntityPickerSelection.Single) _selected.Clear();
            _selected[id] = item;
        }
        else
        {
            _selected.Remove(id);
        }

        // A selection change can flip other rows' locked state (RowSelectable), so re-render the table.
        StateHasChanged();
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private string ConfirmButtonLabel()
    {
        var count = _selected.Count;
        if (ConfirmLabel is not null) return ConfirmLabel(count);

        return SelectionMode == EntityPickerSelection.Multiple
            ? $"{ConfirmText} {(count > 0 ? $"{count} item(s)" : "items")}"
            : ConfirmText;
    }

    private void Confirm()
    {
        if (SelectionMode == EntityPickerSelection.Single)
            MudDialog.Close(DialogResult.Ok(_selected.Values.FirstOrDefault()));
        else
            MudDialog.Close(DialogResult.Ok(_selected.Values.ToList()));
    }

    private void Cancel() => MudDialog.Cancel();
}
