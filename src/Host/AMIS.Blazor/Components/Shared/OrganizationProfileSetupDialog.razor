@using AMIS.Modules.MasterData.Contracts.v1.OrganizationProfile
@using AMIS.Blazor.ApiClient
@inject IOrganizationProfileClient OrgProfileClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Set Up Your Organization Profile</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    This information is printed on official government reports.
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">
            @if (!_isOfficeLinked)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    This agency isn't linked to an office yet. Property codes and record ownership need it —
                    ask your system administrator to link it on the Tenants page.
                </MudAlert>
            }

            <MudTextField @bind-Value="_form.Name"
                          Label="Agency / Organization Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          MaxLength="200"
                          Placeholder="e.g. National Food Authority"
                          HelperText="Printed as the agency name on official reports" />

            <MudTextField @bind-Value="_form.ShortName"
                          Label="Short Name / Acronym"
                          Variant="Variant.Outlined"
                          MaxLength="80"
                          Placeholder="e.g. NFA" />

            <MudTextField @bind-Value="_form.Address"
                          Label="Address"
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="400"
                          Placeholder="e.g. NFA Complex, Visayas Avenue, Diliman, Quezon City" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Skip">Skip for now</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="_busy || string.IsNullOrWhiteSpace(_form.Name)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Class="mr-2" />
            }
            Save & Continue
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private FormModel _form = new();
    private bool _busy;
    private bool _isOfficeLinked = true;

    // A profile normally arrives already seeded from the tenant's linked office at provisioning, so this
    // dialog is the fallback for tenants that predate the link — prefill whatever is there and let the
    // administrator name the agency.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await OrgProfileClient.GetAsync();
            if (existing is null) return;

            _isOfficeLinked = existing.OfficeId.HasValue;
            _form.Name = existing.Name;
            _form.ShortName = existing.ShortName ?? string.Empty;
            _form.Address = existing.Address ?? string.Empty;
        }
        catch
        {
            // No profile yet — start with an empty form.
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) return;

        _busy = true;
        try
        {
            var command = new UpsertOrganizationProfileCommand(
                _form.Name.Trim(),
                NullIfEmpty(_form.ShortName),
                NullIfEmpty(_form.Address),
                null);

            await OrgProfileClient.UpsertAsync(command);
            Snackbar.Add("Organization profile saved.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Skip() => MudDialog.Cancel();

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string ShortName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}

