@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Page Setup</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 360px;">
            <MudSelect T="string"
                       Label="Paper size"
                       @bind-Value="PaperSize"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined">
                @foreach (var p in _paperOptions)
                {
                    <MudSelectItem Value="@p.Value">@p.Label</MudSelectItem>
                }
            </MudSelect>

            <MudField Label="Orientation" Variant="Variant.Outlined" DisableUnderLine="true" InnerPadding="false">
                <MudRadioGroup T="string" @bind-Value="Orientation">
                    <MudRadio Value="@("landscape")" Color="Color.Primary" Size="Size.Small">Landscape</MudRadio>
                    <MudRadio Value="@("portrait")" Color="Color.Primary" Size="Size.Small">Portrait</MudRadio>
                </MudRadioGroup>
            </MudField>

            <MudSelect T="double"
                       Label="Margin"
                       @bind-Value="MarginMm"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       HelperText="Uniform page margin applied to all four sides.">
                @foreach (var m in _marginOptions)
                {
                    <MudSelectItem Value="@m.Value">@m.Label</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">
            Download PDF
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string PaperSize { get; set; } = "a4";
    [Parameter] public string Orientation { get; set; } = "landscape";

    // Uniform page margin in millimetres. Must match one of the _marginOptions values.
    [Parameter] public double MarginMm { get; set; } = 15d;

    private readonly (string Value, string Label)[] _paperOptions =
    {
        ("a4",       "A4 — 210 × 297 mm (8.27 × 11.69 in)"),
        ("letter",   "Letter — 216 × 279 mm (8.5 × 11 in)"),
        ("longbond", "Long Bond — 216 × 330 mm (8.5 × 13 in)"),
        ("legal",    "Legal — 216 × 356 mm (8.5 × 14 in)")
    };

    private readonly (double Value, string Label)[] _marginOptions =
    {
        (5d,  "0.5 cm"),
        (7d,  "0.7 cm"),
        (10d, "1.0 cm"),
        (15d, "1.5 cm"),
        (20d, "2.0 cm"),
        (25d, "2.5 cm")
    };

    public sealed record Result(string PaperSize, string Orientation, double MarginMm);

    private void Submit() =>
        MudDialog.Close(DialogResult.Ok(new Result(PaperSize, Orientation, MarginMm)));

    private void Cancel() => MudDialog.Cancel();
}
