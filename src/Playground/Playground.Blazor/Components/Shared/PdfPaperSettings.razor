@* Reusable paper-size + orientation picker for QuestPDF report downloads.
   Two-way bindable via @bind-PaperSize / @bind-Orientation.
   Values match the API contract (QuestPdfPaperSize): a4|letter|longbond|legal, landscape|portrait. *@
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudSelect T="string" Value="PaperSize" ValueChanged="OnPaperSizeChanged"
               Label="Paper" Dense="true" Margin="Margin.Dense"
               Variant="Variant.Outlined" Style="min-width:110px">
        <MudSelectItem Value="@("a4")">A4</MudSelectItem>
        <MudSelectItem Value="@("letter")">Letter</MudSelectItem>
        <MudSelectItem Value="@("longbond")">Long Bond</MudSelectItem>
        <MudSelectItem Value="@("legal")">Legal</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Value="Orientation" ValueChanged="OnOrientationChanged"
               Label="Orientation" Dense="true" Margin="Margin.Dense"
               Variant="Variant.Outlined" Style="min-width:130px">
        <MudSelectItem Value="@("landscape")">Landscape</MudSelectItem>
        <MudSelectItem Value="@("portrait")">Portrait</MudSelectItem>
    </MudSelect>
    <MudSelect T="double" Value="MarginMm" ValueChanged="OnMarginChanged"
               Label="Margin" Dense="true" Margin="Margin.Dense"
               Variant="Variant.Outlined" Style="min-width:110px">
        <MudSelectItem Value="5d">0.5 cm</MudSelectItem>
        <MudSelectItem Value="7d">0.7 cm</MudSelectItem>
        <MudSelectItem Value="10d">1.0 cm</MudSelectItem>
        <MudSelectItem Value="15d">1.5 cm</MudSelectItem>
        <MudSelectItem Value="20d">2.0 cm</MudSelectItem>
        <MudSelectItem Value="25d">2.5 cm</MudSelectItem>
    </MudSelect>
</MudStack>

@code {
    [Parameter] public string PaperSize { get; set; } = "a4";
    [Parameter] public EventCallback<string> PaperSizeChanged { get; set; }

    [Parameter] public string Orientation { get; set; } = "landscape";
    [Parameter] public EventCallback<string> OrientationChanged { get; set; }

    // Page margin in millimetres. Must match one of the MudSelectItem values above.
    [Parameter] public double MarginMm { get; set; } = 15d;
    [Parameter] public EventCallback<double> MarginMmChanged { get; set; }

    private Task OnPaperSizeChanged(string value) =>
        PaperSizeChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? "a4" : value);

    private Task OnOrientationChanged(string value) =>
        OrientationChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? "landscape" : value);

    private Task OnMarginChanged(double value) =>
        MarginMmChanged.InvokeAsync(value > 0 ? value : 15d);
}
