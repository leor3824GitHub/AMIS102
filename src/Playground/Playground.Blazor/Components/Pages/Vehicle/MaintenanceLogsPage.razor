@page "/vehicle/maintenance/logs"
@implements IDisposable
@using AMIS.Modules.Vehicle.Contracts.v1.Maintenance
@using AMIS.Modules.Vehicle.Contracts.v1.Vehicles
@using AMIS.Modules.Vehicle.Contracts.Permissions
@inject IVehicleClient VehicleClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Maintenance Logs" Description="Record completed maintenance activities" />

<div class="mt-4">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard Class="AMIS-card">
                <MudCardContent>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudAutocomplete T="VehicleDto" @bind-Value="_query.SelectedVehicle" Label="Vehicle"
                                         Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                         SearchFunc="@SearchVehicles" ToStringFunc="@(v => v == null ? null : $"{v.PlateNumber} - {v.Make} {v.Model} ({v.Year})")"
                                         Clearable="true" />
                        <MudTextField @bind-Value="_query.ScheduleIdText" Label="Schedule Id"
                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_query.MaintenanceType" Label="Type"
                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                        <MudDatePicker @bind-Date="_query.FromDate" Label="From"
                                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                        <MudDatePicker @bind-Date="_query.ToDate" Label="To"
                                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Load" StartIcon="@Icons.Material.Filled.Search">Search</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearFilters">Clear</MudButton>
                        @if (_canCreate)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">New</MudButton>
                        }
                    </MudStack>

                    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Vehicle</MudTh>
                            <MudTh>Odometer</MudTh>
                            <MudTh>Performed By</MudTh>
                            <MudTh>Cost</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.PerformedDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@context.MaintenanceType</MudTd>
                            <MudTd>@context.VehicleId</MudTd>
                            <MudTd>@(context.OdometerAtService?.ToString() ?? "-")</MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(context.PerformedBy) ? "-" : context.PerformedBy)</MudTd>
                            <MudTd>@(context.Cost?.ToString("N2") ?? "-")</MudTd>
                            <MudTd>
                                @if (_canDelete)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => Delete(context.Id))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private readonly List<MaintenanceLogDto> _items = [];
    private List<VehicleDto> _vehicles = [];
    private LogQueryModel _query = new();

    private bool _canCreate => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Create);
    private bool _canDelete => UserProfileState.Permissions.Contains(VehiclePermissions.Maintenance.Delete);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadVehicles();
        await Load();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadVehicles()
    {
        try
        {
            var result = await VehicleClient.SearchVehiclesAsync(new SearchVehiclesQuery
            {
                PageNumber = 1,
                PageSize = 1000
            });

            _vehicles.Clear();
            _vehicles.AddRange(result.Items ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load vehicles: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<VehicleDto>> SearchVehicles(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _vehicles;

        var searchValue = value.ToLowerInvariant();
        return _vehicles.Where(v =>
            v.PlateNumber.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
            v.Make.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
            v.Model.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
            v.Year.ToString().Contains(searchValue)).ToList();
    }

    private async Task Load()
    {
        try
        {
            var items = await VehicleClient.SearchMaintenanceLogsAsync(new MaintenanceLogSearchRequest(
                _query.MaintenanceType,
                _query.SelectedVehicle?.Id,
                ParseGuid(_query.ScheduleIdText),
                ToDateOnly(_query.FromDate),
                ToDateOnly(_query.ToDate)));

            _items.Clear();
            _items.AddRange(items);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load maintenance logs: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<MaintenanceLogFormDialog>("Log Maintenance", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await Load();
        }
    }

    private async Task Delete(Guid id)
    {
        if (!await DialogService.ShowDeleteConfirmAsync("this maintenance log"))
            return;

        try
        {
            await VehicleClient.DeleteMaintenanceLogAsync(id);
            Snackbar.Add("Log deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Guid? ParseGuid(string? text) => Guid.TryParse(text, out var value) ? value : null;
    private static DateOnly? ToDateOnly(DateTime? date) => date.HasValue ? DateOnly.FromDateTime(date.Value) : null;

    private void ClearFilters()
    {
        _query = new();
    }

    private sealed class LogQueryModel
    {
        public VehicleDto? SelectedVehicle { get; set; }
        public string? ScheduleIdText { get; set; }
        public string? MaintenanceType { get; set; }
        public DateTime? FromDate { get; set; }
        public DateTime? ToDate { get; set; }
    }
}

