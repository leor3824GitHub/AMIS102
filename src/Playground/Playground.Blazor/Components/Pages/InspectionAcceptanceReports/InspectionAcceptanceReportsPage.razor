@page "/procurement/inspection-acceptance-reports"
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Playground.Blazor.Components.Pages.Procurement
@using AMIS.Modules.ProcurementAcquisition.Contracts.Permissions
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.InspectionAcceptanceReports
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.SignedDocuments
@inject IInspectionAcceptanceReportClient IarClient
@inject IUserProfileState UserProfileState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AMISPageHeader Title="Inspection &amp; Acceptance Reports"
                Description="Track IARs from Draft to Inspection and Acceptance." />

<MudCard Elevation="1" Class="mb-3">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_keyword" Label="Search IAR No / Supplier" Variant="Variant.Outlined"
                          Dense="true" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                          DebounceInterval="350" OnDebounceIntervalElapsed="@(() => LoadAsync())"
                          Style="max-width:320px" />
            <MudDatePicker Label="From" Date="_fromDate" DateChanged="OnFromDateChanged"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true"
                           Style="max-width:150px" />
            <MudDatePicker Label="To" Date="_toDate" DateChanged="OnToDateChanged"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true"
                           Style="max-width:150px" />
            <MudSpacer />
            @if (_canCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    New IAR
                </MudButton>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

<MudTabs Elevation="0" Rounded="true" PanelClass="pa-0" Class="mb-3" ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged">
    <MudTabPanel Text="All" />
    <MudTabPanel Text="Draft" />
    <MudTabPanel Text="Pending Inspection" />
    <MudTabPanel Text="Inspected" />
    <MudTabPanel Text="Accepted" />
    <MudTabPanel Text="Cancelled" />
</MudTabs>

<MudCard Elevation="1">
    <MudCardContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No IARs found.</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>IAR No.</th>
                        <th>Date</th>
                        <th>PO</th>
                        <th>Supplier</th>
                        <th>Lines</th>
                        <th class="text-right">Total</th>
                        <th class="text-center">Inspected</th>
                        <th class="text-center">Accepted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var iar in _items)
                    {
                        <tr>
                            <td><b>@iar.IarNumber</b></td>
                            <td>@iar.IarDate.ToString("MM/dd/yyyy")</td>
                            <td>@iar.PoNumber</td>
                            <td>@iar.SupplierName</td>
                            <td>@iar.LineItemCount</td>
                            <td class="text-right">@iar.TotalAmount.ToString("N2")</td>
                            @if (iar.Status == InspectionAcceptanceReportStatus.Cancelled)
                            {
                                <td colspan="2" class="text-center">
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(iar.Status)">
                                        Cancelled
                                    </MudChip>
                                </td>
                            }
                            else
                            {
                                var inspected = Milestone(InspectedState(iar.Status),
                                    "Inspected", "Awaiting inspection", "Not yet inspected");
                                var accepted = Milestone(AcceptedState(iar.Status),
                                    "Accepted", "Awaiting acceptance", "Not yet accepted");
                                <td class="text-center">
                                    <MudTooltip Text="@inspected.Tooltip">
                                        <MudIcon Icon="@inspected.Icon" Color="@inspected.Color" Size="Size.Small"
                                                 Style="@(inspected.Muted ? "opacity:.35" : null)" />
                                    </MudTooltip>
                                </td>
                                <td class="text-center">
                                    <MudTooltip Text="@accepted.Tooltip">
                                        <MudIcon Icon="@accepted.Icon" Color="@accepted.Color" Size="Size.Small"
                                                 Style="@(accepted.Muted ? "opacity:.35" : null)" />
                                    </MudTooltip>
                                </td>
                            }
                            <td>
                                <MudStack Row="true" Spacing="0">
                                    @if (iar.Status == InspectionAcceptanceReportStatus.Draft)
                                    {
                                        @if (_canUpdate)
                                        {
                                            <MudTooltip Text="Edit">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Color="Color.Primary" Size="Size.Small"
                                                               OnClick="@(() => OpenEditDialog(iar.Id))" />
                                            </MudTooltip>
                                        }
                                        @if (_canSubmitForInspection)
                                        {
                                            <MudTooltip Text="Submit for Inspection">
                                                <MudIconButton Icon="@Icons.Material.Filled.Send"
                                                               Color="Color.Info" Size="Size.Small"
                                                               OnClick="@(() => SubmitForInspectionAsync(iar.Id))" />
                                            </MudTooltip>
                                        }
                                        @if (_canCancel)
                                        {
                                            <MudTooltip Text="Cancel">
                                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                               Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => CancelIarAsync(iar.Id))" />
                                            </MudTooltip>
                                        }
                                    }
                                    else if (iar.Status == InspectionAcceptanceReportStatus.PendingInspection)
                                    {
                                        @if (_canInspect)
                                        {
                                            <MudTooltip Text="@(IsAssignedInspector(iar) ? "Record Inspection" : "View Inspection")">
                                                <MudIconButton Icon="@Icons.Material.Filled.FactCheck"
                                                               Color="@(IsAssignedInspector(iar) ? Color.Primary : Color.Default)"
                                                               Size="Size.Small"
                                                               OnClick="@(() => OpenInspectionPage(iar.Id))" />
                                            </MudTooltip>
                                        }
                                        @if (_canSubmitForInspection)
                                        {
                                            <MudTooltip Text="Reassign Inspector">
                                                <MudIconButton Icon="@Icons.Material.Filled.SwitchAccount"
                                                               Color="Color.Warning" Size="Size.Small"
                                                               OnClick="@(() => OpenReassignInspectorDialog(iar.Id))" />
                                            </MudTooltip>
                                        }
                                        @if (_canCancel)
                                        {
                                            <MudTooltip Text="Cancel">
                                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                               Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => CancelIarAsync(iar.Id))" />
                                            </MudTooltip>
                                        }
                                    }
                                    else if (iar.Status == InspectionAcceptanceReportStatus.Inspected)
                                    {
                                        @if (_canAccept || _canAssignPropertyNo)
                                        {
                                            <MudTooltip Text="Accept">
                                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                               Color="Color.Success" Size="Size.Small"
                                                               OnClick="@(() => OpenAcceptanceDialog(iar))" />
                                            </MudTooltip>
                                        }
                                        @if (_canCancel)
                                        {
                                            <MudTooltip Text="Cancel">
                                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                               Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => CancelIarAsync(iar.Id))" />
                                            </MudTooltip>
                                        }
                                    }
                                    else
                                    {
                                        <MudTooltip Text="View">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Default" Size="Size.Small"
                                                           OnClick="@(() => OpenAcceptanceDialog(iar))" />
                                        </MudTooltip>
                                    }
                                    @if (iar.Status == InspectionAcceptanceReportStatus.Accepted && (iar.HasSignedCopy ? _canViewSignedCopy : _canUploadSignedCopy))
                                    {
                                        <MudTooltip Text="@(iar.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")">
                                            <MudIconButton Icon="@Icons.Material.Filled.Verified" Size="Size.Small"
                                                           Color="@(iar.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                           OnClick="@(() => OpenSignedCopyAsync(iar.Id, iar.IarNumber))" />
                                        </MudTooltip>
                                    }
                                    <MudMenu Icon="@Icons.Material.Filled.Print"
                                             Color="Color.Secondary"
                                             Size="Size.Small"
                                             Dense="true"
                                             AnchorOrigin="Origin.BottomLeft"
                                             TransformOrigin="Origin.TopLeft"
                                             ToolTip="Print">
                                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                     OnClick="@(() => DownloadFastReportPdfAsync(iar.Id))">
                                            Download PDF
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                     OnClick="@(() => OpenFastReportSetupAsync(iar.Id))">
                                            Fast Report – Page Setup…
                                        </MudMenuItem>
                                    </MudMenu>
                                </MudStack>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Spacing="1">
                <MudText Typo="Typo.caption">@_totalCount IARs total</MudText>
                <MudSpacer />
                <MudPagination Count="@TotalPages" Selected="_page" ShowFirstButton="true" ShowLastButton="true"
                               SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<InspectionAcceptanceReportSummaryDto> _items = [];
    private string? _keyword;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private InspectionAcceptanceReportStatus? _statusFilter;
    private bool _loading;
    private int _activeTab;
    private int _page = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    private bool _canCreate => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Update);
    private bool _canSubmitForInspection => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.SubmitForInspection);
    private bool _canInspect => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Inspect);
    private bool _canAssignPropertyNo => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.AssignPropertyNo);
    private bool _canAccept => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Accept);
    private bool _canCancel => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Cancel);
    private bool _canViewSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.View);
    private bool _canUploadSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.Upload);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnTabChanged(int tab)
    {
        _activeTab = tab;
        _statusFilter = tab switch
        {
            1 => InspectionAcceptanceReportStatus.Draft,
            2 => InspectionAcceptanceReportStatus.PendingInspection,
            3 => InspectionAcceptanceReportStatus.Inspected,
            4 => InspectionAcceptanceReportStatus.Accepted,
            5 => InspectionAcceptanceReportStatus.Cancelled,
            _ => null
        };
        _page = 1;
        await LoadAsync();
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _fromDate = date;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _toDate = date;
        _page = 1;
        await LoadAsync();
    }

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is null ? null : DateOnly.FromDateTime(value.Value);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var response = await IarClient.SearchAsync(_keyword, _statusFilter, page: _page, pageSize: PageSize,
                fromDate: ToDateOnly(_fromDate), toDate: ToDateOnly(_toDate));
            _items = [.. response.Items];
            _totalCount = (int)response.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsAssignedInspector(InspectionAcceptanceReportSummaryDto iar) =>
        UserProfileState.EmployeeId != Guid.Empty && iar.AssignedInspectorId == UserProfileState.EmployeeId;

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<InspectionAcceptanceReportDraftDialog>("New IAR Draft", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(Guid id)
    {
        var iar = await IarClient.GetAsync(id);
        if (iar is null)
        {
            Snackbar.Add("IAR not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters { ["Existing"] = iar };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<InspectionAcceptanceReportDraftDialog>($"IAR {iar.IarNumber}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenAcceptanceDialog(InspectionAcceptanceReportSummaryDto iar)
    {
        var parameters = new DialogParameters<InspectionAcceptanceReportAcceptanceDialog>
        {
            { x => x.Id, iar.Id }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<InspectionAcceptanceReportAcceptanceDialog>(
            $"Inspection & Acceptance Report — {iar.IarNumber}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LoadAsync();
        }
    }

    private async Task SubmitForInspectionAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Submit IAR", "Submit this draft for inspection?", yesText: "Submit", cancelText: "Cancel");
        if (ok != true)
        {
            return;
        }

        try
        {
            await IarClient.SubmitForInspectionAsync(id);
            Snackbar.Add("IAR submitted for inspection.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submit failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelIarAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox("Cancel IAR", "Cancel this IAR? This action cannot be undone.", yesText: "Cancel IAR", cancelText: "Keep");
        if (ok != true)
        {
            return;
        }

        try
        {
            await IarClient.CancelAsync(id);
            Snackbar.Add("IAR cancelled.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenReassignInspectorDialog(Guid id)
    {
        var details = await IarClient.GetAsync(id);
        if (details is null)
        {
            Snackbar.Add("IAR not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["IarId"] = details.Id,
            ["CurrentInspectorId"] = details.InspectedById
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<InspectionAcceptanceReportReassignInspectorDialog>("Reassign Inspector", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private void OpenInspectionPage(Guid id)
    {
        Navigation.NavigateTo($"/procurement/inspection-acceptance-reports/{id}/inspect");
    }

    private void OpenAcceptancePage(Guid id)
    {
        Navigation.NavigateTo($"/procurement/inspection-acceptance-reports/{id}/accept");
    }

    private static Color StatusColor(InspectionAcceptanceReportStatus status) => status switch
    {
        InspectionAcceptanceReportStatus.Draft => Color.Default,
        InspectionAcceptanceReportStatus.PendingInspection => Color.Warning,
        InspectionAcceptanceReportStatus.Inspected => Color.Info,
        InspectionAcceptanceReportStatus.Accepted => Color.Success,
        InspectionAcceptanceReportStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    // Each IAR progresses through two milestones — Inspected, then Accepted.
    // A milestone is Done (green ✔), Active (amber ◷ — the step currently in
    // progress), or NotStarted (muted grey ○). Cancelled is handled separately
    // as a chip, since an X in two boxes reads like "failed inspection".
    private enum MilestoneState { NotStarted, Active, Done }

    private static MilestoneState InspectedState(InspectionAcceptanceReportStatus status) => status switch
    {
        InspectionAcceptanceReportStatus.PendingInspection => MilestoneState.Active,
        InspectionAcceptanceReportStatus.Inspected => MilestoneState.Done,
        InspectionAcceptanceReportStatus.Accepted => MilestoneState.Done,
        _ => MilestoneState.NotStarted
    };

    private static MilestoneState AcceptedState(InspectionAcceptanceReportStatus status) => status switch
    {
        InspectionAcceptanceReportStatus.Inspected => MilestoneState.Active,
        InspectionAcceptanceReportStatus.Accepted => MilestoneState.Done,
        _ => MilestoneState.NotStarted
    };

    private static (string Icon, Color Color, string Tooltip, bool Muted) Milestone(
        MilestoneState state, string doneText, string activeText, string pendingText) => state switch
    {
        MilestoneState.Done => (Icons.Material.Filled.CheckCircle, Color.Success, doneText, false),
        MilestoneState.Active => (Icons.Material.Filled.Schedule, Color.Warning, activeText, false),
        _ => (Icons.Material.Outlined.RadioButtonUnchecked, Color.Default, pendingText, true)
    };

    private async Task DownloadFastReportPdfAsync(Guid id)
    {
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await IarClient.GetFastReportPdfAsync(id,
                pageWidth: saved?.PaperSize ?? "a4",
                orientation: saved?.Orientation ?? "landscape",
                minRows: saved?.MinRows ?? 12);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private const string FastReportKey = "asset-iar";

    private async Task OpenFastReportSetupAsync(Guid id)
    {
        // IAR is always 1 copy per page; the dialog's Copies field is ignored on submit.
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "a4",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "landscape",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 1,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 12
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        try
        {
            var bytes = await IarClient.GetFastReportPdfAsync(id, pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenSignedCopyAsync(Guid id, string iarNumber)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, ProcurementDocumentType.InspectionAcceptanceReport },
            { x => x.DocumentId, id },
            { x => x.DocumentNumber, iarNumber },
            { x => x.IsTerminalState, true }
        };
        await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true });
    }
}
