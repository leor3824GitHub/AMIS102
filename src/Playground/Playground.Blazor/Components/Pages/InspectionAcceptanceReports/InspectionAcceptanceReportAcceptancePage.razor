@page "/procurement/inspection-acceptance-reports/{Id:guid}/accept"
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Modules.ProcurementAcquisition.Contracts.Permissions
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.InspectionAcceptanceReports
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests
@inject IInspectionAcceptanceReportClient IarClient
@inject IUserProfileState UserProfileState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>IAR Acceptance / View</PageTitle>

<AMISPageHeader Title="IAR Acceptance"
                Description="@_headerDescription" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_iar is null)
{
    <MudAlert Severity="Severity.Error">IAR not found.</MudAlert>
}
else
{
    <InspectionAcceptanceReportStageStepper Status="@_iar.Status" />

    @if (_iar.Status == InspectionAcceptanceReportStatus.Accepted)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">
            This IAR is already <b>Accepted</b>. The page is in read-only mode.
        </MudAlert>
    }
    else if (_iar.Status == InspectionAcceptanceReportStatus.Cancelled)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            This IAR is <b>Cancelled</b>. The page is in read-only mode.
        </MudAlert>
    }
    else if (_iar.Status != InspectionAcceptanceReportStatus.Inspected)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Acceptance actions are available only when IAR status is <b>Inspected</b>. Current page is read-only.
        </MudAlert>
    }
    else if (!_canAssignPropertyNoPermission && !_canAcceptPermission)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            You do not have permissions to assign Property No or accept this IAR. Current page is read-only.
        </MudAlert>
    }

    <MudCard Elevation="1" Class="mb-3">
        <MudCardContent Class="pb-2">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">IAR No.</MudText>
                    <MudText Typo="Typo.body1"><b>@_iar.IarNumber</b></MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">IAR Date</MudText>
                    <MudText Typo="Typo.body1">@_iar.IarDate.ToString("MMM dd, yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Purchase Order</MudText>
                    <MudText Typo="Typo.body1">@_iar.PoNumber</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Supplier</MudText>
                    <MudText Typo="Typo.body1">@_iar.SupplierName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Inspector</MudText>
                    <MudText Typo="Typo.body1">@(_iar.InspectedByName ?? "—")</MudText>
                </MudItem>
                @if (_iar.InspectedOnUtc.HasValue)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Inspected On</MudText>
                        <MudText Typo="Typo.body1">@_iar.InspectedOnUtc.Value.ToLocalTime().ToString("MMM dd, yyyy")</MudText>
                    </MudItem>
                }
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                    <MudText Typo="Typo.body1">@_iar.Status</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="1">
        <MudCardContent>
            @{
                var filtered = FilteredLines;
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
                <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                            SelectedValue="_statusFilter"
                            SelectedValueChanged="OnStatusFilterChanged"
                            CheckMark="true" Variant="Variant.Text">
                    <MudChip T="string" Value="@("All")" Size="Size.Small" Color="Color.Default">All (@_allLines.Count)</MudChip>
                    <MudChip T="string" Value="@("Passed")" Size="Size.Small" Color="Color.Success">Passed (@_passedLines.Count)</MudChip>
                    <MudChip T="string" Value="@("Rejected")" Size="Size.Small" Color="Color.Error">Rejected (@_rejectedLines.Count)</MudChip>
                    <MudChip T="string" Value="@("Pending")" Size="Size.Small" Color="Color.Warning">Pending (@_pendingLines.Count)</MudChip>
                </MudChipSet>
            </MudStack>

            @if (filtered.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @(_statusFilter == "All" ? "No lines to display." : $"No {_statusFilter.ToLowerInvariant()} lines.")
                </MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th style="width:48px">#</th>
                            <th>Description</th>
                            <th style="width:60px; text-align:right">Qty</th>
                            <th style="width:110px">Status</th>
                            <th style="min-width:320px">Property No / Remarks</th>
                            <th style="width:170px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in filtered)
                        {
                            <tr>
                                <td>@line.ItemNo</td>
                                <td>@line.Description</td>
                                <td style="text-align:right">@line.Quantity</td>
                                <td>
                                    @switch (line.InspectionResult)
                                    {
                                        case LineInspectionResult.Passed:
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Passed</MudChip>
                                            break;
                                        case LineInspectionResult.Rejected:
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Rejected</MudChip>
                                            break;
                                        default:
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Pending</MudChip>
                                            break;
                                    }
                                </td>
                                <td style="min-width:320px;">
                                    @if (line.InspectionResult == LineInspectionResult.Passed)
                                    {
                                        @if (_isSupply)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Stock item — no property number.</MudText>
                                        }
                                        else if (_canAssignActions)
                                        {
                                            <PropertyNoField Value="@GetPropertyNoInput(line.ItemNo, line.StockPropertyNo)"
                                                            ValueChanged="@(v => OnPropertyNoChanged(line.ItemNo, v))"
                                                            Label="Property No."
                                                            Placeholder="Required for passed lines"
                                                            MaxLength="64"
                                                            InitialYear="@DateTime.Now.Year" />
                                        }
                                        else
                                        {
                                            <MudText>@(string.IsNullOrWhiteSpace(line.StockPropertyNo) ? "-" : line.StockPropertyNo)</MudText>
                                        }
                                    }
                                    else if (line.InspectionResult == LineInspectionResult.Rejected)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Error">
                                            @(string.IsNullOrWhiteSpace(line.InspectionRemarks) ? "No remarks provided." : line.InspectionRemarks)
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Awaiting inspection decision.</MudText>
                                    }
                                </td>
                                <td>
                                    @if (line.InspectionResult == LineInspectionResult.Passed && _canAssignActions && !_isSupply)
                                    {
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Disabled="@(!CanAssignPropertyNo(line))"
                                                       OnClick="@(() => AssignPropertyNoAsync(line.ItemNo))">
                                                Assign
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Color="Color.Secondary"
                                                       Disabled="@(!CanExpandLine(line))"
                                                       OnClick="@(() => ExpandLineAsync(line.ItemNo))">
                                                Expand Qty
                                            </MudButton>
                                        </MudStack>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (PendingLines.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    This IAR still has @PendingLines.Count line(s) without inspection decision. Acceptance is disabled until inspection is finalized.
                </MudAlert>
            }

            @if (_isSupply && _canAcceptActions && CanAccept())
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Supply IAR — accepted lines are landed into Expendable inventory by Stock No. No property numbers are assigned.
                </MudAlert>
            }
            else if (!_isSupply && _canAcceptActions && !CanAccept())
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Click <b>Assign</b> on each passed line to save its Property No — the Accept button becomes available once every passed line has one.
                </MudAlert>
            }
        </MudCardContent>
        <MudCardActions>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" OnClick="BackToList">Back</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@(!_canAcceptActions || _busy || !CanAccept())"
                       OnClick="AcceptAsync">
                Accept IAR
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private InspectionAcceptanceReportDto? _iar;
    private bool _loading = true;
    private bool _busy;
    private readonly Dictionary<int, string> _propertyNoInputs = [];
    private List<InspectionAcceptanceReportLineItemDto> _allLines = [];
    private List<InspectionAcceptanceReportLineItemDto> _passedLines = [];
    private List<InspectionAcceptanceReportLineItemDto> _rejectedLines = [];
    private List<InspectionAcceptanceReportLineItemDto> _pendingLines = [];
    private List<InspectionAcceptanceReportLineItemDto> PassedLines => _passedLines;
    private List<InspectionAcceptanceReportLineItemDto> RejectedLines => _rejectedLines;
    private List<InspectionAcceptanceReportLineItemDto> PendingLines => _pendingLines;

    private string _statusFilter = "Passed";

    private List<InspectionAcceptanceReportLineItemDto> FilteredLines => _statusFilter switch
    {
        "Passed" => _passedLines,
        "Rejected" => _rejectedLines,
        "Pending" => _pendingLines,
        _ => _allLines
    };

    private void OnStatusFilterChanged(string? value)
        => _statusFilter = string.IsNullOrWhiteSpace(value) ? "All" : value;

    // Supply IARs land stock into Expendable inventory and never carry property numbers — the whole
    // Property No / Assign / Expand workflow is Asset-only.
    private bool _isSupply => _iar?.Category == ProcurementCategory.Supply;

    private string _headerDescription => _isSupply
        ? "Review accepted supply lines, then accept to land stock into Expendable inventory."
        : "Assign property numbers, split multi-quantity lines, or review accepted/cancelled IAR details.";

    private bool _canAcceptPermission => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.Accept);
    private bool _canAssignPropertyNoPermission => UserProfileState.Permissions.Contains(ProcurementPermissions.InspectionAcceptanceReports.AssignPropertyNo);
    private bool _canAssignActions => _iar is not null && _iar.Status == InspectionAcceptanceReportStatus.Inspected && _canAssignPropertyNoPermission;
    private bool _canAcceptActions => _iar is not null && _iar.Status == InspectionAcceptanceReportStatus.Inspected && _canAcceptPermission;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _iar = await IarClient.GetAsync(Id);
            SyncPropertyNoInputs();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load IAR: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SyncPropertyNoInputs()
    {
        _propertyNoInputs.Clear();
        if (_iar is null)
        {
            _allLines = [];
            _passedLines = [];
            _rejectedLines = [];
            _pendingLines = [];
            return;
        }

        foreach (var line in _iar.LineItems)
            _propertyNoInputs[line.ItemNo] = line.StockPropertyNo ?? string.Empty;

        var ordered = _iar.LineItems.OrderBy(li => li.ItemNo).ToList();
        _allLines = ordered;
        _passedLines = ordered.Where(li => li.InspectionResult == LineInspectionResult.Passed).ToList();
        _rejectedLines = ordered.Where(li => li.InspectionResult == LineInspectionResult.Rejected).ToList();
        _pendingLines = ordered.Where(li => li.InspectionResult == LineInspectionResult.Pending).ToList();
    }

    private string GetPropertyNoInput(int itemNo, string? fallback)
    {
        if (_propertyNoInputs.TryGetValue(itemNo, out var value))
        {
            return value;
        }

        var initial = fallback ?? string.Empty;
        _propertyNoInputs[itemNo] = initial;
        return initial;
    }

    private void OnPropertyNoChanged(int itemNo, string? value)
    {
        _propertyNoInputs[itemNo] = value?.Trim() ?? string.Empty;
    }

    private bool CanAssignPropertyNo(InspectionAcceptanceReportLineItemDto line)
        => _canAssignActions && line.InspectionResult == LineInspectionResult.Passed;

    private bool CanExpandLine(InspectionAcceptanceReportLineItemDto line)
        => _canAssignActions && line.InspectionResult == LineInspectionResult.Passed && line.Quantity > 1m;

    private bool CanAccept()
    {
        if (_iar is null || _iar.Status != InspectionAcceptanceReportStatus.Inspected)
        {
            return false;
        }

        if (_iar.LineItems.Count == 0)
        {
            return false;
        }

        // Supply IARs carry no property numbers — acceptance only needs at least one passed line.
        if (_isSupply)
        {
            return PassedLines.Count > 0;
        }

        return PassedLines
            .All(li => !string.IsNullOrWhiteSpace(li.StockPropertyNo));
    }

    private async Task AssignPropertyNoAsync(int itemNo)
    {
        if (_iar is null)
        {
            return;
        }

        if (!_propertyNoInputs.TryGetValue(itemNo, out var propertyNo) || string.IsNullOrWhiteSpace(propertyNo))
        {
            Snackbar.Add($"Item {itemNo}: Property No is required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            _iar = await IarClient.AssignPropertyNoAsync(_iar.Id, itemNo, propertyNo.Trim());
            SyncPropertyNoInputs();
            Snackbar.Add($"Item {itemNo}: Property No assigned.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Assign property no failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExpandLineAsync(int itemNo)
    {
        if (_iar is null)
        {
            return;
        }

        var ok = await DialogService.ShowMessageBox(
            "Expand Quantity",
            $"Expand item {itemNo} into one-line-per-unit entries?",
            yesText: "Expand",
            cancelText: "Cancel");

        if (ok != true)
        {
            return;
        }

        _busy = true;
        try
        {
            _iar = await IarClient.ExpandLineByQuantityAsync(_iar.Id, itemNo);
            SyncPropertyNoInputs();
            Snackbar.Add($"Item {itemNo} expanded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Expand failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptAsync()
    {
        if (_iar is null)
        {
            return;
        }

        var ok = await DialogService.ShowMessageBox(
            "Accept IAR",
            _isSupply
                ? "Confirm acceptance and land accepted line items into Expendable inventory?"
                : "Confirm acceptance and publish accepted line items to AssetManagement?",
            yesText: "Accept",
            cancelText: "Cancel");

        if (ok != true)
        {
            return;
        }

        _busy = true;
        try
        {
            _iar = await IarClient.AcceptAsync(_iar.Id);
            Snackbar.Add("IAR accepted.", Severity.Success);
            Navigation.NavigateTo("/procurement/inspection-acceptance-reports");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Accept failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackToList() => Navigation.NavigateTo("/procurement/inspection-acceptance-reports");

}