@page "/asset-register/returned-property"
@implements IDisposable
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Playground.Blazor.Components.Shared
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using ReturnedPropertyReceiptType = AMIS.Modules.AssetRegister.Contracts.v1.ReturnedPropertyReceiptType
@using ReturnedPropertyReceiptStatus = AMIS.Modules.AssetRegister.Contracts.v1.ReturnedPropertyReceiptStatus
@using AccountabilityType = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityType
@using AccountabilityStatus = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityStatus
@using AccountabilityLineStatus = AMIS.Modules.AssetRegister.Contracts.v1.AccountabilityLineStatus
@inject IArReturnedPropertyClient Client
@inject IArAccountabilityClient AccountabilityClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Returned Property Receipts (RRSP / RRP)"
               Description="End-users request the return of property assigned to them; the property custodian receives and accepts it. Accepting marks each asset back to Available." />

<MudGrid Spacing="3">
    <!-- Request Form -->
    @if (_canCreate)
    {
    <MudItem xs="12" md="4">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Request a Return</MudText>
                <MudStack Spacing="2">

                    <MudSelect Value="_form.ReceiptType" T="ReturnedPropertyReceiptType" Label="Receipt Type"
                               Variant="Variant.Outlined" Required="true"
                               ValueChanged="@((ReturnedPropertyReceiptType v) => { _form.ReceiptType = v; _form.SelectedAccountability = null; _accountability = null; _selectedLineIds.Clear(); })">
                        <MudSelectItem T="ReturnedPropertyReceiptType" Value="ReturnedPropertyReceiptType.RRSP">RRSP — Semi-Expendable (ICS)</MudSelectItem>
                        <MudSelectItem T="ReturnedPropertyReceiptType" Value="ReturnedPropertyReceiptType.RRP">RRP — Fixed Assets (PAR)</MudSelectItem>
                    </MudSelect>

                    <MudDatePicker @bind-Date="_form.DateNullable" Label="Date" Variant="Variant.Outlined"
                                   DateFormat="MM/dd/yyyy" Required="true" />

                    <MudAutocomplete T="ArAccountabilitySummaryDto"
                                     Value="_form.SelectedAccountability"
                                     SearchFunc="SearchAccountabilityAsync"
                                     ToStringFunc="@(x => x is null ? "" : x.DocumentNo)"
                                     Label="@(_form.ReceiptType == ReturnedPropertyReceiptType.RRSP ? "My ICS to Return Against" : "My PAR to Return Against")"
                                     Variant="Variant.Outlined"
                                     Required="true" Clearable="true" ResetValueOnEmptyText="true" CoerceValue="true"
                                     ValueChanged="OnAccountabilitySelected" />

                    @if (_accountability is not null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Select items to return from <b>@_accountability.DocumentNo</b>
                            (@_accountability.Lines.Count(l => l.LineStatus == AccountabilityLineStatus.Active) active item(s)).
                        </MudAlert>

                        <MudText Typo="Typo.subtitle2">Items to Return</MudText>
                        @foreach (var line in _accountability.Lines.Where(l => l.LineStatus == AccountabilityLineStatus.Active))
                        {
                            <MudCheckBox @bind-Value="_selectedLineIds[line.Id]"
                                         Label="@($"{line.Snapshot.PropertyNo} — {line.Snapshot.Description} (₱{line.Snapshot.UnitCost:N2})")"
                                         Color="Color.Primary" Dense="true" />
                        }
                    }

                    <MudTextField Value="@ReturnedByDisplay" Label="Returned By" Variant="Variant.Outlined"
                                  ReadOnly="true" HelperText="Auto-assigned to the currently logged-in user" />

                    <MudTextField @bind-Value="_form.Remarks" Label="Remarks" Variant="Variant.Outlined"
                                  Lines="2" MaxLength="1000" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="RequestAsync" Disabled="_busy">
                        Request Return
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    }

    <!-- List Panel -->
    <MudItem xs="12" md="@(_canCreate ? 8 : 12)">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Return Receipts</MudText>
                    <MudTextField @bind-Value="_keyword" Label="Search" Variant="Variant.Outlined" Size="Size.Small"
                                  Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                  DebounceInterval="350" OnDebounceIntervalElapsed="@(() => LoadAsync())" Style="max-width:220px" />
                </MudStack>

                <!-- Status Filter Tabs -->
                <MudTabs Elevation="0" Rounded="true" PanelClass="pa-0" Class="mb-3"
                         ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnTabChanged">
                    <MudTabPanel Text="@GetTabLabel(0, "All")" />
                    <MudTabPanel Text="@GetTabLabel(1, "Pending")" />
                    <MudTabPanel Text="@GetTabLabel(2, "Accepted")" />
                    <MudTabPanel Text="@GetTabLabel(3, "Rejected")" />
                    <MudTabPanel Text="@GetTabLabel(4, "Cancelled")" />
                </MudTabs>

                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_records.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No return receipts found.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Receipt No.</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Accountability</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _records)
                            {
                                <tr>
                                    <td><b>@(string.IsNullOrWhiteSpace(r.ReceiptNo) ? "—" : r.ReceiptNo)</b></td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(r.ReceiptType == ReturnedPropertyReceiptType.RRSP ? Color.Info : Color.Secondary)"
                                                 Variant="Variant.Outlined">
                                            @r.ReceiptType
                                        </MudChip>
                                    </td>
                                    <td>@r.Date.ToString("MM/dd/yyyy")</td>
                                    <td><MudText Typo="Typo.caption">@r.AccountabilityDocumentNo</MudText></td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            @r.ItemCount item(s)
                                        </MudChip>
                                    </td>
                                    <td>@StatusChip(r.Status)</td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            <MudTooltip Text="View Details">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                               Color="Color.Default" OnClick="@(() => ViewAsync(r.Id))" />
                                            </MudTooltip>
                                            @if (r.Status == ReturnedPropertyReceiptStatus.Pending)
                                            {
                                                @if (_canAccept)
                                                {
                                                    <MudTooltip Text="Receive / Accept">
                                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                                                       Color="Color.Success" OnClick="@(() => AcceptAsync(r.Id))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Reject">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                                       Color="Color.Error" OnClick="@(() => RejectAsync(r.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (_canCreate)
                                                {
                                                    <MudTooltip Text="Withdraw Request">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                                                       Color="Color.Warning" OnClick="@(() => CancelAsync(r.Id))" />
                                                    </MudTooltip>
                                                }
                                            }
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudText Typo="Typo.caption">@_totalCount total</MudText>
                        <MudSpacer />
                        <MudPagination Count="@TotalPages" Selected="_page" ShowFirstButton="true" ShowLastButton="true"
                                       SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>

        <!-- Detail Card -->
        @if (_detail is not null)
        {
            <MudCard Elevation="1" Class="mt-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(_detail.ReceiptNo) ? "(Pending — no number yet)" : _detail.ReceiptNo)</MudText>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(_detail.ReceiptType == ReturnedPropertyReceiptType.RRSP ? Color.Info : Color.Secondary)"
                                     Variant="Variant.Outlined">
                                @_detail.ReceiptType
                            </MudChip>
                            @StatusChip(_detail.Status)
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_detail.Date.ToString("MMMM dd, yyyy")</MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _detail = null)" />
                        </MudStack>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="1" Class="mb-2">
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">Accountability Document</MudText>
                            <MudText Typo="Typo.body2"><b>@_detail.AccountabilityDocumentNo</b></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption">Returned By</MudText>
                            <MudText Typo="Typo.body2">@_detail.ReturnedBy.PrintedName@(!string.IsNullOrWhiteSpace(_detail.ReturnedBy.Designation) ? $" — {_detail.ReturnedBy.Designation}" : "")</MudText>
                        </MudItem>
                        @if (_detail.ReceivedBy is not null)
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Received By (Custodian)</MudText>
                                <MudText Typo="Typo.body2">@_detail.ReceivedBy.PrintedName@(!string.IsNullOrWhiteSpace(_detail.ReceivedBy.Designation) ? $" — {_detail.ReceivedBy.Designation}" : "")</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detail.RejectionReason))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Error">Rejection Reason</MudText>
                                <MudText Typo="Typo.body2">@_detail.RejectionReason</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detail.CancellationReason))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Warning">Cancellation Reason</MudText>
                                <MudText Typo="Typo.body2">@_detail.CancellationReason</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detail.Remarks))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption">Remarks</MudText>
                                <MudText Typo="Typo.body2">@_detail.Remarks</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Returned Items (@_detail.Items.Count)</MudText>
                    <MudSimpleTable Dense="true" Striped="true">
                        <thead>
                            <tr><th>#</th><th>Property No.</th><th>Description</th><th>Type</th><th style="text-align:right">Unit Cost</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _detail.Items.OrderBy(x => x.ItemNo))
                            {
                                <tr>
                                    <td>@item.ItemNo</td>
                                    <td><b>@item.Snapshot.PropertyNo</b></td>
                                    <td>@item.Snapshot.Description</td>
                                    <td><MudChip T="string" Size="Size.Small" Color="Color.Default">@item.Snapshot.AssetType</MudChip></td>
                                    <td style="text-align:right">₱@item.Snapshot.UnitCost.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" style="text-align:right"><b>Total:</b></td>
                                <td style="text-align:right"><b>₱@_detail.Items.Sum(x => x.Snapshot.UnitCost).ToString("N2")</b></td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        }
    </MudItem>
</MudGrid>

@code {
    private List<ArReturnedPropertyReceiptSummaryDto> _records = [];
    private ArReturnedPropertyReceiptDto? _detail;
    private ArAccountabilityDto? _accountability;
    private Dictionary<Guid, bool> _selectedLineIds = [];
    private string? _keyword;
    private bool _loading;
    private bool _busy;
    private int _activeTabIndex;
    private int _page = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    private readonly Dictionary<int, int> _statusCounts = [];

    private ReturnForm _form = new();

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.ReturnedProperty.Create);
    private bool _canAccept => UserProfileState.Permissions.Contains(AssetRegisterPermissions.ReturnedProperty.Accept);

    private string ReturnedByDisplay =>
        string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName)
            ? UserProfileState.EmployeeFullName
            : $"{UserProfileState.EmployeeFullName} — {UserProfileState.EmployeePositionName}";

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadStatusCountsAsync();
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private static ReturnedPropertyReceiptStatus? GetStatusFromTabIndex(int index) =>
        index switch
        {
            1 => ReturnedPropertyReceiptStatus.Pending,
            2 => ReturnedPropertyReceiptStatus.Accepted,
            3 => ReturnedPropertyReceiptStatus.Rejected,
            4 => ReturnedPropertyReceiptStatus.Cancelled,
            _ => null
        };

    private async Task OnTabChanged(int index)
    {
        _activeTabIndex = index;
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var status = GetStatusFromTabIndex(_activeTabIndex);
            var response = await Client.SearchAsync(_keyword, receiptType: null, status: status, page: _page, pageSize: PageSize);
            _records = [.. response.Items];
            _totalCount = response.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task LoadStatusCountsAsync()
    {
        try
        {
            _statusCounts.Clear();
            var counts = await Client.GetStatusCountsAsync();
            var byStatus = counts.ToDictionary(c => c.Status, c => c.Count);
            _statusCounts[1] = byStatus.GetValueOrDefault(ReturnedPropertyReceiptStatus.Pending);
            _statusCounts[2] = byStatus.GetValueOrDefault(ReturnedPropertyReceiptStatus.Accepted);
            _statusCounts[3] = byStatus.GetValueOrDefault(ReturnedPropertyReceiptStatus.Rejected);
            _statusCounts[4] = byStatus.GetValueOrDefault(ReturnedPropertyReceiptStatus.Cancelled);
            _statusCounts[0] = byStatus.Values.Sum();
        }
        catch { _statusCounts.Clear(); }
    }

    private async Task RefreshAsync()
    {
        await LoadStatusCountsAsync();
        await LoadAsync();
    }

    private string GetTabLabel(int tabIndex, string label) =>
        _statusCounts.TryGetValue(tabIndex, out var count) && count > 0 ? $"{label} ({count})" : label;

    private async Task ViewAsync(Guid id)
    {
        try { _detail = await Client.GetAsync(id); }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
    }

    private async Task<IEnumerable<ArAccountabilitySummaryDto>> SearchAccountabilityAsync(string? value, CancellationToken ct)
    {
        var expectedType = _form.ReceiptType == ReturnedPropertyReceiptType.RRSP
            ? AccountabilityType.SE_ICS
            : AccountabilityType.PPE_PAR;
        var scopeEmployeeId = UserProfileState.EmployeeId == Guid.Empty ? (Guid?)null : UserProfileState.EmployeeId;
        var response = await AccountabilityClient.SearchAsync(
            keyword: value, type: expectedType, status: AccountabilityStatus.Active,
            receivedByEmployeeId: scopeEmployeeId, page: 1, pageSize: 20, ct: ct);
        return response.Items;
    }

    private async Task OnAccountabilitySelected(ArAccountabilitySummaryDto? selected)
    {
        _form.SelectedAccountability = selected;
        _accountability = null;
        _selectedLineIds.Clear();

        if (selected is null) return;

        try
        {
            _accountability = await AccountabilityClient.GetAsync(selected.Id);
            if (_accountability is not null)
            {
                _selectedLineIds = _accountability.Lines
                    .Where(l => l.LineStatus == AccountabilityLineStatus.Active)
                    .ToDictionary(l => l.Id, _ => true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load accountability detail: {ex.Message}", Severity.Error);
        }
    }

    private async Task RequestAsync()
    {
        if (_form.DateNullable is null || _form.SelectedAccountability is null)
        {
            Snackbar.Add("Date and Accountability are required.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(UserProfileState.EmployeeFullName))
        {
            Snackbar.Add("Your account is not linked to an employee record, so \"Returned By\" cannot be set. Contact an administrator.", Severity.Warning);
            return;
        }

        var lineIds = _selectedLineIds.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        if (lineIds.Count == 0)
        {
            Snackbar.Add("Select at least one item to return.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var returnedBy = new ArEmployeeRefDto(
                UserProfileState.EmployeeId,
                UserProfileState.EmployeeFullName.Trim(),
                string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName) ? null : UserProfileState.EmployeePositionName.Trim());

            var result = await Client.CreateAsync(new CreateReturnedPropertyReceiptRequest(
                _form.ReceiptType,
                DateOnly.FromDateTime(_form.DateNullable!.Value),
                _form.SelectedAccountability.Id,
                lineIds,
                returnedBy,
                _form.Remarks?.Trim()));

            Snackbar.Add($"Return request submitted ({result.Items.Count} item(s)). Awaiting custodian acceptance.", Severity.Success);
            _form = new ReturnForm();
            _accountability = null;
            _selectedLineIds.Clear();
            _detail = result;
            await RefreshAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Request failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task AcceptAsync(Guid id)
    {
        if (string.IsNullOrWhiteSpace(UserProfileState.EmployeeFullName))
        {
            Snackbar.Add("Your account is not linked to an employee record, so you cannot be recorded as the receiver.", Severity.Warning);
            return;
        }

        var ok = await DialogService.ShowMessageBox(
            "Accept Return",
            "Receive and accept this return? The items will be marked back to Available and an official receipt number assigned.",
            yesText: "Accept", cancelText: "Cancel");
        if (ok is not true) return;

        var receivedBy = new ArEmployeeRefDto(
            UserProfileState.EmployeeId,
            UserProfileState.EmployeeFullName.Trim(),
            string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName) ? null : UserProfileState.EmployeePositionName.Trim());

        try
        {
            var result = await Client.AcceptAsync(id, receivedBy);
            Snackbar.Add($"{result.ReceiptNo} accepted.", Severity.Success);
            _detail = result;
            await RefreshAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Accept failed: {ex.Message}", Severity.Error); }
    }

    private async Task RejectAsync(Guid id)
    {
        var parameters = new DialogParameters<ReasonInputDialog>
        {
            { x => x.Title, "Reject Return Request" },
            { x => x.Label, "Rejection Reason" },
            { x => x.ConfirmText, "Reject" }
        };
        var dialog = await DialogService.ShowAsync<ReasonInputDialog>("Reject Return", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason || string.IsNullOrWhiteSpace(reason))
            return;

        try
        {
            await Client.RejectAsync(id, reason);
            Snackbar.Add("Return request rejected.", Severity.Info);
            await RefreshAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Reject failed: {ex.Message}", Severity.Error); }
    }

    private async Task CancelAsync(Guid id)
    {
        var ok = await DialogService.ShowMessageBox(
            "Withdraw Request", "Withdraw this pending return request?",
            yesText: "Yes, Withdraw", cancelText: "No");
        if (ok is not true) return;

        try
        {
            await Client.CancelAsync(id, null);
            Snackbar.Add("Return request withdrawn.", Severity.Info);
            await RefreshAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Withdraw failed: {ex.Message}", Severity.Error); }
    }

    private static RenderFragment StatusChip(ReturnedPropertyReceiptStatus status) => __builder =>
    {
        var (color, icon) = status switch
        {
            ReturnedPropertyReceiptStatus.Pending   => (Color.Info, Icons.Material.Filled.HourglassBottom),
            ReturnedPropertyReceiptStatus.Accepted  => (Color.Success, Icons.Material.Filled.CheckCircle),
            ReturnedPropertyReceiptStatus.Rejected  => (Color.Error, Icons.Material.Filled.Cancel),
            ReturnedPropertyReceiptStatus.Cancelled => (Color.Warning, Icons.Material.Filled.Block),
            _ => (Color.Default, Icons.Material.Filled.Help)
        };
        __builder.OpenComponent<MudChip<string>>(0);
        __builder.AddAttribute(1, "Size", Size.Small);
        __builder.AddAttribute(2, "Color", color);
        __builder.AddAttribute(3, "Icon", icon);
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, status.ToString())));
        __builder.CloseComponent();
    };

    private sealed class ReturnForm
    {
        public ReturnedPropertyReceiptType ReceiptType { get; set; } = ReturnedPropertyReceiptType.RRSP;
        public DateTime? DateNullable { get; set; } = DateTime.Today;
        public ArAccountabilitySummaryDto? SelectedAccountability { get; set; }
        public string? Remarks { get; set; }
    }
}
