@page "/asset-register/ppeir-series"
@implements IDisposable
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@inject IArIssuanceReportClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="PPEIR Form Series"
               Description="Manage pre-printed, pre-numbered PPEIR accountable form batches. Only one series may be active at a time." />

<MudGrid Spacing="3">
    @if (_canCreate)
    {
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@(_editingId is null ? "Register New Series" : "Edit Series")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2" AlignItems="AlignItems.Start">
                    <MudItem xs="6" md="2">
                        <MudNumericField @bind-Value="_startSerial" Label="Start No." Variant="Variant.Outlined" Min="1"
                                         Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudNumericField @bind-Value="_endSerial" Label="End No." Variant="Variant.Outlined" Min="1"
                                         Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex gap-2 align-center">
                        @if (_editingId is null)
                        {
                            <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                        StartIcon="@Icons.Material.Outlined.Add"
                                        OnClick="CreateAsync" Disabled="_busy">
                                Add Series
                            </AMISButton>
                        }
                        else
                        {
                            <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                        StartIcon="@Icons.Material.Outlined.Save"
                                        OnClick="SaveEditAsync" Disabled="_busy">
                                Save
                            </AMISButton>
                            <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                        OnClick="CancelEdit" Disabled="_busy">
                                Cancel
                            </AMISButton>
                        }
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudItem>
    }

    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No PPEIR form series registered yet.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th class="text-right">Start No.</th>
                                <th class="text-right">End No.</th>
                                <th class="text-right">Next No.</th>
                                <th class="text-right">Remaining</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _items)
                            {
                                <tr>
                                    <td class="text-right">@s.StartSerial</td>
                                    <td class="text-right">@s.EndSerial</td>
                                    <td class="text-right">@(s.IsExhausted ? "—" : s.NextSerial.ToString())</td>
                                    <td class="text-right">@s.Remaining</td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                                        }
                                        else if (s.IsExhausted)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Exhausted</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Inactive</MudChip>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @if (!s.IsActive && !s.IsExhausted && _canCreate)
                                            {
                                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                                            OnClick="@(() => ActivateAsync(s.Id))" Disabled="_busy">
                                                    Set Active
                                                </AMISButton>
                                            }
                                            else if (s.IsActive && _canCreate)
                                            {
                                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                                            OnClick="@(() => DeactivateAsync(s.Id))" Disabled="_busy">
                                                    Deactivate
                                                </AMISButton>
                                            }
                                            @if (s.IsUnused && !s.IsActive && _canCreate)
                                            {
                                                <AMISIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                                Icon="@Icons.Material.Outlined.Edit"
                                                                OnClick="@(() => BeginEdit(s))" Disabled="_busy"
                                                                Title="Edit" />
                                            }
                                            @if (s.IsUnused && !s.IsActive && _canDelete)
                                            {
                                                <AMISIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                                Icon="@Icons.Material.Outlined.Delete"
                                                                OnClick="@(() => DeleteAsync(s))" Disabled="_busy"
                                                                Title="Delete" />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudPagination Count="@TotalPages" Selected="_page" ShowFirstButton="true" ShowLastButton="true"
                                   SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _busy;
    private int _startSerial = 1;
    private int _endSerial = 100;
    private Guid? _editingId;
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private int TotalPages => (int)Math.Ceiling(_totalCount / (double)PageSize);
    private List<ArPPEIRFormSeriesDto> _items = [];

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Issuance.Create);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Issuance.Update);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var resp = await Client.SearchSeriesAsync(page: _page, pageSize: PageSize);
            _items = resp.Items.ToList();
            _totalCount = resp.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        if (_endSerial < _startSerial) { Snackbar.Add("End No. must be ≥ Start No.", Severity.Warning); return; }

        _busy = true;
        try
        {
            await Client.CreateSeriesAsync(new CreateArPPEIRFormSeriesRequest(_startSerial, _endSerial));
            Snackbar.Add("Series registered.", Severity.Success);
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private void BeginEdit(ArPPEIRFormSeriesDto s)
    {
        _editingId = s.Id;
        _startSerial = s.StartSerial;
        _endSerial = s.EndSerial;
    }

    private void CancelEdit() => ResetForm();

    private async Task SaveEditAsync()
    {
        if (_editingId is null) return;
        if (_endSerial < _startSerial) { Snackbar.Add("End No. must be ≥ Start No.", Severity.Warning); return; }

        _busy = true;
        try
        {
            await Client.UpdateSeriesAsync(_editingId.Value,
                new UpdateArPPEIRFormSeriesRequest(_startSerial, _endSerial));
            Snackbar.Add("Series updated.", Severity.Success);
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(ArPPEIRFormSeriesDto s)
    {
        var ok = await DialogService.ShowConfirmAsync(
            "Delete Confirmation",
            $"Delete series (range {s.StartSerial}–{s.EndSerial})? This action cannot be undone.",
            confirmText: "Delete", cancelText: "Cancel",
            confirmColor: Color.Error,
            icon: Icons.Material.Outlined.DeleteForever, iconColor: Color.Error);
        if (!ok) return;

        _busy = true;
        try
        {
            await Client.DeleteSeriesAsync(s.Id);
            Snackbar.Add("Series deleted.", Severity.Success);
            if (_editingId == s.Id) ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private void ResetForm()
    {
        _editingId = null;
        _startSerial = 1;
        _endSerial = 100;
    }

    private async Task ActivateAsync(Guid id)
    {
        _busy = true;
        try
        {
            await Client.ActivateSeriesAsync(id);
            Snackbar.Add("Series set as active.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeactivateAsync(Guid id)
    {
        _busy = true;
        try
        {
            await Client.DeactivateSeriesAsync(id);
            Snackbar.Add("Series deactivated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }
}
