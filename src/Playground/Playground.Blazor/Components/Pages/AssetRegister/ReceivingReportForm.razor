@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.v1.Catalog
@using AMIS.Modules.MasterData.Contracts.v1.CapitalizationThresholds
@using Microsoft.AspNetCore.Components.Authorization
@using ReceivingDocumentKind = AMIS.Modules.AssetRegister.Contracts.v1.ReceivingDocumentKind
@using ReceiptType = AMIS.Modules.AssetRegister.Contracts.v1.ReceiptType
@using System.Security.Claims
@inject IArReceivingReportClient Client
@inject IArReceivingReportClient ArReceivingReportClient
@inject IArCatalogClient CatalogClient
@inject ICapitalizationThresholdState ThresholdState
@inject ILookupClient LookupClient
@inject IEmployeesClient EmployeesClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (DocumentKind == ReceivingDocumentKind.PPERR)
        {
            @if (_activeSeries is not null && !_activeSeries.IsExhausted)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Outlined.Tag">
                    Next form no. will be <strong>PPERR-@_activeSeries.NextSerial.ToString($"D{_activeSeries.EndSerial.ToString().Length}")</strong>
                    &nbsp;·&nbsp; @_activeSeries.Remaining remaining in series "<em>@_activeSeries.Label</em>"
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Outlined.Warning">
                    No active PPERR form series. The report number will be auto-generated.
                    <MudLink Href="/asset-register/pperr-series" Class="ml-1">Manage Series</MudLink>
                </MudAlert>
            }
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_date" Label="Date" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect @bind-Value="_receiptType" Label="Type" Variant="Variant.Outlined" T="ReceiptType" Required="true">
                    <MudSelectItem T="ReceiptType" Value="@ReceiptType.Purchase">Purchase</MudSelectItem>
                    <MudSelectItem T="ReceiptType" Value="@ReceiptType.Transfer">Transfer</MudSelectItem>
                    <MudSelectItem T="ReceiptType" Value="@ReceiptType.Donation">Donation</MudSelectItem>
                    <MudSelectItem T="ReceiptType" Value="@ReceiptType.Other">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_receiptType == ReceiptType.Other)
            {
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_otherReceiptType" Label="Specify Other" Variant="Variant.Outlined" Required="true" />
                </MudItem>
            }
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_fundCluster" Label="Fund Cluster" Variant="Variant.Outlined" />
            </MudItem>
            @if (_receiptType == ReceiptType.Purchase)
            {
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="SupplierInfo" Value="_selectedSupplier"
                                     ValueChanged="@(async s => await OnSupplierSelectedAsync(s))"
                                     Label="Received From (Supplier)" Variant="Variant.Outlined"
                                     SearchFunc="SearchSuppliersAsync"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     CoerceText="false" Required="true"
                                     HelperText="Search supplier from accepted IARs" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_address" Label="Address" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_receivedFrom" Label="Received From (Source Office / Donor / Agency)"
                                  Variant="Variant.Outlined" Required="true"
                                  HelperText="e.g. 'NFA Region V' or 'Department of Agriculture' or donor name" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_address" Label="Address" Variant="Variant.Outlined"
                                  HelperText="Source office address (optional)" />
                </MudItem>
            }
            <MudItem xs="12" md="6">
                <MudTextField Value="@(_receivedBy is null ? "Loading..." : FormatEmployee(_receivedBy))"
                              Label="Received By" Variant="Variant.Outlined" ReadOnly="true"
                              HelperText="Auto-assigned to the currently logged-in user" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="EmployeeReferenceDto" @bind-Value="_notedBy" Label="Noted By (Head of Office)" Variant="Variant.Outlined"
                                 SearchFunc="SearchEmployeesAsync" ToStringFunc="FormatEmployee"
                                 CoerceText="false" />
            </MudItem>
            @if (DocumentKind == ReceivingDocumentKind.SMRR)
            {
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_dateReceived" Label="Date Received" Variant="Variant.Outlined" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">Items</MudText>
            </MudItem>

            @if (_receiptType == ReceiptType.Purchase)
            {
                @* ─── From Accepted IAR (purchases) ──────────────────────────────────── *@
                @if (_loadingItems)
                {
                    <MudItem xs="12">
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    </MudItem>
                }
                else if (_availableItems.Count > 0)
                {
                    <MudItem xs="12">
                        <MudTable T="AcceptedIARLineItemDto" Items="_availableItems"
                                  MultiSelection="true" @bind-SelectedItems="_selectedItems"
                                  Dense="true" Hover="true" Elevation="0"
                                  Style="background: var(--mud-palette-surface);">
                            <HeaderContent>
                                <MudTh>Property No</MudTh>
                                <MudTh>Description</MudTh>
                                <MudTh>Date Acquired</MudTh>
                                <MudTh Style="text-align:right">Unit Cost</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Property No"><MudText Typo="Typo.body2">@context.StockPropertyNo</MudText></MudTd>
                                <MudTd DataLabel="Description">
                                    <MudText Typo="Typo.body2">@context.Description</MudText>
                                    @{
                                        var mismatch = LineMismatchMessage(context.UnitCost);
                                    }
                                    @if (!string.IsNullOrEmpty(mismatch))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Class="mt-1">
                                            @mismatch
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Date Acquired"><MudText Typo="Typo.body2">@context.IARDate.ToString("yyyy-MM-dd")</MudText></MudTd>
                                <MudTd DataLabel="Unit Cost" Style="text-align:right"><MudText Typo="Typo.body2">@context.UnitCost.ToString("N2")</MudText></MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                            @_selectedItems.Count of @_availableItems.Count item(s) selected
                        </MudText>
                    </MudItem>
                }
                else if (_selectedSupplier is not null && !_loadingItems)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            No accepted IAR items found for this supplier.
                        </MudText>
                    </MudItem>
                }
            }
            else
            {
                @* ─── Ad-hoc lines (donations, transfers, other) ──────────────────────── *@
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        Lines come from a <b>@_receiptType</b> source (no internal IAR). Capture the
                        originating office/agency and the source document reference on each line so
                        depreciation and the audit trail remain continuous.
                    </MudAlert>
                </MudItem>
                @for (var i = 0; i < _adhocLines.Count; i++)
                {
                    var idx = i;
                    var line = _adhocLines[idx];
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Item @(idx + 1)</MudText>
                                <MudSpacer />
                                @if (_adhocLines.Count > 1)
                                {
                                    <AMISIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Error"
                                                    OnClick="@(() => _adhocLines.RemoveAt(idx))" />
                                }
                            </MudStack>
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudAutocomplete T="ArCatalogItemDto"
                                                         Value="line.SelectedCatalog"
                                                         ValueChanged="@(c => OnAdhocCatalogSelected(idx, c))"
                                                         Text="@line.Description"
                                                         TextChanged="@(t => OnAdhocDescriptionChanged(idx, t))"
                                                         SearchFunc="SearchCatalogAsync"
                                                         ToStringFunc="@(c => c?.Description ?? string.Empty)"
                                                         Label="Description *"
                                                         Variant="Variant.Outlined"
                                                         Dense="true"
                                                         Margin="Margin.Dense"
                                                         CoerceValue="false" CoerceText="false"
                                                         ResetValueOnEmptyText="false"
                                                         MinCharacters="0"
                                                         Clearable="true"
                                                         Class="flex-grow-1" />
                                        <MudTooltip Text="Create a new catalog item from this description">
                                            <AMISIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                            Color="Color.Primary" Size="Size.Small"
                                                            OnClick="@(async () => await OpenAdhocCreateCatalogAsync(idx))" />
                                        </MudTooltip>
                                    </MudStack>
                                    @if (line.SelectedCatalog is not null)
                                    {
                                        <MudStack Row="true" Spacing="1" Class="mt-1">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Inventory2">
                                                @line.SelectedCatalog.Code
                                            </MudChip>
                                            @if (line.SelectedCatalog.Status == CatalogItemStatus.Draft)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassEmpty">
                                                    Draft — cannot be received until Accountant assigns UACS on a PR
                                                </MudChip>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(line.SelectedCatalog.UacsObjectCode))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.AccountBalance">
                                                    UACS @line.SelectedCatalog.UacsObjectCode
                                                </MudChip>
                                            }
                                        </MudStack>
                                    }
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudNumericField @bind-Value="line.UnitCost" Label="Original Cost *"
                                                     Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="0.01m" />
                                    @{
                                        var adhocMismatch = LineMismatchMessage(line.UnitCost);
                                    }
                                    @if (!string.IsNullOrEmpty(adhocMismatch))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Class="mt-1">
                                            @adhocMismatch
                                        </MudChip>
                                    }
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudDatePicker @bind-Date="line.OriginalAcquisitionDate"
                                                   Label="Original Acquisition Date *"
                                                   Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                   HelperText="Source-agency books — used for depreciation timeline" />
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudTextField @bind-Value="line.PropertyNo" Label="New Property No *"
                                                  Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                  MaxLength="32"
                                                  HelperText="Issued by receiving agency on its own books" />
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudTextField @bind-Value="line.SourcePropertyNo" Label="Source PropertyNo"
                                                  Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                  MaxLength="64"
                                                  HelperText="From the originating agency's books" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="line.SourceDocumentRef"
                                                  Label="Source Document Reference *"
                                                  Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                  MaxLength="200"
                                                  HelperText="e.g. PPEIR-2026-0123 dated 2026-04-15, PTR-..., Deed of Donation No. ..." />
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudTextField @bind-Value="line.SerialNo" Label="Serial No" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudTextField @bind-Value="line.Brand" Label="Brand" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudTextField @bind-Value="line.Model" Label="Model" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                }
                <MudItem xs="12">
                    <AMISButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Size="Size.Small"
                            OnClick="AddAdhocLine" Color="Color.Primary">Add Item</AMISButton>
                </MudItem>
            }

            <MudItem xs="12" Class="d-flex justify-end">
                <AMISButton OnClick="OnCancel" Variant="Variant.Text" Color="Color.Default" Class="mr-2">Cancel</AMISButton>
                <AMISButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Success"
                            Disabled="_busy" StartIcon="@Icons.Material.Outlined.Save">
                    @(_busy ? "Saving..." : "Save")
                </AMISButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public ReceivingDocumentKind DocumentKind { get; set; }
    [Parameter] public string Title { get; set; } = "Create Receiving Report";
    [Parameter] public EventCallback<ArReceivingReportDto> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private sealed record SupplierInfo(string Name, string? Address);

    private DateTime? _date = DateTime.Today;
    private ReceiptType _receiptType;
    private string? _otherReceiptType;
    private string? _fundCluster;
    private string _receivedFrom = string.Empty;
    private string? _address;
    private EmployeeReferenceDto? _receivedBy;
    private EmployeeReferenceDto? _notedBy;
    private DateTime? _dateReceived;
    private bool _busy;
    private bool _loadingItems;
    private ArPPERRFormSeriesDto? _activeSeries;

    private SupplierInfo? _selectedSupplier;
    private readonly List<AcceptedIARLineItemDto> _availableItems = [];
    private HashSet<AcceptedIARLineItemDto> _selectedItems = [];

    // Ad-hoc lines path — used when ReceiptType != Purchase (donations, transfers, other).
    private readonly List<AdhocLine> _adhocLines = [new()];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var identityUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrWhiteSpace(identityUserId))
                _receivedBy = await EmployeesClient.ByIdentityAsync(identityUserId);
        }
        catch
        {
            Snackbar.Add("Could not load current user employee record.", Severity.Warning);
        }

        if (DocumentKind == ReceivingDocumentKind.PPERR)
        {
            try { _activeSeries = await Client.GetActiveSeriesAsync(); }
            catch { /* non-critical */ }
        }

        await ThresholdState.EnsureLoadedAsync();
    }

    private string LineMismatchMessage(decimal unitCost)
    {
        if (ThresholdState.Threshold is not { } threshold || unitCost <= 0) return string.Empty;
        var cap = threshold.CapitalizationAmount;
        return DocumentKind switch
        {
            ReceivingDocumentKind.PPERR when !threshold.IsCapitalAsset(unitCost) =>
                $"Below capitalization cutoff ({Money.Symbol}{cap:N2}) — should be SMRR.",
            ReceivingDocumentKind.SMRR when threshold.IsCapitalAsset(unitCost) =>
                $"At/above capitalization cutoff ({Money.Symbol}{cap:N2}) — should be PPERR.",
            _ => string.Empty
        };
    }

    private static string FormatEmployee(EmployeeReferenceDto? e) =>
        e is null ? string.Empty : $"{e.LastName}, {e.FirstName} ({e.EmployeeNumber})";

    private static string PrintedName(EmployeeReferenceDto e) => $"{e.FirstName} {e.LastName}".Trim();

    private async Task<IEnumerable<SupplierInfo>> SearchSuppliersAsync(string value, CancellationToken ct)
    {
        try
        {
            var res = await ArReceivingReportClient.SearchAcceptedIARItemsAsync(value, page: 1, pageSize: 100, ct: ct);
            return (res?.Items ?? [])
                .GroupBy(x => x.SupplierName, StringComparer.OrdinalIgnoreCase)
                .Select(g => new SupplierInfo(g.Key, g.First().SupplierAddress))
                .ToList();
        }
        catch { return []; }
    }

    private async Task OnSupplierSelectedAsync(SupplierInfo? supplier)
    {
        _selectedSupplier = supplier;
        _availableItems.Clear();
        _selectedItems = [];

        if (supplier is null) return;

        _receivedFrom = supplier.Name;
        _address = supplier.Address;

        _loadingItems = true;
        try
        {
            var res = await ArReceivingReportClient.SearchAcceptedIARItemsAsync(
                supplier.Name, page: 1, pageSize: 200);
            _availableItems.AddRange(res?.Items ?? []);
        }
        catch
        {
            Snackbar.Add("Failed to load IAR items for this supplier.", Severity.Error);
        }
        finally { _loadingItems = false; }
    }

    private async Task<IEnumerable<EmployeeReferenceDto>> SearchEmployeesAsync(string value, CancellationToken ct)
    {
        try
        {
            var result = await LookupClient.EmployeesGetAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                isActive: true, pageNumber: 1, pageSize: 20, cancellationToken: ct);
            return result?.Items ?? [];
        }
        catch { return []; }
    }

    private async Task SaveAsync()
    {
        if (_date is null)
        {
            Snackbar.Add("Date is required.", Severity.Warning);
            return;
        }
        if (_receivedBy is null)
        {
            Snackbar.Add("Could not determine the current user. Please refresh and try again.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_receivedFrom))
        {
            Snackbar.Add("Received From is required.", Severity.Warning);
            return;
        }

        List<CreateReceivingReportItemRequest> lineRequests;
        if (_receiptType == ReceiptType.Purchase)
        {
            if (_selectedItems.Count == 0)
            {
                Snackbar.Add("Select at least one IAR item to register.", Severity.Warning);
                return;
            }
            lineRequests = _selectedItems.Select(item => new CreateReceivingReportItemRequest(
                CatalogItemId: item.CatalogItemId,
                Reference: item.IARNumber,
                Description: item.Description,
                AcquisitionDate: item.IARDate,
                UnitCost: item.UnitCost,
                PropertyNo: item.StockPropertyNo!,
                SerialNo: item.SerialNo,
                Brand: item.Brand,
                Model: item.Model,
                SourceIARId: item.IARId,
                PropertyClassHint: item.PropertyClassHint,
                UacsObjectCode: item.UacsObjectCode)).ToList();
        }
        else
        {
            var filled = _adhocLines.Where(l => !string.IsNullOrWhiteSpace(l.Description)).ToList();
            if (filled.Count == 0)
            {
                Snackbar.Add("Add at least one line item with a description.", Severity.Warning);
                return;
            }
            var missingCatalog = filled.Where(l => l.SelectedCatalog is null).ToList();
            if (missingCatalog.Count > 0)
            {
                Snackbar.Add($"Pick or create a catalog item on {missingCatalog.Count} line(s).", Severity.Warning);
                return;
            }
            var missingPropertyNo = filled.Where(l => string.IsNullOrWhiteSpace(l.PropertyNo)).ToList();
            if (missingPropertyNo.Count > 0)
            {
                Snackbar.Add($"Assign a new PropertyNo on {missingPropertyNo.Count} line(s).", Severity.Warning);
                return;
            }
            var missingSourceDoc = filled.Where(l => string.IsNullOrWhiteSpace(l.SourceDocumentRef)).ToList();
            if (missingSourceDoc.Count > 0)
            {
                Snackbar.Add($"Source Document Reference is required on {missingSourceDoc.Count} line(s).", Severity.Warning);
                return;
            }
            var missingOrigDate = filled.Where(l => l.OriginalAcquisitionDate is null).ToList();
            if (missingOrigDate.Count > 0)
            {
                Snackbar.Add($"Original Acquisition Date is required on {missingOrigDate.Count} line(s).", Severity.Warning);
                return;
            }

            lineRequests = filled.Select(l => new CreateReceivingReportItemRequest(
                CatalogItemId: l.SelectedCatalog!.Id,
                Reference: l.SourceDocumentRef,
                Description: l.Description,
                AcquisitionDate: DateOnly.FromDateTime(_date!.Value),
                UnitCost: l.UnitCost,
                PropertyNo: l.PropertyNo!,
                SerialNo: l.SerialNo,
                Brand: l.Brand,
                Model: l.Model,
                SourceIARId: null,
                PropertyClassHint: null,
                UacsObjectCode: l.SelectedCatalog.UacsObjectCode,
                SourceAgencyName: _receivedFrom,
                SourcePropertyNo: l.SourcePropertyNo,
                SourceDocumentRef: l.SourceDocumentRef,
                OriginalAcquisitionDate: DateOnly.FromDateTime(l.OriginalAcquisitionDate!.Value))).ToList();
        }

        _busy = true;
        try
        {
            var request = new CreateReceivingReportRequest(
                DocumentKind,
                DateOnly.FromDateTime(_date.Value),
                _receivedFrom,
                _address,
                _receiptType,
                _receiptType == ReceiptType.Other ? _otherReceiptType : null,
                _fundCluster,
                new ArEmployeeRefDto(_receivedBy.Id, PrintedName(_receivedBy), _receivedBy.PositionName),
                _notedBy is null ? null : new ArEmployeeRefDto(_notedBy.Id, PrintedName(_notedBy), _notedBy.PositionName),
                _dateReceived is null ? null : DateOnly.FromDateTime(_dateReceived.Value),
                lineRequests);

            var created = await Client.CreateAsync(request);
            await OnCreated.InvokeAsync(created);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    // ── Ad-hoc lines helpers ───────────────────────────────────────────────

    private void AddAdhocLine() => _adhocLines.Add(new AdhocLine());

    private async Task<IEnumerable<ArCatalogItemDto>> SearchCatalogAsync(string value, CancellationToken ct)
    {
        try
        {
            var page = await CatalogClient.SearchAsync(keyword: value, isActive: true, page: 1, pageSize: 30, ct: ct);
            return page.Items ?? [];
        }
        catch { return []; }
    }

    private void OnAdhocCatalogSelected(int idx, ArCatalogItemDto? c)
    {
        var line = _adhocLines[idx];
        line.SelectedCatalog = c;
        if (c is not null)
            line.Description = c.Description;
    }

    private void OnAdhocDescriptionChanged(int idx, string? text)
    {
        var line = _adhocLines[idx];
        line.Description = text ?? string.Empty;
        if (line.SelectedCatalog is not null &&
            !string.Equals(line.SelectedCatalog.Description, line.Description, StringComparison.OrdinalIgnoreCase))
        {
            line.SelectedCatalog = null;
        }
    }

    private async Task OpenAdhocCreateCatalogAsync(int idx)
    {
        var line = _adhocLines[idx];
        var parameters = new DialogParameters<AMIS.Playground.Blazor.Components.Pages.Procurement.CreateCatalogItemDialog>
        {
            { x => x.InitialDescription, line.Description }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AMIS.Playground.Blazor.Components.Pages.Procurement.CreateCatalogItemDialog>(
            "Create Catalog Item", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ArCatalogItemDto created)
            return;

        OnAdhocCatalogSelected(idx, created);
    }

    private sealed class AdhocLine
    {
        public ArCatalogItemDto? SelectedCatalog { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal UnitCost { get; set; }
        public DateTime? OriginalAcquisitionDate { get; set; }
        public string? PropertyNo { get; set; }
        public string? SourcePropertyNo { get; set; }
        public string? SourceDocumentRef { get; set; }
        public string? SerialNo { get; set; }
        public string? Brand { get; set; }
        public string? Model { get; set; }
    }
}
