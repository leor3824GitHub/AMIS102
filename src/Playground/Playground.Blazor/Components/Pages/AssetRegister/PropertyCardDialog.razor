@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Modules.AssetRegister.Contracts.v1.Reports
@inject IArDepreciationClient Client

<MudDialog>
    <DialogContent>
        <div style="min-width:620px;">
            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_card is null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No property card available for @PropertyNo.</MudAlert>
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Property No.</MudText><MudText Typo="Typo.body2"><strong>@_card.PropertyNo</strong></MudText></MudItem>
                    <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText><MudText Typo="Typo.body2">@_card.Description</MudText></MudItem>
                    <MudItem xs="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Current State</MudText><MudText Typo="Typo.body2">@_card.CurrentState</MudText></MudItem>
                </MudGrid>

                <MudTable Items="_card.Movements" Dense="true" Hover="true" Striped="true" T="PropertyCardRowDto" FixedHeader="true" Height="360px">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Movement</MudTh>
                        <MudTh>Source</MudTh>
                        <MudTh>Document</MudTh>
                        <MudTh>Party</MudTh>
                        <MudTh Style="text-align:right">Amount (@Money.Symbol)</MudTh>
                        <MudTh>Remarks</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.MovementType</MudChip></MudTd>
                        <MudTd>@context.Source</MudTd>
                        <MudTd>@(context.DocumentNo ?? "—")</MudTd>
                        <MudTd>@(context.Party ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@(context.Amount.HasValue ? context.Amount.Value.ToString("N2") : "—")</MudTd>
                        <MudTd>@(context.Remarks ?? "")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">No movements recorded for this asset.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => MudDialog.Close())">Close</AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string PropertyNo { get; set; } = "";

    private bool _busy = true;
    private PropertyCardDto? _card;

    protected override async Task OnInitializedAsync()
    {
        try { _card = await Client.GetPropertyCardAsync(PropertyNo); }
        finally { _busy = false; }
    }
}
