@using AMIS.Playground.Blazor.ApiClient
@using ArContracts = AMIS.Modules.AssetRegister.Contracts.v1
@inject IAssetRegistryClient AssetClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width:560px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Showing <strong>Available</strong> @(AssetType == ArContracts.AssetType.SE ? "Semi-Expendable" : "PPE") assets eligible for issuance. Tick the items to add, then choose <strong>Add</strong>.
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_keyword" Label="Keyword / Property No." Variant="Variant.Outlined"
                              Dense="true" Margin="Margin.Dense" Class="flex-grow-1"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                              OnKeyDown="OnSearchKeyDown" Immediate="false" />
                <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Outlined.Search" OnClick="SearchAsync" Disabled="_busy">
                    Search
                </AMISButton>
            </MudStack>

            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            else
            {
                <MudTable Items="_items" Dense="true" Hover="true" Striped="true" T="AssetRegistrySummaryDto">
                    <HeaderContent>
                        <MudTh Style="width:48px"></MudTh>
                        <MudTh>Property No.</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Condition</MudTh>
                        <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var disabled = ExcludeIds.Contains(context.Id);
                        }
                        <MudTd>
                            <MudCheckBox T="bool" Dense="true" Disabled="disabled"
                                         Value="@(_selected.ContainsKey(context.Id) || disabled)"
                                         ValueChanged="@((bool v) => Toggle(context, v))" />
                        </MudTd>
                        <MudTd>
                            <strong>@context.PropertyNo</strong>
                            @if (disabled)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">(already added)</MudText>
                            }
                        </MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd>@context.CurrentCondition</MudTd>
                        <MudTd Style="text-align:right">@context.UnitCost.ToString("N2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">No available assets found.</MudText>
                    </NoRecordsContent>
                </MudTable>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.caption">Page @_page of @_totalPages (@_totalCount total)</MudText>
                    <MudStack Row="true" Spacing="1">
                        <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                        Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                        <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                        Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <AMISButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</AMISButton>
        <AMISButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSelected" Disabled="_selected.Count == 0">
            Add @(_selected.Count > 0 ? $"{_selected.Count} item(s)" : "items")
        </AMISButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ArContracts.AssetType AssetType { get; set; }
    [Parameter] public IReadOnlyCollection<Guid> ExcludeIds { get; set; } = [];

    private bool _busy;
    private string? _error;
    private string? _keyword;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 10;
    private IReadOnlyList<AssetRegistrySummaryDto> _items = [];
    private readonly Dictionary<Guid, AssetRegistrySummaryDto> _selected = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await AssetClient.SearchAsync(
                keyword: string.IsNullOrWhiteSpace(_keyword) ? null : _keyword,
                assetType: AssetType,
                lifecycleState: ArContracts.LifecycleState.Available,
                page: _page,
                pageSize: PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private void Toggle(AssetRegistrySummaryDto item, bool selected)
    {
        if (ExcludeIds.Contains(item.Id)) return;
        if (selected) _selected[item.Id] = item;
        else _selected.Remove(item.Id);
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private void AddSelected() => MudDialog.Close(DialogResult.Ok(_selected.Values.ToList()));
    private void Cancel() => MudDialog.Cancel();
}
