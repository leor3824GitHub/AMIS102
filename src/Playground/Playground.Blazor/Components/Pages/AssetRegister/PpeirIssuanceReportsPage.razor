@page "/asset-register/issuance/ppeir"
@implements IDisposable
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Playground.Blazor.Components.Pages.Procurement
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Modules.AssetRegister.Contracts.v1.SignedDocuments
@using IssuanceReportType = AMIS.Modules.AssetRegister.Contracts.v1.IssuanceReportType
@using IssuanceNature = AMIS.Modules.AssetRegister.Contracts.v1.IssuanceNature
@inject IArIssuanceReportClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="PPE Issuance Reports (PPEIR)"
               Description="Record the issuance/transfer of property, plant &amp; equipment. Each report is an atomic transfer document — the listed assets are permanently transferred out of this office upon creation." />

<MudGrid Spacing="3">
    <!-- Filters -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Report No. / Keyword" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                        Search
                    </AMISButton>
                    @if (_canCreate)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.Add" OnClick="ToggleCreateForm">
                            New PPEIR
                        </AMISButton>
                    }
                </MudStack>

                <AMISEnumChips TEnum="IssuanceNature" Value="_natureFilter" ValueChanged="OnNatureChanged"
                               Label="Nature" Class="mt-3" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Create Form -->
    @if (_showCreateForm)
    {
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h6">Create PPEIR (PPE Issuance Report)</MudText></CardHeaderContent>
                    <CardHeaderActions>
                        <AMISIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="@(() => _showCreateForm = false)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <!-- Header fields -->
                        <MudItem xs="12" md="4">
                            <MudSelect @bind-Value="_createForm.Nature" Label="Nature of Issuance" Variant="Variant.Outlined"
                                       T="IssuanceNature" Required="true" Dense="true" Margin="Margin.Dense">
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferCO">Transfer to C.O.</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferRO">Transfer to R.O.</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.TransferPO">Transfer to P.O.</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Donation">Donation</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Dumping">Dumping</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Destruction">Destruction</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Sale">Sale</MudSelectItem>
                                <MudSelectItem T="IssuanceNature" Value="@IssuanceNature.Others">Others</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_createForm.FundCluster" Label="Fund Cluster" Variant="Variant.Outlined"
                                          MaxLength="50" Required="true" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_createForm.DateNullable" Label="Date" Variant="Variant.Outlined"
                                           DateFormat="MM/dd/yyyy" Required="true" Dense="true" />
                        </MudItem>
                        <!-- Office address (full width) -->
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_createForm.IssuedToOfficeAddress" Label="Issued To — Office/Address" Variant="Variant.Outlined"
                                          MaxLength="500" Required="true" Dense="true" Margin="Margin.Dense" />
                        </MudItem>

                        <!-- Officers row -->
                        <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mt-1">Signatories</MudText></MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.IssuedByName" Label="Issued By (Name)" Variant="Variant.Outlined"
                                          MaxLength="200" Required="true" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.IssuedByDesignation" Label="Issued By (Designation)" Variant="Variant.Outlined"
                                          MaxLength="200" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.ApprovedByName" Label="Approved By (Name)" Variant="Variant.Outlined"
                                          MaxLength="200" Required="true" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.ApprovedByDesignation" Label="Approved By (Designation)" Variant="Variant.Outlined"
                                          MaxLength="200" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.IssuedToName" Label="Issued To (Name)" Variant="Variant.Outlined"
                                          MaxLength="200" Required="true" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_createForm.IssuedToDesignation" Label="Issued To (Designation)" Variant="Variant.Outlined"
                                          MaxLength="200" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_createForm.Remarks" Label="Remarks (optional)" Variant="Variant.Outlined"
                                          MaxLength="1000" Lines="2" Dense="true" Margin="Margin.Dense" />
                        </MudItem>

                        <!-- Asset selection -->
                        <MudItem xs="12">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                <MudText Typo="Typo.subtitle2">
                                    PPE Assets to Transfer
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">
                                        — only Available PPE assets (no active PAR) may be issued
                                    </MudText>
                                </MudText>
                                <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Outlined.Search"
                                            OnClick="BrowseAssetsAsync">
                                    Browse Assets…
                                </AMISButton>
                            </MudStack>
                        </MudItem>

                        @if (_createForm.SelectedAssets.Count > 0)
                        {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="mb-1">@_createForm.SelectedAssets.Count asset(s) selected:</MudText>
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Property No.</th>
                                        <th>Description</th>
                                        <th class="text-right">Unit Cost (@Money.Symbol)</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in _createForm.SelectedAssets)
                                    {
                                        <tr>
                                            <td><strong>@asset.PropertyNo</strong></td>
                                            <td>@asset.Description</td>
                                            <td class="text-right">@asset.UnitCost.ToString("N2")</td>
                                            <td>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => _createForm.SelectedAssets.Remove(asset))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudItem>
                        }

                        <MudItem xs="12">
                            <AMISButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                        OnClick="CreateAsync" Disabled="@(_busy || _createForm.SelectedAssets.Count == 0)">
                                Create PPEIR — Transfer Assets Out
                            </AMISButton>
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                This action is irreversible. Assets will be permanently transferred out of this office.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

    <!-- Results -->
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No PPEIR yet.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>PPEIR No.</th>
                                <th>Date</th>
                                <th>Nature</th>
                                <th>Lines</th>
                                <th class="text-right">Total Amount (@Money.Symbol)</th>
                                <th class="text-right"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _items)
                            {
                                <tr>
                                    <td><b>@r.ReportNo</b></td>
                                    <td>@r.Date.ToString("MM/dd/yyyy")</td>
                                    <td>@r.Nature</td>
                                    <td><MudChip T="string" Size="Size.Small" Color="Color.Secondary">@r.LineCount lines</MudChip></td>
                                    <td class="text-right">@r.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.FlexEnd">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                            Color="Color.Primary" Title="View" OnClick="@(() => ViewAsync(r.Id))" />
                                            <MudMenu Icon="@Icons.Material.Filled.Print"
                                                     Color="Color.Secondary"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     AnchorOrigin="Origin.BottomLeft"
                                                     TransformOrigin="Origin.TopLeft"
                                                     ToolTip="Print PPEIR">
                                                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                             OnClick="@(() => DownloadFastReportPdfAsync(r.Id))">
                                                    Download PDF
                                                </MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Layers"
                                                             OnClick="@(() => PrintDataOnlyAsync(r.Id))">
                                                    Print – data only (pre-printed form)…
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                             OnClick="@(() => OpenFastReportSetupAsync(r.Id))">
                                                    Fast Report – Page Setup…
                                                </MudMenuItem>
                                            </MudMenu>
                                            @if (r.HasSignedCopy ? _canViewSigned : _canUploadSigned)
                                            {
                                                <AMISIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                                Color="@(r.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                                Title="@(r.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")"
                                                                OnClick="@(() => OpenSignedCopyAsync(r))" />
                                            }
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <MudText Typo="Typo.caption">Page @_page of @_totalPages (@_totalCount total)</MudText>
                        <MudStack Row="true" Spacing="1">
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                            Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                            Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                        </MudStack>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Detail panel -->
    @if (_selected is not null)
    {
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@_selected.ReportNo</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">PPEIR</MudChip>
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudStack Row="true" Spacing="1">
                            <MudTooltip Text="View report in Reports Workspace">
                                <MudIconButton Icon="@Icons.Material.Outlined.Preview" Size="Size.Small"
                                               Href="@($"/asset-register/reports?issuanceReportId={_selected.Id}")" />
                            </MudTooltip>
                            <AMISIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                            OnClick="@(() => _selected = null)" />
                        </MudStack>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-3">
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Date</MudText>
                            <MudText Typo="Typo.body2">@_selected.Date.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                            <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Nature</MudText>
                            <MudText Typo="Typo.body2">@_selected.Nature</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Issued To — Office/Address</MudText>
                            <MudText Typo="Typo.body2">@_selected.IssuedToOfficeAddress</MudText>
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Issued By</MudText>
                            <MudText Typo="Typo.body2">@_selected.IssuedBy.PrintedName</MudText>
                            @if (!string.IsNullOrWhiteSpace(_selected.IssuedBy.Designation))
                            {
                                <MudText Typo="Typo.caption">@_selected.IssuedBy.Designation</MudText>
                            }
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Approved By</MudText>
                            <MudText Typo="Typo.body2">@_selected.ApprovedBy.PrintedName</MudText>
                            @if (!string.IsNullOrWhiteSpace(_selected.ApprovedBy.Designation))
                            {
                                <MudText Typo="Typo.caption">@_selected.ApprovedBy.Designation</MudText>
                            }
                        </MudItem>
                        <MudItem xs="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Issued To</MudText>
                            <MudText Typo="Typo.body2">@_selected.IssuedTo.PrintedName</MudText>
                            @if (!string.IsNullOrWhiteSpace(_selected.IssuedTo.Designation))
                            {
                                <MudText Typo="Typo.caption">@_selected.IssuedTo.Designation</MudText>
                            }
                        </MudItem>
                        @if (!string.IsNullOrWhiteSpace(_selected.Remarks))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Remarks</MudText>
                                <MudText Typo="Typo.body2">@_selected.Remarks</MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Lines (@_selected.Lines.Count)</MudText>
                    <MudTable Items="_selected.Lines" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Property No.</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Unit</MudTh>
                            <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                            <MudTh Style="text-align:right">Amount (@Money.Symbol)</MudTh>
                            <MudTh Style="text-align:right">Accum. Depr.</MudTh>
                            <MudTh Style="text-align:right">Book Value</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ItemNo</MudTd>
                            <MudTd>@context.Snapshot.PropertyNo</MudTd>
                            <MudTd>@context.Snapshot.Description</MudTd>
                            <MudTd>@context.Snapshot.Unit</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotUnitCost.ToString("N2")</MudTd>
                            <MudTd Style="text-align:right">@context.SnapshotAmount.ToString("N2")</MudTd>
                            <MudTd Style="text-align:right">@(context.AccumulatedDepreciation?.ToString("N2") ?? "—")</MudTd>
                            <MudTd Style="text-align:right">@(context.BookValue?.ToString("N2") ?? "—")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private const IssuanceReportType PpeirReportType = IssuanceReportType.PPEIR;

    private bool _busy;
    private string? _error;
    private string? _keyword;
    private IssuanceNature? _natureFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 20;
    private List<ArIssuanceReportSummaryDto> _items = [];
    private ArIssuanceReportDto? _selected;
    private bool _showCreateForm;

    private CreateFormModel _createForm = new();

    private sealed class CreateFormModel
    {
        public IssuanceNature Nature { get; set; }
        public string FundCluster { get; set; } = "";
        public DateTime? DateNullable { get; set; } = DateTime.Today;
        public string IssuedByName { get; set; } = "";
        public string? IssuedByDesignation { get; set; }
        public Guid IssuedByEmployeeId { get; set; }
        public string ApprovedByName { get; set; } = "";
        public string? ApprovedByDesignation { get; set; }
        public string IssuedToName { get; set; } = "";
        public string? IssuedToDesignation { get; set; }
        public string IssuedToOfficeAddress { get; set; } = "";
        public string? Remarks { get; set; }
        public List<AssetRegistrySummaryDto> SelectedAssets { get; set; } = [];
    }

    private bool _canCreate      => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Issuance.Create);
    private bool _canViewSigned   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.View);
    private bool _canUploadSigned => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.Upload);

    // PPEIR is created atomically (the act of creating it issues the assets) — a document of record on existence.
    private async Task OpenSignedCopyAsync(ArIssuanceReportSummaryDto item)
    {
        // Fully-qualified: this page also imports the Procurement namespace, which has its own SignedCopyDialog.
        var parameters = new DialogParameters<AMIS.Playground.Blazor.Components.Pages.AssetRegister.SignedCopyDialog>
        {
            { x => x.DocumentType, AssetRegisterDocumentType.IssuanceReport },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.ReportNo) ? "(no report number)" : item.ReportNo },
            { x => x.IsTerminalState, true }
        };
        // Footer "Close" is the only exit (no header ×, no backdrop dismiss) so the upload result always reaches us.
        var options = new DialogOptions { CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AMIS.Playground.Blazor.Components.Pages.AssetRegister.SignedCopyDialog>("Signed Copy", parameters, options);
        var result = await dialog.Result;

        // A signed copy was just uploaded — flip the row's HasSignedCopy so the icon turns green
        // immediately, without waiting for the next server search (which computes it via EXISTS).
        if (result is { Canceled: false, Data: true })
        {
            _items = _items
                .Select(x => x.Id == item.Id ? x with { HasSignedCopy = true } : x)
                .ToList();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.SearchAsync(_keyword, PpeirReportType, _natureFilter, page: _page, pageSize: PageSize);
            _items = result.Items.ToList();
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ViewAsync(Guid id)
    {
        _busy = true;
        try
        {
            _selected = await Client.GetAsync(id);
            if (_selected is null) Snackbar.Add("Report not found.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        if (_showCreateForm)
        {
            _createForm = new CreateFormModel
            {
                IssuedByName = UserProfileState.EmployeeFullName,
                IssuedByDesignation = UserProfileState.EmployeePositionName,
                IssuedByEmployeeId = UserProfileState.EmployeeId,
                DateNullable = DateTime.Today
            };
        }
    }

    private async Task BrowseAssetsAsync()
    {
        var parameters = new DialogParameters<AvailableAssetsPickerDialog>
        {
            { x => x.AssetType, AMIS.Modules.AssetRegister.Contracts.v1.AssetType.PPE },
            { x => x.ExcludeIds, (IReadOnlyCollection<Guid>)_createForm.SelectedAssets.Select(a => a.Id).ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AvailableAssetsPickerDialog>("Available PPE Assets", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<AssetRegistrySummaryDto> picked || picked.Count == 0)
            return;

        foreach (var asset in picked.Where(a => _createForm.SelectedAssets.All(x => x.Id != a.Id)))
            _createForm.SelectedAssets.Add(asset);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_createForm.FundCluster) ||
            string.IsNullOrWhiteSpace(_createForm.IssuedByName) ||
            string.IsNullOrWhiteSpace(_createForm.ApprovedByName) ||
            string.IsNullOrWhiteSpace(_createForm.IssuedToName) ||
            string.IsNullOrWhiteSpace(_createForm.IssuedToOfficeAddress) ||
            !_createForm.DateNullable.HasValue)
        {
            Snackbar.Add("All required fields must be filled.", Severity.Warning);
            return;
        }

        if (_createForm.SelectedAssets.Count == 0)
        {
            Snackbar.Add("At least one asset must be selected.", Severity.Warning);
            return;
        }

        if (UserProfileState.EmployeeId == Guid.Empty)
        {
            Snackbar.Add("Your account is not linked to an employee record. Cannot prepare a report.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var req = new CreateIssuanceReportRequest(
                PpeirReportType,
                DateOnly.FromDateTime(_createForm.DateNullable.Value),
                _createForm.FundCluster,
                _createForm.Nature,
                new ArEmployeeRefDto(_createForm.IssuedByEmployeeId, _createForm.IssuedByName.Trim(), _createForm.IssuedByDesignation),
                new ArEmployeeRefDto(UserProfileState.EmployeeId, _createForm.ApprovedByName.Trim(), _createForm.ApprovedByDesignation),
                new ArEmployeeRefDto(Guid.Empty, _createForm.IssuedToName.Trim(), _createForm.IssuedToDesignation),
                _createForm.IssuedToOfficeAddress.Trim(),
                _createForm.Remarks?.Trim(),
                _createForm.SelectedAssets.Select(a => a.Id).ToList());

            _selected = await Client.CreateAsync(req);
            Snackbar.Add($"PPEIR {_selected.ReportNo} created. Assets transferred out.", Severity.Success);
            _showCreateForm = false;
            _createForm = new();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task OnNatureChanged(IssuanceNature? value) { _natureFilter = value; _page = 1; await LoadAsync(); }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private const string FastReportKey = "issuance-report";

    private async Task DownloadFastReportPdfAsync(Guid id)
    {
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await Client.GetFastReportPdfAsync(id,
                pageWidth: saved?.PaperSize ?? "longbond",
                orientation: saved?.Orientation ?? "portrait",
                minRows: saved?.MinRows,
                dataOnly: saved?.DataOnly,
                offsetX: saved?.OffsetX,
                offsetY: saved?.OffsetY);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private Task OpenFastReportSetupAsync(Guid id) => ShowFastReportSetupAsync(id, forceDataOnly: false);
    private Task PrintDataOnlyAsync(Guid id) => ShowFastReportSetupAsync(id, forceDataOnly: true);

    private async Task ShowFastReportSetupAsync(Guid id, bool forceDataOnly)
    {
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "longbond",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "portrait",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 1,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 12,
            [nameof(FastReportPageSetupDialog.SupportsDataOnlyOverlay)] = true,
            [nameof(FastReportPageSetupDialog.DataOnly)] = forceDataOnly || (saved?.DataOnly ?? false),
            [nameof(FastReportPageSetupDialog.OffsetX)] = saved?.OffsetX ?? 0d,
            [nameof(FastReportPageSetupDialog.OffsetY)] = saved?.OffsetY ?? 0d
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows, r.DataOnly, r.OffsetX, r.OffsetY));

        try
        {
            var bytes = await Client.GetFastReportPdfAsync(id, pageWidth: r.PaperSize, orientation: r.Orientation,
                minRows: r.MinRows, dataOnly: r.DataOnly, offsetX: r.OffsetX, offsetY: r.OffsetY);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }
}
