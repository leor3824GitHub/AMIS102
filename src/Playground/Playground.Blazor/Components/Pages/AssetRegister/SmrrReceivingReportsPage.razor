@page "/asset-register/receiving/smrr"
@implements IDisposable
@using AMIS.Playground.Blazor.ApiClient
@using AMIS.Playground.Blazor.Components.Pages.Procurement
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using ReceivingDocumentKind = AMIS.Modules.AssetRegister.Contracts.v1.ReceivingDocumentKind
@using ReceiptType = AMIS.Modules.AssetRegister.Contracts.v1.ReceiptType
@using AMIS.Modules.AssetRegister.Contracts.v1.SignedDocuments
@inject IArReceivingReportClient Client
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Supplies and Materials Receiving Reports (SMRR)"
               Description="Record receipt of supplies and semi-expendable materials. Each line materializes one or more AssetRegistry rows for accountability tracking." />

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_keyword" Label="Report No. / Received From" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                  OnKeyDown="OnSearchKeyDown" Immediate="false" Style="flex:1;" />
                    <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                        Search
                    </AMISButton>
                    @if (_canCreate)
                    {
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                    StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => _showCreateForm = !_showCreateForm)">
                            New SMRR
                        </AMISButton>
                    }
                </MudStack>

                <AMISEnumChips TEnum="ReceiptType" Value="_receiptTypeFilter" ValueChanged="OnReceiptTypeChanged"
                               Label="Type" Class="mt-3" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    @if (_showCreateForm)
    {
        <MudItem xs="12">
            <ReceivingReportForm DocumentKind="SmrrDocumentKind"
                                 Title="Create SMRR (Supplies and Materials Receiving Report)"
                                 OnCreated="OnCreatedAsync"
                                 OnCancel="@(() => _showCreateForm = false)" />
        </MudItem>
    }

    <MudItem xs="12">
        <MudCard Elevation="1">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No SMRR yet.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>SMRR No.</th>
                                <th>Date</th>
                                <th>Received From</th>
                                <th>Type</th>
                                <th>Lines</th>
                                <th class="text-right">Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _items)
                            {
                                <tr>
                                    <td><b>@r.ReportNo</b></td>
                                    <td>@r.Date.ToString("MM/dd/yyyy")</td>
                                    <td>@r.ReceivedFrom</td>
                                    <td>@ReceiptTypeLabel(r.ReceiptType)</td>
                                    <td><MudChip T="string" Size="Size.Small" Color="Color.Info">@r.ItemCount lines</MudChip></td>
                                    <td class="text-right">@r.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <AMISIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                        Color="Color.Primary" Title="View" OnClick="@(() => ViewAsync(r.Id))" />
                                        <MudMenu Icon="@Icons.Material.Filled.Print"
                                                 Color="Color.Secondary"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomLeft"
                                                 TransformOrigin="Origin.TopLeft"
                                                 ToolTip="Print">
                                            <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                         OnClick="@(() => PrintFastAsync(r.Id))">
                                                Download PDF
                                            </MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                         OnClick="@(() => OpenFastReportSetupAsync(r.Id))">
                                                Fast Report – Page Setup…
                                            </MudMenuItem>
                                        </MudMenu>
                                        @if (r.HasSignedCopy ? _canViewSigned : _canUploadSigned)
                                        {
                                            <AMISIconButton Icon="@Icons.Material.Filled.Draw" Size="Size.Small"
                                                            Color="@(r.HasSignedCopy ? Color.Success : Color.Secondary)"
                                                            Title="@(r.HasSignedCopy ? "Signed copy uploaded — click to view" : "Upload signed copy")"
                                                            OnClick="@(() => OpenSignedCopyAsync(r))" />
                                        }
                                        @if (_canDelete)
                                        {
                                            <AMISIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                            Color="Color.Error" Title="Delete" OnClick="@(() => DeleteAsync(r.Id, r.ReportNo))" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudPagination Count="@TotalPages" Selected="_page" ShowFirstButton="true" ShowLastButton="true"
                                   SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private const ReceivingDocumentKind SmrrDocumentKind = ReceivingDocumentKind.SMRR;
    private string? _keyword;
    private ReceiptType? _receiptTypeFilter;
    private bool _busy;
    private bool _showCreateForm;
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private int TotalPages => (int)Math.Ceiling(_totalCount / (double)PageSize);

    private List<ArReceivingReportSummaryDto> _items = [];

    private bool _canCreate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Receiving.Create);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Receiving.Delete);
    private bool _canViewSigned   => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.View);
    private bool _canUploadSigned => UserProfileState.Permissions.Contains(AssetRegisterPermissions.SignedDocuments.Upload);

    // SMRR is created atomically — a document of record on existence.
    private async Task OpenSignedCopyAsync(ArReceivingReportSummaryDto item)
    {
        // Fully-qualified: this page also imports the Procurement namespace, which has its own SignedCopyDialog.
        var parameters = new DialogParameters<AMIS.Playground.Blazor.Components.Pages.AssetRegister.SignedCopyDialog>
        {
            { x => x.DocumentType, AssetRegisterDocumentType.ReceivingReport },
            { x => x.DocumentId, item.Id },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(item.ReportNo) ? "(no report number)" : item.ReportNo },
            { x => x.IsTerminalState, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<AMIS.Playground.Blazor.Components.Pages.AssetRegister.SignedCopyDialog>("Signed Copy", parameters, options);
    }

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var resp = await Client.SearchAsync(_keyword, SmrrDocumentKind, _receiptTypeFilter,
                page: _page, pageSize: PageSize);
            _items = resp.Items.ToList();
            _totalCount = resp.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OnReceiptTypeChanged(ReceiptType? value) { _receiptTypeFilter = value; _page = 1; await LoadAsync(); }

    private async Task OnCreatedAsync(ArReceivingReportDto created)
    {
        _showCreateForm = false;
        Snackbar.Add($"Created {created.ReportNo}", Severity.Success);
        await LoadAsync();
    }

    private async Task ViewAsync(Guid id)
    {
        try
        {
            var detail = await Client.GetAsync(id);
            if (detail is null) { Snackbar.Add("Report not found.", Severity.Warning); return; }
            var parameters = new DialogParameters { ["Report"] = detail };
            await DialogService.ShowAsync<ReceivingReportDetailDialog>("Receiving Report", parameters);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error);
        }
    }

    private const string FastReportKey = "smrr-receiving-report";

    private async Task PrintFastAsync(Guid id)
    {
        try
        {
            var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
            var bytes = await Client.GetSmrrFastReportPdfAsync(id,
                pageWidth: saved?.PaperSize ?? "longbond",
                orientation: saved?.Orientation ?? "portrait",
                minRows: saved?.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenFastReportSetupAsync(Guid id)
    {
        var saved = await FastReportSetupPrefs.GetAsync(FastReportKey);
        var parameters = new DialogParameters
        {
            [nameof(FastReportPageSetupDialog.PaperSize)] = saved?.PaperSize ?? "longbond",
            [nameof(FastReportPageSetupDialog.Orientation)] = saved?.Orientation ?? "portrait",
            [nameof(FastReportPageSetupDialog.Copies)] = saved?.Copies ?? 1,
            [nameof(FastReportPageSetupDialog.MinRows)] = saved?.MinRows ?? 12
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FastReportPageSetupDialog>("Page Setup", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not FastReportPageSetupDialog.Result r) return;

        await FastReportSetupPrefs.SaveAsync(FastReportKey, new FastReportSetup(r.PaperSize, r.Orientation, r.Copies, r.MinRows));

        try
        {
            var bytes = await Client.GetSmrrFastReportPdfAsync(id, pageWidth: r.PaperSize, orientation: r.Orientation, minRows: r.MinRows);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fast report failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid id, string reportNo)
    {
        var ok = await DialogService.ShowConfirmAsync(
            "Delete Confirmation",
            $"Delete {reportNo}? This will also delete its lines and cannot be undone.",
            confirmText: "Delete", cancelText: "Cancel",
            confirmColor: Color.Error,
            icon: Icons.Material.Outlined.DeleteForever, iconColor: Color.Error);
        if (!ok) return;
        try
        {
            await Client.DeleteAsync(id);
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    private static string ReceiptTypeLabel(ReceiptType t) => t switch
    {
        ReceiptType.Purchase => "Purchase",
        ReceiptType.Transfer => "Transfer",
        ReceiptType.Donation => "Donation",
        ReceiptType.Other => "Other",
        _ => t.ToString()
    };
}

