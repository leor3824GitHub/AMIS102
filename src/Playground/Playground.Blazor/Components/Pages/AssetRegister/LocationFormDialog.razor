@using AMIS.Playground.Blazor.ApiClient
@inject ISnackbar Snackbar
@inject ILocationClient LocationClient

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Code" Label="Code" Placeholder="e.g. SR-01, WH-MAIN, OFF-GSD"
                          Required="true" MaxLength="64"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.Name" Label="Name" Placeholder="e.g. Supply Room"
                          Required="true" MaxLength="200"
                          Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            <MudSelect @bind-Value="_form.Type" Label="Type" Required="true"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                <MudSelectItem T="LocationKind" Value="LocationKind.Warehouse">Warehouse</MudSelectItem>
                <MudSelectItem T="LocationKind" Value="LocationKind.Office">Office</MudSelectItem>
                <MudSelectItem T="LocationKind" Value="LocationKind.Storage">Storage</MudSelectItem>
                <MudSelectItem T="LocationKind" Value="LocationKind.Department">Department</MudSelectItem>
                <MudSelectItem T="LocationKind" Value="LocationKind.Other">Other</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_form.Description" Label="Description" Placeholder="Optional notes" Lines="2"
                          MaxLength="500" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSaving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_isSaving">
            @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            @(_isEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public LocationModel? Existing { get; set; }

    private LocationForm _form = new();
    private bool _isSaving;

    private bool _isEdit => Existing is not null;

    private sealed class LocationForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public LocationKind Type { get; set; } = LocationKind.Storage;
        public string? Description { get; set; }
    }

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _form = new LocationForm
            {
                Code = Existing.Code,
                Name = Existing.Name,
                Type = Existing.Type,
                Description = Existing.Description
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Code) || string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("Code and Name are required.", Severity.Warning);
            return;
        }

        try
        {
            _isSaving = true;
            var code = _form.Code.Trim();
            var name = _form.Name.Trim();
            var description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim();

            if (Existing is not null)
            {
                var updated = await LocationClient.UpdateAsync(Existing.Id, code, name, _form.Type, null, description);
                Snackbar.Add("Location updated.", Severity.Success);
                Dialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var created = await LocationClient.CreateAsync(code, name, _form.Type, null, description);
                Snackbar.Add("Location created.", Severity.Success);
                Dialog.Close(DialogResult.Ok(created));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save location: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
