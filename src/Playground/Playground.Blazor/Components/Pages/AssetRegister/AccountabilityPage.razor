@page "/asset-register/accountability"
@implements IDisposable
@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Playground.Blazor.ApiClient
@inject IArAccountabilityClient Client
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IDialogService DialogService
@inject IJSRuntime JS

<AMISPageHeader Title="Property Accountability (ICS / PAR)"
               Description="Unified accountability tracking for Semi-Expendable (ICS) and PPE (PAR) per COA 2022-004." />

@if (_canIssue)
{
    <div class="d-flex justify-end mb-3">
        <AMISButton Variant="Variant.Filled" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Add" OnClick="OpenIssueDialogAsync">
            New ICS / PAR
        </AMISButton>
    </div>
}

<!-- Filters + Results -->
<div>
        <MudCard Elevation="1">
            <MudCardContent>
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="9">
                        <MudTextField @bind-Value="_keyword" Label="Keyword / Document No." Variant="Variant.Outlined"
                                      Dense="true" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                      OnKeyDown="OnSearchKeyDown" Immediate="false" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                    StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                            Search
                        </AMISButton>
                    </MudItem>
                </MudGrid>

                <AMISEnumChips TEnum="AccountabilityType" Value="_typeFilter" ValueChanged="OnTypeChanged"
                               Label="Type" LabelFunc="AccountabilityTypeLabel" Class="mt-3" />
                <AMISEnumChips TEnum="AccountabilityStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                               Label="Status" LabelFunc="FormatStatus" />
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else
                {
                    <MudTable Items="_items" Dense="true" Hover="true" Striped="true" T="ArAccountabilitySummaryDto">
                        <HeaderContent>
                            <MudTh>Document No.</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Issued On</MudTh>
                            <MudTh>Expires On</MudTh>
                            <MudTh Style="text-align:right">Lines</MudTh>
                            <MudTh Style="text-align:center">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Document No."><strong>@context.DocumentNo</strong></MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.AccountabilityType == AccountabilityType.SE_ICS ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@StatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @FormatStatus(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Issued On">@context.IssuedOn.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Expires On">@(context.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                            <MudTd DataLabel="Lines" Style="text-align:right">@context.LineCount</MudTd>
                            <MudTd DataLabel="Actions" Style="text-align:center">
                                <MudStack Row="true" Spacing="0" Justify="Justify.Center">
                                    <MudTooltip Text="View">
                                        <AMISIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                        Color="Color.Default" OnClick="@(() => OpenViewDialogAsync(context.Id))" />
                                    </MudTooltip>
                                    <MudTooltip Text="@($"Print {(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")}")">
                                        <AMISIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                                                        Color="Color.Secondary" OnClick="@(() => PrintRowAsync(context))"
                                                        Disabled="@(_printingId == context.Id)" />
                                    </MudTooltip>
                                    @if (context.Status == AccountabilityStatus.PendingAcceptance && _canUpdate)
                                    {
                                        <MudTooltip Text="Edit">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                            Color="Color.Primary" OnClick="@(() => OpenEditDialogAsync(context.Id))" />
                                        </MudTooltip>
                                    }
                                    @if (context.Status == AccountabilityStatus.PendingAcceptance && _canDelete)
                                    {
                                        <MudTooltip Text="Delete">
                                            <AMISIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                            Color="Color.Error" OnClick="@(() => DeleteRowAsync(context))" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No accountability documents found.</MudText>
                        </NoRecordsContent>
                    </MudTable>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <MudText Typo="Typo.caption">
                            Page @_page of @_totalPages (@_totalCount total)
                        </MudText>
                        <MudStack Row="true" Spacing="1">
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                            Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                            Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                        </MudStack>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
</div>

@code {
    private bool _busy;
    private Guid? _printingId;
    private string? _error;
    private string? _keyword;
    private AccountabilityType? _typeFilter;
    private AccountabilityStatus? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private IReadOnlyList<ArAccountabilitySummaryDto> _items = [];

    [SupplyParameterFromQuery(Name = "id")]
    public Guid? QueryId { get; set; }

    private bool _canIssue  => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Issue);
    private bool _canUpdate => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Delete);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
        if (QueryId.HasValue)
            await OpenViewDialogAsync(QueryId.Value);
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.SearchAsync(_keyword, _typeFilter, _statusFilter, page: _page, pageSize: PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Create ICS / PAR ─────────────────────────────────────────────────────

    private async Task OpenIssueDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueAccountabilityDialog>("New ICS / PAR", options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return;

        _page = 1;
        await LoadAsync();
    }

    // ── Row actions ──────────────────────────────────────────────────────────

    private async Task OpenViewDialogAsync(Guid id)
    {
        var parameters = new DialogParameters<AccountabilityDetailDialog> { { x => x.Id, id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AccountabilityDetailDialog>("Accountability Detail", parameters, options);
        var result = await dialog.Result;
        // Renew/Cancel inside the dialog mutate the record — reload the list if anything changed.
        if (result is not null && !result.Canceled && result.Data is true)
            await LoadAsync();
    }

    private async Task OpenEditDialogAsync(Guid id)
    {
        var parameters = new DialogParameters<EditAccountabilityDialog> { { x => x.Id, id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditAccountabilityDialog>("Edit Accountability", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task DeleteRowAsync(ArAccountabilitySummaryDto item)
    {
        var label = item.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR";
        var confirmed = await DialogService.ShowMessageBox(
            $"Delete {label}?",
            $"Permanently delete {label} {item.DocumentNo} and release its reserved assets back to Available? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        try
        {
            await Client.DeleteAsync(item.Id);
            Snackbar.Add($"{label} {item.DocumentNo} deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintRowAsync(ArAccountabilitySummaryDto item)
    {
        _printingId = item.Id;
        try
        {
            var bytes = await Client.GetFastReportPdfAsync(item.Id, item.AccountabilityType, pageWidth: "longbond");
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _printingId = null;
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private async Task OnTypeChanged(AccountabilityType? value) { _typeFilter = value; _page = 1; await LoadAsync(); }
    private async Task OnStatusChanged(AccountabilityStatus? value) { _statusFilter = value; _page = 1; await LoadAsync(); }

    private static string AccountabilityTypeLabel(AccountabilityType t) => t switch
    {
        AccountabilityType.SE_ICS => "ICS (SE)",
        AccountabilityType.PPE_PAR => "PAR (PPE)",
        _ => t.ToString()
    };

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private static string FormatStatus(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => "Active",
        AccountabilityStatus.Renewed => "Renewed",
        AccountabilityStatus.Returned => "Returned",
        AccountabilityStatus.Cancelled => "Cancelled",
        AccountabilityStatus.PendingAcceptance => "Pending Acceptance",
        _ => v.ToString()
    };
    private static Color StatusColor(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => Color.Success,
        AccountabilityStatus.Renewed => Color.Warning,
        AccountabilityStatus.Returned => Color.Info,
        AccountabilityStatus.Cancelled => Color.Error,
        AccountabilityStatus.PendingAcceptance => Color.Warning,
        _ => Color.Default
    };
}
