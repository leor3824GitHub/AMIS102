@page "/asset-register/accountability"
@implements IDisposable
@using AMIS.Modules.AssetRegister.Contracts.v1
@using AMIS.Modules.AssetRegister.Contracts.Permissions
@using AMIS.Playground.Blazor.ApiClient
@inject IArAccountabilityClient Client
@inject IAssetRegistryClient AssetClient
@inject ILookupClient LookupClient
@inject ISnackbar Snackbar
@inject IUserProfileState UserProfileState
@inject IJSRuntime JS

<AMISPageHeader Title="Property Accountability (ICS / PAR)"
               Description="Unified accountability tracking for Semi-Expendable (ICS) and PPE (PAR) per COA 2022-004." />

<MudGrid Spacing="3">
    <!-- Create Form -->
    @if (_canIssue)
    {
        <MudItem xs="12" md="5">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">New ICS / PAR</MudText>
                    <MudStack Spacing="2">
                        <MudSelect Value="_form.Type" Label="Type" Variant="Variant.Outlined" T="AccountabilityType"
                                   Required="true" Dense="true" Margin="Margin.Dense"
                                   ValueChanged="OnTypeChangedForm">
                            <MudSelectItem T="AccountabilityType" Value="AccountabilityType.SE_ICS">ICS — Semi-Expendable</MudSelectItem>
                            <MudSelectItem T="AccountabilityType" Value="AccountabilityType.PPE_PAR">PAR — Property, Plant &amp; Equipment</MudSelectItem>
                        </MudSelect>

                        <MudDatePicker @bind-Date="_form.IssuedOnNullable" Label="Issued On" Variant="Variant.Outlined"
                                       DateFormat="MM/dd/yyyy" Required="true" Dense="true" Margin="Margin.Dense" />

                        @if (_form.Type == AccountabilityType.SE_ICS)
                        {
                            <MudDatePicker @bind-Date="_form.ExpiresOnNullable" Label="Expires On" Variant="Variant.Outlined"
                                           DateFormat="MM/dd/yyyy" Required="true" Dense="true" Margin="Margin.Dense"
                                           HelperText="ICS (SE) requires an expiry date per COA 2022-004." />
                        }

                        <MudTextField @bind-Value="_form.FundCluster" Label="Fund Cluster" Variant="Variant.Outlined"
                                      Required="true" MaxLength="64" Dense="true" Margin="Margin.Dense" />

                        <MudAutocomplete T="EmployeeReferenceDto"
                                         @bind-Value="_form.IssuedFrom"
                                         SearchFunc="SearchEmployees"
                                         ToStringFunc="FormatEmployee"
                                         Label="Issued From (Supply Officer)" Variant="Variant.Outlined"
                                         Clearable="true" ResetValueOnEmptyText="true" CoerceValue="true"
                                         Dense="true" Margin="Margin.Dense"
                                         HelperText="Defaults to you if left blank." />

                        <MudAutocomplete T="EmployeeReferenceDto"
                                         @bind-Value="_form.ReceivedBy"
                                         SearchFunc="SearchEmployees"
                                         ToStringFunc="FormatEmployee"
                                         Label="Received By (End-User)" Variant="Variant.Outlined"
                                         Required="true" Clearable="true" ResetValueOnEmptyText="true" CoerceValue="true"
                                         Dense="true" Margin="Margin.Dense" />

                        <MudDivider Class="my-2" />
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Property Items to Issue</MudText>
                            <AMISIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                            OnClick="AddItem" />
                        </MudStack>

                        @for (var i = 0; i < _form.Items.Count; i++)
                        {
                            var idx = i;
                            var li = _form.Items[idx];
                            <MudPaper Outlined="true" Class="pa-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Item @(idx + 1)</MudText>
                                    <MudSpacer />
                                    <AMISIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Error"
                                                    OnClick="@(() => RemoveItem(idx))" />
                                </MudStack>
                                <MudStack Spacing="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudTextField @bind-Value="li.PropertyNo" Label="Property No." Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" MaxLength="50"
                                                      Placeholder="@(_form.Type == AccountabilityType.SE_ICS ? "e.g. SPLV-2026-01-0001" : "e.g. PPE-2026-01-0001")"
                                                      Class="flex-grow-1"
                                                      OnKeyDown="@(e => OnItemKeyDown(e, li))" />
                                        <AMISIconButton Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"
                                                        OnClick="@(() => LookupAssetAsync(li))" />
                                    </MudStack>
                                    @if (li.Asset is not null)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success">
                                            @li.Asset.Description | @Money.Symbol@li.Asset.UnitCost.ToString("N2") — Available
                                        </MudText>
                                    }
                                    else if (!string.IsNullOrEmpty(li.LookupError))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error">@li.LookupError</MudText>
                                    }
                                </MudStack>
                            </MudPaper>
                        }

                        <AMISButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                    OnClick="IssueAsync" Disabled="_issuing">
                            @if (_issuing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            @(_form.Type == AccountabilityType.SE_ICS ? "Create ICS" : "Create PAR")
                        </AMISButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

    <!-- Filters + Results + Detail -->
    <MudItem xs="12" md="@(_canIssue ? 7 : 12)">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="9">
                        <MudTextField @bind-Value="_keyword" Label="Keyword / Document No." Variant="Variant.Outlined"
                                      Dense="true" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search"
                                      OnKeyDown="OnSearchKeyDown" Immediate="false" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <AMISButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                    StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadAsync" Disabled="_busy">
                            Search
                        </AMISButton>
                    </MudItem>
                </MudGrid>

                <AMISEnumChips TEnum="AccountabilityType" Value="_typeFilter" ValueChanged="OnTypeChanged"
                               Label="Type" LabelFunc="AccountabilityTypeLabel" Class="mt-3" />
                <AMISEnumChips TEnum="AccountabilityStatus" Value="_statusFilter" ValueChanged="OnStatusChanged"
                               Label="Status" />
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mt-3">
            <MudCardContent>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else
                {
                    <MudTable Items="_items" Dense="true" Hover="true" Striped="true"
                              OnRowClick="OnRowClick" T="ArAccountabilitySummaryDto" RowClass="cursor-pointer">
                        <HeaderContent>
                            <MudTh>Document No.</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Issued On</MudTh>
                            <MudTh>Expires On</MudTh>
                            <MudTh Style="text-align:right">Lines</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.DocumentNo</strong></MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.AccountabilityType == AccountabilityType.SE_ICS ? Color.Info : Color.Secondary)"
                                         Variant="Variant.Outlined">
                                    @(context.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@StatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @FormatStatus(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.IssuedOn.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@(context.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                            <MudTd Style="text-align:right">@context.LineCount</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No accountability documents found.</MudText>
                        </NoRecordsContent>
                    </MudTable>

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                        <MudText Typo="Typo.caption">
                            Page @_page of @_totalPages (@_totalCount total)
                        </MudText>
                        <MudStack Row="true" Spacing="1">
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                            Disabled="_page <= 1 || _busy" OnClick="PrevPage" />
                            <AMISIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                            Disabled="_page >= _totalPages || _busy" OnClick="NextPage" />
                        </MudStack>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>

        <!-- Detail panel -->
        @if (_selected is not null)
        {
            <MudCard Elevation="2" Class="mt-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">
                                @(_selected.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR") — @_selected.DocumentNo
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(_selected.Status)" Variant="Variant.Filled">
                                @FormatStatus(_selected.Status)
                            </MudChip>
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <AMISButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                    StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                    OnClick="PrintAsync" Disabled="_printing">
                            @if (_printing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                            Print @(_selected.AccountabilityType == AccountabilityType.SE_ICS ? "ICS" : "PAR")
                        </AMISButton>
                        <AMISIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="@(() => _selected = null)" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-3">
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Issued On</MudText>
                            <MudText Typo="Typo.body2">@_selected.IssuedOn.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Expires On</MudText>
                            <MudText Typo="Typo.body2">@(_selected.ExpiresOn?.ToString("yyyy-MM-dd") ?? "—")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Fund Cluster</MudText>
                            <MudText Typo="Typo.body2">@_selected.FundCluster</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Issued By</MudText>
                            <MudText Typo="Typo.body2">@_selected.IssuedBy.PrintedName (@(_selected.IssuedBy.Designation ?? "—"))</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Received By</MudText>
                            <MudText Typo="Typo.body2">@_selected.ReceivedBy.PrintedName (@(_selected.ReceivedBy.Designation ?? "—"))</MudText>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(_selected.CancellationReason))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    Cancellation reason: @_selected.CancellationReason
                                </MudAlert>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Line Items</MudText>
                    <MudTable Items="_selected.Lines" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Property No.</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Unit</MudTh>
                            <MudTh Style="text-align:right">Issued</MudTh>
                            <MudTh Style="text-align:right">Returned</MudTh>
                            <MudTh Style="text-align:right">Unit Cost (@Money.Symbol)</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Returned On</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Snapshot.PropertyNo</MudTd>
                            <MudTd>@context.Snapshot.Description</MudTd>
                            <MudTd>@context.Snapshot.Unit</MudTd>
                            <MudTd Style="text-align:right">@context.IssuedQty</MudTd>
                            <MudTd Style="text-align:right">@context.ReturnedQty</MudTd>
                            <MudTd Style="text-align:right">@context.Snapshot.UnitCost.ToString("N2")</MudTd>
                            <MudTd>@FormatLineStatus(context.LineStatus)</MudTd>
                            <MudTd>@(context.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <!-- Renew action (Active ICS only — PAR does not expire) -->
                    @if (_selected.Status == AccountabilityStatus.Active && _selected.AccountabilityType == AccountabilityType.SE_ICS && _canIssue)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Renew ICS</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                            <MudDatePicker @bind-Date="_renewIssuedOn" Label="New Issued On" Variant="Variant.Outlined"
                                           DateFormat="MM/dd/yyyy" Dense="true" Margin="Margin.Dense" Style="flex:1;" />
                            <MudDatePicker @bind-Date="_renewExpiresOn" Label="New Expires On" Variant="Variant.Outlined"
                                           DateFormat="MM/dd/yyyy" Dense="true" Margin="Margin.Dense" Style="flex:1;" />
                            <AMISButton Variant="Variant.Outlined" Color="Color.Primary"
                                        OnClick="RenewAsync" Disabled="_busy || _renewIssuedOn is null || _renewExpiresOn is null">
                                Renew
                            </AMISButton>
                        </MudStack>
                    }

                    <!-- Cancel action (only for Active) -->
                    @if (_selected.Status == AccountabilityStatus.Active && _canCancel)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Cancel Accountability</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                            <MudTextField @bind-Value="_cancelReason" Label="Reason" Variant="Variant.Outlined"
                                          Style="flex:1;" MaxLength="500" />
                            <AMISButton Variant="Variant.Outlined" Color="Color.Error"
                                        OnClick="CancelAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_cancelReason)">
                                Cancel ICS/PAR
                            </AMISButton>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudItem>
</MudGrid>

@code {
    private bool _busy;
    private bool _issuing;
    private bool _printing;
    private string? _error;
    private string? _keyword;
    private AccountabilityType? _typeFilter;
    private AccountabilityStatus? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private const int PageSize = 15;
    private IReadOnlyList<ArAccountabilitySummaryDto> _items = [];
    private ArAccountabilityDto? _selected;
    private string? _cancelReason;
    private DateTime? _renewIssuedOn = DateTime.Today;
    private DateTime? _renewExpiresOn = DateTime.Today.AddYears(1);

    private readonly IssueForm _form = new();

    [SupplyParameterFromQuery(Name = "id")]
    public Guid? QueryId { get; set; }

    private bool _canIssue => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Issue);
    private bool _canCancel => UserProfileState.Permissions.Contains(AssetRegisterPermissions.Accountability.Cancel);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        _form.Items.Add(new IssueItemRow());
        await LoadAsync();
        if (QueryId.HasValue)
        {
            _selected = await Client.GetAsync(QueryId.Value);
        }
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Client.SearchAsync(_keyword, _typeFilter, _statusFilter, page: _page, pageSize: PageSize);
            _items = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Create ICS / PAR ─────────────────────────────────────────────────────

    private void OnTypeChangedForm(AccountabilityType value)
    {
        _form.Type = value;
        // Re-validate any already looked-up assets against the new type.
        foreach (var item in _form.Items)
        {
            item.Asset = null;
            item.LookupError = null;
        }
    }

    private void AddItem() => _form.Items.Add(new IssueItemRow());

    private void RemoveItem(int idx)
    {
        if (_form.Items.Count > 1) _form.Items.RemoveAt(idx);
    }

    private async Task OnItemKeyDown(KeyboardEventArgs e, IssueItemRow row)
    {
        if (e.Key == "Enter") await LookupAssetAsync(row);
    }

    private async Task LookupAssetAsync(IssueItemRow row)
    {
        var propertyNo = row.PropertyNo?.Trim().ToUpperInvariant();
        row.Asset = null;
        row.LookupError = null;
        if (string.IsNullOrWhiteSpace(propertyNo))
        {
            row.LookupError = "Enter a property number.";
            return;
        }

        try
        {
            var asset = await AssetClient.GetByPropertyNoAsync(propertyNo);
            if (asset is null)
            {
                row.LookupError = "Property number not found.";
                return;
            }

            var expectedType = _form.Type == AccountabilityType.SE_ICS
                ? AMIS.Modules.AssetRegister.Contracts.v1.AssetType.SE
                : AMIS.Modules.AssetRegister.Contracts.v1.AssetType.PPE;
            if (asset.AssetType != expectedType)
            {
                row.LookupError = asset.AssetType == AMIS.Modules.AssetRegister.Contracts.v1.AssetType.SE
                    ? "This is a Semi-Expendable asset — issue it via ICS, not PAR."
                    : "This is a PPE asset — issue it via PAR, not ICS.";
                return;
            }

            if (asset.LifecycleState != LifecycleState.Available)
            {
                row.LookupError = $"Asset is '{asset.LifecycleState}', not Available for issuance.";
                return;
            }

            if (asset.CurrentLocationId is null)
            {
                row.LookupError = "Asset has no location on record; set its location before issuing.";
                return;
            }

            row.Asset = asset;
        }
        catch (Exception ex)
        {
            row.LookupError = ex.Message;
        }
    }

    private async Task IssueAsync()
    {
        if (_form.IssuedOnNullable is null)
        {
            Snackbar.Add("Issued On date is required.", Severity.Warning);
            return;
        }
        if (_form.ReceivedBy is null)
        {
            Snackbar.Add("Received By (End-User) is required.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.FundCluster))
        {
            Snackbar.Add("Fund Cluster is required.", Severity.Warning);
            return;
        }
        if (_form.Type == AccountabilityType.SE_ICS && _form.ExpiresOnNullable is null)
        {
            Snackbar.Add("ICS (Semi-Expendable) requires an expiry date.", Severity.Warning);
            return;
        }
        if (_form.Items.Count == 0 || _form.Items.Any(i => i.Asset is null))
        {
            Snackbar.Add("All property items must be looked up and eligible for this document type.", Severity.Warning);
            return;
        }

        var issuedBy = ToRef(_form.IssuedFrom) ?? CurrentUserRef();
        if (issuedBy is null)
        {
            Snackbar.Add("Issued From (Supply Officer) is required, and your account is not linked to an employee record.", Severity.Warning);
            return;
        }

        var receivedBy = ToRef(_form.ReceivedBy)!;
        var issuedOn = DateOnly.FromDateTime(_form.IssuedOnNullable.Value);
        DateOnly? expiresOn = _form.Type == AccountabilityType.SE_ICS
            ? DateOnly.FromDateTime(_form.ExpiresOnNullable!.Value)
            : null;

        var lines = _form.Items
            .Select((row, idx) => new IssueAccountabilityLineRequest(
                row.Asset!.Id,
                (idx + 1).ToString(),
                row.Asset!.CurrentLocationId!.Value,
                null))
            .ToList();

        _issuing = true;
        try
        {
            var result = await Client.IssueAsync(new IssueAccountabilityRequest(
                _form.Type,
                _form.FundCluster!.Trim(),
                issuedBy,
                receivedBy,
                issuedOn,
                expiresOn,
                lines));

            Snackbar.Add($"{(_form.Type == AccountabilityType.SE_ICS ? "ICS" : "PAR")} {result.DocumentNo} created — {result.Lines.Count} item(s) issued.", Severity.Success);
            ResetForm();
            _page = 1;
            await LoadAsync();
            _selected = result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Create failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _issuing = false;
        }
    }

    private void ResetForm()
    {
        _form.Type = AccountabilityType.SE_ICS;
        _form.IssuedOnNullable = DateTime.Today;
        _form.ExpiresOnNullable = DateTime.Today.AddYears(1);
        _form.FundCluster = null;
        _form.IssuedFrom = null;
        _form.ReceivedBy = null;
        _form.Items.Clear();
        _form.Items.Add(new IssueItemRow());
    }

    private async Task<IEnumerable<EmployeeReferenceDto>> SearchEmployees(string? value, CancellationToken ct)
    {
        try
        {
            var result = await LookupClient.EmployeesGetAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                isActive: true,
                pageNumber: 1,
                pageSize: 20,
                cancellationToken: ct);
            return result?.Items ?? [];
        }
        catch { return []; }
    }

    private static string FormatEmployee(EmployeeReferenceDto? e) =>
        e is null ? "" : $"{e.FirstName} {e.LastName} ({e.EmployeeNumber})";

    private static ArEmployeeRefDto? ToRef(EmployeeReferenceDto? e) =>
        e is null
            ? null
            : new ArEmployeeRefDto(
                e.Id,
                $"{e.FirstName} {e.LastName}".Trim(),
                string.IsNullOrWhiteSpace(e.PositionName) ? null : e.PositionName);

    private ArEmployeeRefDto? CurrentUserRef() =>
        UserProfileState.EmployeeId == Guid.Empty || string.IsNullOrWhiteSpace(UserProfileState.EmployeeFullName)
            ? null
            : new ArEmployeeRefDto(
                UserProfileState.EmployeeId,
                UserProfileState.EmployeeFullName.Trim(),
                string.IsNullOrWhiteSpace(UserProfileState.EmployeePositionName) ? null : UserProfileState.EmployeePositionName.Trim());

    // ── Row actions ──────────────────────────────────────────────────────────

    private async Task OnRowClick(TableRowClickEventArgs<ArAccountabilitySummaryDto> args)
    {
        _busy = true;
        try
        {
            _selected = await Client.GetAsync(args.Item.Id);
            _cancelReason = null;
            _renewIssuedOn = DateTime.Today;
            _renewExpiresOn = DateTime.Today.AddYears(1);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PrintAsync()
    {
        if (_selected is null) return;
        _printing = true;
        try
        {
            var bytes = await Client.GetFastReportPdfAsync(_selected.Id, _selected.AccountabilityType, pageWidth: "longbond");
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _printing = false;
        }
    }

    private async Task RenewAsync()
    {
        if (_selected is null || _renewIssuedOn is null || _renewExpiresOn is null) return;
        _busy = true;
        try
        {
            var result = await Client.RenewAsync(
                _selected.Id,
                DateOnly.FromDateTime(_renewIssuedOn.Value),
                DateOnly.FromDateTime(_renewExpiresOn.Value));
            _selected = result;
            Snackbar.Add($"ICS renewed as {result.DocumentNo}.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_cancelReason)) return;
        _busy = true;
        try
        {
            _selected = await Client.CancelAsync(_selected.Id, _cancelReason);
            Snackbar.Add("Accountability cancelled.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
    private async Task OnTypeChanged(AccountabilityType? value) { _typeFilter = value; _page = 1; await LoadAsync(); }
    private async Task OnStatusChanged(AccountabilityStatus? value) { _statusFilter = value; _page = 1; await LoadAsync(); }

    private static string AccountabilityTypeLabel(AccountabilityType t) => t switch
    {
        AccountabilityType.SE_ICS => "ICS (SE)",
        AccountabilityType.PPE_PAR => "PAR (PPE)",
        _ => t.ToString()
    };

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private static string FormatStatus(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => "Active",
        AccountabilityStatus.Renewed => "Renewed",
        AccountabilityStatus.Returned => "Returned",
        AccountabilityStatus.Cancelled => "Cancelled",
        _ => v.ToString()
    };
    private static Color StatusColor(AccountabilityStatus v) => v switch
    {
        AccountabilityStatus.Active => Color.Success,
        AccountabilityStatus.Renewed => Color.Warning,
        AccountabilityStatus.Returned => Color.Info,
        AccountabilityStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
    private static string FormatLineStatus(AccountabilityLineStatus v) => v switch
    {
        AccountabilityLineStatus.Active => "Active",
        AccountabilityLineStatus.Returned => "Returned",
        AccountabilityLineStatus.Lost => "Lost",
        _ => v.ToString()
    };

    private sealed class IssueForm
    {
        public AccountabilityType Type { get; set; } = AccountabilityType.SE_ICS;
        public DateTime? IssuedOnNullable { get; set; } = DateTime.Today;
        public DateTime? ExpiresOnNullable { get; set; } = DateTime.Today.AddYears(1);
        public string? FundCluster { get; set; }
        public EmployeeReferenceDto? IssuedFrom { get; set; }
        public EmployeeReferenceDto? ReceivedBy { get; set; }
        public List<IssueItemRow> Items { get; set; } = [];
    }

    private sealed class IssueItemRow
    {
        public string? PropertyNo { get; set; }
        public AssetRegistryDto? Asset { get; set; }
        public string? LookupError { get; set; }
    }
