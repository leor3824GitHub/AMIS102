<MudDataGrid T="StockCardLineDto" Items="_lines" Dense="true" Hover="true" Striped="true" Bordered="true"
             Loading="_loading" Filterable="true" SortMode="SortMode.Multiple" Elevation="1">
    <Columns>
        <PropertyColumn Property="x => x.Date" Title="Date" Format="MM/dd/yyyy" CellStyle="text-align:center" />
        <PropertyColumn Property="x => x.Reference" Title="Reference (PO / RIS No.)" />
        <TemplateColumn Title="Office / Department" Sortable="false" Filterable="false">
            <CellTemplate>
                @FormatOffice(context.Item.Office)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Receipt Qty" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Receipt" ? context.Item.ReceiptQty.ToString() : "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Receipt Unit Cost" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Receipt" ? context.Item.ReceiptUnitCost.ToString("N2") : "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Receipt Total Cost" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Receipt" ? context.Item.ReceiptTotalCost.ToString("N2") : "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Issue Qty" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Issue" ? context.Item.IssueQty.ToString() : "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Issue Unit Cost" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Issue" ? context.Item.IssueUnitCost.ToString("N2") : "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Issue Total Cost" CellStyle="text-align:right">
            <CellTemplate>
                @(context.Item.TransactionType == "Issue" ? context.Item.IssueTotalCost.ToString("N2") : "—")
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.BalanceQty" Title="Balance Qty" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.BalanceUnitCost" Title="Balance Unit Cost" Format="N4" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.BalanceTotalCost" Title="Balance Total Cost" Format="N2" CellStyle="text-align:right" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="StockCardLineDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
            @(_selectedProduct is null
                ? "Search and select a product above to view its stock card."
                : "No transactions found for this product.")
        </MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private bool _loading;
    private ProductDto? _selectedProduct;
    private StockCardDto? _stockCard;
    private List<StockCardLineDto> _lines = [];
    private Dictionary<Guid, string> _departmentNames = [];
    private const string ReportKey = "quest-stock-card";

    [Parameter]
    [SupplyParameterFromQuery(Name = "productId")]
    public string? QueryProductId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var depts = await LookupClient.DepartmentsAsync(isActive: true, pageNumber: 1, pageSize: 500);
            _departmentNames = (depts.Items ?? [])
                .ToDictionary(d => d.Id, d => d.Name);
        }
        catch { /* non-critical */ }

        if (!string.IsNullOrWhiteSpace(QueryProductId) && Guid.TryParse(QueryProductId, out var id))
            await LoadStockCardAsync(id);
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string text, CancellationToken ct)
    {
        try
        {
            var result = await ProductsClient.SearchAsync(new SearchProductsQuery
            {
                Keyword = text,
                PageNumber = 1,
                PageSize = 30
            }, ct);
            return result.Items ?? [];
        }
        catch
        {
            return [];
        }
    }

    private async Task OnProductSelected(ProductDto? product)
    {
        _selectedProduct = product;
        _stockCard = null;
        _lines = [];

        if (product is not null)
            await LoadStockCardAsync(product.Id);
    }

    private async Task LoadStockCardAsync(Guid productId)
    {
        _loading = true;
        try
        {
            _stockCard = await ReportsClient.GetStockCardAsync(productId);
            _lines = _stockCard?.Lines ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load stock card: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_stockCard is null) return;

        var sb = new StringBuilder();
        sb.AppendLine($"Stock Card — {_stockCard.ProductCode} {_stockCard.ProductName} ({_stockCard.UnitOfMeasure})");
        sb.AppendLine("Date,Reference,Office/Dept,Receipt Qty,Receipt Unit Cost,Receipt Total,Issue Qty,Issue Unit Cost,Issue Total,Balance Qty,Balance Unit Cost,Balance Total");

        foreach (var line in _stockCard.Lines)
        {
            sb.AppendLine(string.Join(",",
                line.Date.LocalDateTime.ToString("yyyy-MM-dd"),
                Quote(line.Reference),
                Quote(FormatOffice(line.Office)),
                line.ReceiptQty > 0 ? line.ReceiptQty.ToString() : "",
                line.ReceiptQty > 0 ? line.ReceiptUnitCost.ToString("N2") : "",
                line.ReceiptQty > 0 ? line.ReceiptTotalCost.ToString("N2") : "",
                line.IssueQty > 0 ? line.IssueQty.ToString() : "",
                line.IssueQty > 0 ? line.IssueUnitCost.ToString("N2") : "",
                line.IssueQty > 0 ? line.IssueTotalCost.ToString("N2") : "",
                line.BalanceQty,
                line.BalanceUnitCost.ToString("N4"),
                line.BalanceTotalCost.ToString("N2")));
        }

        var dataUrl = $"data:text/csv;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()))}";
        await JS.InvokeVoidAsync("open", dataUrl, "_blank");
        Snackbar.Add("CSV export ready.", Severity.Success);
    }

    private string FormatOffice(string? departmentId)
    {
        if (string.IsNullOrWhiteSpace(departmentId)) return string.Empty;
        if (Guid.TryParse(departmentId, out var id) && _departmentNames.TryGetValue(id, out var name))
            return name;
        return departmentId;
    }

    private async Task DownloadQuestPdfAsync()
    {
        if (_selectedProduct is null) return;

        var r = await QuestPdfSetupPrefs.ShowSetupDialogAsync(DialogService, ReportKey, defaultMarginMm: 15d);
        if (r is null) return;

        _loading = true;
        try
        {
            var bytes = await ReportsClient.GenerateStockCardPdfAsync(_selectedProduct.Id, r.PaperSize, r.Orientation, r.MarginMm);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Quote(string? v) =>
        string.IsNullOrEmpty(v) ? "\"\"" : $"\"{v.Replace("\"", "\"\"")}\"";
}
