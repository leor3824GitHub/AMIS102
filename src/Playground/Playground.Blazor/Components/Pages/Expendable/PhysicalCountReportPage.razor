@page "/expendable/reports/physical-count"
@using AMIS.Modules.Expendable.Contracts.v1.Requests
@using AMIS.Playground.Blazor.ApiClient
@using System.Text
@inherits ComponentBase
@inject IReportsClient ReportsClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div>
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_asOfDate" Label="As of Date" Variant="Variant.Outlined"
                               DateFormat="yyyy-MM-dd" Clearable="false" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadReportAsync"
                               StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">
                        Generate Report
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ExportCsvAsync"
                               StartIcon="@Icons.Material.Filled.Download" Disabled="_loading || _items.Count == 0">
                        Export CSV
                    </MudButton>
                    <MudSpacer />
                    <PdfPaperSettings @bind-PaperSize="_paperSize" @bind-Orientation="_orientation" @bind-MarginMm="_marginMm" />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DownloadQuestPdfAsync"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf" Disabled="_loading || _items.Count == 0">
                        Download PDF
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
</div>

<MudDataGrid T="PhysicalCountItemDto" Items="_items" Dense="true" Hover="true" Striped="true"
             Bordered="true" Loading="_loading" Filterable="true" SortMode="SortMode.Multiple"
             Elevation="1">
    <Columns>
        <PropertyColumn Property="x => x.ArticleNumber" Title="Article" CellStyle="text-align:center" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
        <PropertyColumn Property="x => x.StockNo" Title="Stock No." CellStyle="text-align:center" />
        <PropertyColumn Property="x => x.UnitOfMeasure" Title="Unit of Measure" CellStyle="text-align:center" />
        <PropertyColumn Property="x => x.UnitValue" Title="Unit Value" Format="N2" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.BalancePerCard" Title="Balance Per Card (Qty)" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.OnHandPerCount" Title="On Hand Per Count (Qty)" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.ShortageQuantity" Title="Shortage Qty" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.ShortageValue" Title="Shortage Value" Format="N2" CellStyle="text-align:right" />
        <PropertyColumn Property="x => x.Remarks" Title="Remarks" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="PhysicalCountItemDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
            No products found. Click Generate Report to load data.
        </MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private bool _loading;
    private List<PhysicalCountItemDto> _items = [];
    private DateTime? _asOfDate = DateTime.Today;
    private string _paperSize = "a4";
    private string _orientation = "landscape";
    private double _marginMm = 15d;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        _items = [];
        try
        {
            _items = await ReportsClient.GetPhysicalCountReportAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_items.Count == 0) return;

        var sb = new StringBuilder();
        sb.AppendLine("Article,Description,Stock No.,Unit of Measure,Unit Value,Balance Per Card (Qty),On Hand Per Count (Qty),Shortage Qty,Shortage Value,Remarks");

        foreach (var item in _items)
        {
            sb.AppendLine(string.Join(",",
                item.ArticleNumber,
                Quote(item.Description),
                Quote(item.StockNo),
                Quote(item.UnitOfMeasure),
                item.UnitValue.ToString("N2"),
                item.BalancePerCard > 0 ? item.BalancePerCard.ToString() : "",
                item.OnHandPerCount > 0 ? item.OnHandPerCount.ToString() : "",
                item.ShortageQuantity != 0 ? item.ShortageQuantity.ToString() : "",
                item.ShortageValue > 0 ? item.ShortageValue.ToString("N2") : "",
                Quote(item.Remarks ?? "")));
        }

        var dataUrl = $"data:text/csv;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()))}";
        await JS.InvokeVoidAsync("open", dataUrl, "_blank");
        Snackbar.Add("CSV export ready.", Severity.Success);
    }

    private async Task DownloadQuestPdfAsync()
    {
        if (_items.Count == 0) return;
        _loading = true;
        try
        {
            var bytes = await ReportsClient.GeneratePhysicalCountPdfAsync(null, _asOfDate, _paperSize, _orientation, _marginMm);
            var dataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(bytes)}";
            await JS.InvokeVoidAsync("open", dataUrl, "_blank");
            Snackbar.Add("PDF ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Quote(string? v) =>
        string.IsNullOrEmpty(v) ? "\"\"" : $"\"{v.Replace("\"", "\"\"")}\"";
}

