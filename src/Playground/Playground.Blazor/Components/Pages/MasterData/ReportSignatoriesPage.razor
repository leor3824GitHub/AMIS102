@page "/master-data/report-signatories"
@implements IDisposable
@using AMIS.Modules.MasterData.Contracts.v1.ReportSignatories
@using AMIS.Modules.MasterData.Contracts.Permissions
@using AMIS.Playground.Blazor.ApiClient
@using MudBlazor
@inject IReportSignatoryClient SignatoryClient
@inject ISnackbar Snackbar
@inject IDialogService MudDialog
@inject IUserProfileState UserProfileState

<AMISPageHeader Title="Report Signatories" Description="Configure signature blocks for printed government reports">
    <ActionContent>
        @if (_canCreate)
        {
            <MudButton Size="Size.Medium" Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                New Signatory
            </MudButton>
        }
    </ActionContent>
</AMISPageHeader>

<MudGrid Spacing="3" Class="mt-2">

    <!-- Table -->
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Style="flex:1">Configured Signatories</MudText>
                <MudSelect T="string" @bind-Value="_filter" Label="Filter by Report" Variant="Variant.Outlined"
                           Dense="true" Style="width:180px" Clearable="true">
                    <MudSelectItem Value="@("VehicleInventory")">Vehicle Inventory</MudSelectItem>
                    <MudSelectItem Value="@("PhysicalCount")">Physical Count</MudSelectItem>
                    <MudSelectItem Value="@("DepartmentIssuance")">Department Issuance</MudSelectItem>
                    <MudSelectItem Value="@("StockCard")">Stock Card</MudSelectItem>
                    <MudSelectItem Value="@("EmployeeIssuance")">Employee Issuance</MudSelectItem>
                    <MudSelectItem Value="@("AbstractOfCanvass")">Abstract of Canvass</MudSelectItem>
                </MudSelect>
            </MudStack>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudSimpleTable Dense="true" Striped="true" Bordered="true">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th style="width:50px">Order</th>
                            <th>Label</th>
                            <th>Name</th>
                            <th>Title</th>
                            <th style="width:60px">Active</th>
                            <th style="width:90px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in FilteredSignatories)
                        {
                            <tr>
                                <td><MudChip T="string" Size="Size.Small" Color="@ReportColor(s.ReportType)">@ReportLabel(s.ReportType)</MudChip></td>
                                <td style="text-align:center">@s.SortOrder</td>
                                <td><small>@s.Label</small></td>
                                <td><strong>@s.Name</strong></td>
                                <td><small>@s.Title</small></td>
                                <td style="text-align:center">
                                    @if (s.IsActive) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
                                    else { <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" Size="Size.Small" /> }
                                </td>
                                <td>
                                    <MudStack Row="true" Spacing="0">
                                        @if (_canUpdate)
                                        {
                                            <MudTooltip Text="Edit signatory">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                               OnClick="() => OpenEditDialog(s)" Disabled="_busy" />
                                            </MudTooltip>
                                        }
                                        @if (_canDelete)
                                        {
                                            <MudTooltip Text="Delete signatory">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                               Color="Color.Error" OnClick="() => ConfirmDeleteAsync(s)" Disabled="_busy" />
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </td>
                            </tr>
                        }
                        @if (!FilteredSignatories.Any())
                        {
                            <tr><td colspan="7" style="text-align:center;color:#999">No signatories found.</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _loading;
    private bool _busy;
    private string? _filter;
    private List<ReportSignatoryDto> _signatories = [];

    private bool _canCreate => UserProfileState.Permissions.Contains(MasterDataPermissions.ReportSignatories.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(MasterDataPermissions.ReportSignatories.Update);
    private bool _canDelete => UserProfileState.Permissions.Contains(MasterDataPermissions.ReportSignatories.Delete);

    private IEnumerable<ReportSignatoryDto> FilteredSignatories =>
        string.IsNullOrEmpty(_filter)
            ? _signatories.OrderBy(s => s.ReportType).ThenBy(s => s.SortOrder)
            : _signatories.Where(s => s.ReportType == _filter).OrderBy(s => s.SortOrder);

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.OnProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfileState.OnProfileChanged -= OnProfileChanged;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // Load all signatories in one call by using "All" filter
            _signatories = await SignatoryClient.GetReportSignatoriesAsync("All");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load signatories: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (!_canCreate) return;

        var parameters = new DialogParameters { ["AllSignatories"] = _signatories };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await MudDialog.ShowAsync<ReportSignatoryFormDialog>("Add Signatory", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(ReportSignatoryDto s)
    {
        var parameters = new DialogParameters
        {
            ["Existing"] = s,
            ["AllSignatories"] = _signatories
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        var dialog = await MudDialog.ShowAsync<ReportSignatoryFormDialog>($"Edit {s.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(ReportSignatoryDto s)
    {
        if (await MudDialog.ShowDeleteConfirmAsync(s.Name ?? "this signatory"))
        {
            await DeleteAsync(s);
        }
    }

    private async Task DeleteAsync(ReportSignatoryDto s)
    {
        _busy = true;
        try
        {
            await SignatoryClient.DeleteAsync(s.Id);
            _signatories.Remove(s);
            Snackbar.Add("Signatory deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ReportLabel(string reportType) => reportType switch
    {
        "VehicleInventory" => "Vehicle",
        "PhysicalCount" => "Physical Count",
        "DepartmentIssuance" => "Dept. Issuance",
        "StockCard" => "Stock Card",
        "EmployeeIssuance" => "Emp. Issuance",
        "AbstractOfCanvass" => "Canvass",
        _ => reportType
    };

    private static Color ReportColor(string reportType) => reportType switch
    {
        "VehicleInventory" => Color.Info,
        "PhysicalCount" => Color.Success,
        "AbstractOfCanvass" => Color.Warning,
        _ => Color.Default
    };
}

