@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.Canvass
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseOrders
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests
@using AMIS.Framework.Shared.Persistence
@using AMIS.Playground.Blazor.ApiClient
@using PurchaseOrderContracts = AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseOrders
@inject IPurchaseOrderClient Client
@inject IPurchaseRequestClient PurchaseRequestClient
@inject ICanvassRequestClient CanvassClient
@inject IMaster_dataClient MasterDataClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="1">
            <MudText Typo="Typo.h6" Class="mb-1">@(_editing is null ? "New Purchase Order" : $"Edit {_editing.PoNumber}")</MudText>

            <!-- Purchase Request Section -->
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--mud-palette-primary); margin-top: 4px;">Purchase Request</MudText>
            <MudAutocomplete T="PurchaseRequestSummaryDto"
                             Value="_selectedPurchaseRequest"
                             ValueChanged="OnPurchaseRequestChanged"
                             SearchFunc="SearchPurchaseRequests"
                             ToStringFunc="FormatPurchaseRequest"
                             Label="Purchase Request *"
                             Variant="Variant.Outlined"
                             Placeholder="Search PR number or purpose..."
                             Required="true"
                             Clearable="true"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Dense="true" Margin="Margin.Dense" />

            @if (_prefilledCanvass is not null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Icon="@Icons.Material.Filled.EmojiEvents" Class="mt-1">
                    Prefilled from awarded canvass <b>@_prefilledCanvass.RivNumber</b>
                    @if (!string.IsNullOrWhiteSpace(_prefilledCanvass.AwardedSupplierName))
                    {
                        <span> · Supplier: @_prefilledCanvass.AwardedSupplierName</span>
                    }
                </MudAlert>
            }
            else
            {
                <MudTextField @bind-Value="_form.CanvassRequestId" Label="Canvass Request ID (optional)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
            }

            <!-- Supplier Section -->
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--mud-palette-primary); margin-top: 6px;">Supplier Information</MudText>
            <MudAutocomplete T="SupplierDto"
                             Value="_selectedSupplier"
                             ValueChanged="OnSupplierChanged"
                             SearchFunc="SearchSuppliers"
                             ToStringFunc="FormatSupplier"
                             Label="Supplier *"
                             Variant="Variant.Outlined"
                             Placeholder="Search supplier..."
                             Required="true"
                             Clearable="true"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Dense="true" Margin="Margin.Dense" />

            <MudTextField @bind-Value="_form.SupplierAddress" Label="Supplier Address *" Variant="Variant.Outlined" Required="true" Lines="2" Dense="true" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_form.SupplierTin" Label="TIN (optional)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />

            <!-- Delivery & Payment Section -->
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--mud-palette-primary); margin-top: 6px;">Delivery &amp; Payment</MudText>

            <MudSelect @bind-Value="_form.ModeOfProcurement" Label="Mode of Procurement" Variant="Variant.Outlined" T="ModeOfProcurement" Dense="true" Margin="Margin.Dense">
                @foreach (var mode in Enum.GetValues<ModeOfProcurement>())
                {
                    <MudSelectItem Value="mode">@mode.ToString().Replace("_", " ")</MudSelectItem>
                }
            </MudSelect>

            <MudGrid Spacing="1">
                <MudItem xs="12" sm="12" md="6"><MudTextField @bind-Value="_form.PlaceOfDelivery" Label="Place of Delivery *" Variant="Variant.Outlined" Required="true" Dense="true" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="12" md="6"><MudDatePicker @bind-Date="_form.DateOfDeliveryNullable" Label="Delivery Date" Variant="Variant.Outlined" DateFormat="MM/dd/yyyy" Dense="true" Margin="Margin.Dense" /></MudItem>
            </MudGrid>

            <MudGrid Spacing="1">
                <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_form.DeliveryTerm" Label="Delivery Term *" Variant="Variant.Outlined" Required="true" Dense="true" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_form.PaymentTerm" Label="Payment Term *" Variant="Variant.Outlined" Required="true" Dense="true" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="12" md="4"></MudItem>
            </MudGrid>

            <MudGrid Spacing="1">
                <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_form.FundCluster" Label="Fund Cluster" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_form.OursBursNumber" Label="OURS/BURS No." Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="12" md="4"></MudItem>
            </MudGrid>

            <!-- Line Items Section -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--mud-palette-primary)">Line Items</MudText>
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Size="Size.Small"
                           OnClick="AddLineItem" Color="Color.Primary">Add Item</MudButton>
            </MudStack>

            @if (!_form.LineItems.Any(li => !string.IsNullOrWhiteSpace(li.Description)))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">At least one line item with a description is required.</MudAlert>
            }

            @for (var i = 0; i < _form.LineItems.Count; i++)
            {
                var idx = i;
                var li = _form.LineItems[idx];
                <MudPaper Outlined="true" Class="pa-2 mt-1" Style="background: var(--mud-palette-background-grey);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Item @(idx + 1)</b></MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveLineItem(idx))" />
                    </MudStack>

                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="li.Description" Label="Description *" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="li.StockNumber" Label="Stock No." Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="li.Unit" Label="Unit" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="li.Quantity" Label="Qty" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="0.01m" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="li.UnitCost" Label="Unit Cost" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="0m" /></MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Amount: <b>₱@((li.Quantity * li.UnitCost).ToString("N2"))</b>
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @if (_form.LineItems.Any())
            {
                <MudPaper Class="pa-2 mt-1" Style="background: var(--mud-palette-primary-lighten); border: 1px solid var(--mud-palette-primary);">
                    <MudText Typo="Typo.body2"><b>Total: ₱@_form.LineItems.Sum(li => li.Quantity * li.UnitCost).ToString("N2")</b></MudText>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
            @if (_busy) { <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" /> }
            @(_editing is null ? "Create PO" : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PurchaseOrderDto? PurchaseOrder { get; set; }
    [Parameter] public Guid? PrefilledCanvassId { get; set; }

    private PurchaseOrderDto? _editing;
    private PoForm _form = new();
    private bool _busy;
    private PurchaseRequestSummaryDto? _selectedPurchaseRequest;
    private SupplierDto? _selectedSupplier;
    private CanvassRequestDto? _prefilledCanvass;

    protected override async Task OnInitializedAsync()
    {
        if (PurchaseOrder is not null)
        {
            await BeginEdit(PurchaseOrder);
        }
        else if (PrefilledCanvassId.HasValue)
        {
            await PrefillFromCanvassAsync(PrefilledCanvassId.Value);
        }
    }

    private async Task PrefillFromCanvassAsync(Guid canvassId)
    {
        try
        {
            var canvass = await CanvassClient.GetAsync(canvassId);
            if (canvass is null)
            {
                Snackbar.Add("Canvass request not found.", Severity.Warning);
                return;
            }

            if (canvass.Status != CanvassRequestStatus.Awarded)
            {
                Snackbar.Add("Canvass request has not been awarded yet.", Severity.Warning);
                return;
            }

            var awarded = canvass.Quotations.FirstOrDefault(q => q.IsAwarded);
            if (awarded is null)
            {
                Snackbar.Add("No awarded quotation found on this canvass.", Severity.Warning);
                return;
            }

            PurchaseRequestSummaryDto? prSummary = null;
            try
            {
                var pr = await PurchaseRequestClient.GetAsync(canvass.PurchaseRequestId);
                if (pr is not null)
                {
                    prSummary = new PurchaseRequestSummaryDto(
                        pr.Id, pr.PrNumber, pr.PrDate, pr.DepartmentName, pr.ResponsibilityCenterCode, pr.Purpose,
                        pr.PrType, pr.Status, pr.LineItems.Count,
                        pr.LineItems.Sum(li => li.EstimatedTotalCost), pr.CreatedOnUtc);
                }
            }
            catch { }

            _prefilledCanvass = canvass;
            _selectedPurchaseRequest = prSummary;
            _selectedSupplier = new SupplierDto
            {
                Id = awarded.SupplierId,
                Code = string.Empty,
                Name = awarded.SupplierName,
                TinNo = awarded.TinNumber,
                Address = awarded.SupplierAddress,
                IsActive = true
            };

            _form = new PoForm
            {
                CanvassRequestId = canvass.Id.ToString(),
                SupplierName = awarded.SupplierName,
                SupplierAddress = awarded.SupplierAddress,
                SupplierTin = awarded.TinNumber,
                ModeOfProcurement = ModeOfProcurement.SmallValueProcurement,
                PlaceOfDelivery = string.Empty,
                DeliveryTerm = awarded.DeliveryTerms ?? "30 days",
                PaymentTerm = "30 days",
                LineItems = awarded.LineItems
                    .Select(li => new PoLineItemRow
                    {
                        StockNumber = null,
                        Unit = li.Unit,
                        Description = li.Description,
                        Quantity = li.Quantity,
                        UnitCost = li.UnitPrice
                    })
                    .ToList()
            };

            if (_form.LineItems.Count == 0)
            {
                _form.LineItems.Add(new());
            }

            Snackbar.Add($"Prefilled from awarded canvass {canvass.RivNumber}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not prefill from canvass: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<PurchaseRequestSummaryDto>> SearchPurchaseRequests(string value, CancellationToken ct)
    {
        try
        {
            var result = await PurchaseRequestClient.SearchAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                status: null,
                page: 1,
                pageSize: 20,
                ct: ct);

            return result.Items ?? Enumerable.Empty<PurchaseRequestSummaryDto>();
        }
        catch
        {
            return Enumerable.Empty<PurchaseRequestSummaryDto>();
        }
    }

    private async Task<IEnumerable<SupplierDto>> SearchSuppliers(string value, CancellationToken ct)
    {
        var result = await MasterDataClient.SuppliersListAsync(
            keyword: string.IsNullOrWhiteSpace(value) ? null : value,
            pageNumber: 1,
            pageSize: 20,
            isActive: true,
            cancellationToken: ct);

        return result?.Items ?? Enumerable.Empty<SupplierDto>();
    }

    private Task OnPurchaseRequestChanged(PurchaseRequestSummaryDto? request)
    {
        _selectedPurchaseRequest = request;
        return Task.CompletedTask;
    }

    private Task OnSupplierChanged(SupplierDto? supplier)
    {
        _selectedSupplier = supplier;
        _form.SupplierName = supplier?.Name ?? string.Empty;
        _form.SupplierTin = supplier?.TinNo;

        if (!string.IsNullOrWhiteSpace(supplier?.Address))
        {
            _form.SupplierAddress = supplier.Address;
        }
        else if (supplier is null)
        {
            _form.SupplierAddress = string.Empty;
        }

        return Task.CompletedTask;
    }

    private static string FormatPurchaseRequest(PurchaseRequestSummaryDto? request)
    {
        if (request is null)
            return string.Empty;

        return string.IsNullOrWhiteSpace(request.Purpose)
            ? request.PrNumber
            : $"{request.PrNumber} - {request.Purpose}";
    }

    private static string FormatSupplier(SupplierDto? supplier)
    {
        if (supplier is null)
            return string.Empty;

        return string.IsNullOrWhiteSpace(supplier.Code)
            ? supplier.Name
            : $"{supplier.Name} ({supplier.Code})";
    }

    private async Task SaveAsync()
    {
        if (!IsFormValid())
        {
            Snackbar.Add("Fill in all required fields and at least one line item.", Severity.Warning);
            return;
        }

        var allowDuplicate = false;
        if (_editing is null)
        {
            var (proceed, overrideDuplicate) = await ConfirmNoDuplicateAsync();
            if (!proceed)
                return;
            allowDuplicate = overrideDuplicate;
        }

        _busy = true;
        try
        {
            var lineItems = _form.LineItems
                .Select(li => new PurchaseOrderLineItemRequest(li.StockNumber, li.Unit, li.Description, li.Quantity, li.UnitCost))
                .ToList();

            if (_editing is null)
            {
                await CreateWithDuplicateRetryAsync(lineItems, allowDuplicate);
                Snackbar.Add("Purchase order created.", Severity.Success);
            }
            else
            {
                await Client.UpdateAsync(_editing.Id, new UpdatePurchaseOrderCommand(
                    _editing.Id,
                    _selectedSupplier!.Id,
                    _form.SupplierName, _form.SupplierAddress, _form.SupplierTin,
                    _form.ModeOfProcurement, _form.PlaceOfDelivery,
                    ToDateOnly(_form.DateOfDeliveryNullable),
                    _form.DeliveryTerm, _form.PaymentTerm, _form.FundCluster, _form.OursBursNumber, lineItems));
                Snackbar.Add("Purchase order updated.", Severity.Success);
            }
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Snackbar.Add($"Save failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task BeginEdit(PurchaseOrderDto po)
    {
        _editing = po;

        PurchaseRequestSummaryDto? purchaseRequest = null;
        try
        {
            var pr = await PurchaseRequestClient.GetAsync(po.PurchaseRequestId);
            if (pr is not null)
            {
                purchaseRequest = new PurchaseRequestSummaryDto(
                    pr.Id,
                    pr.PrNumber,
                    pr.PrDate,
                    pr.DepartmentName,
                    pr.ResponsibilityCenterCode,
                    pr.Purpose,
                    pr.PrType,
                    pr.Status,
                    pr.LineItems.Count,
                    pr.LineItems.Sum(li => li.EstimatedTotalCost),
                    pr.CreatedOnUtc);
            }
        }
        catch { }

        _selectedPurchaseRequest = purchaseRequest;
        _selectedSupplier = new SupplierDto
        {
            Id = po.SupplierId,
            Code = string.Empty,
            Name = po.SupplierName,
            TinNo = po.SupplierTin,
            Address = po.SupplierAddress,
            IsActive = true
        };

        _form = new PoForm
        {
            CanvassRequestId = po.CanvassRequestId?.ToString(),
            SupplierName = po.SupplierName,
            SupplierAddress = po.SupplierAddress,
            SupplierTin = po.SupplierTin,
            ModeOfProcurement = po.ModeOfProcurement,
            PlaceOfDelivery = po.PlaceOfDelivery,
            DateOfDeliveryNullable = po.DateOfDelivery?.ToDateTime(TimeOnly.MinValue),
            DeliveryTerm = po.DeliveryTerm,
            PaymentTerm = po.PaymentTerm,
            FundCluster = po.FundCluster,
            OursBursNumber = po.OursBursNumber,
            LineItems = po.LineItems.Select(li => new PoLineItemRow
            {
                StockNumber = li.StockNumber,
                Unit = li.Unit,
                Description = li.Description,
                Quantity = li.Quantity,
                UnitCost = li.UnitCost
            }).ToList()
        };
    }

    private async Task CreateWithDuplicateRetryAsync(List<PurchaseOrderLineItemRequest> lineItems, bool allowDuplicate)
    {
        try
        {
            await Client.CreateAsync(new PurchaseOrderContracts.CreatePurchaseOrderCommand(
                _selectedPurchaseRequest!.Id,
                string.IsNullOrWhiteSpace(_form.CanvassRequestId) ? null : Guid.Parse(_form.CanvassRequestId),
                _selectedSupplier!.Id,
                _form.SupplierName, _form.SupplierAddress, _form.SupplierTin,
                _form.ModeOfProcurement, _form.PlaceOfDelivery,
                ToDateOnly(_form.DateOfDeliveryNullable),
                _form.DeliveryTerm, _form.PaymentTerm, _form.FundCluster, _form.OursBursNumber, lineItems,
                allowDuplicate));
        }
        catch (DuplicatePurchaseOrderException dup) when (!allowDuplicate)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Possible Duplicate Purchase Order",
                $"{dup.Message} Do you still want to create this PO?",
                yesText: "Create anyway",
                cancelText: "Cancel");

            if (confirmed is not true)
                throw new OperationCanceledException("Cancelled by user after duplicate warning.");

            await Client.CreateAsync(new PurchaseOrderContracts.CreatePurchaseOrderCommand(
                _selectedPurchaseRequest!.Id,
                string.IsNullOrWhiteSpace(_form.CanvassRequestId) ? null : Guid.Parse(_form.CanvassRequestId),
                _selectedSupplier!.Id,
                _form.SupplierName, _form.SupplierAddress, _form.SupplierTin,
                _form.ModeOfProcurement, _form.PlaceOfDelivery,
                ToDateOnly(_form.DateOfDeliveryNullable),
                _form.DeliveryTerm, _form.PaymentTerm, _form.FundCluster, _form.OursBursNumber, lineItems,
                AllowDuplicate: true));
        }
    }

    private async Task<(bool Proceed, bool AllowDuplicate)> ConfirmNoDuplicateAsync()
    {
        if (_selectedPurchaseRequest is null || _selectedSupplier is null)
            return (true, false);

        var newDescriptions = _form.LineItems
            .Select(li => NormalizeItem(li.Description))
            .Where(d => d.Length > 0)
            .ToHashSet();

        if (newDescriptions.Count == 0)
            return (true, false);

        Guid? canvassId = Guid.TryParse(_form.CanvassRequestId, out var cid) ? cid : null;

        List<PurchaseOrderSummaryDto> candidates;
        try
        {
            var result = await Client.SearchAsync(
                purchaseRequestId: _selectedPurchaseRequest.Id,
                supplierId: _selectedSupplier.Id,
                page: 1,
                pageSize: 50);
            candidates = result.Items?
                .Where(p => p.Status != PurchaseOrderStatus.Cancelled)
                .ToList() ?? [];
        }
        catch
        {
            return (true, false);
        }

        if (candidates.Count == 0)
            return (true, false);

        var duplicates = new List<(PurchaseOrderSummaryDto Po, List<string> Items)>();
        foreach (var c in candidates)
        {
            PurchaseOrderDto? detail;
            try { detail = await Client.GetAsync(c.Id); }
            catch { continue; }
            if (detail is null) continue;

            if (canvassId.HasValue && detail.CanvassRequestId != canvassId)
                continue;

            var overlap = detail.LineItems
                .Select(li => li.Description)
                .Where(d => newDescriptions.Contains(NormalizeItem(d)))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (overlap.Count > 0)
                duplicates.Add((c, overlap));
        }

        if (duplicates.Count == 0)
            return (true, false);

        var poList = string.Join(", ", duplicates.Select(d => $"{d.Po.PoNumber} ({d.Po.Status})"));
        var sampleItems = duplicates
            .SelectMany(d => d.Items)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(3)
            .ToList();
        var itemPreview = string.Join(", ", sampleItems);

        var message = $"A purchase order already exists for this purchase request and supplier ({_selectedSupplier.Name}) with overlapping item(s): {itemPreview}. Existing PO(s): {poList}. Do you still want to create this PO?";

        var confirmed = await DialogService.ShowMessageBox(
            "Possible Duplicate Purchase Order",
            message,
            yesText: "Create anyway",
            cancelText: "Cancel");

        return confirmed is true ? (true, true) : (false, false);
    }

    private void AddLineItem() => _form.LineItems.Add(new());
    private void RemoveLineItem(int idx) { if (_form.LineItems.Count > 1) _form.LineItems.RemoveAt(idx); }
    private void Cancel() => Dialog.Cancel();

    private bool IsFormValid() =>
        _selectedPurchaseRequest is not null &&
        _selectedSupplier is not null &&
        !string.IsNullOrWhiteSpace(_form.SupplierName) &&
        !string.IsNullOrWhiteSpace(_form.SupplierAddress) &&
        !string.IsNullOrWhiteSpace(_form.PlaceOfDelivery) &&
        !string.IsNullOrWhiteSpace(_form.DeliveryTerm) &&
        !string.IsNullOrWhiteSpace(_form.PaymentTerm) &&
        _form.LineItems.Any(li => !string.IsNullOrWhiteSpace(li.Description));

    private static DateOnly? ToDateOnly(DateTime? d) => d.HasValue ? DateOnly.FromDateTime(d.Value) : null;
    private static string NormalizeItem(string? value) =>
        string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim().ToLowerInvariant();

    private sealed class PoForm
    {
        public string? CanvassRequestId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public string SupplierAddress { get; set; } = string.Empty;
        public string? SupplierTin { get; set; }
        public ModeOfProcurement ModeOfProcurement { get; set; } = ModeOfProcurement.SmallValueProcurement;
        public string PlaceOfDelivery { get; set; } = string.Empty;
        public DateTime? DateOfDeliveryNullable { get; set; }
        public string DeliveryTerm { get; set; } = "30 days";
        public string PaymentTerm { get; set; } = "30 days";
        public string? FundCluster { get; set; }
        public string? OursBursNumber { get; set; }
        public List<PoLineItemRow> LineItems { get; set; } = [new()];
    }

    private sealed class PoLineItemRow
    {
        public string? StockNumber { get; set; }
        public string Unit { get; set; } = "pc";
        public string Description { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitCost { get; set; }
    }
}
