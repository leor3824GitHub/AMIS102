@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">PR Number</MudText>
                <MudText Typo="Typo.body1"><b>@PurchaseRequest.PrNumber</b></MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">PR Date</MudText>
                <MudText Typo="Typo.body1">@PurchaseRequest.PrDate.ToString("MM/dd/yyyy")</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">Status</MudText>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(PurchaseRequest.Status)" Icon="@StatusIcon(PurchaseRequest.Status)">
                    @PurchaseRequest.Status
                </MudChip>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Department</MudText>
                <MudText Typo="Typo.body1">@PurchaseRequest.DepartmentName</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Responsibility Center Code</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(PurchaseRequest.ResponsibilityCenterCode) ? "-" : PurchaseRequest.ResponsibilityCenterCode)</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">Requested By</MudText>
                <MudText Typo="Typo.body1">@PurchaseRequest.RequestedByName?.ToUpperInvariant()</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">Funds Available (Accountant)</MudText>
                <MudText Typo="Typo.body1">
                    @(string.IsNullOrWhiteSpace(PurchaseRequest.FundsAvailableCertifiedByName)
                        ? "-"
                        : $"{PurchaseRequest.FundsAvailableCertifiedByName.ToUpperInvariant()}{(PurchaseRequest.FundsAvailableCertifiedOnUtc is null ? "" : $" • {PurchaseRequest.FundsAvailableCertifiedOnUtc.Value.ToLocalTime():MM/dd/yyyy}")}")
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">Approved By (HoPE)</MudText>
                <MudText Typo="Typo.body1">
                    @(string.IsNullOrWhiteSpace(PurchaseRequest.ApprovedByName)
                        ? "-"
                        : $"{PurchaseRequest.ApprovedByName.ToUpperInvariant()}{(PurchaseRequest.ApprovedOnUtc is null ? "" : $" • {PurchaseRequest.ApprovedOnUtc.Value.ToLocalTime():MM/dd/yyyy}")}")
                </MudText>
            </MudItem>

            @if (!string.IsNullOrWhiteSpace(PurchaseRequest.ReturnedReason))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <b>Returned by @PurchaseRequest.ReturnedByName?.ToUpperInvariant()</b>
                        @if (PurchaseRequest.ReturnedOnUtc is not null)
                        {
                            <span> on @PurchaseRequest.ReturnedOnUtc.Value.ToLocalTime().ToString("MM/dd/yyyy")</span>
                        }
                        — @PurchaseRequest.ReturnedReason
                    </MudAlert>
                </MudItem>
            }

            @if (!string.IsNullOrWhiteSpace(PurchaseRequest.RejectionReason))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">
                        <b>Rejected:</b> @PurchaseRequest.RejectionReason
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Purpose</MudText>
                <MudText Typo="Typo.body1">@PurchaseRequest.Purpose</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">PR Type</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(PurchaseRequest.PrType == PrType.Unplanned ? Color.Warning : Color.Info)">
                    @PurchaseRequest.PrType
                </MudChip>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">SAI</MudText>
                <MudText Typo="Typo.body1">@FormatDoc(PurchaseRequest.SaiNumber, PurchaseRequest.SaiDate)</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.subtitle2">ALOBS</MudText>
                <MudText Typo="Typo.body1">@FormatDoc(PurchaseRequest.AlobsNumber, PurchaseRequest.AlobsDate)</MudText>
            </MudItem>

            @if (PurchaseRequest.PrType == PrType.Unplanned)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2">Justification</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(PurchaseRequest.Justification) ? "-" : PurchaseRequest.Justification)</MudText>
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">Line Items</MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th>Description</th>
                            <th style="width:60px;text-align:center" title="Catalog linked"></th>
                            <th style="width:90px;text-align:right">Qty</th>
                            <th style="width:80px">Unit</th>
                            <th style="width:120px;text-align:right">Unit Cost</th>
                            <th style="width:120px;text-align:right">Total</th>
                            <th style="width:140px">UACS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in PurchaseRequest.LineItems)
                        {
                            <tr>
                                <td>@line.ItemNo</td>
                                <td>@line.ItemDescription</td>
                                <td style="text-align:center">
                                    @if (line.CatalogItemId is not null && line.CatalogItemId != Guid.Empty)
                                    {
                                        <MudTooltip Text="@($"Linked catalog item: {line.CatalogItemId}")">
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Info" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                </td>
                                <td style="text-align:right">@line.Quantity.ToString("N2")</td>
                                <td>@line.UnitOfIssue</td>
                                <td style="text-align:right">@line.EstimatedUnitCost.ToString("N2")</td>
                                <td style="text-align:right">@line.EstimatedTotalCost.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(line.UacsObjectCode) ? "-" : line.UacsObjectCode)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudStack Row="true" JustifyContent="JustifyContent.End" Class="mt-2">
                    <MudText Typo="Typo.subtitle2">Estimated Total: @PurchaseRequest.LineItems.Sum(x => x.EstimatedTotalCost).ToString("N2")</MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public PurchaseRequestDto PurchaseRequest { get; set; } = default!;

    private void Close() => MudDialog.Close();

    private static string FormatDoc(string? number, DateOnly? date)
    {
        if (string.IsNullOrWhiteSpace(number) && date is null)
        {
            return "-";
        }

        if (string.IsNullOrWhiteSpace(number))
        {
            return date!.Value.ToString("MM/dd/yyyy");
        }

        return date is null ? number : $"{number} ({date.Value:MM/dd/yyyy})";
    }

    private static Color StatusColor(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => Color.Default,
        PurchaseRequestStatus.PendingFundsAvailable => Color.Info,
        PurchaseRequestStatus.PendingApproval => Color.Secondary,
        PurchaseRequestStatus.ReturnedForRevision => Color.Warning,
        PurchaseRequestStatus.Approved => Color.Success,
        PurchaseRequestStatus.Rejected => Color.Error,
        PurchaseRequestStatus.Cancelled => Color.Warning,
        PurchaseRequestStatus.Completed => Color.Tertiary,
        _ => Color.Default
    };

    private static string StatusIcon(PurchaseRequestStatus status) => status switch
    {
        PurchaseRequestStatus.Draft => Icons.Material.Filled.Edit,
        PurchaseRequestStatus.PendingFundsAvailable => Icons.Material.Filled.AccountBalance,
        PurchaseRequestStatus.PendingApproval => Icons.Material.Filled.HourglassBottom,
        PurchaseRequestStatus.ReturnedForRevision => Icons.Material.Filled.Reply,
        PurchaseRequestStatus.Approved => Icons.Material.Filled.CheckCircle,
        PurchaseRequestStatus.Rejected => Icons.Material.Filled.Cancel,
        PurchaseRequestStatus.Cancelled => Icons.Material.Filled.Block,
        PurchaseRequestStatus.Completed => Icons.Material.Filled.TaskAlt,
        _ => Icons.Material.Filled.Help
    };
}
