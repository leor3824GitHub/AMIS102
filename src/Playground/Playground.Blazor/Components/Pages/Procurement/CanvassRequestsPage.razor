@page "/procurement/canvass-requests"
@using AMIS.Playground.Blazor.Components.Pages.Procurement
@using AMIS.Modules.ProcurementAcquisition.Contracts.Permissions
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.Canvass
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.PurchaseRequests
@using AMIS.Modules.ProcurementAcquisition.Contracts.v1.SignedDocuments
@using AMIS.Framework.Shared.Persistence
@using AMIS.Playground.Blazor.ApiClient
@inject ICanvassRequestClient Client
@inject IPurchaseRequestClient PurchaseRequestClient
@inject IMaster_dataClient MasterDataClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IUserProfileState UserProfileState
@inject IFastReportSetupPreferences FastReportSetupPrefs
@inject IJSRuntime JS

<AMISPageHeader Title="Canvass Requests (RIV)" Description="Request for Issuance of Voucher • manage supplier quotations and award" />

<MudGrid Spacing="3">
    <!-- Create Form -->
    <MudItem xs="12" md="4">
        @if (_canCreate)
        {
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">New Canvass Request</MudText>
                    <MudStack Spacing="2">
                        <MudAutocomplete T="PurchaseRequestSummaryDto"
                                         Value="_selectedPurchaseRequest"
                                         ValueChanged="OnPurchaseRequestChanged"
                                         SearchFunc="SearchPurchaseRequests"
                                         ToStringFunc="FormatPurchaseRequest"
                                         Label="Purchase Request"
                                         Variant="Variant.Outlined"
                                         Placeholder="Search PR number or purpose..."
                                         Required="true"
                                         Clearable="true"
                                         CoerceValue="true"
                                         ResetValueOnEmptyText="true" />
                        <MudDatePicker @bind-Date="_returnDeadlineNullable" Label="Return Deadline"
                                       Variant="Variant.Outlined" Required="true" DateFormat="MM/dd/yyyy" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="CreateAsync" Disabled="@(_busy || _selectedItemNos.Count == 0)">
                            @if (_busy) { <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" /> }
                            Create Canvass Request (@_selectedItemNos.Count item@(_selectedItemNos.Count == 1 ? "" : "s"))
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        @if (_selectedPurchaseRequestDetail is not null)
        {
            <MudCard Elevation="1" Class="mt-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">PR Details Preview</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Purpose</MudText>
                            <MudText Typo="Typo.body2">@_selectedPurchaseRequestDetail.Purpose</MudText>
                        </div>
                        <MudDivider />
                        <MudGrid Spacing="1">
                            <MudItem xs="12" sm="6">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">PR Type</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(_selectedPurchaseRequestDetail.PrType == PrType.Unplanned ? Color.Warning : Color.Info)">
                                        @_selectedPurchaseRequestDetail.PrType
                                    </MudChip>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total</MudText>
                                    <MudText Typo="Typo.body2"><b>₱@_selectedPurchaseRequestDetail.LineItems.Sum(x => x.EstimatedTotalCost).ToString("N2")</b></MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                        <MudDivider />
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Select Items to Canvass (@_selectedItemNos.Count selected)</MudText>
                            @if (_canvassableLines.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No line items.</MudText>
                            }
                            else
                            {
                                @if (!_hasUncoveredLines)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                        All items on this PR are already covered by a canvass.
                                    </MudAlert>
                                }
                                <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x: auto;">
                                    <thead>
                                        <tr>
                                            <th style="width:40px"></th>
                                            <th style="width:40px">#</th>
                                            <th>Description</th>
                                            <th style="width:80px;text-align:right">Qty</th>
                                            <th style="width:60px">Unit</th>
                                            <th style="width:90px;text-align:right">Unit Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in _canvassableLines)
                                        {
                                            var no = line.ItemNo;
                                            <tr style="@(line.IsCovered ? "opacity:0.55" : "")">
                                                <td>
                                                    @if (line.IsCovered)
                                                    {
                                                        <MudTooltip Text="@($"Already on {line.CoveringRivNumber}")">
                                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Secondary" />
                                                        </MudTooltip>
                                                    }
                                                    else
                                                    {
                                                        <MudCheckBox T="bool" Dense="true"
                                                                     Value="_selectedItemNos.Contains(no)"
                                                                     ValueChanged="@((bool v) => ToggleItem(no, v))" />
                                                    }
                                                </td>
                                                <td>@no</td>
                                                <td>
                                                    @line.Description
                                                    @if (line.IsCovered)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">on @line.CoveringRivNumber</MudText>
                                                    }
                                                </td>
                                                <td style="text-align:right">@line.Quantity.ToString("N2")</td>
                                                <td>@line.Unit</td>
                                                <td style="text-align:right">@line.EstimatedUnitCost.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </div>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

    </MudItem>

    <!-- List Panel -->
    <MudItem xs="12" md="8">
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudText Typo="Typo.h6" Class="flex-grow-1">Canvass Requests</MudText>
                    <MudTextField @bind-Value="_keyword" Label="Search" Variant="Variant.Outlined" Size="Size.Small"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Style="max-width:220px" DebounceInterval="400"
                                  OnDebounceIntervalElapsed="@(async () => await LoadAsync())" />
                    <MudDatePicker Label="From" Date="_fromDate" DateChanged="OnFromDateChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                   Style="max-width:150px" />
                    <MudDatePicker Label="To" Date="_toDate" DateChanged="OnToDateChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                   Style="max-width:150px" />
                </MudStack>

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                    @foreach (var s in _statusFilters)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_statusFilter == s ? Color.Primary : Color.Default)"
                                 OnClick="@(() => SetStatusFilter(s))">@s</MudChip>
                    }
                </MudStack>

                @if (!_loaded)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No canvass requests found.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>RIV #</th>
                                <th>PR #</th>
                                <th>Deadline</th>
                                <th>Quotations</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                var isSelected = _selected?.Id == item.Id;
                                <tr style="@(isSelected ? "background:var(--mud-palette-primary-lighten)" : "")">
                                    <td><b>@item.RivNumber</b></td>
                                    <td>@item.PrNumber</td>
                                    <td>@item.ReturnDeadline.ToString("MM/dd/yyyy")</td>
                                    <td>@item.QuotationCount</td>
                                    <td>@CanvassStatusChip(item.Status)</td>
                                    <td>
                                        <MudStack Row="true" Spacing="0">
                                            <MudTooltip Text="@(isSelected ? "Hide Quotations" : "View Quotations")">
                                                <MudIconButton Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Small"
                                                               Color="Color.Primary"
                                                               OnClick="@(async () => await ToggleCanvass(item.Id))" />
                                            </MudTooltip>
                                            @if (item.Status == CanvassRequestStatus.Open && _canUpdate)
                                            {
                                                <MudTooltip Text="Add Quotation">
                                                    <MudIconButton Icon="@Icons.Material.Filled.PostAdd" Size="Size.Small"
                                                                   Color="Color.Secondary"
                                                                   OnClick="@(async () => await OpenQuotationDialogFor(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if (item.Status == CanvassRequestStatus.Open && item.QuotationCount > 0 && _canAward)
                                            {
                                                <MudTooltip Text="Award to Supplier">
                                                    <MudIconButton Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small"
                                                                   Color="Color.Success"
                                                                   OnClick="@(async () => await AwardAsync(item.Id))" />
                                                </MudTooltip>
                                            }
                                            @if (item.Status == CanvassRequestStatus.Awarded && _canCreatePo && !item.HasPurchaseOrder)
                                            {
                                                <MudTooltip Text="Create Purchase Order from awarded quotation">
                                                    <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small"
                                                                   Color="Color.Primary"
                                                                   OnClick="@(() => GoToPurchaseOrder(item.Id))" />
                                                </MudTooltip>
                                            }
                                            else if (item.HasPurchaseOrder)
                                            {
                                                <MudTooltip Text="@($"Purchase Order already created: {item.PurchaseOrderNumber}")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small"
                                                                   Color="Color.Default" Disabled="true" />
                                                </MudTooltip>
                                            }
                                            @if (_canViewSignedCopy && item.Status == CanvassRequestStatus.Awarded)
                                            {
                                                <MudTooltip Text="Signed copy (Abstract of Canvass)">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Secondary"
                                                                   OnClick="@(() => OpenSignedCopyAsync(item.Id, item.RivNumber, item.Status))" />
                                                </MudTooltip>
                                            }
                                            <MudMenu Icon="@Icons.Material.Filled.Print"
                                                     Color="Color.Secondary"
                                                     Size="Size.Small"
                                                     Dense="true"
                                                     AnchorOrigin="Origin.BottomLeft"
                                                     TransformOrigin="Origin.TopLeft"
                                                     ToolTip="Print reports">
                                                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf"
                                                             OnClick="@(() => DownloadFastReportPdfAsync(item.Id))">
                                                    Abstract of Canvass – PDF
                                                </MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Description"
                                                             OnClick="@(() => DownloadRfqFastReportPdfAsync(item.Id))">
                                                    Request for Quotation – PDF
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                             OnClick="@(() => OpenFastReportSetupAsync(item.Id))">
                                                    Abstract of Canvass – Page Setup…
                                                </MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                             OnClick="@(() => OpenRfqFastReportSetupAsync(item.Id))">
                                                    Request for Quotation – Page Setup…
                                                </MudMenuItem>
                                            </MudMenu>
                                        </MudStack>
                                    </td>
                                </tr>
                                <!-- Inline quotation list if selected -->
                                @if (isSelected && _selectedDetail is not null)
                                {
                                    <tr>
                                        <td colspan="6">
                                            <MudPaper Outlined="true" Class="pa-3 ma-1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                                    <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Quotations for @_selectedDetail.RivNumber</MudText>
                                                    @if (_selectedDetail.Status == CanvassRequestStatus.Open && _canUpdate)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                   StartIcon="@Icons.Material.Filled.PostAdd"
                                                                   OnClick="OpenQuotationDialog">
                                                            Add Quotation
                                                        </MudButton>
                                                    }
                                                </MudStack>
                                                @if (_selectedDetail.Quotations.Count == 0)
                                                {
                                                    @if (_selectedDetail.Status == CanvassRequestStatus.Open)
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No quotations yet. Click <b>Add Quotation</b> above to record one.</MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No quotations recorded.</MudText>
                                                    }
                                                }
                                                else
                                                {
                                                    <MudSimpleTable Dense="true" Hover="true">
                                                        <thead>
                                                            <tr>
                                                                <th>Supplier</th>
                                                                <th>Date</th>
                                                                <th style="text-align:right">Total</th>
                                                                <th>Terms</th>
                                                                <th>Awarded</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var q in _selectedDetail.Quotations)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <MudText Typo="Typo.body2"><b>@q.SupplierName</b></MudText>
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@q.SupplierAddress</MudText>
                                                                    </td>
                                                                    <td>@q.QuotationDate.ToString("MM/dd/yyyy")</td>
                                                                    <td style="text-align:right">₱@q.LineItems.Sum(li => li.Total).ToString("N2")</td>
                                                                    <td>@(q.DeliveryTerms ?? "—")</td>
                                                                    <td>
                                                                        @if (q.IsAwarded)
                                                                        {
                                                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Star">Awarded</MudChip>
                                                                                @if (_selectedDetail.HasPurchaseOrder)
                                                                                {
                                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.ShoppingCart">
                                                                                        PO @_selectedDetail.PurchaseOrderNumber
                                                                                    </MudChip>
                                                                                }
                                                                                else if (_canCreatePo)
                                                                                {
                                                                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                                               StartIcon="@Icons.Material.Filled.ShoppingCart"
                                                                                               OnClick="@(() => GoToPurchaseOrder(_selectedDetail.Id))">
                                                                                        Create PO
                                                                                    </MudButton>
                                                                                }
                                                                            </MudStack>
                                                                        }
                                                                        else if (_selectedDetail.Status == CanvassRequestStatus.Open && _canAward)
                                                                        {
                                                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                                                                       OnClick="@(async () => await AwardToQuotation(_selectedDetail.Id, q.Id))">
                                                                                Award
                                                                            </MudButton>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                }
                                            </MudPaper>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_totalCount > _pageSize)
                    {
                        <MudStack Row="true" JustifyContent="JustifyContent.Center" Class="mt-3">
                            <MudPagination Count="@((_totalCount + _pageSize - 1) / _pageSize)"
                                           Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" />
                        </MudStack>
                    }
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _canCreate => UserProfileState.Permissions.Contains(ProcurementPermissions.CanvassRequests.Create);
    private bool _canUpdate => UserProfileState.Permissions.Contains(ProcurementPermissions.CanvassRequests.Update);
    private bool _canAward => UserProfileState.Permissions.Contains(ProcurementPermissions.CanvassRequests.Award);
    private bool _canViewSignedCopy => UserProfileState.Permissions.Contains(ProcurementPermissions.SignedDocuments.View);

    private async Task OpenSignedCopyAsync(Guid id, string rivNumber, CanvassRequestStatus status)
    {
        var parameters = new DialogParameters<SignedCopyDialog>
        {
            { x => x.DocumentType, ProcurementDocumentType.AbstractOfCanvass },
            { x => x.DocumentId, id },
            { x => x.DocumentNumber, rivNumber },
            { x => x.IsTerminalState, status == CanvassRequestStatus.Awarded }
        };
        await DialogService.ShowAsync<SignedCopyDialog>("Signed Copy", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true });
    }
    private bool _canCreatePo => UserProfileState.Permissions.Contains(ProcurementPermissions.PurchaseOrders.Create);

    private List<CanvassRequestSummaryDto> _items = [];
    private CanvassRequestDto? _selected, _selectedDetail;
    private PurchaseRequestSummaryDto? _selectedPurchaseRequest;
    private PurchaseRequestDto? _selectedPurchaseRequestDetail;
    private List<CanvassablePrLineDto> _canvassableLines = [];
    private readonly HashSet<int> _selectedItemNos = [];
    private DateTime? _returnDeadlineNullable;
    private bool _busy, _loaded;
    private string _keyword = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _statusFilter = "All";
    private int _page = 1, _pageSize = 15, _totalCount;

    private static readonly string[] _statusFilters = ["All", "Open", "Evaluated", "Awarded", "Cancelled"];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task<IEnumerable<PurchaseRequestSummaryDto>> SearchPurchaseRequests(string value, CancellationToken token)
    {
        try
        {
            var result = await PurchaseRequestClient.SearchAsync(
                keyword: string.IsNullOrWhiteSpace(value) ? null : value,
                status: PurchaseRequestStatus.Approved,
                page: 1,
                pageSize: 20,
                excludeFullyCanvassed: true,
                ct: token);

            return result.Items ?? Enumerable.Empty<PurchaseRequestSummaryDto>();
        }
        catch
        {
            return Enumerable.Empty<PurchaseRequestSummaryDto>();
        }
    }

    private async Task OnPurchaseRequestChanged(PurchaseRequestSummaryDto? request)
    {
        _selectedPurchaseRequest = request;
        _selectedPurchaseRequestDetail = null;
        _canvassableLines = [];
        _selectedItemNos.Clear();

        if (request is not null)
        {
            try
            {
                _selectedPurchaseRequestDetail = await PurchaseRequestClient.GetAsync(request.Id);
            }
            catch
            {
                _selectedPurchaseRequestDetail = null;
            }

            try
            {
                _canvassableLines = (await Client.GetCanvassablePrLinesAsync(request.Id)).ToList();
                // Pre-select all lines that are still available for canvassing.
                foreach (var line in _canvassableLines.Where(l => !l.IsCovered))
                {
                    _selectedItemNos.Add(line.ItemNo);
                }
            }
            catch
            {
                _canvassableLines = [];
            }
        }
    }

    private bool _hasUncoveredLines => _canvassableLines.Any(l => !l.IsCovered);

    private void ToggleItem(int itemNo, bool selected)
    {
        if (selected) _selectedItemNos.Add(itemNo);
        else _selectedItemNos.Remove(itemNo);
    }

    private static string FormatPurchaseRequest(PurchaseRequestSummaryDto? request)
    {
        if (request is null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(request.Purpose)
            ? request.PrNumber
            : $"{request.PrNumber} - {request.Purpose}";
    }

    private async Task OpenQuotationDialog()
    {
        if (_selected is null) return;
        if (_selected.Status != CanvassRequestStatus.Open)
        {
            Snackbar.Add($"Cannot add quotation — canvass is {_selected.Status}.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(CanvassQuotationDialog.CanvassRequestId)] = _selected.Id,
            [nameof(CanvassQuotationDialog.PurchaseRequestId)] = _selected.PurchaseRequestId,
            [nameof(CanvassQuotationDialog.Form)] = new QuotationForm()
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CanvassQuotationDialog>("Add Quotation", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await SelectCanvass(_selected.Id);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            CanvassRequestStatus? filter = _statusFilter == "All" ? null : Enum.Parse<CanvassRequestStatus>(_statusFilter);
            var result = await Client.SearchAsync(_keyword, filter, _page, _pageSize, ToDateOnly(_fromDate), ToDateOnly(_toDate));
            _items = result.Items?.ToList() ?? [];
            _totalCount = (int)result.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loaded = true; }
    }

    private async Task SetStatusFilter(string s) { _statusFilter = s; _page = 1; await LoadAsync(); }

    private async Task OnFromDateChanged(DateTime? date) { _fromDate = date; _page = 1; await LoadAsync(); }

    private async Task OnToDateChanged(DateTime? date) { _toDate = date; _page = 1; await LoadAsync(); }

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is null ? null : DateOnly.FromDateTime(value.Value);

    private async Task CreateAsync()
    {
        if (_selectedPurchaseRequest is null || !_returnDeadlineNullable.HasValue)
        {
            Snackbar.Add("Select a purchase request and return deadline.", Severity.Warning);
            return;
        }
        if (_selectedItemNos.Count == 0)
        {
            Snackbar.Add("Select at least one line item to canvass.", Severity.Warning);
            return;
        }
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var selectedDeadline = DateOnly.FromDateTime(_returnDeadlineNullable.Value);
        if (selectedDeadline <= today)
        {
            Snackbar.Add("Return deadline must be a future date.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            await Client.CreateAsync(new CreateCanvassRequestCommand(
                _selectedPurchaseRequest.Id, selectedDeadline, _selectedItemNos.OrderBy(n => n).ToList()));
            Snackbar.Add("Canvass request created.", Severity.Success);
            _selectedPurchaseRequest = null;
            _selectedPurchaseRequestDetail = null;
            _canvassableLines = [];
            _selectedItemNos.Clear();
            _returnDeadlineNullable = null;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task SelectCanvass(Guid id)
    {
        var detail = await Client.GetAsync(id);
        if (detail is null) { Snackbar.Add("Canvass request not found.", Severity.Error); return; }
        _selected = detail;
        _selectedDetail = detail;
    }

    private async Task ToggleCanvass(Guid id)
    {
        if (_selected?.Id == id)
        {
            _selected = null;
            _selectedDetail = null;
        }
        else
        {
            await SelectCanvass(id);
        }
    }

    private async Task OpenQuotationDialogFor(Guid canvassId)
    {
        await SelectCanvass(canvassId);
        if (_selected is null) return;
        await OpenQuotationDialog();
    }

    private async Task AwardAsync(Guid canvassId)
    {
        var detail = await Client.GetAsync(canvassId);
        if (detail is null || detail.Quotations.Count == 0) { Snackbar.Add("No quotations to award.", Severity.Warning); return; }
        // Award to the lowest-priced quotation
        var lowest = detail.Quotations.OrderBy(q => q.LineItems.Sum(li => li.Total)).First();
        await AwardToQuotation(canvassId, lowest.Id);
    }

    private async Task AwardToQuotation(Guid canvassId, Guid quotationId)
    {
        var ok = await DialogService.ShowMessageBox("Award Canvass", "Award this canvass to the selected supplier?", "Award", cancelText: "Cancel");
        if (ok is not true) return;
        _busy = true;
        try
        {
            await Client.AwardAsync(canvassId, quotationId);
            Snackbar.Add("Canvass awarded.", Severity.Success);
            if (_selected?.Id == canvassId) await SelectCanvass(canvassId);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Award failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

