<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Playground.Maui.Features.PhysicalCount"
             xmlns:svc="clr-namespace:Playground.Maui.Services"
             x:DataType="vm:PhysicalCountFoundAtStationViewModel"
             x:Class="Playground.Maui.Features.PhysicalCount.PhysicalCountFoundAtStationPage"
             Title="Found at Station"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="0,16,0,32" Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,0,0,8" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{StaticResource Danger}"
                   FontSize="13"
                   Margin="20,0,20,12" />

            <!-- Property number header card — always editable so a damaged/missing sticker
                 can be keyed manually (scan pre-fills it, manual entry overrides). -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="16,0" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label FontSize="11" FontAttributes="Bold" CharacterSpacing="0.8"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="PROPERTY NO." />
                                <Span Text=" *" TextColor="{StaticResource Danger}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry Text="{Binding PropertyNo}"
                           FontFamily="InterBold" FontSize="18"
                           Placeholder="Scan or type the property number" />
                    <Label Text="This asset is not on the pre-generated checklist."
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Catalog item — required to close the session -->
            <Label FontSize="11" FontAttributes="Bold" CharacterSpacing="0.8"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}"
                   Margin="20,20,20,8">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="CATALOG ITEM" />
                        <Span Text=" *" TextColor="{StaticResource Danger}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Border Style="{StaticResource CardBorderStyle}" Margin="16,0" Padding="20">
                <VerticalStackLayout Spacing="10">

                    <!-- Selected item chip -->
                    <Border IsVisible="{Binding SelectedCatalogItem, Converter={StaticResource IsNotNullConverter}}"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="Transparent"
                            Padding="10,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding SelectedCatalogItem.Code}"
                                       FontFamily="InterBold" FontSize="13"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding SelectedCatalogItem.Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Change"
                                    FontSize="11"
                                    Padding="8,4"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    Command="{Binding SelectCatalogItemCommand}"
                                    CommandParameter="{x:Null}" />
                        </Grid>
                    </Border>

                    <!-- Search field -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding SelectedCatalogItem, Converter={StaticResource IsNullConverter}}">
                        <Entry Grid.Column="0"
                               Text="{Binding CatalogSearchText}"
                               Placeholder="Search catalog (e.g. laptop, printer)"
                               ReturnCommand="{Binding SearchCatalogCommand}" />
                        <Button Grid.Column="1"
                                Text="Search"
                                Command="{Binding SearchCatalogCommand}"
                                IsEnabled="{Binding IsCatalogSearching, Converter={StaticResource InvertedBoolConverter}}"
                                FontSize="13"
                                Padding="12,0" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsCatalogSearching}"
                                       IsVisible="{Binding IsCatalogSearching}"
                                       HeightRequest="24" />

                    <!-- Search results -->
                    <CollectionView ItemsSource="{Binding CatalogResults}"
                                    IsVisible="{Binding CatalogResults.Count, Converter={StaticResource IsNotZeroConverter}}"
                                    MaximumHeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="svc:CatalogItemDto">
                                <Border Margin="0,2" Padding="10,8"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PhysicalCountFoundAtStationViewModel}}, Path=SelectCatalogItemCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Code}"
                                               FontFamily="InterSemiBold" FontSize="13" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                        <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                               Text="{Binding DefaultUnit}"
                                               FontSize="11"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Required — the catalog item lets the system recognize this asset into the registry at session close."
                           Style="{StaticResource CaptionStyle}"
                           IsVisible="{Binding SelectedCatalogItem, Converter={StaticResource IsNullConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Asset details card -->
            <Label Text="ASSET DETAILS"
                   Style="{StaticResource SectionHeaderStyle}"
                   Margin="20,20,20,10" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="16,0" Padding="20">
                <VerticalStackLayout Spacing="0">

                    <!-- Description -->
                    <VerticalStackLayout Spacing="4" Padding="0,0,0,14">
                        <Label FontSize="11" FontAttributes="Bold" CharacterSpacing="0.8"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="DESCRIPTION" />
                                    <Span Text=" *" TextColor="{StaticResource Danger}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding Description}"
                               Placeholder="e.g. Dell Laptop Model XYZ" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                    <!-- Unit Cost -->
                    <VerticalStackLayout Spacing="4" Padding="0,14,0,14">
                        <Label Text="UNIT COST (&#x20B1;)" Style="{StaticResource FieldLabelStyle}" />
                        <Entry Keyboard="Numeric"
                               Text="{Binding UnitCostText}"
                               Placeholder="0.00" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                    <!-- Remarks -->
                    <VerticalStackLayout Spacing="4" Padding="0,14,0,0">
                        <Label Text="REMARKS (optional)" Style="{StaticResource FieldLabelStyle}" />
                        <Editor Text="{Binding Remarks}"
                                Placeholder="e.g. found in stock room, sticker missing"
                                HeightRequest="80"
                                AutoSize="TextChanges" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="16,20,16,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Button Grid.Column="1"
                        Text="Add Entry"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
