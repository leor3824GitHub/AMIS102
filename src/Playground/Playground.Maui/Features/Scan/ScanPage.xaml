<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Playground.Maui.Features.Scan"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:zxingcore="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.MAUI"
             xmlns:cam="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.Camera"
             x:DataType="vm:ScanViewModel"
             x:Class="Playground.Maui.Features.Scan.ScanPage"
             Title="Scan Asset">

    <Grid RowDefinitions="*,Auto">

        <!-- Barcode viewfinder (default mode) -->
        <zxing:CameraBarcodeReaderView Grid.Row="0"
                                       x:Name="BarcodeReader"
                                       IsVisible="{Binding IsBarcodeMode}"
                                       IsDetecting="{Binding IsBarcodeMode}"
                                       BarcodesDetected="OnBarcodeDetected">
            <zxing:CameraBarcodeReaderView.Options>
                <zxingcore:BarcodeReaderOptions Formats="QrCode,Code128,Code39,DataMatrix"
                                                AutoRotate="True"
                                                Multiple="False" />
            </zxing:CameraBarcodeReaderView.Options>
        </zxing:CameraBarcodeReaderView>

        <!-- Live text viewfinder (text mode) — frames are auto-captured and OCR'd by the page -->
        <cam:CameraView Grid.Row="0"
                        x:Name="TextCamera"
                        IsVisible="{Binding IsTextMode}" />

        <!-- Text-mode overlay: hint + live activity, no shutter button -->
        <VerticalStackLayout Grid.Row="0"
                             IsVisible="{Binding IsTextMode}"
                             VerticalOptions="Start" HorizontalOptions="Center"
                             Spacing="8" Padding="20,24"
                             InputTransparent="True">
            <ActivityIndicator IsRunning="{Binding IsTextMode}"
                               Color="{StaticResource White}"
                               HorizontalOptions="Center" />
            <Label Text="Point at the printed property number"
                   FontFamily="InterSemiBold"
                   FontSize="14"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Hold steady — it reads automatically."
                   FontSize="12"
                   TextColor="{StaticResource Gray200}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- No camera placeholder -->
        <VerticalStackLayout Grid.Row="0"
                             IsVisible="{Binding IsCameraAvailable, Converter={StaticResource InvertedBoolConverter}}"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="12" Padding="32">
            <Label Text="&#x1F4F7;"
                   FontSize="52"
                   HorizontalOptions="Center" />
            <Label Text="Camera not available on this device."
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Use the search box below to look up a property number."
                   FontSize="13"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Bottom panel: manual entry -->
        <Border Grid.Row="1"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Padding="20,16,20,24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="16" Opacity="0.06" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Label Text="MANUAL ENTRY"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0,0,0,0" />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Placeholder="Property No. e.g. SPLV-2026-01-0001"
                           Text="{Binding ManualPropertyNo}"
                           ReturnCommand="{Binding SearchManualCommand}"
                           AutomationId="PropertyNoEntry" />
                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchManualCommand}" />
                    <!-- Enter live text scan -->
                    <Button Grid.Column="2"
                            Text="Scan Text"
                            IsVisible="{Binding IsTextMode, Converter={StaticResource InvertedBoolConverter}}"
                            IsEnabled="{Binding IsOcrSupported}"
                            Command="{Binding StartTextScanCommand}" />
                    <!-- Exit live text scan (returns to barcode mode) -->
                    <Button Grid.Column="2"
                            Text="Stop"
                            IsVisible="{Binding IsTextMode}"
                            Command="{Binding StopTextScanCommand}" />
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
