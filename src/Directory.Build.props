<Project>
	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Enable latest C# features and diagnostics -->
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Code quality & analysis -->
		<!-- Warnings are errors so a NEW class of defect cannot land silently. The codes already
		     present in the tree are parked in WarningsBaseline below; anything NOT on that list
		     now fails the build. This is a ratchet, not a cleanup: the list only ever shrinks. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>

		<!-- Docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppress warning about missing XML docs -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<!-- Container tags (if using container builds) -->
		<ContainerImageTags>10.0.0-rc;latest</ContainerImageTags>

		<!-- Prevent MSBuild from excluding common folders (optional) -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<!--
	  ══ Warning baseline ══════════════════════════════════════════════════════════════════
	  Every diagnostic code that was already firing when TreatWarningsAsErrors was switched on
	  (census taken from a clean full-solution rebuild: ~1,900 instances across these codes).
	  They stay warnings so the build is green today; every OTHER code is now a hard error.

	  Rules of engagement:
	    • This list may SHRINK, never grow. Adding a code here needs a reason in the PR.
	    • Fix a code everywhere, then delete its entry — that is the burn-down.
	    • Do not silence a code by adding it here just to make a red build green.

	  Priority burn-down (real defects, not style):
	    CS8602/CS8603/CS8604/CS8669 — nullability holes; `Nullable` is enabled but unenforced
	    CA2000                      — IDisposable not disposed
	    S2139                       — exception logged and rethrown (duplicate noise)
	    S1144/S2094/S3168           — dead code
	  Deliberately parked (cosmetic / high-volume / upstream style choices):
	    CA1305 CA1873 S101 CA2234 CA1515 CS1573 …
	  Verified-safe in context, suppress at the call site instead of fixing:
	    CA5359/S4830 — cert validation bypass, already gated to dev localhost in ChatHubClient
	    S2068        — MultitenancyConstants.DefaultPassword, an inherited seed constant
	                   (weak-default worth revisiting, but not a leaked secret)
	  ══════════════════════════════════════════════════════════════════════════════════════
	-->
	<PropertyGroup>
		<WarningsBaseline>
			CA1002;CA1003;CA1008;CA1032;CA1054;CA1056;CA1062;CA1305;CA1307;CA1308;CA1707;
			CA1711;CA1716;CA1720;CA1812;CA1822;CA1859;CA1869;CA1873;CA2000;CA2227;CA2234;
			CA1515;CA5359;
			CS1573;CS1574;CS8602;CS8603;CS8604;CS8669;
			IDE0066;
			NU1608;
			S101;S125;S127;S1066;S1144;S1172;S1244;S2068;S2094;S2139;S2292;S2325;S2365;
			S2486;S2737;S2953;S3011;S3168;S3241;S3261;S3267;S3358;S3871;S4136;S4830;S5034;
			S5693;S6667;S6966;
			XA4301;MSG0005
		</WarningsBaseline>
		<!-- Collapse the formatted list above into the semicolon-delimited form NoWarn expects.
		     Strips every kind of whitespace (newlines, CR, tabs, spaces) in one pass — a chain of
		     .Replace() calls silently misses tabs, and this file is tab-indented, which leaves
		     entries like ";<tab><tab>CA1002" that only work because Roslyn happens to trim them. -->
		<NoWarn>$(NoWarn);$([System.Text.RegularExpressions.Regex]::Replace($(WarningsBaseline), '\s', ''))</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sonar Analyzer for deep static analysis -->
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- Default NuGet metadata -->
		<Authors>Mukesh Murugan</Authors>
		<Company>AMIS</Company>
		<Version>10.0.0-rc.1</Version>
		<RepositoryUrl>https://github.com/AMIS/dotnet-starter-kit</RepositoryUrl>
		<PackageTags>AMIS;AMIS;Modular;CQRS;VerticalSlice;DotNet;CleanArchitecture</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://AMIS.net</PackageProjectUrl>
		<Description>AMIS .NET Starter Kit - A production-ready modular .NET framework for building enterprise applications</Description>
		<!-- Enable NuGet pack globally (overridden in Host/Tests) -->
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<!-- Include root README.md in NuGet packages -->
	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>

