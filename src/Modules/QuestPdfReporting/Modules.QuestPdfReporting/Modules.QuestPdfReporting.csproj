	</ItemGroup>

	<!-- Static report assets (e.g. the agency logo printed on government forms).
	     Drop raster images (PNG/JPG) under ReportAssets\ and they are embedded automatically. -->
	<ItemGroup>
		<EmbeddedResource Include="ReportAssets\**\*.png" />
		<EmbeddedResource Include="ReportAssets\**\*.jpg" />
	</ItemGroup>

