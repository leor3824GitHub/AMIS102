        Border.Lines="15" Border.Width="0.5" />
      <TextObject Name="OthersLbl" Left="460" Top="200" Width="128" Height="22"
        Text="OTHERS" Font="Times New Roman, 8pt" VertAlign="Center"
        Padding="2,1,2,1" />
      <TextObject Name="BlankRight4" Left="590" Top="200" Width="151" Height="22"
        Text="" Border.Lines="15" Border.Width="0.5" />

      <!-- ─── Table Column Headers (Y=226, H=28) ─────── -->
      <TextObject Name="H_NameItem" Left="0" Top="226" Width="160" Height="28"
        Text="NAME OF&#10;ITEM" HorzAlign="Center" VertAlign="Center"
