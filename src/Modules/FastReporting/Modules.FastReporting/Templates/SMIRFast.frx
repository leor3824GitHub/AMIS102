      <TextObject Name="SmirNoVal" Left="590" Top="72" Width="151" Height="20"
        Text="[SmirDS.SmirNo]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />

      <!-- Report title -->
      <TextObject Name="Title" Left="0" Top="100" Width="741" Height="24"
        Text="SUPPLIES AND MATERIALS ISSUANCE  REPORT"
        HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 11pt, style=Bold" />
      <!-- Underline below title -->
      <TextObject Name="TitleUL" Left="60" Top="124" Width="621" Height="1.5"
        Text="" Border.Lines="4" Border.Width="1" />

      <!-- ─── Info Section ─────────────────────────────────── -->

      <!-- Row 1 (Y=134): ISSUED TO label | value | SALE checkbox | DATE label | DATE value -->
      <TextObject Name="IssuedToLbl" Left="0" Top="134" Width="120" Height="22"
        Text="ISSUED TO :" Font="Times New Roman, 8pt, style=Bold"
        VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="4,1,4,1" />
