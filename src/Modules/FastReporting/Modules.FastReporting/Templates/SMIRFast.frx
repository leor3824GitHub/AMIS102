        Padding="2,1,2,1" />
      <TextObject Name="BlankRight3" Left="590" Top="178" Width="151" Height="22"
        Text="" Border.Lines="15" Border.Width="0.5" />

      <!-- Row 4 (Y=200): blank | blank | OTHERS checkbox | blank -->
      <TextObject Name="BlankLbl4" Left="0" Top="200" Width="120" Height="22"
        Text="" Border.Lines="15" Border.Width="0.5" />
      <TextObject Name="BlankVal4" Left="120" Top="200" Width="320" Height="22"
