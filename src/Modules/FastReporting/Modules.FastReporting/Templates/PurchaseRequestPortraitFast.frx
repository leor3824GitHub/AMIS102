<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="05/27/2026 00:00:00" ReportInfo.Modified="05/28/2026 00:00:00" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary />
  <!--
    Data sources are registered at runtime via Report.RegisterData(IEnumerable, name).
    Same data contract as PurchaseRequestFast.frx (landscape):
      PurchaseRequestDS (header) + LineItemsDS (rows).

    NOTE: This portrait template does NOT use a DataBand. Two full-width PR copies are
    stacked vertically on a single page (top + bottom). Everything lives in one tall
    ReportTitleBand so the whole layout is positioned deterministically and never spills
    onto a second page. The handler populates each row slot by name (T_R{i}_* for the top
    copy, B_R{i}_* for the bottom copy) because FastReport bands can't flow the same data
    source into two non-contiguous regions of the same physical page. Capacity: 12 items.
  -->

  <!--
    Layout: A4 portrait (210 × 297 mm), 8 mm margins.
    Content width  = (210-16) × 3.7795 ≈ 733 units
    Content height = (297-16) × 3.7795 ≈ 1062 units

    Two identical PR copies stacked top/bottom, each full content width:
      Top copy    : y = 2    … 493   (≈ 130 mm)
      Cut zone     : y = 493  … 526   (≈  8.7 mm)  ← cut here
      Bottom copy : y = 526  … 1017  (≈ 130 mm)
    Entire content sits in ReportTitleBand (Height = 1018). A 16-unit PageFooterBand
    holds pagination. 1018 + 16 = 1034 ≤ 1062 → always one page.

    Column widths (per copy, total 733):
      Stock No  ( 9.5%) :  70     x=0
      Unit      ( 7.5%) :  55     x=70
      Description (52%) : 380     x=125
      Quantity  ( 8.9%) :  65     x=505
      Unit Cost (10.6%) :  78     x=570
      Total Cost(11.6%) :  85     x=648..733
  -->

  <ReportPage Name="Page1"
    Watermark.Font="Arial, 60pt"
    PaperWidth="210" PaperHeight="297"
    LeftMargin="8" TopMargin="8" RightMargin="8" BottomMargin="8"
    Landscape="false">

    <!-- ═══════════════════════════════════════════════════════════
         REPORT TITLE BAND  (renders once) — holds BOTH copies.
         Height = 1018 covers top copy (2..493), cut line (500..516),
         and bottom copy (526..1017). Bottom = top + 524 Y-offset.
         ═══════════════════════════════════════════════════════════ -->
    <ReportTitleBand Name="ReportTitle1" Width="733" Height="1018">

      <!-- ╔══════════════════════ TOP COPY ══════════════════════╗ -->

      <!-- ── TOP COPY: Org Header ─────────────────────────── -->
      <TextObject Name="T_Republic" Left="0" Top="2" Width="733" Height="14.3"
        Text="Republic of the Philippines" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt" />
      <TextObject Name="T_NFA" Left="0" Top="18.3" Width="733" Height="17.6"
        Text="National Food Authority" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 10pt, style=Bold" />
      <TextObject Name="T_OrgName" Left="0" Top="37.9" Width="733" Height="14.3"
        Text="[PurchaseRequestDS.OrgName]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt" />
      <TextObject Name="T_OrgAddr" Left="0" Top="54.2" Width="733" Height="14.3"
        Text="[PurchaseRequestDS.OrgAddress]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt" />

      <!-- ── TOP COPY: Exhibit 4 + Title ──────────────────── -->
      <TextObject Name="T_Exhibit" Left="0" Top="71.5" Width="733" Height="14.3"
        Text="Exhibit 4" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 10pt, style=Bold" />
      <TextObject Name="T_Title" Left="0" Top="85.8" Width="733" Height="22"
        Text="PURCHASE REQUEST" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 14pt, style=Bold" />

      <!-- ── TOP COPY: PR Form Header  top=111, H=33.9 ── -->
      <TextObject Name="T_DeptLbl" Left="0" Top="111" Width="95" Height="33.9"
        Text="Name of Department/ Office/ Section:"
        Font="Times New Roman, 7pt" HorzAlign="Left" VertAlign="Center" WordWrap="true"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_DeptVal" Left="95" Top="111" Width="285" Height="33.9"
        Text="[PurchaseRequestDS.DepartmentName]"
        Font="Times New Roman, 8pt" VertAlign="Center" WordWrap="true"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_PrNoLbl" Left="380" Top="111" Width="60" Height="16.95"
        Text="PR No.:"
        Font="Times New Roman, 7pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_PrNoVal" Left="440" Top="111" Width="100" Height="16.95"
        Text="[PurchaseRequestDS.PrNumber]"
        Font="Times New Roman, 8pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_RccLbl" Left="380" Top="127.95" Width="60" Height="16.95"
        Text="RC Code:"
        Font="Times New Roman, 7pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_RccVal" Left="440" Top="127.95" Width="100" Height="16.95"
        Text="[PurchaseRequestDS.ResponsibilityCenterCode]"
        Font="Times New Roman, 8pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_DateLbl" Left="540" Top="111" Width="40" Height="33.9"
        Text="Date:"
        Font="Times New Roman, 7pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="T_DateVal" Left="580" Top="111" Width="153" Height="33.9"
        Text="[PurchaseRequestDS.PrDate]"
        Font="Times New Roman, 8pt" VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />

      <!-- ── TOP COPY: Table Column Headers (top=144.9, H=33.9) ── -->
      <TextObject Name="T_HStockNo" Left="0" Top="144.9" Width="70" Height="33.9"
        Text="Stock&#10;Property&#10;No." HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
