<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="06/14/2026 00:00:00" ReportInfo.Modified="06/14/2026 00:00:00" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary />
  <!--
    Data sources registered at runtime via Report.RegisterData(...).

    Layout: Long Bond (216 × 330 mm) portrait, 10 mm margins.
    Content width = (216-20) × 3.7795 = 741 units

    DataSources:
      ParDS       – single-row header / signatory record
      LineItemsDS – one row per PAR item (DataTable)

    Column widths (total 741):
      Quantity        :  60   x=0
      Unit            :  60   x=60
      Description     : 290   x=120
      Property Number : 130   x=410
      Date Acquired   :  90   x=540
      Amount          : 111   x=630  → 741

    Border.Lines bitmap: Left=1, Right=2, Top=4, Bottom=8, All=15
  -->

  <ReportPage Name="Page1"
    PaperWidth="216" PaperHeight="330"
    LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10">

    <!-- ═══════════════════════════════════════════════════════════
         TITLE BAND  (appears once)
         ═══════════════════════════════════════════════════════════ -->
    <ReportTitleBand Name="ReportTitle1" Width="741" Height="120">

      <!-- Appendix tag -->
      <TextObject Name="Appendix" Left="0" Top="0" Width="741" Height="14"
        Text="Appendix 71" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Italic" />

      <!-- Entity Name row -->
      <TextObject Name="EntityLbl" Left="0" Top="14" Width="80" Height="22"
        Text="Entity Name:" VertAlign="Center"
        Font="Times New Roman, 8pt" Padding="2,0,2,0" />
      <TextObject Name="EntityVal" Left="80" Top="14" Width="480" Height="22"
        Text="[ParDS.EntityName]" VertAlign="Bottom"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="ParNoLbl" Left="560" Top="14" Width="60" Height="22"
        Text="PAR No.:" VertAlign="Center" HorzAlign="Right"
        Font="Times New Roman, 8pt" Padding="0,0,4,0" />
      <TextObject Name="ParNoVal" Left="620" Top="14" Width="121" Height="22"
        Text="[ParDS.PARNo]" VertAlign="Bottom"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- Fund Cluster row -->
      <TextObject Name="FundClusterLbl" Left="0" Top="36" Width="80" Height="22"
        Text="Fund Cluster:" VertAlign="Center"
        Font="Times New Roman, 8pt" Padding="2,0,2,0" />
      <TextObject Name="FundClusterVal" Left="80" Top="36" Width="250" Height="22"
        Text="[ParDS.FundCluster]" VertAlign="Bottom"
        Font="Times New Roman, 9pt"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- Title -->
      <TextObject Name="Title" Left="0" Top="58" Width="741" Height="26"
        Text="PROPERTY ACKNOWLEDGEMENT RECEIPT" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 14pt, style=Bold" />

      <!-- ── Column header row (top=84, H=36) ───────────────── -->
      <TextObject Name="HQty" Left="0" Top="84" Width="60" Height="36"
        Text="Quantity" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HUnit" Left="60" Top="84" Width="60" Height="36"
        Text="Unit" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HDesc" Left="120" Top="84" Width="290" Height="36"
        Text="Description" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HPropNo" Left="410" Top="84" Width="130" Height="36"
        Text="Property&#10;Number" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HDateAcq" Left="540" Top="84" Width="90" Height="36"
        Text="Date&#10;Acquired" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HAmount" Left="630" Top="84" Width="111" Height="36"
        Text="Amount" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />

    </ReportTitleBand>

    <!-- ═══════════════════════════════════════════════════════════
         DATA BAND  (repeats once per line item, height = 18)
         ═══════════════════════════════════════════════════════════ -->
    <DataBand Name="Data1" DataSource="LineItemsDS" Width="741" Height="18" CanGrow="true">

      <TextObject Name="DQty" Left="0" Top="0" Width="60" Height="18"
        Text="[LineItemsDS.Quantity]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />
      <TextObject Name="DUnit" Left="60" Top="0" Width="60" Height="18"
        Text="[LineItemsDS.Unit]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />
      <TextObject Name="DDesc" Left="120" Top="0" Width="290" Height="18"
        Text="[LineItemsDS.Description]" HorzAlign="Left" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="4,1,2,1"
        CanGrow="true" GrowToBottom="true" WordWrap="true" />
      <TextObject Name="DPropNo" Left="410" Top="0" Width="130" Height="18"
        Text="[LineItemsDS.PropertyNo]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        CanGrow="true" GrowToBottom="true" WordWrap="true" />
      <TextObject Name="DDateAcq" Left="540" Top="0" Width="90" Height="18"
        Text="[LineItemsDS.DateAcquired]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />
      <TextObject Name="DAmount" Left="630" Top="0" Width="111" Height="18"
        Text="[LineItemsDS.Amount]" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,4,1"
        GrowToBottom="true" />

    </DataBand>

    <!-- ═══════════════════════════════════════════════════════════
         SUMMARY BAND  (signature blocks — appears once at end)
         ═══════════════════════════════════════════════════════════ -->
    <ReportSummaryBand Name="ReportSummary1" Width="741" Height="162">

      <!-- Left half: Received by (end user) (x=0, W=360) -->
      <!-- Right half: Issued by (supply officer) (x=381, W=360) -->

      <!-- "Received by:" / "Issued by:" headings (H=22) -->
      <TextObject Name="RecByLbl" Left="0" Top="0" Width="360" Height="22"
        Text="Received by:" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="13" Border.Width="0.5" Padding="4,0,2,0" />
      <TextObject Name="IssByLbl" Left="381" Top="0" Width="360" Height="22"
        Text="Issued by:" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="13" Border.Width="0.5" Padding="4,0,2,0" />

      <!-- Blank signature space (H=44) -->
      <TextObject Name="RecBySigSpace" Left="0" Top="22" Width="360" Height="44"
        Text="" Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="IssBySigSpace" Left="381" Top="22" Width="360" Height="44"
        Text="" Border.Lines="11" Border.Width="0.5" />

      <!-- Name row (H=18) -->
      <TextObject Name="RecByName" Left="0" Top="66" Width="360" Height="18"
        Text="[ParDS.ReceivedByName]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="IssByName" Left="381" Top="66" Width="360" Height="18"
        Text="[ParDS.IssuedByName]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Signature Over Printed Name" label (H=14) -->
      <TextObject Name="RecBySigLbl" Left="0" Top="84" Width="360" Height="14"
        Text="Signature Over Printed Name" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="IssBySigLbl" Left="381" Top="84" Width="360" Height="14"
        Text="Signature Over Printed Name" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />

      <!-- Position/Office row (H=18) -->
      <TextObject Name="RecByPos" Left="0" Top="98" Width="360" Height="18"
        Text="[ParDS.ReceivedByPosition]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="IssByPos" Left="381" Top="98" Width="360" Height="18"
        Text="[ParDS.IssuedByPosition]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Position/Office" label (H=14) -->
      <TextObject Name="RecByPosLbl" Left="0" Top="116" Width="360" Height="14"
        Text="Position/Office" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="IssByPosLbl" Left="381" Top="116" Width="360" Height="14"
        Text="Position/Office" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />

      <!-- Date row (H=18) -->
      <TextObject Name="RecByDate" Left="0" Top="130" Width="360" Height="18"
        Text="[ParDS.PARDate]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="IssByDate" Left="381" Top="130" Width="360" Height="18"
        Text="" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Date" label (H=14) -->
      <TextObject Name="RecByDateLbl" Left="0" Top="148" Width="360" Height="14"
        Text="Date" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="14" Border.Width="0.5" />
      <TextObject Name="IssByDateLbl" Left="381" Top="148" Width="360" Height="14"
        Text="Date" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="14" Border.Width="0.5" />

    </ReportSummaryBand>

  </ReportPage>
</Report>
