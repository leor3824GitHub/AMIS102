<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="05/26/2026 00:00:00" ReportInfo.Modified="05/26/2026 00:00:00" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary />
  <!--
    Data sources registered at runtime via Report.RegisterData(...).

    Layout: Long Bond (216 × 330 mm) portrait, 10 mm margins.
    Content width = (216-20) × 3.7795 = 741 units

    DataSources:
      IcsDS       – single-row header / signatory record
      LineItemsDS – one row per ICS item (DataTable)

    Column widths (total 741):
      Quantity          :  55   x=0
      Unit              :  55   x=55
      Unit Cost         :  90   x=110
      Total Cost        :  90   x=200
      Description       : 250   x=290
      Inventory Item No.:  96   x=540
      Est. Useful Life  : 105   x=636  → 741

    Border.Lines bitmap: Left=1, Right=2, Top=4, Bottom=8, All=15
  -->

  <ReportPage Name="Page1"
    PaperWidth="216" PaperHeight="330"
    LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10">

    <!-- ═══════════════════════════════════════════════════════════
         TITLE BAND  (appears once)
         Height = 14 + 22 + 22 + 26 + 36 = 120
         ═══════════════════════════════════════════════════════════ -->
    <ReportTitleBand Name="ReportTitle1" Width="741" Height="120">

      <!-- Appendix tag -->
      <TextObject Name="Appendix" Left="0" Top="0" Width="741" Height="14"
        Text="Appendix 59" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Italic" />

      <!-- Entity Name row -->
      <TextObject Name="EntityLbl" Left="0" Top="14" Width="80" Height="22"
        Text="Entity Name:" VertAlign="Center"
        Font="Times New Roman, 8pt" Padding="2,0,2,0" />
      <TextObject Name="EntityVal" Left="80" Top="14" Width="480" Height="22"
        Text="[IcsDS.EntityName]" VertAlign="Bottom"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="IcsNoLbl" Left="560" Top="14" Width="60" Height="22"
        Text="ICS No.:" VertAlign="Center" HorzAlign="Right"
        Font="Times New Roman, 8pt" Padding="0,0,4,0" />
      <TextObject Name="IcsNoVal" Left="620" Top="14" Width="121" Height="22"
        Text="[IcsDS.ICSNo]" VertAlign="Bottom"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- Fund Cluster row -->
      <TextObject Name="FundClusterLbl" Left="0" Top="36" Width="80" Height="22"
        Text="Fund Cluster:" VertAlign="Center"
        Font="Times New Roman, 8pt" Padding="2,0,2,0" />
      <TextObject Name="FundClusterVal" Left="80" Top="36" Width="250" Height="22"
        Text="[IcsDS.FundCluster]" VertAlign="Bottom"
        Font="Times New Roman, 9pt"
        Border.Lines="8" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- Title -->
      <TextObject Name="Title" Left="0" Top="58" Width="741" Height="26"
        Text="INVENTORY CUSTODIAN SLIP" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 14pt, style=Bold" />

      <!-- ── Column header row 1 (top=84, H=18) ───────────────── -->
      <!-- Qty — spans both header rows (H=36) -->
      <TextObject Name="HQty" Left="0" Top="84" Width="55" Height="36"
        Text="Quanti&#10;ty" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <!-- Unit — spans both header rows (H=36) -->
      <TextObject Name="HUnit" Left="55" Top="84" Width="55" Height="36"
        Text="Unit" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <!-- Amount (spanning Unit Cost + Total Cost) — top row only (H=18) -->
      <TextObject Name="HAmount" Left="110" Top="84" Width="180" Height="18"
        Text="Amount" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <!-- Description — spans both header rows (H=36) -->
      <TextObject Name="HDesc" Left="290" Top="84" Width="250" Height="36"
        Text="Description" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <!-- Inventory Item No. — spans both header rows (H=36) -->
      <TextObject Name="HInvItemNo" Left="540" Top="84" Width="96" Height="36"
        Text="Inventory&#10;Item No." HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <!-- Estimated Useful Life — spans both header rows (H=36) -->
      <TextObject Name="HEstLife" Left="636" Top="84" Width="105" Height="36"
        Text="Estimated&#10;Useful Life" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />

      <!-- ── Column header row 2 (top=102, H=18) — sub-cells under Amount ── -->
      <TextObject Name="HUnitCost" Left="110" Top="102" Width="90" Height="18"
        Text="Unit&#10;Cost" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HTotalCost" Left="200" Top="102" Width="90" Height="18"
        Text="Total&#10;Cost" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Bold,Italic"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />

    </ReportTitleBand>

    <!-- ═══════════════════════════════════════════════════════════
         DATA BAND  (repeats once per line item, height = 18)
         ═══════════════════════════════════════════════════════════ -->
    <DataBand Name="Data1" DataSource="LineItemsDS" Width="741" Height="18" CanGrow="true">

      <TextObject Name="DQty" Left="0" Top="0" Width="55" Height="18"
        Text="[LineItemsDS.Quantity]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />
      <TextObject Name="DUnit" Left="55" Top="0" Width="55" Height="18"
        Text="[LineItemsDS.Unit]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />
      <TextObject Name="DUnitCost" Left="110" Top="0" Width="90" Height="18"
        Text="[LineItemsDS.UnitCost]" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,4,1"
        GrowToBottom="true" />
      <TextObject Name="DTotalCost" Left="200" Top="0" Width="90" Height="18"
        Text="[LineItemsDS.TotalCost]" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,4,1"
        GrowToBottom="true" />
      <TextObject Name="DDesc" Left="290" Top="0" Width="250" Height="18"
        Text="[LineItemsDS.Description]" HorzAlign="Left" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="4,1,2,1"
        CanGrow="true" GrowToBottom="true" WordWrap="true" />
      <TextObject Name="DInvItemNo" Left="540" Top="0" Width="96" Height="18"
        Text="[LineItemsDS.InventoryItemNo]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        CanGrow="true" GrowToBottom="true" WordWrap="true" />
      <TextObject Name="DEstLife" Left="636" Top="0" Width="105" Height="18"
        Text="[LineItemsDS.EstUsefulLife]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1"
        GrowToBottom="true" />

    </DataBand>

    <!-- ═══════════════════════════════════════════════════════════
         SUMMARY BAND  (signature blocks — appears once at end)
         Height = 22 + 44 + 18 + 14 + 18 + 14 + 18 + 14 = 162
         ═══════════════════════════════════════════════════════════ -->
    <ReportSummaryBand Name="ReportSummary1" Width="741" Height="162">

      <!-- Left half: Received from (x=0, W=360) -->
      <!-- Right half: Received by  (x=381, W=360) -->
      <!-- 21-unit gap between halves                -->

      <!-- "Received from:" / "Received by:" headings (H=22) -->
      <TextObject Name="RecFromLbl" Left="0" Top="0" Width="360" Height="22"
        Text="Received from:" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="13" Border.Width="0.5" Padding="4,0,2,0" />
      <TextObject Name="RecByLbl" Left="381" Top="0" Width="360" Height="22"
        Text="Received by:" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="13" Border.Width="0.5" Padding="4,0,2,0" />

      <!-- Blank signature space (H=44) with bottom and side borders -->
      <TextObject Name="RecFromSigSpace" Left="0" Top="22" Width="360" Height="44"
        Text="" Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="RecBySigSpace" Left="381" Top="22" Width="360" Height="44"
        Text="" Border.Lines="11" Border.Width="0.5" />

      <!-- Name row (H=18) — printed name, bottom border = signature line -->
      <TextObject Name="RecFromName" Left="0" Top="66" Width="360" Height="18"
        Text="[IcsDS.IssuedFromName]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="RecByName" Left="381" Top="66" Width="360" Height="18"
        Text="[IcsDS.ReceivedByName]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Signature Over Printed Name" label (H=14) -->
      <TextObject Name="RecFromSigLbl" Left="0" Top="84" Width="360" Height="14"
        Text="Signature Over Printed Name" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="RecBySigLbl" Left="381" Top="84" Width="360" Height="14"
        Text="Signature Over Printed Name" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />

      <!-- Position/Office row (H=18) -->
      <TextObject Name="RecFromPos" Left="0" Top="98" Width="360" Height="18"
        Text="[IcsDS.IssuedFromPosition]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="RecByPos" Left="381" Top="98" Width="360" Height="18"
        Text="[IcsDS.ReceivedByPosition]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="11" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Position/Office" label (H=14) -->
      <TextObject Name="RecFromPosLbl" Left="0" Top="116" Width="360" Height="14"
        Text="Position/Office" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />
      <TextObject Name="RecByPosLbl" Left="381" Top="116" Width="360" Height="14"
        Text="Position/Office" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="11" Border.Width="0.5" />

      <!-- Date row (H=18) -->
      <TextObject Name="RecFromDate" Left="0" Top="130" Width="360" Height="18"
        Text="[IcsDS.ICSDate]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,0,2,0" />
      <TextObject Name="RecByDate" Left="381" Top="130" Width="360" Height="18"
        Text="" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 8pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,0,2,0" />

      <!-- "Date" label (H=14) -->
      <TextObject Name="RecFromDateLbl" Left="0" Top="148" Width="360" Height="14"
        Text="Date" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="14" Border.Width="0.5" />
      <TextObject Name="RecByDateLbl" Left="381" Top="148" Width="360" Height="14"
        Text="Date" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 7pt, style=Italic"
        Border.Lines="14" Border.Width="0.5" />

    </ReportSummaryBand>

  </ReportPage>
</Report>
