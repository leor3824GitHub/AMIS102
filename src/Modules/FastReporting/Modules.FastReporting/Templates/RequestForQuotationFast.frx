<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="05/26/2026 00:00:00" ReportInfo.Modified="05/26/2026 00:00:00" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary />
  <!--
    Layout: A4 portrait (210 × 297 mm), 8 mm margins.
    Content width  = (210-16) × 3.7795 ≈ 733 units
    Content height = (297-16) × 3.7795 ≈ 1062 units

    Two copies per page: GroupHeaderBand + DataBand + GroupFooterBand, grouped by
    LineItemsDS.CopyNumber (1 and 2). Handler duplicates rows for each copy.

    Per copy (MinRows=8): GroupHeader(190) + 8×DataRow(20) + GroupFooter(138) = 488
    Two copies: 976 units — fits comfortably on A4.

    Table column widths (total 733):
      ITEM/DESCRIPTION (55%) : 403    x=0
      UNIT              (10%) :  73    x=403
      QTY               (10%) :  73    x=476
      RATE/PRICE       (12.5%):  92    x=549   ← blank, supplier fills
      TOTAL            (12.5%):  92    x=641   ← blank, supplier fills
  -->

  <ReportPage Name="Page1"
    PaperWidth="210" PaperHeight="297"
    LeftMargin="8" TopMargin="8" RightMargin="8" BottomMargin="8"
    Landscape="false">

    <!-- ═══════════════════════════════════════════════════════════
         GROUP HEADER BAND  (one per copy — org header, form title,
         supplier fields, instruction, column headers)
         Condition: [LineItemsDS.CopyNumber] — groups copy 1 then copy 2
         ═══════════════════════════════════════════════════════════ -->
    <GroupHeaderBand Name="GroupHeader1" Width="733" Height="190"
      Condition="[LineItemsDS.CopyNumber]" StartNewPage="false">

      <!-- ── Organization Header ────────────────────────────────── -->
      <TextObject Name="Republic" Left="0" Top="0" Width="733" Height="13"
        Text="Republic of the Philippines" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt" />
      <TextObject Name="NFA" Left="0" Top="14" Width="733" Height="17"
        Text="National Food Authority" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 11pt, style=Bold" />
      <TextObject Name="OrgName" Left="0" Top="32" Width="733" Height="13"
        Text="[RfqDS.OrgName]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt" />
      <TextObject Name="OrgAddr" Left="0" Top="46" Width="733" Height="13"
        Text="[RfqDS.OrgAddress]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt" />

      <!-- ── Form Title ─────────────────────────────────────────── -->
      <TextObject Name="FormTitle" Left="0" Top="63" Width="733" Height="22"
        Text="REQUEST FOR QUOTATION" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 14pt, style=Bold" />
      <TextObject Name="TitleUnderline" Left="133" Top="87" Width="467" Height="1.1"
        Text="" Border.Lines="4" Border.Width="1" />

      <!-- ── Row 1: Supplier Name / Date / RIV# ──────────────────
           Widths: 120 + 190 + 60 + 100 + 50 + 213 = 733
      ─────────────────────────────────────────────────────────── -->
      <TextObject Name="SupNameLbl" Left="0" Top="92" Width="120" Height="20"
        Text="SUPPLIER'S NAME:" Font="Times New Roman, 7.5pt, style=Bold"
        VertAlign="Center" HorzAlign="Left"
        Border.Lines="15" Border.Width="0.5" Padding="3,1,2,1" />
      <TextObject Name="SupNameVal" Left="120" Top="92" Width="190" Height="20"
        Text="" Font="Times New Roman, 9pt"
        VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="DateLbl" Left="310" Top="92" Width="60" Height="20"
        Text="DATE:" Font="Times New Roman, 7.5pt, style=Bold"
        VertAlign="Center" HorzAlign="Left"
        Border.Lines="15" Border.Width="0.5" Padding="3,1,2,1" />
      <TextObject Name="DateVal" Left="370" Top="92" Width="100" Height="20"
        Text="" Font="Times New Roman, 9pt"
        VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="RivLbl" Left="470" Top="92" Width="50" Height="20"
        Text="RIV#" Font="Times New Roman, 7.5pt, style=Bold"
        VertAlign="Center" HorzAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="RivVal" Left="520" Top="92" Width="213" Height="20"
        Text="[RfqDS.RivNumber]" Font="Times New Roman, 9pt, style=Bold"
        VertAlign="Center" HorzAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />

      <!-- ── Row 2: Address / TIN No. ───────────────────────────
           Widths: 80 + 310 + 70 + 273 = 733
      ─────────────────────────────────────────────────────────── -->
      <TextObject Name="AddrLbl" Left="0" Top="114" Width="80" Height="20"
        Text="ADDRESS:" Font="Times New Roman, 7.5pt, style=Bold"
        VertAlign="Center" HorzAlign="Left"
        Border.Lines="15" Border.Width="0.5" Padding="3,1,2,1" />
      <TextObject Name="AddrVal" Left="80" Top="114" Width="310" Height="20"
        Text="" Font="Times New Roman, 9pt"
        VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="TinLbl" Left="390" Top="114" Width="70" Height="20"
        Text="TIN NO." Font="Times New Roman, 7.5pt, style=Bold"
        VertAlign="Center" HorzAlign="Left"
        Border.Lines="15" Border.Width="0.5" Padding="3,1,2,1" />
      <TextObject Name="TinVal" Left="460" Top="114" Width="273" Height="20"
        Text="" Font="Times New Roman, 9pt"
        VertAlign="Center"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />

      <!-- ── Row 3: Instruction Text ───────────────────────────── -->
      <TextObject Name="InstructionText" Left="0" Top="136" Width="733" Height="30"
        Text="PLEASE INDICATE YOUR OFFER INCLUDING THE SHORTEST DELIVERY PERIOD FOR EACH ITEM DESCRIBED BELOW AND RETURN THIS FORM TO US ON OR BEFORE [RfqDS.ReturnDeadline]."
        Font="Times New Roman, 8pt" VertAlign="Center" HorzAlign="Left" WordWrap="true"
        Border.Lines="15" Border.Width="0.5" Padding="4,2,4,2" />

      <!-- ── Row 4: Table Column Headers ──────────────────────────
           No background fill — plain bordered cells.
      ─────────────────────────────────────────────────────────── -->
      <TextObject Name="HDesc" Left="0" Top="168" Width="403" Height="20"
        Text="ITEM / DESCRIPTION" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="HUnit" Left="403" Top="168" Width="73" Height="20"
        Text="UNIT" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HQty" Left="476" Top="168" Width="73" Height="20"
        Text="QTY" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HRate" Left="549" Top="168" Width="92" Height="20"
        Text="RATE/PRICE" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="HTotal" Left="641" Top="168" Width="92" Height="20"
        Text="T O T A L" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />

    <!-- ═══════════════════════════════════════════════════════════
         DATA BAND  (one row per line item per copy)
         Nested inside the GroupHeaderBand so FastReport associates the
         group header/footer with this band. As flat siblings the group
         bands never print — only the data rows would render.
         ═══════════════════════════════════════════════════════════ -->
    <DataBand Name="Data1" DataSource="LineItemsDS" Width="733" Height="20">

      <TextObject Name="DDesc" Left="0" Top="0" Width="403" Height="20"
        Text="[LineItemsDS.Description]" VertAlign="Center" HorzAlign="Left"
        Font="Times New Roman, 9pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="4,1,4,1" />
      <TextObject Name="DUnit" Left="403" Top="0" Width="73" Height="20"
        Text="[LineItemsDS.Unit]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="DQty" Left="476" Top="0" Width="73" Height="20"
        Text="[LineItemsDS.Quantity]" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 9pt"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,1,1" />
      <TextObject Name="DRate" Left="549" Top="0" Width="92" Height="20"
        Text="" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 9pt"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,4,1" />
      <TextObject Name="DTotal" Left="641" Top="0" Width="92" Height="20"
        Text="" HorzAlign="Right" VertAlign="Center"
        Font="Times New Roman, 9pt"
        Border.Lines="15" Border.Width="0.5" Padding="1,1,4,1" />

    </DataBand>

    <!-- ═══════════════════════════════════════════════════════════
         GROUP FOOTER BAND  (reservation clause, signature blocks,
         important note — rendered once per copy)
         ═══════════════════════════════════════════════════════════ -->
    <GroupFooterBand Name="GroupFooter1" Width="733" Height="138">

      <!-- ── Reservation Clause (no background) ────────────────── -->
      <TextObject Name="Reservation" Left="0" Top="0" Width="733" Height="36"
        Text="THE NFA HEREBY RESERVES THE RIGHT TO REJECT ANY OR ALL BID/OFFER TO WAIVE ANY FORMALITY  HEREIN OR TO ACCEPT CONDITIONS MOST ADVANTAGEOUS TO THE AGENCY."
        Font="Times New Roman, 8pt" VertAlign="Center" HorzAlign="Left" WordWrap="true"
        Border.Lines="15" Border.Width="0.5" Padding="4,2,4,2" />

      <!-- ── Label Row (top=36, h=34) — full-bordered cells, no gaps ──
           Left  200 : Approving official signature area
           Mid   200 : Terms of Delivery (blank for supplier)
           Right 333 : SUPPLIER'S NAME & SIGNATURE (blank for supplier)
      ─────────────────────────────────────────────────────────── -->
      <TextObject Name="RmSignArea" Left="0" Top="36" Width="200" Height="34"
        Text="" Font="Times New Roman, 9pt"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />
      <TextObject Name="TermsLbl" Left="200" Top="36" Width="200" Height="34"
        Text="Terms of Delivery" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="2,2,2,2" />
      <TextObject Name="SupSigLbl" Left="400" Top="36" Width="333" Height="34"
        Text="SUPPLIER'S NAME &amp; SIGNATURE" HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold"
        Border.Lines="15" Border.Width="0.5" Padding="2,2,2,2" />

      <!-- ── Signature Row (top=70, h=42) — three full-bordered cells.
           Name/designation and the supplier signature line + DATE are
           overlaid (borderless) inside these cells so the grid stays
           a clean, closed rectangle (no partial borders / open boxes). ── -->
      <TextObject Name="LeftSigCell" Left="0" Top="70" Width="200" Height="42"
        Text="" Border.Lines="15" Border.Width="0.5" />
      <TextObject Name="MidTermsCell" Left="200" Top="70" Width="200" Height="42"
        Text="" Border.Lines="15" Border.Width="0.5" />
      <TextObject Name="SupSigCell" Left="400" Top="70" Width="333" Height="42"
        Text="" Border.Lines="15" Border.Width="0.5" />

      <!-- Left signature block: name above the line, designation below. -->
      <TextObject Name="SignatoryNameVal" Left="0" Top="74" Width="200" Height="16"
        Text="[RfqDS.SignatoryName]" HorzAlign="Center" VertAlign="Bottom"
        Font="Times New Roman, 9pt, style=Bold" Padding="2,1,2,1" />
      <TextObject Name="SignatoryNameUnderline" Left="15" Top="90" Width="170" Height="1.1"
        Text="" Border.Lines="4" Border.Width="0.75" />
      <TextObject Name="SignatoryRoleVal" Left="0" Top="92" Width="200" Height="16"
        Text="[RfqDS.SignatoryRole]" HorzAlign="Center" VertAlign="Top"
        Font="Times New Roman, 8pt" Padding="2,1,2,1" />

      <!-- Supplier cell: signature line, then DATE label beneath it. -->
      <TextObject Name="SupSigUnderline" Left="420" Top="90" Width="293" Height="1.1"
        Text="" Border.Lines="4" Border.Width="0.75" />
      <TextObject Name="DateLblBottom" Left="400" Top="93" Width="333" Height="16"
        Text="DATE:" HorzAlign="Left" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Bold" Padding="6,1,2,1" />

      <!-- ── Important Note (top=112) ───────────────────────────── -->
      <TextObject Name="ImportantNote" Left="0" Top="112" Width="733" Height="15"
        Text="IMPORTANT: ERASURE / ALTERATIONS / INTER CANCELLATIONS WILL INVALIDATE THE OFFER."
        HorzAlign="Center" VertAlign="Center"
        Font="Times New Roman, 8pt, style=Italic"
        Border.Lines="15" Border.Width="0.5" Padding="2,1,2,1" />

    </GroupFooterBand>

    </GroupHeaderBand>

    <!-- ═══════════════════════════════════════════════════════════
         PAGE FOOTER
         ═══════════════════════════════════════════════════════════ -->
    <PageFooterBand Name="PageFooter1" Top="1048" Width="733" Height="14">
      <TextObject Name="PgNo" Left="0" Top="0" Width="733" Height="14"
        Text="Page [Page#] of [TotalPages#]" HorzAlign="Right"
        Font="Times New Roman, 7pt" />
    </PageFooterBand>

  </ReportPage>
</Report>
