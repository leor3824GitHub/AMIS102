<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>AMIS.Modules.Chat</RootNamespace>
		<AssemblyName>AMIS.Modules.Chat</AssemblyName>
		<PackageId>AMIS.Modules.Chat</PackageId>
